@using System.Collections
@using Telerik.Reporting
@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@model Vfi.Ui.Mvc.Vfi.Areas.Sales.Models.OrderModel
@{
    ViewBag.Title = "Quản lý chứng từ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">

        function grid_OnDataBinding(args) {
            
            if (!onLoading) {
                OnLoadingData();
                var statusValue = $("#Status").data("tComboBox").value();
                if (statusValue === "")
                    statusValue = 0;
                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else {
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                }
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else {
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
                }

                //    if (customerId == 0)
                //        customerId = 0;

                args.data = $.extend(args.data, {
                    fromDate: fromDate,
                    toDate: toDate,
                    status: statusValue
                });
            }

        }


        function status_onChange() {
            RefreshGrid2("gridTaxInvoicesManagement");
        }

        function status_onLoad() {
            var combobox = $('#Status').data('tComboBox');
            var dataSource =
            [
                { Text: "Chưa duyệt", Value: "1" },
                { Text: "Đã duyệt", Value: "4" },
                { Text: "Hoàn thành", Value: "2" },
                { Text: "Huỷ", Value: "3" }
            ];

            combobox.dataBind(dataSource);
        }

        function month_onload() {
            var combobox = $('#Month').data('tComboBox');
            var dataSource =
            [
                { Text: "1", Value: "1" },
                { Text: "2", Value: "2" },
                { Text: "3", Value: "3" },
                { Text: "4", Value: "4" },
                { Text: "5", Value: "5" },
                { Text: "6", Value: "6" },
                { Text: "7", Value: "7" },
                { Text: "8", Value: "8" },
                { Text: "9", Value: "9" },
                { Text: "10", Value: "10" },
                { Text: "11", Value: "11" },
                { Text: "12", Value: "12" }
            ];
            combobox.dataBind(dataSource);
            combobox.text(new Date().getMonth() + 1);
        }

        function PrintDeptReport() {
            if (!onLoading) {
                OnLoadingData();
                var month = $("#Month").data("tComboBox").text();
                if (month === null)
                    month = new Date().getMonth() + 1;

                var year = $("#Year").val();
                if (year === null || year == "")
                    month = new Date().getYear() + 1;

                $('#result').load('@Url.Action("PrintDeptReport", "Orders", new {area = "Sales"})',
                    {
                        month: month,
                        year: year
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

        function PrintProductDetail() {
            
            if (!onLoading) {
                OnLoadingData();
                var combobox = $('#Month').data('tDropDownList').text();
                var monthlyDate = combobox.text();

                $('#result').load('@Url.Action("PrintTaxInvoiceProductDetail", "Inv", new {area = "Inv"})',
                    {
                        monthlyDate: monthlyDate
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

        function grid_OnDataBound() {
            OnLoadedData();
        }

        var onLoading = false;
        function OnLoadingData() {
            if (!onLoading) {
                onLoading = true;
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (Chờ load)";
                    loading.classList.add('loading');
                }
            }
        }
        function OnLoadedData() {
            if (onLoading) {
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    if (loading && loading.className.includes("loading")) {
                        loading.classList.remove('loading');
                        loading.innerHTML = "<span></span>";
                    }
                }
                onLoading = false;
            }
        }

        var startGrid = false;
        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }
    </script>
}

