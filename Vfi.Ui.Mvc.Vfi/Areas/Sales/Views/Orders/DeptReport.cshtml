                                        .Selectable()
                                        .ClientEvents(e => e.OnError("grid_OnError")
                                                            .OnRowSelect("grid_OnRowSelect"))
                                        .ToHtmlString());
                                items.Add().Text("Thanh toán").Content(
                                    Html.Telerik().Grid<TaxInvoiceDetailModel>()
                                        .Name("gridTaxInvoiceDetail_<#= CustomerId #>")
                                        .DataBinding(dataDindings => dataDindings.Ajax()
                                                                                 .Select("SelectTaxInvoicesDetailByCustomerId", "Orders",
                                                                                         new {month = "<#= Month #>", year = "<#= Year #>", customerId = "<#= CustomerId #>"}))
                                        .Columns(columns =>
                                            {
                                                columns.Bound(f => f.TaxInvoiceList).Width(100).Title("Hóa đơn");
                                                columns.Bound(f => f.ImportDate).Width(100).Title("Ngày")
                                                       .Format("{0:dd/MM/yyyy}");
                                                columns.Bound(f => f.TypeDetail).Width(98).Title("Loại")
                                                       .HtmlAttributes(new {style = "text-align: left;"});
                                                columns.Bound(f => f.Money).Width(98).Title("Số tiền")
                                                       .HtmlAttributes(new {style = "text-align: right;"})
                                                       .ClientTemplate("<#= MoneyFormat #>");
                                                columns.Bound(f => f.StatusName).Width(98).Title("Tình trạng")
                                                       .HtmlAttributes(new {style = "text-align: left;"});
                                                columns.Bound(f => f.Times).Width(150).Title("Số lần");
                                                columns.Bound(f => f.Note).Title("Note");
                                                columns.Bound(f => f.ModifiedDate).Width(100).Title("Ngày tạo")
                                                       .Format("{0:dd/MM/yyyy HH:mm:ss}");
                                                columns.Bound(f => f.ModifiedUser).Width(100).Title("Người tạo");
                                            })
                                        .Resizable(f => f.Columns(true))
                                        .ClientEvents(e => e.OnError("grid_OnError"))
                                        .ToHtmlString());
                            }
                        )
                        .ToHtmlString()))
                .ClientEvents(events => events
                                            .OnDataBinding("grid_OnDataBinding")
                                            .OnRowSelect("grid_OnRowSelect")
                                            .OnError("grid_OnError")
                                            .OnDataBound("OnLoadedData")
                                            )
                .Selectable()
                .Scrollable(f => f.Height(510))
                //.HtmlAttributes(new { style = "width: 950px;" })
                .Resizable(f => f.Columns(true))
                .Reorderable(f => f.Columns(true))
                .Filterable()
                .Sortable()
                .Groupable()
                .Render();
        }
        @*@{ Html.Telerik().ScriptRegistrar().OnDocumentReady("applyFrozenColumns();"); }*@
    </div>
