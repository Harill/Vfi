@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@{
    ViewBag.Title = "Báo cáo doanh thu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">

        var startGrid = false;
        function RefreshGrid2(name) {
            if (!onLoading) {
                OnLoadingData();
                startGrid = true;
                RefreshGrid('gridProductionMonthly');
            }
        }

        function grid_OnDataBound() {
            OnLoadedData();
        }

        var onLoading = false;
        function OnLoadingData() {
            if (!onLoading) {
                onLoading = true;
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (Chờ load)";
                    loading.classList.add('loading');
                }
            }
        }
        function OnLoadedData() {
            if (onLoading) {
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    if (loading && loading.className.includes("loading")) {
                        loading.classList.remove('loading');
                        loading.innerHTML = "<span></span>";
                    }
                }
                onLoading = false;
            }
        }


        function grid_OnDataBinding(args) {
            if (startGrid) {
                var customerId = $('#cboCustomer').data('tComboBox').value();
                if (customerId === "")
                    customerId = 0;
                var customerCode = $('#cboCustomer').data('tComboBox').text();
                var month = $("#Month").data("tComboBox").text();
                if (month === null)
                    month = new Date().getMonth() + 1;

                var year = $("#Year").val();
                if (year === null || year === "")
                    month = new Date().getYear() + 1;

                args.data = $.extend(args.data, {
                    month: month,
                    year: year,
                    customerId: customerId,
                    customerCode: customerCode
                });
            }
        }

        function month_onload() {
            var combobox = $('#Month').data('tComboBox');
            var dataSource =
            [
                { Text: "1", Value: "1" },
                { Text: "2", Value: "2" },
                { Text: "3", Value: "3" },
                { Text: "4", Value: "4" },
                { Text: "5", Value: "5" },
                { Text: "6", Value: "6" },
                { Text: "7", Value: "7" },
                { Text: "8", Value: "8" },
                { Text: "9", Value: "9" },
                { Text: "10", Value: "10" },
                { Text: "11", Value: "11" },
                { Text: "12", Value: "12" }
            ];
            combobox.dataBind(dataSource);
            combobox.text(new Date().getMonth() + 1);
        }

        function PrintDeptReport() {
            if (!onLoading) {
                OnLoadingData();
                var month = $("#Month").data("tComboBox").text();
                if (month === null)
                    month = new Date().getMonth() + 1;

                var year = $("#Year").val();
                if (year === null || year === "")
                    month = new Date().getYear() + 1;

                $('#result').load('@Url.Action("PrintDeptReport", "Orders", new {area = "Sales"})',
                    {
                        month: month,
                        year: year
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    })
            };
            return false;
        }
       
        //function RefreshGrid2() {
        //    startGrid = true;
        //    RefreshGrid("gridProductionMonthly");
            //$(".t-grid .t-refresh").trigger('click');
            // $(".t-comboBox .t-refresh").trigger('click');
        //}

    </script>
}

