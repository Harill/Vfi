@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@{
    ViewBag.Title = "Duyệt Invoice ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">
        function gridDetail_onEdit(e) {
            //var dataItem = e.dataItem;
            //var mode = e.mode;
            var form = e.form;

            var taxInvoiceList = $(form).find('#TaxInvoiceList');
            var data = taxInvoiceList.val();
            //var lineTotal = $(form).find("#LineTotal").data("tTextBox");
            //if (mode == 'insert') {
            //    vendorCode.attr("style", "color: blue;");
            //}
            //if (mode == 'edit') {
            //}
            if (data !== "") {
                taxInvoiceList.attr("readonly", "readonly");
                taxInvoiceList.attr("style", "color: red;");
            }
        }
        function gridProduct_onEdit(e) {
            var mode = e.mode;
            var form = e.form;
            //alert(e.dataItem['DueDate']);
            /* var materialCodeName = $(form).find('#MaterialCode');
            var materialCodeNameData = $(form).find('#MaterialCode').data('tComboBox');

            var customerCodeName = $(form).find('#CustomerCodeName');
            var customerCodeNameData = $(form).find('#CustomerCodeName').data('tComboBox');
*/
            if (mode === 'insert') {

            } else if (mode === 'edit') {
                var monthlyDate = e.dataItem['ShiftmentDate'];
                if (monthlyDate === null)
                    monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', new Date());
                else
                    monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);
                e.dataItem['ShiftmentDate'] = monthlyDate;
                //var a = e;
                //alert(e.dataItem['DueDate']);
                /*materialCodeNameData.reload();
                materialCodeName.bind('dataBound', function () { // your code 
                    materialCodeNameData.select(function (item) {
                        return item.Value == e.dataItem['MaterialId'];
                    });
                });

                customerCodeNameData.reload();
                customerCodeName.bind('dataBound', function () { // your code 
                    customerCodeNameData.select(function (item) {
                        return item.Value == e.dataItem['CustomerId'];
                    });
                });*/
            }

        }

        var startGrid = false;
        function RefreshGrid2(name) {
            if (!onLoading) {
                OnLoadingData();
                startGrid = true;
                RefreshGrid(name);
            }
        }

        function grid_OnDataBound() {
            OnLoadedData();
        }

        var onLoading = false;
        function OnLoadingData() {
            if (!onLoading) {
                onLoading = true;
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (Chờ load)";
                    loading.classList.add('loading');
                }
            }
        }
        function OnLoadedData() {
            if (onLoading) {
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    if (loading && loading.className.includes("loading")) {
                        loading.classList.remove('loading');
                        loading.innerHTML = "<span></span>";
                    }
                }
                onLoading = false;
            }
        }


        function Grid_OnSave(e) {
            var value = e.values;
            var taxInvoice = value.TaxInvoice;
            var taxPercent = value.TaxPercent;
            var invoiceId = value.InvoiceId;
            var exchangeRate = value.ExchangeRate;
            var note = value.Note;
            e.data = $.extend(e.data, {
                invoiceId: invoiceId,
                taxInvoice: taxInvoice,
                taxPercent: taxPercent,
                note: note,
                exchangeRate: exchangeRate
            });
        }
        function Grid_OnDelete(e) {
            var value = e.values;
            var invoiceId = value.InvoiceId;
            var note = value.Note;
            e.data = $.extend(e.data, {
                invoiceId: invoiceId,
                note: note
            });
        }
        function Grid_OnDataBinding(args) {

            var month = $('#Month').data('tComboBox').value();
            var year = $('#Year').data('tAutoComplete').text();

            args.data = $.extend(args.data, {
                month: month,
                year: year
            });
        }

    </script>
    <script type="text/javascript">

        function PrintInvoiceForm(val) {
            $('#result').load('@Url.Action("PrintInvoice", "Inv", new { area = "Inv" })',
                {
                    invoiceId: val,
                    showPrice: true,
                }, function (data) {
                    //alert(data);
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }

        function PrintInvoiceExportForm(val) {
            $('#result').load('@Url.Action("PrintInvoice", "Inv", new { area = "Inv" })',
                {
                    invoiceId: val
                }, function (data) {
                    //alert(data);
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }

        function month_onLoad() {
            var combobox = $('#Month').data('tComboBox');
            var dataSource =
            [
                { Text: "1", Value: "1" },
                { Text: "2", Value: "2" },
                { Text: "3", Value: "3" },
                { Text: "4", Value: "4" },
                { Text: "5", Value: "5" },
                { Text: "6", Value: "6" },
                { Text: "7", Value: "7" },
                { Text: "8", Value: "8" },
                { Text: "9", Value: "9" },
                { Text: "10", Value: "10" },
                { Text: "11", Value: "11" },
                { Text: "12", Value: "12" }
            ];

            combobox.dataBind(dataSource);
            if (new Date().getMonth() === 12)
                combobox.value = "1";
            else combobox.value(new Date().getMonth() + 1);
        }
    </script>
}

<div class="title">
    @*Duyệt invoice*@
    @HttpContext.GetGlobalResourceObject("Resource", "ApproveInvoicesForm")
</div>
<div>
    <div class="grid_1">
        @*@Html.Label("Tháng")*@
        @HttpContext.GetGlobalResourceObject("Resource", "Month")
    </div>
    <div class="grid_2">
        @{
            Html.Telerik().ComboBox()
                .Name("Month")
                .HtmlAttributes(new { style = "width: 40px" })
                .DropDownHtmlAttributes(new { style = "width: 40px" })
                //.Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                // .HighlightFirstMatch(true)
                //.AutoFill(true)
                .ClientEvents(events => events.OnLoad("month_onLoad"))
                .Render();
        }
    </div>

    <div class="grid_1">
        @*@Html.Label("Năm")*@
        @HttpContext.GetGlobalResourceObject("Resource", "Year")
    </div>
    <div class="grid_2">

        @{
            Html.Telerik().AutoComplete()
                .Name("Year")
                .Value(DateTime.Now.Year + "")
                .HtmlAttributes(new { style = "width: 40px" })
                .Render();
        }
    </div>
    <button id="btnRefresh" class='t-button' onclick=" return RefreshGrid2('gridInvoice'); ">
        <span class='t-icon t-insert'></span>
        @*Làm mới*@
        @HttpContext.GetGlobalResourceObject("Resource", "Refresh")
        <span class="twoToneButton"></span>
    </button>
</div>
<div class="cover-div">
