                                                    new {area = "Sales", orderDetailId = "<#= OrderDetailId #>",})
                                        )
                                        .Columns(columns =>
                                        {
                                            columns.Bound(f => f.MaterialCode)
                                                .HeaderTemplate("Mã nguyên liệu")
                                                .HtmlAttributes(new {style = "text-align: left;font-weight: bold"});
                                            columns.Bound(f => f.TotalInvKg).Title("Tồn kho(kg)").Width(70)
                                                .Format("{0:n2}")
                                                .HtmlAttributes(new { style = "text-align: right;border-left:1px solid black;" });
                                            columns.Bound(f => f.ProductWeight).Title("TL phoi(g/pcs)").Width(65)
                                                .Format("{0:n3}")
                                                .HtmlAttributes(new {style = "text-align: right;"});
                                            columns.Bound(f => f.RequireInYearKg).Width(70)
                                                .HeaderTemplate("Yêu cầu (kg)")
                                                .Format("{0:n2}")
                                                .HtmlAttributes(new {style = "text-align: right;"});
                                            columns.Bound(f => f.RequireInMonthKg).Width(70)
                                                .HeaderTemplate("Đã duyệt (kg)")
                                                .Format("{0:n2}")
                                                .HtmlAttributes(new { style = "text-align: right;border-left:1px solid black;" });
                                            columns.Bound(f => f.RequireByMonthKg).Width(70)
                                                .HeaderTemplate("Chưa duyệt (kg)")
                                                .Format("{0:n2}")
                                                .HtmlAttributes(new { style = "text-align: right;" });

                                            columns.Bound(f => f.TotalRequireKg).Width(70)
                                                .HeaderTemplate("Tổng YC (kg)")
                                                .Format("{0:n2}")
                                                .HtmlAttributes(new { style = "text-align: right;border-left:1px solid black;" });
                                            columns.Bound(f => f.OnPoKg).Width(70)
                                                .HeaderTemplate("Đã đặt (kg)")
                                                .Format("{0:n2}")
                                                .HtmlAttributes(new { style = "text-align: right;" });
                                            columns.Bound(f => f.RequirePoKg).Width(70)
                                                .HeaderTemplate("Cần đặt (kg)")
                                                .Format("{0:n2}")
                                                .HtmlAttributes(new { style = "text-align: right;" });
                                            columns.Bound(f => f.RequirePoKg).Width(70)
                                                .HeaderTemplate("Cần đặt (kg)")
                                                .Format("{0:n2}")
                                                .HtmlAttributes(new { style = "text-align: right;" });
                                            columns.Bound(f => f.ForecastInMonth).Width(70)
                                                .HeaderTemplate("TB 3T SD (kg)")
                                                .Format("{0:n2}")
                                                .HtmlAttributes(new { style = "text-align: right;border-left:1px solid black;" });
                                            
                                        })
                                        .Editable(editing => editing.Mode(GridEditMode.InLine))
                                        .ClientEvents(e => e.OnError("grid_OnError"))
                                        .ToHtmlString()
                                    );

                                items.Add().Text("Công cụ").Content(
                                    Html.Telerik().Grid<ExpectedProductionMaterialPlanModel>()
                                        .Name("gridOrderTool_<#= OrderDetailId #>")
                                        .DataKeys(key => key.Add(f => f.MaterialId).RouteKey("materialId"))
                                        .DataBinding(
                                            dataBinding => dataBinding.Ajax()
                                                .Select("SelectToolOrderByOrderDetailId", "SalesOrder",
                                                    new { area = "Sales", orderDetailId = "<#= OrderDetailId #>", })
                                        )
                                        .Columns(columns => {
                                            columns.Bound(f => f.MaterialName).Width(150)
                                                .HeaderTemplate("Loại công cụ")
                                                .HtmlAttributes(new { style = "text-align: left;font-weight: bold" });
                                            columns.Bound(f => f.MaterialCode)
                                                .HeaderTemplate("Mã công cụ")
                                                .HtmlAttributes(new { style = "text-align: left;font-weight: bold" });
                                            columns.Bound(f => f.TotalInv).Title("Tồn kho").Width(70)
                                                .Format("{0:n1}")
                                                .HtmlAttributes(new { style = "text-align: right;border-left:1px solid black;" });
                                            columns.Bound(f => f.RequireInYear).Width(70)
                                                .HeaderTemplate("Yêu cầu")
                                                .Format("{0:n1}")
                                                .HtmlAttributes(new { style = "text-align: right;" });
                                            columns.Bound(f => f.RequireInMonth).Width(70)
                                                .HeaderTemplate("Đã duyệt")
                                                .Format("{0:n1}")
                                                .HtmlAttributes(new { style = "text-align: right;border-left:1px solid black;" });
                                            columns.Bound(f => f.RequireByMonth).Width(70)
                                                .HeaderTemplate("Chưa duyệt")
                                                .Format("{0:n1}")
                                                .HtmlAttributes(new { style = "text-align: right;" });

                                            columns.Bound(f => f.TotalRequire).Width(70)
                                                .HeaderTemplate("Tổng YC")
                                                .Format("{0:n1}")
                                                .HtmlAttributes(new { style = "text-align: right;border-left:1px solid black;" });
                                            columns.Bound(f => f.OnPoKg).Width(70)
                                                .HeaderTemplate("Đã đặt")
                                                .Format("{0:n1}")
                                                .HtmlAttributes(new { style = "text-align: right;" });
                                            columns.Bound(f => f.RequirePoKg).Width(70)
                                                .HeaderTemplate("Cần đặt")
                                                .Format("{0:n1}")
                                                .HtmlAttributes(new { style = "text-align: right;" });
                                            columns.Bound(f => f.ForecastInMonth).Width(70)
                                                .HeaderTemplate("TB 3T SD")
                                                .Format("{0:n1}")
                                                .HtmlAttributes(new { style = "text-align: right;border-left:1px solid black;" });

                                        })
                                        .Editable(editing => editing.Mode(GridEditMode.InLine))
                                        .ClientEvents(e => e.OnError("grid_OnError"))
                                        .ToHtmlString()
                                    );
                                
                                items.Add().Text("Xuất bán").Content(
                                    Html.Telerik().Grid<ExportFormTP_KDDetailsModel>()
                                        .Name("gridExportDetail_<#= OrderDetailId #>")
                                        .DataBinding(dataDindings =>
                                            dataDindings.Ajax()
                                                .Select("SelectExportDetailById", "SalesOrder",
                                                    new {area = "Sales", orderDetailId = "<#= OrderDetailId #>"}))
                                        .Columns(columns =>
                                        {
                                            columns.Bound(f => f.TransactionCode).Title("Phiếu xuất").Width(100);
                                            columns.Bound(f => f.ExportDate).Title("Ngày xuất").Width(100)
                                                .Format("{0:dd/MM/yyyy}");
                                            columns.Bound(f => f.Quality).Width(98).Title("Số lượng (PCS)")
                                                .HtmlAttributes(new {style = "text-align: right;"})
                                                .Format("{0:n0}");
                                            columns.Bound(f => f.Weight).Width(98).Title("Trọng lượng (g)")
                                                .HtmlAttributes(new {style = "text-align: right;"})
                                                .Format("{0:n0}");

                                            columns.Bound(f => f.Note).Title("Ghi chú");
                                        })
                                        .ClientEvents(e => e.OnError("grid_OnError"))
                                        .ToHtmlString());

                                items.Add().Text("Dự báo").Content(
                                    Html.Telerik().Grid<ForecastDetailModel>()
                                        .Name("gridForecastDetail_<#= OrderDetailId #>")
                                        .DataBinding(dataDindings =>
                                            dataDindings.Ajax()
                                                .Select("SelectForecastDetailByOrderDetailId", "SalesOrder",
                                                    new {area = "Sales", orderDetailId = "<#= OrderDetailId #>"}))
                                        .Columns(columns =>
                                        {
                                            columns.Bound(f => f.ForecastDate).Title("Ngày DB").Width(100)
                                                .Format("{0:dd/MM/yyyy}");
                                            columns.Bound(f => f.ForecastQuantity).Width(98).Title("Số lượng (PCS)")
                                                .HtmlAttributes(new {style = "text-align: right;"})
                                                .Format("{0:n0}");
                                        })
                                        .ClientEvents(e => e.OnError("grid_OnError"))
                                        .ToHtmlString());
                            })
                            .ClientEvents(e => e.OnError("grid_OnError"))
                            .ToHtmlString()
                        ))
                    .Selectable()
                    .Editable(editing => editing.Mode(GridEditMode.InLine))
                    .Resizable(f => f.Columns(true))
                    .ClientEvents(events => events.OnRowDataBound("gridOrderDetail_OnRowDataBound")
                        .OnRowSelect("grid_OnRowSelect")
                        .OnSave("gridOrderDetail_OnSave")
                        .OnEdit("gridOrderDetail_OnEdit")
                        .OnError("grid_OnError"))
                    .ToHtmlString()
                ))
            .Selectable()
            .Editable(editing => editing.Mode(GridEditMode.InLine))
            .ClientEvents(events => events.OnRowSelect("grid_OnRowSelect")
                .OnRowDataBound("grid_OnRowDataBound")
                .OnSave("grid_OnSave")
                .OnError("grid_OnError"))
            .Sortable()
            .Filterable()
            .Resizable(resizing => resizing.Columns(true))
            .Render();
    }
</div>

