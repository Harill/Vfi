@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@{
    ViewBag.Title = "Duyệt Đơn Hàng ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">

        function grid_OnRowDataBound(e) {
            var dataItem = e.dataItem; //FA5858 F4FA58
            //if (dataItem.CustomerId !== 107 && dataItem.CustomerId !== 67) {
            //    if (dataItem.DetailStatus === 1 || !dataItem.SalesManager) {
            //        e.row.childNodes[1].innerHTML = "";
            //    }
            //}

            if (!dataItem.CanApprove) {
                e.row.childNodes[1].innerHTML = "";
            }
            if (dataItem.StatusColor === 2) {
                e.row.style.backgroundColor = "#FA5858";
            }
        }

        function grid_OnSave(e) {
            var value = e.values;
            var dueDate = value.DueDate;
            dueDate = $.telerik.formatString('{0:dd/MM/yyyy}', dueDate);
            var orderId = value.OrderId;
            e.data = $.extend(e.data,
            {
                orderId: orderId,
                dueDate: dueDate
            });
        }

    </script>
    <script type="text/javascript">
        function gridOrderDetail_OnSave(e) {
            var value = e.values;
            var vfiDueDate = value.VFIDueDate;
            vfiDueDate = $.telerik.formatString('{0:dd/MM/yyyy}', vfiDueDate);
            var orderDetailId = value.OrderDetailId;
            var orderId = value.OrderId;
            e.data = $.extend(e.data,
            {
                orderId: orderId,
                orderDetailId: orderDetailId,
                vfiDueDate: vfiDueDate
            });
        }

        function SplitOrderDetails(orderId) {
            var $detailIds = $("input[name='chkOrderDetailIds']:checked");
            if ($detailIds.length === 0) {
                alert("Vui lòng chọn SP nhân bản");
                return false;
            }
            var ids = {};
            for (var i = 0; i < $detailIds.length; i++) {
                ids[i] = $detailIds[i].value;
            }
            try {
                $.ajax({
                    type: 'post',
                    data: {
                        orderId: orderId,
                        orderDetailIds: ids
                    },
                    dataType: 'json',
                    url: '@Url.Action("SplitOrderDetails", "SalesOrder")',
                    timeout: 20000,
                    success: function(data) {
                        //alert(data);
                        if (data === 1) {
                            alert("Tách thành công!");
                            $('#gridProduct').data('tGrid').ajaxRequest();
                        } else if (data === 0) {
                            alert("Không tách được đơn hàng");
                        } else if (data === 2) {
                            alert("Không được chọn tách tất cả chi tiết");
                        }
                        //else if (data == 2) {
                        //    $('#lookupTransactionCodeExisted').attr('class', 'imgUnAvailable');
                        //    $('#txtTransactionCodeHidden').val(0);
                        //}
                    }
                });
            } catch (err) {
                alert("Co Loi !");
            }
            return false;
        }


        function gridOrderDetail_OnRowDataBound(e) {
            var dataItem = e.dataItem; //FA5858 F4FA58
            if (!dataItem.InForcast) {
                e.row.childNodes[7].style.backgroundColor = "yellow";
            }
            if (dataItem.IsProduction) {
                e.row.childNodes[6].style.backgroundColor = "yellow";
            }
            if (!dataItem.ApproveType) {
                e.row.childNodes[2].innerHTML = "";
            }
        }

        function gridOrderDetail_OnEdit(e) {
            var mode = e.mode;
            var form = e.form;

            if (mode === 'edit') {
                if (!e.dataItem.IsInvManager) {
                    var nodes = $(form).find('#VFIDueDate');
                    nodes[0].parentNode.parentNode.parentNode.innerHTML = e.dataItem.VFIDueDate.format('dd/MM/yyyy');
                }
            }
        }

        function gridOrderProgress_OnRowDataBound(e) {
            var dataItem = e.dataItem;
            if (!dataItem.IsProductionManager) {
                e.row.childNodes[1].innerHTML = "";
                //var btns = e.currentTarget.getElementsByClassName("t-button t-grid-edit t-button-icon");
                //for (var i = 0; i < btns.length; i++) {
                //    btns[i].parentNode.innerHTML = "";
                //}
            }
            if (dataItem.StartDate <= Date.now()) {
                e.row.childNodes[10].bgColor = "red";
            }
            if (dataItem.EndDate <= Date.now()) {
                e.row.childNodes[11].bgColor = "red";
            }
        }

        function PrintApproveOrderDetailForm(val) {
            $('#result').load('@Url.Action("PrintApproveOrderDetailForm", "SalesOrder", new { area = "Sales" })',
                {
                    orderId: val
                }, function () {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }

        function PrintPrepareDetail(val) {
            $('#result').load('@Url.Action("PrintPreparationTools", "Orders", new { area = "Sales" })',
                {
                    orderDetailId: val
                }, function () {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }
    </script>
}

