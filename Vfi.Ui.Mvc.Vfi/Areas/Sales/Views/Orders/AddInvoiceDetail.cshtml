@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@using Vfi.Ui.Mvc.Vfi.Models
@model ExportFormTP_KD
@{
    ViewBag.Title = "Phân đơn hàng xuất kho";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">

        function transactionCode_OnChange() {
            RefreshGrid("gridExportDetail");
        }

        function gridExportDetail_onDataBinding(args) {
            var id = $("#InvoiceNumber").data('tComboBox').value();
            if (id != 0) {
                args.data = $.extend(args.data, {
                    id: id
                });
                $("#gridExportOrderDetail").data("tGrid").rebind({
                    exportDetailId: ""
                });
            }
        }
    </script>

    <script type="text/javascript">
        function PickupProductId() {

            var $checkedRecords = $(':checked');
            if ($checkedRecords.length < 1) {
                alert("Vui lọn chọn ít nhất 1 nguyên liệu");
                return;
            }

            //var a = {};
            //var ids = "";
            //for (var i = 0; i < $checkedRecords.length; i++) {
            //    a[i] = $checkedRecords[i].value;

            //    ids += $checkedRecords[i].value;
            //    if (i < ($checkedRecords.length - 1))
            //        ids += ":";
            //}
            var exportDetailId = $checkedRecords[0].value;

            //var id = $("#InvoiceNumber").data('tComboBox').value();
            //if (id != 0) {
            $("#gridExportOrderDetail").data("tGrid").rebind({
                exportDetailId: exportDetailId
            });
            //}
        }
    </script>

    <!-- client event grid material inventory -->
    <script type="text/javascript">

        function gridProductInventoryDetail_onSave(e) {

            //var cell = e.cell;
            //cell.style.backgroundColor = "#F4FA58";
            var quanlity = $(e.cell).find('#AvailableQty').val();
            if (!isNaN(parseInt(quanlity))) {

                var sumQuality = 0;
                var spanRequests = $("span[name='AvailableQty']");
                for (var i = 0; i < spanRequests.length; i++) {
                    var innerText = spanRequests[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sumQuality = sumQuality + parseInt(innerText);
                }
                sumQuality = sumQuality + parseInt(quanlity);
                $("#TotalQuantity").text(sumQuality);
            }

        }

        function gridProductInventoryDetail_onSubmitChanges(e) {
            e.values = $.extend(e.values,
                {
                    //id: id
                }
            );
            //var id = $("#InvoiceNumber").data('tComboBox').value();
            //$("#gridExportDetail").data("tGrid").rebind({
            //    id: id
            //});
        }

        function AddInvoiceDetailDefault() {
            
            if (confirm("Đồng ý lưu mặc định")) {
                $.post('@Url.Action("ExportOrderDetailSaveDefault", "Orders")',
                    {},
                    function(data) {

                        //if (data === "okie") {

                        var id = $("#InvoiceNumber").data('tComboBox').value();
                        $("#gridExportDetail").data("tGrid").rebind({
                            id: id
                        });
                        $("#gridExportOrderDetail").data("tGrid").rebind({
                            exportDetailId: ""
                        });
                        //} else
                        alert(data);
                    });
            }
            return false;
        }

        function InvoiceRefresh() {
            $("#InvoiceNumber").data("tComboBox").reload();
        }

    </script>

}

<div class="title">
    @*Phân đơn hàng xuất kho*@
    @HttpContext.GetGlobalResourceObject("Resource", "AddInvoiceDetail")
</div>

<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">

    <fieldset>
        <legend>
            @*Thông tin phiếu xuất*@
            @HttpContext.GetGlobalResourceObject("Resource", "Information")
        </legend>
        <div class="grid_2">
            Invoice

        </div>
        <div class="grid_6">
            @{
                Html.Telerik().ComboBox()
                    .Name("InvoiceNumber")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxExportTpTransaction", "Orders", new { area = "Sales" }))
                    .HtmlAttributes(new { style = "width: 100%" })
                    .ClientEvents(events => events.OnChange("transactionCode_OnChange"))
                    .Render();
            }
        </div>
        <button class="t-button" id="btnRefresh" name="btnPickupMaterialId" onclick=" InvoiceRefresh() ">
            <span class='t-icon t-refresh'></span>
        </button>
    </fieldset>
</div>
<div class="clear"></div>

<div class="cover-div">
    @{
        Html.Telerik().Grid<ExportFormTP_KDDetailsModel>()
            .Name("gridExportDetail")
            .ToolBar(bar => bar.Template(
        @<text>
        <div class="grid_7">
            <button class="t-button" id="btnPickupProductId" name="btnPickupProductId" onclick="PickupProductId()">
                <span class='t-icon t-insert'></span>
                @*Chọn các sản phẩm vào lưới*@
                @HttpContext.GetGlobalResourceObject("Resource", "Select")
            </button>
        </div>
        <div class="clear"></div>
        </text>
))
            .DataKeys(keys => keys.Add(f => f.DetailId).RouteKey("detailId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectProductInExportTp", "Inv", new { area = "Inv", id = 0 }))
            .Columns(columns =>
                         {
                             columns.Bound(f => f.DetailId)
                                 //.Title("Chọn")
                                 //.Title(@HttpContext.GetGlobalResourceObject("Resource", "").ToString())
                                 .Width(75)
                                 .ClientTemplate("<input type='radio' name='chkProductIds' value='<#= DetailId #>' />")
                                 .HtmlAttributes(new { style = "text-align:center" });
                             
                             columns.Bound(f => f.ProductCode)
                                 //.HeaderTemplate("Mã Sản Phẩm")
                                 .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductCode").ToString())
                                 .Width(250);
                            
                             columns.Bound(f => f.Quality)
                                 //.HeaderTemplate("Số lượng xuất")
                                 .Title(@HttpContext.GetGlobalResourceObject("Resource", "Quantity").ToString())
                                 .Width(150)
                                 .ClientTemplate("<#= Quality == null ? 0 : $.telerik.formatString('{0:n0}', Quality) #>")
                                 .HtmlAttributes(new { style = "text-align: right;" });
                           
                             columns.Bound(f => f.TotalQuantity)
                                 //.HeaderTemplate("Số lượng trong đơn hàng")
                                 .Title(@HttpContext.GetGlobalResourceObject("Resource", "QuantityInOrder").ToString())
                                 .Width(150)
                                 .ClientTemplate("<#= TotalQuantity == null ? 0 : $.telerik.formatString('{0:n0}', TotalQuantity) #>")
                                 .HtmlAttributes(new { style = "text-align: right;" });
                         })
            .Scrollable(f => f.Height("auto"))
            .Scrollable(f => f.Height(200))
            .Resizable(f => f.Columns(true))
            //.Pageable(f => f.Style(GridPagerStyles.Status))
            .ClientEvents(events => events.OnDataBinding("gridExportDetail_onDataBinding")
            .OnError("grid_OnError"))
            .Render();
    }
</div>
<div class="clear"></div>
<br />

<div class="t-info-sha" style="padding-left: 15px; width: 250px; color: Maroon;">
   @* Chi tiết lệnh xuất nhập sản phẩm*@
    @HttpContext.GetGlobalResourceObject("Resource", "DetailOrder")
</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<OrderDetailModel>()
            .Name("gridExportOrderDetail")
            .ToolBar(bar => {
                    bar.Custom().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Text)
                        .Text(@HttpContext.GetGlobalResourceObject("Resource", "SaveDefaultText").ToString())
                        .Name("A")
                        
                        //.Action("ExportOrderDetailSaveDefault", "Orders", new { area = "Sales" });
                       .HtmlAttributes(new { onclick = "AddInvoiceDetailDefault()", href = "#" });
                    bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
                        .SaveText(@HttpContext.GetGlobalResourceObject("Resource", "SaveChangesText").ToString())
                        .CancelText(@HttpContext.GetGlobalResourceObject("Resource", "CancelText").ToString());
                })
            .DataKeys(keys => keys.Add(f => f.OrderDetailId).RouteKey("orderDetailId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("InputProductOrderDetail", "Inv", new { area = "Inv", exportDetailId = "" })
                                                     .Update("AddExportInvoiceDetail", "Orders", new { area = "Sales" }))
            .Columns(columns => {
                    columns.Bound(f => f.ProductCode).Width(150).ReadOnly(true)
                           //.HeaderTemplate("Mã Sản Phẩm")
                           .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductCode").ToString())
                           ;

                    columns.Bound(f => f.OrderNumber).Width(100).ReadOnly(true)
                           .HeaderTemplate("PO VF")
                           //.Title(@HttpContext.GetGlobalResourceObject("Resource", "").ToString()
                           ;

                    columns.Bound(f => f.PONumber).Width(150).ReadOnly(true)
                           //.HeaderTemplate("PO KH")
                           .Title(@HttpContext.GetGlobalResourceObject("Resource", "CustomerPO2").ToString())
                           ;

                    columns.Bound(f => f.CustomerDueDate).Width(80).ReadOnly(true)
                           //.HeaderTemplate("Ngày KH YC")
                           .Title(@HttpContext.GetGlobalResourceObject("Resource", "CustomerRequestDate2").ToString())
                           .ClientTemplate("<#= CustomerDueDate == null ? 0 : $.telerik.formatString('{0:dd/MM/yyyy}', CustomerDueDate) #>")
                           .HtmlAttributes(new { style = "text-align: right;" });

                    columns.Bound(f => f.VFIDueDate).Width(80).ReadOnly(true)
                           //.HeaderTemplate("Ngày giao ĐH")
                           .Title(@HttpContext.GetGlobalResourceObject("Resource", "DeliveryDate").ToString())
                           .ClientTemplate("<#= VFIDueDate == null ? 0 : $.telerik.formatString('{0:dd/MM/yyyy}', VFIDueDate) #>")
                           .HtmlAttributes(new { style = "text-align: right;" });

                    columns.Bound(f => f.UnitPrice).Width(60).ReadOnly(true)
                           //.HeaderTemplate("Đơn giá")
                           .Title(@HttpContext.GetGlobalResourceObject("Resource", "UnitPrice").ToString())
                           .HtmlAttributes(new { style = "text-align: right;" });

                    columns.Bound(f => f.Currency).Width(60).ReadOnly(true)
                           //.HeaderTemplate("ĐVT")
                           .Title(@HttpContext.GetGlobalResourceObject("Resource", "Unit2").ToString())
                           .HtmlAttributes(new { style = "text-align: center;" });

                    columns.Bound(f => f.RequiredNumber).Width(100).ReadOnly(true)
                           //.HeaderTemplate("SL ĐH")
                           .Title(@HttpContext.GetGlobalResourceObject("Resource", "OrderQuantity").ToString())
                           .ClientTemplate("<#= RequiredNumber == null ? 0 : $.telerik.formatString('{0:n0}', RequiredNumber) #>")
                           .HtmlAttributes(new { style = "text-align: right;" })
                           .Aggregate(agg => agg.Sum())
                           .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                           .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>");

                    columns.Bound(f => f.AvailableQty).Width(100)
                           //.HeaderTemplate("SL phân")
                           .Title(@HttpContext.GetGlobalResourceObject("Resource", "SplitQuantity2").ToString())
                           .ClientTemplate("<span name='AvailableQty'><#= AvailableQty == null ? 0 : $.telerik.formatString('{0:n0}', AvailableQty) #></span>")
                           .FooterTemplate("<span id='TotalQuantity'></span>")
                           .HtmlAttributes(new { style = "text-align: right;" });

                    columns.Bound(f => f.Note).ReadOnly(true)
                           //.HeaderTemplate("Ghi chú ĐH")
                           .Title(@HttpContext.GetGlobalResourceObject("Resource", "Note").ToString())
                           ;

                    //columns.Command(commands => commands.Delete().Text("Xoá")).Title("");
                })
            .ClientEvents(events => events
                                        .OnSave("gridProductInventoryDetail_onSave")
                                        .OnSubmitChanges("gridProductInventoryDetail_onSubmitChanges")
                                        .OnError("grid_OnError")
            )
            .Editable(f => f.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
            // .Footer(false)
            .Resizable(f => f.Columns(true))
            .Render()
            ;
    }
</div>
