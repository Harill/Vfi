    <div class="cover-div">
        @{
            Html.Telerik().Grid<InvoiceTempModel>()
                .Name("gridInvoice")
                .DataKeys(key => key.Add(f => f.InvoiceId).RouteKey("invoiceId"))
                //.ToolBar(
                //    toolbar =>
                //    toolbar.Insert().ButtonType(GridButtonType.ImageAndText).ImageHtmlAttributes(new { style = "margin-left:0px;" }))
                .DataBinding(
                    dataBinding => dataBinding.Ajax()
                                              .Select("SelectApprovedInvoice_New", "Orders", new {area = "Sales"}))
                .Columns(columns =>
                    {
                        //columns.Bound(f => f.OrderNumber).Width(50).ReadOnly(true);
                        columns.Bound(f => f.InvoiceNumber).Width(65).ReadOnly(true).Title("Số Invoice")
                               .Aggregate(agg => agg.Count())
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>")
                            ;
                        columns.Bound(f => f.CustomerCode).Title("Mã KH").Width(50).ReadOnly(true);
                        columns.Bound(f => f.ShiftmentDate).Width(75).Title("Ngày xuất").ReadOnly(true)
                               .Format("{0:dd/MM/yyyy}");
                        columns.Bound(f => f.TaxInvoice).Title("Số HĐ").Width(80);
                        columns.Bound(f => f.TotalQuantity).Width(50)
                               .HeaderTemplate("Tổng</br>SL")
                               .HtmlAttributes(new {style = "text-align: right;"})
                               .Format("{0:n0}")
                               .Aggregate(agg => agg.Sum())
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>");
                        columns.Bound(f => f.TaxPercent).Width(45)
                               .HeaderTemplate("Thuế</br>(%)")
                               .HtmlAttributes(new {style = "text-align: right;"});
                        columns.Bound(f => f.ExchangeRate).Width(50)
                               .HeaderTemplate("Tỉ</br>giá")
                               .Format("{0:n0}")
                               .HtmlAttributes(new {style = "text-align: right;"});
                        columns.Bound(f => f.TotalAmountAfterTax).Title("Tổng tiền").Width(80)
                               .HtmlAttributes(new {style = "text-align: right;"})
                               .ClientTemplate("<#= TotalAmountAfterTaxFormat #>")
                               .Aggregate(agg => agg.Sum())
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                            ;
                        columns.Bound(f => f.TotalAmountAfterTaxVND).Width(90)
                               .HeaderTemplate("Tổng tiền</br>(VND)")
                               .HtmlAttributes(new {style = "text-align: right;"})
                               .Format("{0:n0}")
                               .Aggregate(agg => agg.Sum())
                               .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>")
                               .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Sum) #></div>");

                        //columns.Bound(f => f.CurrencyCode).Width(45)
                        //    .HeaderTemplate("Tiền</br>tệ");
                        columns.Bound(f => f.ModifiedDate).Width(75).ReadOnly(true).Title("Ngày tạo")
                               .ClientTemplate("<#= ModifiedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy HH:mm:ss}', ModifiedDate) #>");
                        columns.Bound(f => f.Note).Title("Ghi chú").Width(100);
                        columns.Bound(f => f.ExportId).Title("Invoice").Width(45).ReadOnly(true)
                               .ClientTemplate("<input type='button' id='id_<#= InvoiceId #>' style='min-width:30px' value='In' class='t-button' onclick=PrintInvoiceForm(<#= InvoiceId #>) />")
                               .HtmlAttributes(new { style = "text-align:center" });
                        columns.Bound(f => f.ExportId).Title("Packing List").Width(45).ReadOnly(true)
                               .ClientTemplate("<input type='button' id='id_<#= InvoiceId #>' value='In' class='t-button' min-width='20px' onclick=PrintInvoiceExportForm(<#= InvoiceId #>) />")
                               .HtmlAttributes(new { style = "text-align:left" });
                        //columns.Bound(f => f.EmployeeSale).Title("NV Bán").Width(50).ReadOnly(true);
                    })
                .DetailView(details => details.ClientTemplate(
                    Html.Telerik().TabStrip()
                        .Name("TabStrip_<#= ExportId #>")
                        .SelectedIndex(0)
                        .Items(items =>
                               items.Add().Text("Thông tin chi tiết").Content(

                                   Html.Telerik().Grid<InvoiceDetailTempModel>()
                                       .Name("gridTransactionDetail_<#= ExportId #>")
                                       .DataKeys(key => key.Add(f => f.DetailId).RouteKey("DetailId"))
                                       .DataBinding(dataDindings =>
                                                    dataDindings.Ajax()
                                                                .Select("SelectInvoiceDetailByExportId_New", "Orders", new {exportId = "<#= ExportId #>", invoiceId = "<#= InvoiceId #>"})
                                       )
                                       .Columns(columns =>
                                           {
                                               columns.Bound(f => f.TaxInvoiceList).Title("Chứng từ").Width(100);
                                               columns.Bound(f => f.ProductCode).Title("Mã SP").Width(100).ReadOnly(true);
                                               columns.Bound(f => f.PONumber).Title("Lệnh Mua").Width(100).ReadOnly(true);
                                               columns.Bound(f => f.Quantity).Width(50).ReadOnly(true).Title("Số lượng")
                                                      .HtmlAttributes(new {style = "text-align: right;"})
                                                      .Format("{0:n0}");
                                               columns.Bound(f => f.UnitPriceFormat).ReadOnly(true).Width(50).Title("Đơn giá")
                                                      .HtmlAttributes(new {style = "text-align: right;"});
                                               columns.Bound(f => f.AmountFormat).Width(70).Title("Tổng tiền").ReadOnly(true)
                                                      .HtmlAttributes(new {style = "text-align: right;"});
                                               columns.Bound(f => f.Note).Title("Ghi chú").Width(100).ReadOnly(true);
                                           }).DetailView(details2 => details2.ClientTemplate(
                                               //Html.Telerik().TabStrip()
                                               //.Name("TabStrip_<#= ExportId #>_<#= DetailId #>")
                                               //.SelectedIndex(0)
                                               //.Items(items2 =>
                                               //       items2.Add().Text("Thông tin chi tiết").Content(

                                               Html.Telerik().Grid<InvoiceDetailTempModel>()
                                                   .Name("gridInvoiceDetail_<#= DetailId #>")
                                                   .DataKeys(key => key.Add(f => f.OrderDetailId).RouteKey("orderDetailId"))
                                                   .DataBinding(dataDindings =>
                                                                dataDindings.Ajax()
                                                                            .Select("SelectInvoiceDetailByExportDetailId", "Orders", new {exportDetailId = "<#= DetailId #>"})
                                                   //.Update("UpdateProductTaxInvoiceDetailByExportDetailId", "Orders")
                                                   )
                                                   .Columns(columns =>
                                                       {
                                                           columns.Bound(f => f.OrderNumber).Title("Số PO").Width(60);
                                                           columns.Bound(f => f.VFIDueDate).Title("Ngày PO").Width(60)
                                                                  .Format("{0:dd/MM/yyyy}");
                                                           columns.Bound(f => f.Quantity).Title("Số lượng").Width(60)
                                                                  .Format("{0:n0}");
                                                           columns.Bound(f => f.UnitPriceFormat).Width(50).Title("Đơn giá")
                                                                  .HtmlAttributes(new {style = "text-align: right;"});
                                                           columns.Bound(f => f.CurrencyCode).Title("ĐVT").Width(60);
                                                           columns.Bound(f => f.Amount).Title("Tổng tiền").Width(60)
                                                                  .ClientTemplate("<#= AmountFormat#>");
                                                           columns.Bound(f => f.Note).Width(100).Title("Ghi chú ĐH");
                                                       })
                                                   .ClientEvents(e => e.OnError("grid_OnError"))
                                                   .ToHtmlString())
                                       )
                                       .Selectable()
                                       .ClientEvents(e => e.OnError("grid_OnError").OnRowSelect("grid_OnRowSelect"))
                                       .ToHtmlString()))
                        .ToHtmlString()))
                .Selectable()
                .ClientEvents(events => events.OnRowSelect("grid_OnRowSelect")
                                              .OnDataBinding("GridVND_OnDataBinding")
                                              .OnDataBound("OnLoadedData")
                )
                .Scrollable(f => f.Height(400))
                .Sortable()
                .Filterable()
                .Resizable(resizing => resizing.Columns(true))
                .Scrollable()
                .Render();
        }
    </div>

