@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Theo dõi tiến độ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript">

        function grid_OnDataBinding(args) {
            if (startGrid && !onLoading) {
                OnLoadingData();
                var productCode = $("#ProductCode").data("tAutoComplete").value();

                var customerId = $('#cboCustomer').data('tComboBox').value();
                if (customerId == "")
                    customerId = 0;
                var warehouseId = $('#cboWarehouse').data('tComboBox').value();
                if (warehouseId == "")
                    warehouseId = 0;
                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

                args.data = $.extend(args.data, {
                    fromDate: fromDate,
                    toDate: toDate,
                    productCode: productCode,
                    customerId: customerId,
                    warehouseId: warehouseId
                });

                index = 0;
                reload = true;
                //$("#ForecastByMonthHeader")[0].parentNode.innerHTML =
                //("<span id='ForecastByMonthHeader'>Dự báo</br>"
                //    + monthCount + " tháng</span>");
                //$("#RequireByMonthHeader")[0].parentNode.innerHTML =
                //("<span id='RequireByMonthHeader'>Yêu cầu</br>"
                //    + monthCount + " tháng</span>");
            }
        }

        var index = 0;

        function grid_OnRowDataBound(data) {
            if (reload) {
                reload = false;
                loadHeader(data.dataItem);
            }
        }
        var showDate = new Date("1990/01/01");
        function loadHeader(data) {
            if (data.Days != null) {
                for (var i = 0; i < data.Days.length ; i++) {
                    var date = data.Days[i].Date;
                    var header = document.getElementById("ProgressDay" + (i + 1));
                    if (header) {
                        if (date < showDate) { header.innerText = ""; }
                        else { header.innerText = date.format("dd/MM"); }
                    }
                }
            }
        }

        function grid_OnDataBound(data) {
            OnLoadedData();
        }
        var reload = false;
        function grid_OnLoad(grid) {
        }

        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }
        var startGrid = false;

        var onLoading = false;
        function OnLoadingData() {
            if (!onLoading) {
                onLoading = true;
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (Chờ load)";
                    loading.classList.add('loading');
                }
            }
        }
        function OnLoadedData() {
            if (onLoading) {
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    if (loading && loading.className.includes("loading")) {
                        loading.classList.remove('loading');
                        loading.innerHTML = "<span></span>";
                    }
                }
                onLoading = false;
            }
        }
    </script>

}

<div class="title">Tiến độ thực hiện đơn hàng</div>
<div class="clear"></div>
<br />

<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">

    <fieldset>
        <legend>Tiêu chí trích lọc</legend>
        <div class="grid_2">Công đoạn:</div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("cboWarehouse")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxProgressWarehouseByUser", "Warehouse", new { area = "Inv" }))
                    .HtmlAttributes(new { style = "width: 100%; " })
                    .AutoFill(true)
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .Render();
            }
        </div>
        <div class="grid_2_5">Khách hàng:</div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("cboCustomer")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                    .DropDownHtmlAttributes(new { style = "width: 275px" })
                    .HtmlAttributes(new { style = "width: 100%; " })
                    .AutoFill(true)
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .Render();
            }
        </div>
        <div class="grid_1_5">Mã SP:</div>
        <div class="grid_4">
            @{
                Html.Telerik().AutoComplete()
                    .Name("ProductCode")
                    .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv", new { area = "Inv" }))
                    //.DropDownHtmlAttributes(new { style = "width: 100%;" })
                    .HtmlAttributes(new { style = "width: 100%; " })
                    .Encode(false)
                    .AutoFill(true)
                    .HighlightFirstMatch(true)
                    .Render();
            }
        </div>

        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("fromDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today.Month + "/01/" + DateTime.Today.Year)
                    .Render();
            }
        </div>
        <div class="grid_2">
            @{
                Html.Telerik().DatePicker()
                    .Name("toDate")
                    .Format("dd/MM/yyyy")
                    .Value(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1))
                    .Render();
            }
        </div>
        <div class="grid_3 prefix_1">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2('gridProduction'); ">
                <span class='t-icon t-insert'></span>
                Làm mới
                <span class="twoToneButton"></span>
            </button>
        </div>
    </fieldset>
</div>
<div class="clear">
</div>

