@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@using Vfi.Ui.Mvc.Vfi.Models.Production
@{
    ViewBag.Title = "Thẻ kho";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .highslide-container div {
        font-family: Verdana, Helvetica;
        font-size: 10pt;
    }

    .highslide-container table {
        background: none;
    }

    .highslide {
        outline: none;
        text-decoration: none;
    }

    .highslide img {
        border: 2px solid silver;
    }

    .highslide:hover img {
        border-color: gray;
    }

    .highslide-active-anchor img {
        visibility: hidden;
    }

    .highslide-gallery .highslide-active-anchor img {
        border-color: black;
        visibility: visible;
        cursor: default;
    }

    .highslide-image {
        border-width: 2px;
        border-style: solid;
        border-color: white;
    }

    .highslide-wrapper, .highslide-outline {
        background: white;
    }

    .glossy-dark {
        background: #111;
    }

    .highslide-number {
        display: none;
        font-weight: bold;
        color: gray;
        font-size: .9em;
    }

    .highslide-caption {
        display: none;
        font-size: 1em;
        padding: 5px;
        width: 100%;
        text-align: center;
        font-weight: bold;
        /*background: white;*/
    }

    .highslide-heading {
        display: none;
        font-weight: bold;
        margin: 0.4em;
    }

    .highslide-dimming {
        /*position: absolute;*/
        background: black;
    }

    a.highslide-full-expand {
        display: block;
        margin: 0 10px 10px 0;
        width: 34px;
        height: 34px;
    }

    .highslide-loading {
        display: block;
        color: black;
        font-size: 9px;
        font-weight: bold;
        text-transform: uppercase;
        text-decoration: none;
        padding: 3px;
        border: 1px solid white;
        background-color: white;
        padding-left: 22px;
        background-repeat: no-repeat;
        background-position: 3px 1px;
    }

    a.highslide-credits,
    a.highslide-credits i {
        padding: 2px;
        color: silver;
        text-decoration: none;
        font-size: 10px;
        display: none;
    }

    a.highslide-credits:hover,
    a.highslide-credits:hover i {
        color: white;
        background-color: gray;
    }

    .highslide-move, .highslide-move * {
        cursor: move;
    }

    .highslide-viewport {
        display: none;
        position: fixed;
        width: 100%;
        height: 100%;
        z-index: 1;
        background: none;
        left: 0;
        top: 0;
    }

    .highslide-overlay {
        display: none;
    }

    .hidden-container {
        display: none;
    }
    /* Example of a semitransparent, offset closebutton */
    .closebutton {
        position: relative;
        top: -15px;
        left: 15px;
        width: 30px;
        height: 30px;
        cursor: pointer;
        /* NOTE! For IE6, you also need to update the highslide-ie6.css file. */
    }

    .highslide-controls {
        display: none;
    }
</style>
@section Scripts{
    
<script type="text/javascript">
    hs.graphicsDir = '';
    hs.align = 'center';
    hs.transitions = ['expand', 'crossfade'];
    hs.outlineType = '';
    hs.fadeInOut = true;
    hs.numberPosition = 'caption';
    hs.dimmingOpacity = 0.75;

    // Add the controlbar
    if (hs.addSlideshow)
        hs.addSlideshow({
            //slideshowGroup: 'group1',
            interval: 5000,
            repeat: false,
            useControls: true,
            fixedControls: 'fit',
            overlayOptions: {
                opacity: .75,
                position: 'bottom center',
                hideOnMouseOut: true
            }
        });
</script>
    <script type="text/javascript">

        function gridInventory_OnDataBinding(e) {
            var productId = $("#ProductCode").data('tComboBox').value();
            if (productId === "")
                productId = 0;
            e.data = $.extend(e.data, {
                productId: productId
            });
        }

        function DisplayPicture() {
            $('#result').empty();
            @*var productId = $("#ProductCode").data('tComboBox').value();
            if (productId === "")
                productId = 0;
            if (productId !== 0) {
                $('#result').load('@Url.Action("GetProductPicture", "Inv")',
                    {
                        productId: productId
                    });
            }*@
        }


        function RefreshGrids() {
            RefreshGrid("gridInventory");
            DisplayPicture();
        }
    </script>
}

<div class="title">
    @*Thẻ kho sản phẩm (C)*@
    @HttpContext.GetGlobalResourceObject("Resource", "ICForCustomer")
</div>
<div class="clear"></div>
<br/>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">
    <fieldset>
        <legend>
            @*Tiêu chí trích lọc*@
            @HttpContext.GetGlobalResourceObject("Resource", "Filter")
        </legend>
        <div class="grid_2">
            @*Sản phẩm*@
            @HttpContext.GetGlobalResourceObject("Resource", "Product")
        </div>
        <div class="grid_4">
             @{
                Html.Telerik().ComboBox()
                    .Name("ProductCode")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxProductCustomerAccess", "Product", new { area = "" }))
                    .HtmlAttributes(new {style = "width: 200px"})
                    .DropDownHtmlAttributes(new {style = "width: 275px"})
                    .AutoFill(true)
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .Render();
            }
          
        </div>
        <div class="grid_3 prefix_1">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrids(); ">
                <span class='t-icon t-insert'></span>
                @*Tìm*@
                @HttpContext.GetGlobalResourceObject("Resource", "Refresh")
            </button>
        </div>
<div class="grid_4" id="result"></div>
    </fieldset>
</div>
<div class="clear">
</div>

<div class="cover-div">
    @{
        Html.Telerik().Grid<SoLieuTongHopSanPham>()
            .Name("gridInventory")
            //.DataKeys(key => key.Add(f => f.ProductId).RouteKey("productId"))
            .DataBinding(
                dataBinding => dataBinding.Ajax()
                    .Select("SelectProductInventoryForCustomer", "Inv", new { area = "Inv", productId = 0 })
            )
            .Columns(columns =>
            {
                columns.Bound(f => f.ProductCode).Width(85)
                    //.HeaderTemplate("<strong>Tồn kho</br>hiện tại</strong>")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "PresentInv1").ToString())
                    .Title("");
          
                columns.Bound(f => f.TonTong).Width(60)
                    //.HeaderTemplate("Tồn</br>tổng")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "TotalInv1").ToString())
                    .ClientTemplate("<#= ProductCode == 'TL(g/pc)' ? '' : $.telerik.formatString('{0:n0}', TonTong) #>")
                    .HtmlAttributes(new {style = "text-align: right;"});
          
                columns.Bound(f => f.TonKhoSX2CNC).Width(60)
                    .HeaderTemplate("CNC")
                    .ClientTemplate("<#= ProductCode == 'TL(g/pc)' ? $.telerik.formatString('{0:n3}', TonKhoSX2CNC) : $.telerik.formatString('{0:n0}', TonKhoSX2CNC) #>")
                    .HtmlAttributes(new {style = "text-align: right;"});
         
                columns.Bound(f => f.TonKhoSX2SX2).Width(60)
                    //.HeaderTemplate("SX2")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Production22").ToString())
                    .HtmlAttributes(new { style = "text-align: right;" })
                    .ClientTemplate("<#= ProductCode == 'TL(g/pc)' ? $.telerik.formatString('{0:n3}', TonKhoSX2SX2B) : $.telerik.formatString('{0:n0}', TonKhoSX2SX2) #>");
           
                columns.Bound(f => f.TonKhoSX2SX2B).Width(60)
                    //.HeaderTemplate("SX2</br>(gia công)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Production22").ToString()
                        + "</br>("
                        + @HttpContext.GetGlobalResourceObject("Resource", "Processing").ToString()
                        + ")"
                    )
                    .HtmlAttributes(new { style = "text-align: right;" })
                    .ClientTemplate("<#= ProductCode == 'TL(g/pc)' ? $.telerik.formatString('{0:n3}', TonKhoSX2SX2) : $.telerik.formatString('{0:n0}', TonKhoSX2SX2B) #>");
            
                columns.Bound(f => f.TonKhoNhietLuyen).Width(60)
                    //.HeaderTemplate("Nhiệt</br> luyện")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "HeatTreatment1").ToString())
                    .HtmlAttributes(new {style = "text-align: right;"})
                    .ClientTemplate("<#= ProductCode == 'TL(g/pc)' ? $.telerik.formatString('{0:n3}', TonKhoNhietLuyen) : $.telerik.formatString('{0:n0}', TonKhoNhietLuyen) #>");
               
                columns.Bound(f => f.TonKhoRungBong).Width(60)
                    //.HeaderTemplate("Rung</br>bóng")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Polishing1").ToString())
                    .HtmlAttributes(new {style = "text-align: right;"})
                    .ClientTemplate("<#= ProductCode == 'TL(g/pc)' ? $.telerik.formatString('{0:n3}', TonKhoRungBong) : $.telerik.formatString('{0:n0}', TonKhoRungBong) #>");
             
                columns.Bound(f => f.TonKhoGCN).Width(60)
                    //.HeaderTemplate("Chờ</br>GCN")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "PlatingPending1").ToString())
                    .HtmlAttributes(new {style = "text-align: right;"})
                    .ClientTemplate("<#= ProductCode == 'TL(g/pc)' ? $.telerik.formatString('{0:n3}', TonKhoGCN) : $.telerik.formatString('{0:n0}', TonKhoGCN) #>");
           
                columns.Bound(f => f.TonKhoNCU).Width(60)
                    //.HeaderTemplate("Xi</br>mạ")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "PlatingB2").ToString())
                    .HtmlAttributes(new {style = "text-align: right;"})
                    .ClientTemplate("<#= ProductCode == 'TL(g/pc)' ? $.telerik.formatString('{0:n3}', TonKhoNCU) : $.telerik.formatString('{0:n0}', TonKhoNCU) #>");
              
                columns.Bound(f => f.TonKhoNCUKiemTra).Width(60)
                    //.HeaderTemplate("KT</br>ngoài")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ExternalInspection3").ToString())
                    .HtmlAttributes(new {style = "text-align: right;"})
                    .ClientTemplate("<#= ProductCode == 'TL(g/pc)' ? $.telerik.formatString('{0:n3}', TonKhoNCUKiemTra) : $.telerik.formatString('{0:n0}', TonKhoNCUKiemTra) #>");
              
                columns.Bound(f => f.TonKhoQCA).Width(60)
                    .HeaderTemplate("QC/A")
                    .HtmlAttributes(new {style = "text-align: right;"})
                    .ClientTemplate("<#= ProductCode == 'TL(g/pc)' ? $.telerik.formatString('{0:n3}', TonKhoQCA) : $.telerik.formatString('{0:n0}', TonKhoQCA) #>");
              
                columns.Bound(f => f.TonKhoQCB).Width(60)
                    .HeaderTemplate("QC/B")
                    .HtmlAttributes(new { style = "text-align: right;" })
                    .ClientTemplate("<#= ProductCode == 'TL(g/pc)' ? $.telerik.formatString('{0:n3}', TonKhoQCB) : $.telerik.formatString('{0:n0}', TonKhoQCB) #>");
            
                columns.Bound(f => f.TonKhoQCC).Width(60)
                    .HeaderTemplate("QC/C")
                    .HtmlAttributes(new { style = "text-align: right;" })
                    .ClientTemplate("<#= ProductCode == 'TL(g/pc)' ? $.telerik.formatString('{0:n3}', TonKhoQCC) : $.telerik.formatString('{0:n0}', TonKhoQCC) #>");
            
                columns.Bound(f => f.Packing).Width(60)
                    //.HeaderTemplate("Đóng</br>gói")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Packing").ToString())
                    .HtmlAttributes(new { style = "text-align: right;" })
                    .ClientTemplate("<#= ProductCode == 'TL(g/pc)' ? $.telerik.formatString('{0:n3}', Packing) : $.telerik.formatString('{0:n0}', Packing) #>");
                           
                columns.Bound(f => f.TonKhoTPA).Width(60)
                    //.HeaderTemplate("Thành</br>phẩm")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "FinishedProduct1").ToString())
                    .HtmlAttributes(new { style = "text-align: right;" })
                    .ClientTemplate("<#= ProductCode == 'TL(g/pc)' ? $.telerik.formatString('{0:n3}', TonKhoTPA) : $.telerik.formatString('{0:n0}', TonKhoTPA) #>");
                        
                columns.Bound(f => f.TonKhoCXL).Width(60)
                    //.HeaderTemplate("Chờ</br>PL")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "SortingPending1").ToString())
                    .HtmlAttributes(new {style = "text-align: right;"})
                    .ClientTemplate("<#= ProductCode == 'TL(g/pc)' ? $.telerik.formatString('{0:n3}', TonKhoCXL) : $.telerik.formatString('{0:n0}', TonKhoCXL) #>");
              
                columns.Bound(f => f.ReProcessing).Width(60)
                    //.HeaderTemplate("Chờ</br>GC lại")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ReProcessing3").ToString())
                    .HtmlAttributes(new {style = "text-align: right;"})
                    .ClientTemplate("<#= ProductCode == 'TL(g/pc)' ? $.telerik.formatString('{0:n3}', ReProcessing) : $.telerik.formatString('{0:n0}', ReProcessing) #>");
            })
            .ClientEvents(events => events.OnDataBinding("gridInventory_OnDataBinding")
                .OnError("grid_OnError"))
            //.HtmlAttributes(new {style = "width: 950px;"})
            //.Resizable(resizing => resizing.Columns(true))
            .Footer(false)
            .Render();
    }
</div>
