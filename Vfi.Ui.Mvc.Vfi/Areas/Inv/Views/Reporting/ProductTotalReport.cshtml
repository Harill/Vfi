@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Báo cáo đơn giá SP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript">

        function grid_OnDataBinding(args) {
            if (startGrid && !onLoading) {
                OnLoadingData();
                var productCode = $("#ProductCode").data("tAutoComplete").value();
                var machineId = $("#MachineId").data("tComboBox").value();
                var fromDate = $("#fromDate").data("tDatePicker").value();

                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

                args.data = $.extend(args.data, {
                    fromDate: fromDate,
                    toDate: toDate,
                    productCode: productCode,
                    machineId: machineId,
                });
                index = 0;
            }
        }

        var index = 0;

        function grid_OnDataBound() {
            OnLoadedData();
        }

        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }
        var startGrid = false;

    </script>

}

<div class="title">
    Báo cáo đơn giá SP
    @HttpContext.GetGlobalResourceObject("Resource", "")
</div>
