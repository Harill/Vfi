<div id="pnlInvMonthly">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">

        <fieldset>
            <legend>
                @*Tiêu chí trích lọc*@
                @HttpContext.GetGlobalResourceObject("Resource", "Filter")
            </legend>
            <div class="grid_1">
                @*Máy*@
                @HttpContext.GetGlobalResourceObject("Resource", "Machine")
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().ComboBox()
                        .Name("MachineId")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxMachineAllProduction2", "Machine", new { area = "Factory" }))
                        .DropDownHtmlAttributes(new { style = "width: 100%; " })
                        .HtmlAttributes(new { style = "width: 100%; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            <div class="grid_2">
                @*@Html.LabelFor(f => f.ProductCodeName)*@
                @HttpContext.GetGlobalResourceObject("Resource", "Product")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCode")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                        .DropDownHtmlAttributes(new { style = "width: 100%; " })
                        .HtmlAttributes(new { style = "width: 100%; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            

            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("fromDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today.Month + "/01/" + DateTime.Today.Year)
