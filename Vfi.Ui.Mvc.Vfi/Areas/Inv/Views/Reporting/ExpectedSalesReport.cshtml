<div id="pnlInvMonthly">
    <div class="cover-div">
        @{
            Html.Telerik().Grid<ExpectedSalesModel>()
                .Name("gridExpectedSales")
                .ToolBar(bar => bar.Insert().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
                    .Text("Thêm mới")
                    )
                .DataKeys(keys => keys.Add(f => f.ProductId).RouteKey("productId"))
                .DataBinding(dataBindings => dataBindings.Ajax()
                                                         .Select("SelectExpectedSales2", "Reporting", new { month = DateTime.Now.Month, year = DateTime.Now.Year })
                                                         .Insert("InsertExpectedSales2", "Reporting")
                                                         .Update("UpdateExpectedSales2", "Reporting"))
                .Columns(columns =>
                    {
                        columns.Command(command => command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image))   
                            .Width(50)
                            .Title("")
                            .HtmlAttributes(new {style = "text-align:center"});

                        columns.Bound(f => f.Index)
                            //.Title("STT")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Index").ToString())
                            .Width(30).ReadOnly(true)
                            .HeaderHtmlAttributes(new {style = "font-weight: bold"})
                            .HtmlAttributes(new {style = "font-weight: center;"});
                      
                        columns.Bound(f => f.CustomerCode)
                            //.Title("Mã KH")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "CustomerCode2").ToString())
                            .Width(30).ReadOnly(true)
                            .HeaderHtmlAttributes(new {style = "font-weight: bold;"})
                            .HtmlAttributes(new {style = "text-align: center;"});
                       
                        columns.Bound(f => f.ProductCode)
                            //.Title("Mã SP")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductCode2").ToString())
                            .Width(70)
                            .HeaderHtmlAttributes(new {style = "font-weight: bold;"})
                            .HtmlAttributes(new {style = "text-align: left;"})
                            .Aggregate(agg => agg.Count())
                            .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                            .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>");
                        
                        columns.Bound(f => f.ExpectedSalesQuantity).Width(50)
                            //.HeaderTemplate("Dự kiến<br/>BH")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Expected").ToString()
                                + "</br>"
                                + @HttpContext.GetGlobalResourceObject("Resource", "Selling").ToString()
                            )
                            .HtmlAttributes(new {style = "text-align: right;"})
                            .Aggregate(agg => agg.Sum())
                            .Format("{0:n0}")
                            .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                            .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                            .FooterHtmlAttributes(new {style = "text-align: right;"});
                       
                        columns.Bound(f => f.ForeCastDate).Width(90)
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "ForecastDate1").ToString())
                            .Format("<#= ForeCastDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', ForeCastDate) #>");
                    })
                .Resizable(f => f.Columns(true))
                .Reorderable(f => f.Columns(true))
                .Editable(f => f.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
                .Filterable()
                .Sortable()
                .ClientEvents(events => events
                                            .OnDataBinding("grid_OnDataBinding")
                                            .OnSave("grid_OnSave")
                                            .OnError("grid_OnError"))
                .Render();
        }
    </div>
</div>

