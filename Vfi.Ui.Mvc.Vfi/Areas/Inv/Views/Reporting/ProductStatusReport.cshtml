@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Tình trạng SP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript">

        function grid_OnDataBinding(args) {
            if (startGrid) {
                var productCodeNameForMonthly = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();

                var customerId = $("#CustomerForMonthly").data('tComboBox').value();
                if (customerId === "")
                    customerId = 0;

                args.data = $.extend(args.data, {
                    customerId: customerId,
                    productCode: productCodeNameForMonthly
                });
                index = 0;
            }
        }

        var index = 0;

        var startGrid = false;
        function RefreshGrid2() {
            startGrid = true;
            RefreshGrid("grid");
        }
    </script>
}

<div class="title">
    @*Báo cáo tình trạng sản phẩm*@
    @HttpContext.GetGlobalResourceObject("Resource", "ProductStatusReport")

</div>
<div class="clear"></div>
<div id="pnlInvMonthly">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 1000px;">
        <fieldset>
            <legend>
                @*Tiêu chí trích lọc*@
                @HttpContext.GetGlobalResourceObject("Resource", "Filter")

            </legend>
            <div class="grid_2">
                @*@Html.Label("Mã KH")*@
                @HttpContext.GetGlobalResourceObject("Resource", "CustomerCode2")

            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("CustomerForMonthly")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                        .HtmlAttributes(new { style = "width: 150px" })
                        .DropDownHtmlAttributes(new { style = "width: 275px" })
                        //.ClientEvents(events => events.OnChange("customerForPeriod_onChange"))
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>
            <div class="grid_2">
@*                @Html.LabelFor(f => f.ProductCodeName)*@
                @HttpContext.GetGlobalResourceObject("Resource", "Product")

            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeNameForMonthly")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                        .DropDownHtmlAttributes(new { style = "width: 200px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            <div class="grid_3 prefix_1">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2(); ">
                    <span class='t-icon t-insert'></span>
                    @*Làm mới*@
                    @HttpContext.GetGlobalResourceObject("Resource", "Refresh")

                </button>
            </div>
        </fieldset>
    </div>
    <div class="clear">
    </div>

    <div class="cover-div">
        @{
            Html.Telerik().Grid<ProductStatusModel>()
                .Name("grid")
                .DataKeys(keys => keys.Add(f => f.ProductId).RouteKey("productId"))
                .DataBinding(dataBindings => dataBindings.Ajax()
                                                         .Select("SelectProductStatusReport", "Reporting",
                                                                 new {
                                                                     customerId = -1,
                                                                     productCode = ""
                                                                 })
                )
                .Columns(columns => {
                    columns.Bound(f => f.ProductId)
                        .Width(40)
                        .ClientTemplate("<#= ++index #>")
                        //.HeaderTemplate("<strong>STT</strong>")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Index").ToString());
                    
                    columns.Bound(f => f.CustomerCode).Width(80)
                        //.HeaderTemplate("<strong>Mã KH</strong>")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "CustomerCode2").ToString())
                        .HtmlAttributes(new { style = "text-align: center;" });
                    
                    columns.Bound(f => f.ProductCode).Width(140)
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductCode2").ToString())
                        .HtmlAttributes(new { style = "text-align: center;" })
                        .Aggregate(agg => agg.Count())
                        .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                        .FooterHtmlAttributes(new { style = "text-align: center;" });
                    
                    columns.Bound(f => f.UnitPrice).Width(120)
                        //.HeaderTemplate("<strong>Giá trị SP</strong>")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductValue2").ToString())
                        .Format("{0:n0}")
                        .HtmlAttributes(new { style = "text-align: right;" });
                    
                    columns.Bound(f => f.MaterialPrice).Width(120)
                        //.HeaderTemplate("<strong>Giá trị NL</strong>")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "MaterialValue2").ToString())
                        .Format("{0:n0}")
                        .HtmlAttributes(new { style = "text-align: right;" });
                    
                    columns.Bound(f => f.MaterialUnitWeight).Width(120)
                        //.HeaderTemplate("<strong>TL phoi</strong>")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "RawMaterialWeight2").ToString())
                        .Format("{0:n3}")
                        .HtmlAttributes(new { style = "text-align: right;" });
                    
                    columns.Bound(f => f.MaterialCode).Width(120)
                        //.HeaderTemplate("<strong>Nguyên liệu</strong>")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Material").ToString())
                        .HtmlAttributes(new { style = "text-align: center;" });
                    
                    // so lieu
                    columns.Bound(f => f.TotalInv)
                        //.Title("Tồn kho</br>Tổng")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "TotalInv1").ToString())
                        .Width(80)
                        .Aggregate(agg => agg.Sum())
                        .Format("{0:n0}")
                        .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                        .HtmlAttributes(new { style = "text-align: right;" })
                        .FooterHtmlAttributes(new { style = "text-align: right;" });
                        
                    columns.Bound(f => f.FinishInv)
                        //.Title("Tồn kho</br>TP")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Inv").ToString()
                            + "</br>"
                            + @HttpContext.GetGlobalResourceObject("Resource", "FinishedProduct2").ToString()
                        )
                        .Width(80)
                        .Aggregate(agg => agg.Sum())
                        .Format("{0:n0}")
                        .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                        .HtmlAttributes(new { style = "text-align: right;" })
                        .FooterHtmlAttributes(new { style = "text-align: right;" });

                    
                    columns.Bound(f => f.LastProductionDate)
                        //.HeaderTemplate("Ngày SX<br/>cuối")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "LastProductionDate3").ToString())
                        .Width(100)
                        .ClientTemplate("<#= LastProductionDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', LastProductionDate) #>")
                        .HtmlAttributes(new { style = "text-align: right;" });
                    
                    columns.Bound(f => f.LastExportDate)
                        //.HeaderTemplate("Ngày giao<br/>cuối")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "LastDeliveryDate1").ToString())
                        .Width(100)
                        .ClientTemplate("<#= LastExportDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', LastExportDate) #>")
                        .HtmlAttributes(new { style = "text-align: right;" });
                    
                    columns.Bound(f => f.LastFinishInvDate)
                        //.HeaderTemplate("Ngày chuyển<br/> TP cuối")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "TransferDate").ToString()
                            + "</br>"
                            + @HttpContext.GetGlobalResourceObject("Resource", "LastFinishedProduct2").ToString()
                        )
                        .Width(100)
                        .ClientTemplate("<#= LastFinishInvDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', LastFinishInvDate) #>")
                        .HtmlAttributes(new { style = "text-align: right;" });
                    
                    columns.Bound(f => f.LastRotateDate)
                        //.HeaderTemplate("Ngày chuyển<br/> kho cuối")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "TransferDate").ToString()
                            + "</br>"
                            + @HttpContext.GetGlobalResourceObject("Resource", "LastWarehouse").ToString()
                        )
                        .Width(100)
                        .ClientTemplate("<#= LastRotateDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', LastRotateDate) #>")
                        .HtmlAttributes(new { style = "text-align: right;" });
                     
                    columns.Bound(f => f.ModifiedDate)
                        //.HeaderTemplate("Ngày cuối<br/>cập nhật")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "LastDate").ToString()
                            + "</br>"
                            + @HttpContext.GetGlobalResourceObject("Resource", "Update").ToString()
                        )
                        .Width(100)
                        .ClientTemplate("<#= ModifiedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', ModifiedDate) #>")
                        .HtmlAttributes(new { style = "text-align: right;" });

                    })
                .ClientEvents(events => events
                                            .OnDataBinding("grid_OnDataBinding")
                                            .OnError("grid_OnError"))
                .Scrollable(f => f.Height(510))
                //.HtmlAttributes(new { style = "width: 950px;" })
                .Resizable(f => f.Columns(true))
                .Reorderable(f => f.Columns(true))
                .Filterable()
                .Sortable()
                .Groupable()
                .Render();
        }
        @*@{ Html.Telerik().ScriptRegistrar().OnDocumentReady("applyFrozenColumns();"); }*@
    </div>
</div>

<!-- windown -->
@{
    Html.Telerik().Window()
        .Name("windowReport")
        .Modal(true)
        .Draggable(true)
        .Content
        (
    @<text>
    <div id="result"></div>
    </text>
)
        //.ClientEvents(e => e.OnLoad("Window_onLoad"));
        .Visible(false)
        .Width(960)
        .Render();
}

<style type="text/css">
    #windowReport {
        /*
            float: right;
            Position: relative;
            */
        min-height: 580px;
        top: 15%;
    }

    #result {
        height: 520px;
        overflow: hidden;
    }

    #ReportBody {
        padding-bottom: 25px;
        margin-bottom: 25px;
    }

    .tb-witdh td {
        width: 55px;
    }
</style>
