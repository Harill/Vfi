@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Models.Production
@model ProductInventoryModel
@{
    ViewBag.Title = "KH lên máy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{

    <!-- grid Monthly -->
    <script type="text/javascript">
        var startGrid = false;
        function RefreshGrid2() {
            startGrid = true;
            RefreshGrid("grid");
        }

        var index = 0;

        function grid_OnDataBinding(args) {
            index = 0;
            if (startGrid) {

                var productCodeNameForMonthly = $("#ProductCode").data("tAutoComplete").value();

                var customerId = $("#Customer").data('tComboBox').value();
                if (customerId == 0)
                    customerId = 0;
                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

                var invDate = $("#invDate").data("tDatePicker").value();
                if (invDate === null)
                    invDate = "";
                else
                    invDate = $.telerik.formatString('{0:dd/MM/yyyy}', invDate);
                //var type = $("#Type").data('tDropDownList').value();
                //if (type == 0)
                //    type = 0;
                //var isAllOrder = $("input[name='chkAllOrder']").attr('checked');
                var cames = $("input[name='chkCames']").attr('checked');
                var cnc = $("input[name='chkCnc']").attr('checked');
                args.data = $.extend(args.data, {
                    customerId: customerId,
                    productCode: productCodeNameForMonthly,
                    fromPoDate: fromDate,
                    toPoDate: toDate,
                    invDate: invDate,
                    cames: cames,
                    cnc: cnc,
                    //type: type,
                    //isAllOrder: isAllOrder,
                });
            }
        }
    </script>
    <!-- report -->
    <script type="text/javascript">

        //function type_onLoad() {
        //    var combobox = $('#Type').data('tDropDownList');
        //    var dataSource =
        //    [
        //        { Text: "Đơn hàng KD", Value: "1" },
        //        { Text: "Dự báo KD", Value: "2" }
        //    ];

        //    combobox.dataBind(dataSource);
        //    combobox.value("Đơn hàng KD");
        //}

    </script>
}

<div class="title">
    @*Kế hoạch lên máy*@
    @HttpContext.GetGlobalResourceObject("Resource", "MachineSetupPlan")
</div>
<div class="clear"></div>
<br />

<div id="pnlInvMonthly">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 1180px;">
        <fieldset>
            <legend>
                @*Tiêu chí trích lọc*@
                @HttpContext.GetGlobalResourceObject("Resource", "Filter")
            </legend>
            <div class="grid_2">
                @*@Html.Label("Khách hàng")*@
                @HttpContext.GetGlobalResourceObject("Resource", "Customer")
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Customer")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                        .HtmlAttributes(new { style = "width: 100%" })
                        .DropDownHtmlAttributes(new { style = "width: 250%" })
                        //.ClientEvents(events => events.OnChange("customerForPeriod_onChange"))
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>
            <div class="grid_2">
                @*@Html.Label("Sản phẩm")*@
                @HttpContext.GetGlobalResourceObject("Resource", "Product")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                    .Name("ProductCode")
                    .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv", new { area = "Inv" }))
                        .HtmlAttributes(new { style = "width: 100%" })
                        .DropDownHtmlAttributes(new { style = "width: 250%" })
                    .AutoFill(true)
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .Render();
                }
            </div>
           @* <div class="grid_3">
                @{
                    Html.Telerik().DropDownList()
                        .Name("Type")
                        .HtmlAttributes(new { style = "width: 100px" })
                        .DropDownHtmlAttributes(new { style = "width: 100px" })
                        .ClientEvents(events => events.OnLoad("type_onLoad"))
                        .Render();
                }
            </div>*@
            <div class="grid_9">
                <div class="grid_2">
                    @*@Html.Label("Ngày PO")*@
                    @HttpContext.GetGlobalResourceObject("Resource", "PODate") 
                </div>
                <div class="grid_3">
                    @{
                        Html.Telerik().DatePicker()
                            .Name("fromDate")
                            .Format("dd/MM/yyyy")
                            .Value(DateTime.Now)
                            .Render();
                    }
                </div>
                <div class="grid_3">
                    @{
                        Html.Telerik().DatePicker()
                            .Name("toDate")
                            .Format("dd/MM/yyyy")
                            .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(4).AddSeconds(-1))
                            .Render();
                    }
                </div>
                <div class="grid_2">
                    @*@Html.Label("Ngày báo cáo")*@
                    @HttpContext.GetGlobalResourceObject("Resource", "ReportDate")
                </div>
                <div class="grid_3">
                    @{
                        Html.Telerik().DatePicker()
                            .Name("invDate")
                            .Format("dd/MM/yyyy")
                            .Value(DateTime.Now)
                            .Render();
                    }
                </div>

            </div>

            @*<div class="grid_2_5">
                <label>
                    <input type="checkbox" id="chkAllOrder" name="chkAllOrder" />
                    Lấy tất cả
                </label>
                <br />
            </div>*@
            
                <div class="grid_2">
                <label>
                    <input type="checkbox" id="chkCames" name="chkCames" checked/>
                    Cames
                </label> <br />
                <label>
                    <input type="checkbox" id="chkCnc" name="chkCnc" checked/>
                    CNC
                </label>
            </div>
            <div class="grid_3">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2(); ">
                    <span class='t-icon t-insert'></span>
                    @*Làm mới*@
                    @HttpContext.GetGlobalResourceObject("Resource", "Refresh")
                </button>
            </div>
        </fieldset>
    </div>
</div>
<div class="clear"></div>

<div class="cover-div">
    @{
        Html.Telerik().Grid<MachineSetupPlanModel>()
                .Name("grid")
                .DataKeys(keys => keys.Add(f => f.ProductId).RouteKey("productId"))
                .DataBinding(dataBindings => dataBindings.Ajax()
                                                         .Select("SelectMachineSetupPlan", "Reporting",
                                                                 new {
                                                                     customerId = 0,
                                                                     productCode = "",
                                                                     fromPoDate = "",
                                                                     toPoDate = "",
                                                                     invDate = "",
                                                                     cames = false,
                                                                     cnc = false,
                                                                 })
                                                         )
                .Columns(columns => {
                        
                    columns.Bound(f => f.ProductId)
                        //.Title("STT")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Index").ToString())
                        .Width(35).ReadOnly(true)
                        .HeaderHtmlAttributes(new { style = "font-weight: bold" })
                        .ClientTemplate("<#= ++index #>")
                        .HtmlAttributes(new { style = "font-weight: center;" });
                       
                    columns.Bound(f => f.CustomerCode)
                        //.Title("Mã KH")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "CustomerCode2").ToString())
                        .Width(60).ReadOnly(true)
                        .HeaderHtmlAttributes(new { style = "font-weight: bold;" })
                        .HtmlAttributes(new { style = "text-align: center;" });
                        
                    columns.Bound(f => f.ProductCode)
                        //.Title("Mã SP")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductCode2").ToString())
                        .Width(120).ReadOnly(true)
                        .HeaderHtmlAttributes(new { style = "font-weight: bold;" })
                        .Aggregate(agg => agg.Count())
                        .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>")
                        .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>")
                        .FooterTemplate("<span id='tongcot1'></span>");
                     
                    //columns.Bound(f => f.Type).Width(100)
                        //       .HeaderTemplate("Loại").ReadOnly(true)
                        //       .HtmlAttributes(new { style = "text-align: center;border-right:black 3px double;" });
                       
                    columns.Bound(f => f.TotalInv).Width(70)
                        //.HeaderTemplate("Tổng</br>tồn")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "TotalInv1").ToString())
                        .ReadOnly(true)
                        .Format("{0:n0}")
                        .HtmlAttributes(new { style = "text-align: right;" });
                     
                    columns.Bound(f => f.OrderNumber).Width(70)
                        //.HeaderTemplate("Đơn hàng")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Order").ToString())
                        .ReadOnly(true)
                        .Format("{0:n0}")
                        .HtmlAttributes(new { style = "text-align: right;" });
                       
                    columns.Bound(f => f.ForecastNumber).Width(70)
                        //.HeaderTemplate("Dự báo")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Forecast").ToString())
                        .ReadOnly(true)
                        .Format("{0:n0}")
                        .HtmlAttributes(new { style = "text-align: right;" });
                      
                    columns.Bound(f => f.RequireNumber).Width(70)
                        //.HeaderTemplate("Yêu cầu SX")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductionRequest2").ToString())
                        .ReadOnly(true)
                        .Format("{0:n0}")
                        .HtmlAttributes(new { style = "text-align: right;" });
                      
                    columns.Bound(f => f.RequireDate).Width(85)
                        //.HeaderTemplate("Ngày YC")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "RequestDate2").ToString())
                        .ReadOnly(true)
                        .Format("{0:dd/MM/yyyy}")
                        .HtmlAttributes(new { style = "text-align: center;" });
                     
                    columns.Bound(f => f.State).Width(50)
                        //.HeaderTemplate("Tình</br>trạng")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Status1").ToString());
                       
                    columns.Bound(f => f.SetupDate).Width(85)
                        //.HeaderTemplate("Thời hạn</br>lên máy")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "SetupDate").ToString())
                        .ReadOnly(true)
                        .Format("{0:dd/MM/yyyy}")
                        .HtmlAttributes(new { style = "text-align: center;" });
                      
                    columns.Bound(f => f.MaterialCode).Width(100)
                        //.HeaderTemplate("Nguyên</br>liệu")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Material").ToString())
                        .ReadOnly(true)
                        .HtmlAttributes(new { style = "text-align: center;" });
                    
                    columns.Bound(f => f.MaterialInv).Width(70)
                        //.HeaderTemplate("Tồn kho</br>NL (cây)")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Inventory").ToString()
                            + "</br>"
                            + @HttpContext.GetGlobalResourceObject("Resource", "Material2").ToString()
                            + " ("
                            + @HttpContext.GetGlobalResourceObject("Resource", "Bar").ToString()
                            + ")"
                        )
                        .ReadOnly(true)
                        .Format("{0:n0}")
                        .HtmlAttributes(new { style = "text-align: right;" });
                     
                    columns.Bound(f => f.MaterialInvKg).Width(70)
                        //.HeaderTemplate("Tồn kho</br>NL (kg)")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Inventory").ToString()
                            + "</br>"
                            + @HttpContext.GetGlobalResourceObject("Resource", "Material2").ToString()
                            + " (kg)"
                        )                        
                        .ReadOnly(true)
                        .Format("{0:n2}")
                        .HtmlAttributes(new { style = "text-align: right;" });
                       
                    columns.Bound(f => f.ProductionHistory).Width(100).Format("{0}")
                        //.HeaderTemplate("Lịch sử máy SX")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "History").ToString()
                            + " "
                            + @HttpContext.GetGlobalResourceObject("Resource", "Machine").ToString()
                            + " "
                            + @HttpContext.GetGlobalResourceObject("Resource", "Production2").ToString()
                        );
                     
                    columns.Bound(f => f.ProductionOnRun).Width(100).Format("{0}")
                        //.HeaderTemplate("Máy đang chạy</br>(theo sơ đồ máy)")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "RunningMachine").ToString()
                            + "</br>("
                            + @HttpContext.GetGlobalResourceObject("Resource", "Follow").ToString()
                            + " "
                            + @HttpContext.GetGlobalResourceObject("Resource", "MachineDiagram").ToString()
                            + ")"
                        );
                      
                    columns.Bound(f => f.AvailableMachine).Width(100).Format("{0}")
                        //.HeaderTemplate("Máy trống theo</br>chức năng SP")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "EmptyMachine").ToString()
                            + " "
                            + @HttpContext.GetGlobalResourceObject("Resource", "Follow").ToString() 
                            + "</br>"
                            + @HttpContext.GetGlobalResourceObject("Resource", "ProductFunction2").ToString()
                        );

                    })

                .Scrollable(f => f.Height(510))
            //.HtmlAttributes(new { style = "width: 950px;" })
                .Resizable(f => f.Columns(true))
                .Reorderable(f => f.Columns(true))
            //.Editable(f => f.Mode(GridEditMode.InCell))
                .Filterable()
            //.Groupable(group => group.Groups(g => g.Add(model => model.Type))) // hjx hjx
                .Sortable()
                .Selectable()
                .ClientEvents(events => events
                                            .OnDataBinding("grid_OnDataBinding")
                                            .OnRowSelect("grid_OnRowSelect")
                                            .OnError("grid_OnError"))
                .Groupable()
                .Render();
    }
</div>
