@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Báo cáo giao hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnLoad.js")"></script>
    <!-- grid Monthly -->
    <script type="text/javascript">
        var startGrid = false;

        function grid_OnDataBinding(args) {
            if (startGrid && !onLoading) {
                OnLoadingData();
                var productCode = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();

                var customerId = $("#CustomerForMonthly").data('tComboBox').value();
                if (customerId === "")
                    customerId = 0;
                args.data = $.extend(args.data, {
                    customerId: customerId,
                    productCode: productCode,
                });
            }
        }

        var index = 0;

        function grid_OnDataBound() {
            OnLoadedData();
            index = 0;
        }

        function grid_OnRowDataBound(e) {
            if (e.dataItem.StatusColor) {
                e.row.cells.namedItem('StatusName').bgColor = '#' + e.dataItem.StatusColor;
            }
        }

    </script>
    <!-- report -->
    <script type="text/javascript">

        function printReport() {

            if (!onLoading) {
                OnLoadingData();
                var customerId = $("#CustomerForMonthly").data('tComboBox').value();
                if (customerId === "")
                    customerId = 0;
                $('#result').load('@Url.Action("PrintDeliverySalesReport", "Reporting")',
                    {
                        customerId: customerId,
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }

    </script>
}

<div class="title">
    @*Báo cáo giao hàng*@
    @HttpContext.GetGlobalResourceObject("Resource", "DeliverySalesReport")
</div>
<div class="clear"></div>
<br />

