                        .Render();
                }
            </div>
            <div class="grid_2">
                @*@Html.LabelFor(f => f.ProductCodeName)*@
                @HttpContext.GetGlobalResourceObject("Resource", "ProductCode")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeNameForMonthly")
