@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Báo cáo SP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- grid Monthly -->

    <script type="text/javascript">

        function grid_OnDataBinding(args) {
            if (startGrid) {
                OnLoadingData();
                var productCodeNameForMonthly = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();

                var customerId = $("#CustomerForMonthly").data('tComboBox').value();
                if (customerId === "")
                    customerId = 0;

                var type = $("#ReportType").data("tDropDownList").value();
                if (type === null)
                    type = 2;
                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                args.data = $.extend(args.data, {
                    type: type,
                    customerId: customerId,
                    productName: productCodeNameForMonthly,
                    fromDate: fromDate,
                    toDate: toDate
                });
                index = 0;
            }
        }

        var index = 0;
        function grid_OnDataBound() {
            OnLoadedData();
        }
    </script>
    <!-- report -->
    <script type="text/javascript">
        function printImportExportProduction() {
            if (!onLoading) {
                OnLoadingData();
                var type = $("#ReportType").data("tDropDownList").value();
                if (type === null)
                    type = 2;
                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                var customerId = $("#CustomerForMonthly").data('tComboBox').value();
                if (customerId === "")
                    customerId = 0;

                $('#result').load('@Url.Action("PrintAllProductsReport", "Reporting")',
                    {
                        customerId: customerId,
                        type: type,
                        fromDate: fromDate,
                        toDate: toDate
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

        function printImportExportProduction2() {
            if (!onLoading) {
                OnLoadingData();
                var month = 0;
                var year = 0;
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    year = "";
                else {
                    month = $.telerik.formatString('{0:mm}', toDate);
                    year = $.telerik.formatString('{0:yyyy}', toDate);
                }
                $('#result').load('@Url.Action("PrintAllProductsReport2", "Reporting")',
                    {
                        type: 0,
                        month: month,
                        year: year
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

        function printImportExportProduction3() {

            if (!onLoading) {
                OnLoadingData();
                var year = 0;
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    year = "";
                else
                    year = $.telerik.formatString('{0:yyyy}', toDate);
                $('#result').load('@Url.Action("PrintAllProductsReport3", "Reporting")',
                    {
                        year: year
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

        function printNotFinishInvProduct() {
            if (!onLoading) {
                OnLoadingData();
                var productCode = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();
                var type = $("#ReportType").data("tDropDownList").value();
                if (type === null)
                    type = 2;
                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                var customerId = $("#CustomerForMonthly").data('tComboBox').value();
                if (customerId === "")
                    customerId = 0;
                $('#result').load('@Url.Action("PrintNotFinishInvProduct", "Reporting")',
                    {
                        customerId: customerId,
                        productCode: productCode,
                        caculateModel: type,
                        fromDate: fromDate,
                        toDate: toDate,
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

        function reportType_onLoad() {
            var combobox = $('#ReportType').data('tDropDownList');
            var dataSource =
            [
                { Text: "Tất cả", Value: "1" },
                { Text: "Diễn biến", Value: "2" }
            ];

            combobox.dataBind(dataSource);
            combobox.select(1);
        }

        var startGrid = false;
        function RefreshGrid2(name) {
                OnLoadingData();
                startGrid = true;
                RefreshGrid(name);
        }

        var onLoading = false;
        function OnLoadingData() {
            if (!onLoading) {
                onLoading = true;
                var loadings = document.querySelectorAll('.loadButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (Chờ load)";
                    loading.classList.add('loading');
                }
            }
        }
        function OnLoadedData() {
            if (onLoading) {
                var loadings = document.querySelectorAll('.loadButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    if (loading && loading.className.includes("loading")) {
                        loading.classList.remove('loading');
                        loading.innerHTML = "<span></span>";
                    }
                }
                onLoading = false;
            }
        }
        
    </script>
}

