@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "SX tổng hợp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript">

        function grid_OnDataBinding(args) {
            if (startGrid && !onLoading) {
                OnLoadingData();
                var productCode = $("#ProductCode").data("tAutoComplete").value();
                var materialCode = $("#MaterialCodeName").data("tAutoComplete").value();
                var machine = $("#Machine").data("tAutoComplete").value();
                var shift = $("#Shift").data("tAutoComplete").value();

                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

                args.data = $.extend(args.data, {
                    fromDate: fromDate,
                    toDate: toDate,
                    productCode: productCode,
                    materialCode: materialCode,
                    machineName: machine,
                    shiftName: shift
                });
                index = 0;
            }
        }

        var index = 0;

        function grid_OnDataBound() {
            OnLoadedData();
        }

        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }
        var startGrid = false;

    </script>

}

<div class="title">Báo cáo sản xuất tổng hợp</div>
<div class="clear"></div>
<br />

<div id="pnlInvMonthly">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">

        <fieldset>
            <legend>Tiêu chí trích lọc</legend>
            <div class="grid_1">
                Máy
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("Machine")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxMachine", "Machine", new { area = "Factory" }))
                        .DropDownHtmlAttributes(new { style = "width: 100%; " })
                         .HtmlAttributes(new { style = "width: 100%; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            <div class="grid_2">
                @Html.LabelFor(f => f.ProductCodeName)
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCode")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                        .DropDownHtmlAttributes(new { style = "width: 100%; " })
                        .HtmlAttributes(new { style = "width: 100%; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            
            <div class="grid_2">
                @Html.Label("Nguyên Liệu")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("MaterialCodeName")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedMaterialInventory", "Inv", new { materialTypeId = 0 }))
                        //.HtmlAttributes(new { style = "width: 185px; " })
                        .DropDownHtmlAttributes(new { style = "width: 250px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            <div class="grid_1">
                Ca
            </div>
            <div class="grid_2">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("Shift")
                         .HtmlAttributes(new { style = "width: 100%; " })
                        .Render();
                }
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("fromDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today.Month + "/01/" + DateTime.Today.Year)
                        .Render();
                }
            </div>
            <div class="grid_2">
                @{
                    Html.Telerik().DatePicker()
                        .Name("toDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
            <div class="grid_3 prefix_1">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2('gridProduction'); ">
                    <span class='t-icon t-insert'></span>
                    Làm mới
                    <span class="loadButton"></span>
                </button>
            </div>
        </fieldset>
    </div>
    <div class="clear">
    </div>

