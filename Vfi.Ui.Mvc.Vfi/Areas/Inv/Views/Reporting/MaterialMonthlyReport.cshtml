<style>
    .highslide-container div {
        font-family: Verdana, Helvetica;
        font-size: 10pt;
    }

    .highslide-container table {
        background: none;
    }

    .highslide {
        outline: none;
        text-decoration: none;
    }

        .highslide img {
            border: 2px solid silver;
        }

        .highslide:hover img {
            border-color: gray;
        }

    .highslide-active-anchor img {
        visibility: hidden;
    }

    .highslide-gallery .highslide-active-anchor img {
        border-color: black;
        visibility: visible;
        cursor: default;
    }

    .highslide-image {
        border-width: 2px;
        border-style: solid;
        border-color: white;
    }

    .highslide-wrapper, .highslide-outline {
        background: white;
    }

    .glossy-dark {
        background: #111;
    }

    .highslide-image-blur {
    }

    .highslide-number {
        display: none;
        font-weight: bold;
        color: gray;
        font-size: .9em;
    }

    .highslide-caption {
        display: none;
        font-size: 1em;
        padding: 5px;
        width: 100%;
        text-align: center;
        font-weight: bold;
        /*background: white;*/
    }

    .highslide-heading {
        display: none;
        font-weight: bold;
        margin: 0.4em;
    }

    .highslide-dimming {
        /*position: absolute;*/
        background: black;
    }

    a.highslide-full-expand {
        display: block;
        margin: 0 10px 10px 0;
        width: 34px;
        height: 34px;
    }

    .highslide-loading {
        display: block;
        color: black;
        font-size: 9px;
        font-weight: bold;
        text-transform: uppercase;
        text-decoration: none;
        padding: 3px;
        border: 1px solid white;
        background-color: white;
        padding-left: 22px;
        background-repeat: no-repeat;
        background-position: 3px 1px;
    }

    a.highslide-credits,
    a.highslide-credits i {
        padding: 2px;
        color: silver;
        text-decoration: none;
        font-size: 10px;
        display: none;
    }

        a.highslide-credits:hover,
        a.highslide-credits:hover i {
            color: white;
            background-color: gray;
        }

    .highslide-move, .highslide-move * {
        cursor: move;
    }

    .highslide-viewport {
        display: none;
        position: fixed;
        width: 100%;
        height: 100%;
        z-index: 1;
        background: none;
        left: 0;
        top: 0;
    }

    .highslide-overlay {
        display: none;
    }

    .hidden-container {
        display: none;
    }
    /* Example of a semitransparent, offset closebutton */
    .closebutton {
        position: relative;
        top: -15px;
        left: 15px;
        width: 30px;
        height: 30px;
        cursor: pointer;
        /* NOTE! For IE6, you also need to update the highslide-ie6.css file. */
    }

    .highslide-controls {
        display: none;
    }
</style>
<script type="text/javascript">
    hs.graphicsDir = '';
    hs.align = 'center';
    hs.transitions = ['expand', 'crossfade'];
    hs.outlineType = '';
    hs.fadeInOut = true;
    hs.numberPosition = 'caption';
    hs.dimmingOpacity = 0.75;

    // Add the controlbar
    if (hs.addSlideshow)
        hs.addSlideshow({
            //slideshowGroup: 'group1',
            interval: 5000,
            repeat: false,
            useControls: true,
            fixedControls: 'fit',
            overlayOptions: {
                opacity: .75,
                position: 'bottom center',
                hideOnMouseOut: true
            }
        });
    </script>
@section Scripts{
    <script type="text/javascript">

        function grid_OnSave(e) {
            var i = 0;
            var drawing2D = "";
            var editRow = e.target.getElementsByClassName("t-grid-edit-row")[0];
            //var ul2D = editRow.childNodes[2].childNodes[1].childNodes[1];
            var ul2D = editRow.getElementsByClassName("t-upload-files t-reset")[0];
            if (ul2D == null && e.Upload === "" || typeof ul2D == 'undefined') {
                drawing2D = e.dataItem.InfoImg;
            } else if (ul2D != null) {
                var child2D = ul2D.childNodes;
                for (i = child2D.length - 1; i >= 0; i--) {
                    if (child2D[i].childNodes[0].textContent === "uploaded") {
                        e.values.InfoImg = child2D[0].childNodes[1].title;
                        drawing2D = child2D[0].childNodes[1].title;
                        break;
                    }
                }
            }
            var drawing2D2 = "";
            //var ul2D2 = editRow.childNodes[3].childNodes[1].childNodes[1];
            var ul2D2 = editRow.getElementsByClassName("t-upload-files t-reset")[1];
            if (ul2D2 == null && e.Upload === "" || typeof ul2D2 == 'undefined') {
                drawing2D2 = e.dataItem.InfoImg2;
            } else if (ul2D2 != null) {
                var child2D2 = ul2D2.childNodes;
                for (i = child2D2.length - 1; i >= 0; i--) {
                    if (child2D2[i].childNodes[0].textContent === "uploaded") {
                        e.values.InfoImg2 = child2D2[0].childNodes[1].title;
                        drawing2D2 = child2D2[0].childNodes[1].title;
                        break;
                    }
                }
            }
            var message = "";
            if (drawing2D === "" || drawing2D === "askquestion.jpg" ||
                drawing2D2 === "" || drawing2D2 === "askquestion.jpg") {
                message += "\nCảnh báo!";
                if (drawing2D === "") {
                    message += "\nSẽ dùng hình mặc định !";
                }
                message += "\nĐồng ý lưu ??";
                if (confirm(message)) {};
            } else {
                return true;
            }
        }
        var startGrid = false;

        function gridMaterialInventory_onDataBinding(args) {

            if (startGrid && !onLoading) {
                OnLoadingData();
                var materialTypeId = $("#MaterialTypeName").data('tComboBox').value();
                if (materialTypeId === "")
                    materialTypeId = 0;
                var vendor = $("#cboVendor").data('tComboBox').value();
                if (vendor === "")
                    vendor = 0;

                var materialName = $("#MaterialCodeName").data("tAutoComplete").value();
                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else {
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                }
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else {
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                }
                args.data = $.extend(args.data,
                {
                    materialCode: materialName,
                    materialTypeId: materialTypeId,
                    vendor: vendor,
                    fromDate: fromDate,
                    toDate: toDate
                });
            }
        }

        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }

        function grid_OnDataBound() {
            OnLoadedData();
        }

        function grid_OnRowDataBound(e) {
            if (!e.dataItem.CanEdit && !e.dataItem.CanUpload) {
                e.row.getElementsByClassName("t-button t-grid-edit t-button-icon")[0].parentNode.innerHTML = "";
            }
        }
        function grid_OnEdit(e) {

            var mode = e.mode;
            var form = e.form;
            if (mode === 'insert') {
            } else if (mode === 'edit') {
                if (!e.dataItem.CanEdit) {
                    var dataItem = e.dataItem;
                    nodes = $(form).find('#MaterialUnitWeight');
                    nodes[0].parentNode.innerHTML = (dataItem.MaterialUnitWeight).format(4);
                    nodes = $(form).find('#MaterialUnitPrice');
                    nodes[0].parentNode.innerHTML = (dataItem.MaterialUnitPrice).format(0);
                }
            }
        }


    </script>


    <!-- report -->
    <script type="text/javascript">

        function printMaterialInvTotalInMonth() {
            
            if (!onLoading) {
                OnLoadingData();
                var materialTypeId = $("#MaterialTypeName").data('tComboBox').value();
                if (materialTypeId === "")
                    materialTypeId = 0;
                var vendor = $("#cboVendor").data('tComboBox').value();
                if (vendor === "")
                    vendor = 0;
                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else {
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                }
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else {
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                }

                $('#result').load('@Url.Action("PrintMaterialInvTotalInMonth", "Reporting")',
                    {
                        materialTypeId: materialTypeId,
                        vendor: vendor,
                        fromDate: fromDate,
                        toDate: toDate
                    },
                    function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

    </script>

}

    <div class="title">Báo cáo tổng hợp nguyên liệu</div>

    <div id="pnlInv">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">
        <fieldset>
            <legend>Lưu ý</legend>
            <ul>
                <li>
                    <b>1.Quy cách đặt tên hình Đặt (<span style="color: red">'Mã NL đầy đủ'+'Lô NLxChiều Dài'</span>) trước hình bản vẽ để lưu lại (Vd: <span style="color: red">C3604(D)3-h9-GW18Ax3.jpg</span>)</b>
                </li>
                <li>
                    <b>2.Tên file upload hình không được <span style="color: red">giống</span> với nguyên liệu khác ( upload hình sẽ bị đèn lên hình cũ )</b>
                </li>
                <li>
                    <b>3.Xem xét kĩ cảnh báo trước khi xác nhận, sau khi xác nhận xảy ra lỗi <span style="color: red">không thể phục hồi</span> </b>
                </li>
            </ul>
        </fieldset>
        <fieldset>
            <legend>Tiêu chí trích lọc</legend>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("MaterialTypeName")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxAllMaterialType", "Material", new {area = ""}))
                        .HtmlAttributes(new {style = "width: 150px"})
                        .DropDownHtmlAttributes(new {style = "width: 250px"})
                        .SelectedIndex(0)
                        .Render();
                }
            </div>
            <div class="grid_1">
                NCC
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("cboVendor")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxMaterialVendor", "Vendor", new {area = "Purchasing"}))
                        .HtmlAttributes(new {style = "width: 150px"})
                        .DropDownHtmlAttributes(new {style = "width: 250px"})
                        .SelectedIndex(0)
                        .Render();
                }
            </div>
            <div class="grid_2">
                @Html.LabelFor(f => f.MaterialCodeName)
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("MaterialCodeName")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedMaterialInventory", "Inv", new { materialTypeId = 0 }))
                        //.HtmlAttributes(new { style = "width: 185px; " })
                        .DropDownHtmlAttributes(new { style = "width: 250px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("fromDate")
                        .Format("dd/MM/yyyy")
                        .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
                        .Render();
                }
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("toDate")
                        .Format("dd/MM/yyyy")
                        .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(1).AddDays(-1))
                        .Render();
                }
            </div>
            <div class="grid_3">
                <button id="btnRefesh" class="t-button" onclick="return RefreshGrid2('gridMaterialInventory'); ">
                    <span class='t-icon t-insert'></span>
                    Làm mới
                    <span class="loadButton"></span>
                </button>
            </div>
            <div class="grid_6">
                <button id="btnMaterialInv" class="t-button" onclick="return printMaterialInvTotalInMonth(); ">
                    <span class='t-icon t-insert'></span>
                    Xuất báo cáo tồn kho nguyên liệu
                    <span class="loadButton"></span>
                </button>
            </div>
        </fieldset>

