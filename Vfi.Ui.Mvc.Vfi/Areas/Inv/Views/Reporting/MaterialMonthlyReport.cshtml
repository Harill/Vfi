@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model MaterialInventoryModel
@{
    ViewBag.Title = "Nguyên liệu tổng hợp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .highslide-container div {
        font-family: Verdana, Helvetica;
        font-size: 10pt;
    }

    .highslide-container table {
        background: none;
    }

    .highslide {
        outline: none;
        text-decoration: none;
    }

        .highslide img {
            border: 2px solid silver;
        }

        .highslide:hover img {
            border-color: gray;
        }

    .highslide-active-anchor img {
        visibility: hidden;
    }

    .highslide-gallery .highslide-active-anchor img {
        border-color: black;
        visibility: visible;
        cursor: default;
    }

    .highslide-image {
        border-width: 2px;
        border-style: solid;
        border-color: white;
    }

    .highslide-wrapper, .highslide-outline {
        background: white;
    }

    .glossy-dark {
        background: #111;
    }

    .highslide-image-blur {
    }

    .highslide-number {
        display: none;
        font-weight: bold;
        color: gray;
        font-size: .9em;
    }

    .highslide-caption {
        display: none;
        font-size: 1em;
        padding: 5px;
        width: 100%;
        text-align: center;
        font-weight: bold;
        /*background: white;*/
    }

    .highslide-heading {
        display: none;
        font-weight: bold;
        margin: 0.4em;
    }

    .highslide-dimming {
        /*position: absolute;*/
        background: black;
    }

    a.highslide-full-expand {
        display: block;
        margin: 0 10px 10px 0;
        width: 34px;
        height: 34px;
    }

    .highslide-loading {
        display: block;
        color: black;
        font-size: 9px;
        font-weight: bold;
        text-transform: uppercase;
        text-decoration: none;
        padding: 3px;
        border: 1px solid white;
        background-color: white;
        padding-left: 22px;
        background-repeat: no-repeat;
        background-position: 3px 1px;
    }

    a.highslide-credits,
    a.highslide-credits i {
        padding: 2px;
        color: silver;
        text-decoration: none;
        font-size: 10px;
        display: none;
    }

        a.highslide-credits:hover,
        a.highslide-credits:hover i {
            color: white;
            background-color: gray;
        }

    .highslide-move, .highslide-move * {
        cursor: move;
    }

    .highslide-viewport {
        display: none;
        position: fixed;
        width: 100%;
        height: 100%;
        z-index: 1;
        background: none;
        left: 0;
        top: 0;
    }

    .highslide-overlay {
        display: none;
    }

    .hidden-container {
        display: none;
    }
    /* Example of a semitransparent, offset closebutton */
    .closebutton {
        position: relative;
        top: -15px;
        left: 15px;
        width: 30px;
        height: 30px;
        cursor: pointer;
        /* NOTE! For IE6, you also need to update the highslide-ie6.css file. */
    }

    /*.highslide-controls {
        display: none;
    }*/
</style>
    
@section Scripts{
    <script type="text/javascript">
        hs.graphicsDir = '';
        hs.align = 'center';
        hs.transitions = ['expand', 'crossfade'];
        hs.outlineType = '';
        hs.fadeInOut = true;
        hs.numberPosition = 'caption';
        hs.dimmingOpacity = 0.75;

        // Add the controlbar
        if (hs.addSlideshow)
            hs.addSlideshow({
                //slideshowGroup: 'group1',
                interval: 5000,
                repeat: false,
                useControls: true,
                fixedControls: 'fit',
                overlayOptions: {
                    opacity: .75,
                    position: 'bottom center',
                    hideOnMouseOut: true
                }
            });
    </script>

    <script type="text/javascript">

        function grid_OnSave(e) {
            var i = 0;
            var drawing2D = "";
            var editRow = e.target.getElementsByClassName("t-grid-edit-row")[0];
            //var ul2D = editRow.childNodes[2].childNodes[1].childNodes[1];
            var ul2D = editRow.getElementsByClassName("t-upload-files t-reset")[0];
            if (ul2D == null && e.Upload === "" || typeof ul2D == 'undefined') {
                drawing2D = e.dataItem.InfoImg;
            } else if (ul2D != null) {
                var child2D = ul2D.childNodes;
                for (i = child2D.length - 1; i >= 0; i--) {
                    if (child2D[i].childNodes[0].textContent === "uploaded") {
                        e.values.InfoImg = child2D[0].childNodes[1].title;
                        drawing2D = child2D[0].childNodes[1].title;
                        break;
                    }
                }
            }
            var drawing2D2 = "";
            //var ul2D2 = editRow.childNodes[3].childNodes[1].childNodes[1];
            var ul2D2 = editRow.getElementsByClassName("t-upload-files t-reset")[1];
            if (ul2D2 == null && e.Upload === "" || typeof ul2D2 == 'undefined') {
                drawing2D2 = e.dataItem.InfoImg2;
            } else if (ul2D2 != null) {
                var child2D2 = ul2D2.childNodes;
                for (i = child2D2.length - 1; i >= 0; i--) {
                    if (child2D2[i].childNodes[0].textContent === "uploaded") {
                        e.values.InfoImg2 = child2D2[0].childNodes[1].title;
                        drawing2D2 = child2D2[0].childNodes[1].title;
                        break;
                    }
                }
            }
            var message = "";
            if (drawing2D === "" || drawing2D === "askquestion.jpg" ||
                drawing2D2 === "" || drawing2D2 === "askquestion.jpg") {
                message += "\nCảnh báo!";
                if (drawing2D === "") {
                    message += "\nSẽ dùng hình mặc định !";
                }
                message += "\nĐồng ý lưu ??";
                if (confirm(message)) {};
            } else {
                return true;
            }
        }
        var startGrid = false;

        function gridMaterialInventory_onDataBinding(args) {

            if (startGrid && !onLoading) {
                OnLoadingData();
                var materialTypeId = $("#MaterialTypeName").data('tComboBox').value();
                if (materialTypeId === "")
                    materialTypeId = 0;
                var vendor = $("#cboVendor").data('tComboBox').value();
                if (vendor === "")
                    vendor = 0;

                var materialName = $("#MaterialCodeName").data("tAutoComplete").value();
                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else {
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                }
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else {
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                }
                args.data = $.extend(args.data,
                {
                    materialCode: materialName,
                    materialTypeId: materialTypeId,
                    vendor: vendor,
                    fromDate: fromDate,
                    toDate: toDate
                });
            }
        }

        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }

        function grid_OnDataBound() {
            OnLoadedData();
        }

        function grid_OnRowDataBound(e) {
            if (!e.dataItem.CanEdit && !e.dataItem.CanUpload) {
                e.row.getElementsByClassName("t-button t-grid-edit t-button-icon")[0].parentNode.innerHTML = "";
            }
        }
        function grid_OnEdit(e) {

            var mode = e.mode;
            var form = e.form;
            if (mode === 'insert') {
            } else if (mode === 'edit') {
                if (!e.dataItem.CanEdit) {
                    var dataItem = e.dataItem;
                    nodes = $(form).find('#MaterialUnitWeight');
                    nodes[0].parentNode.innerHTML = (dataItem.MaterialUnitWeight).format(4);
                    nodes = $(form).find('#MaterialUnitPrice');
                    nodes[0].parentNode.innerHTML = (dataItem.MaterialUnitPrice).format(0);
                }
            }
        }


    </script>


    <!-- report -->
    <script type="text/javascript">

        function printMaterialInvTotalInMonth() {
            
            if (!onLoading) {
                OnLoadingData();
                var materialTypeId = $("#MaterialTypeName").data('tComboBox').value();
                if (materialTypeId === "")
                    materialTypeId = 0;
                var vendor = $("#cboVendor").data('tComboBox').value();
                if (vendor === "")
                    vendor = 0;
                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else {
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                }
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else {
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                }

                $('#result').load('@Url.Action("PrintMaterialInvTotalInMonth", "Reporting")',
                    {
                        materialTypeId: materialTypeId,
                        vendor: vendor,
                        fromDate: fromDate,
                        toDate: toDate
                    },
                    function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }



        function grid_OnRowDataBound_Color(e) {
            var dataItem = e.dataItem;
            var $row = $(e.row);

            // Nếu có NG trong chi tiết thì tô đỏ toàn bộ hàng
            if (dataItem.HaveNG == true && dataItem.HaveLock == true) {
                $row.children().css({
                    "background-color": "#ab153c",
                    "color": "white",
                });
            }
            else if (dataItem.HaveNG == true && dataItem.HaveLock == false) {
                $row.children().css({
                    "background-color": "#dea452",
                    //"color": "white",
                });
            }
            else if (dataItem.HaveNG == false && dataItem.HaveLock == true) {
                $row.children().css({
                    "background-color": "#8d02f0", // Tim'
                    "color": "#FFFFFF"             // chữ trắng
                });
            }
            //else {
            //    // Giữ lại logic cũ nếu muốn
            //    if (dataItem.State == 1) {
            //        $row.children().eq(5).css("background-color", "#FA5858");
            //    } else if (dataItem.State == 2) {
            //        $row.children().eq(5).css("background-color", "yellow");
            //    }
            //}
        }


    </script>

}

