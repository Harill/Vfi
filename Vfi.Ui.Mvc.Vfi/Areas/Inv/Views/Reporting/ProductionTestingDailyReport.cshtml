                                //.Title("Người làm")
                                .Title(@HttpContext.GetGlobalResourceObject("Resource", "ModifiedUser").ToString());
                            
                            columns.Bound(f => f.ModifiedDate).Width(150)
                                //.Title("Ngày làm")
                                .Title(@HttpContext.GetGlobalResourceObject("Resource", "ModifiedDate").ToString())
                                .Format("{0:dd/MM/yyyy HH:mm}");
                        })
                        .ClientEvents(events => events.OnError("grid_OnError"))
                        .ToHtmlString()))
                .ClientEvents(events => events
                                            .OnDataBinding("grid_OnDataBinding")
                                            .OnDataBound("grid_OnDataBound")
                                            .OnRowDataBound("grid_OnRowDataBound")
                                            .OnError("grid_OnError"))
                .Scrollable(f => f.Height(510))
