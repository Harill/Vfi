                           .HeaderTemplate("<span id='Col2'>0</span>")
                           .HtmlAttributes(new { style = "text-align: right;" });
                    
                    columns.Bound(f => f.Details[2].Number).Width(55)
                           .HeaderTemplate("<span id='Col3'>0</span>")
                           .HtmlAttributes(new { style = "text-align: right;" });
                    
                    columns.Bound(f => f.Details[3].Number).Width(55)
                           .HeaderTemplate("<span id='Col4'>0</span>")
                           .HtmlAttributes(new { style = "text-align: right;" });
                    
                    columns.Bound(f => f.Details[4].Number).Width(55)
                           .HeaderTemplate("<span id='Col5'>0</span>")
                           .HtmlAttributes(new { style = "text-align: right;" });
                    
                    columns.Bound(f => f.Details[5].Number).Width(55)
                           .HeaderTemplate("<span id='Col6'>0</span>")
                           .HtmlAttributes(new { style = "text-align: right;" });
                    
                    columns.Bound(f => f.Details[6].Number).Width(55)
                           .HeaderTemplate("<span id='Col7'>0</span>")
                           .HtmlAttributes(new { style = "text-align: right;" });
                    
                    columns.Bound(f => f.Details[7].Number).Width(55)
                           .HeaderTemplate("<span id='Col8'>0</span>")
                           .HtmlAttributes(new { style = "text-align: right;" });
                    
                    columns.Bound(f => f.Details[8].Number).Width(55)
                        .HeaderTemplate("<span id='Col9'>0</span>")
                           .HtmlAttributes(new { style = "text-align: right;" });
                    
                    columns.Bound(f => f.Details[9].Number).Width(55)
                           .HeaderTemplate("<span id='Col10'>0</span>")
                           .HtmlAttributes(new { style = "text-align: right;" });
                    
                    columns.Bound(f => f.Details[10].Number).Width(55)
                           .HeaderTemplate("<span id='Col11'>0</span>")
                           .HtmlAttributes(new { style = "text-align: right;" });
                    
                    columns.Bound(f => f.Details[11].Number).Width(55)
                           .HeaderTemplate("<span id='Col12'>0</span>")
                           .HtmlAttributes(new { style = "text-align: right;" });
                })

                .DetailView(details => details.ClientTemplate(
                    Html.Telerik().Grid<Vfi.Ui.Mvc.Vfi.Areas.Factory.Models.RealTestingModel>()
                        .Name("gridDetail_<#= ReferenceTestingDetailId #>_<#= FromWarehouseId #>")
                        .DataBinding(dataDindings => dataDindings.Ajax()
                            .Select("SelectProductionTestingDailyDetailReport", "Reporting",
                                new {
                                    productId = "<#= ProductId #>",
                                    machineId = "<#= MachineId #>",
                                    testingDetailId = "<#= ReferenceTestingDetailId #>",
                                    warehouseId = "<#= WarehouseId #>",
                                    fromWarehouseId = "<#= FromWarehouseId #>",
                                    fromDateTimeStr = "<#= FromDateTimeStr #>",
                                    toDateTimeStr = "<#= ToDateTimeStr #>"
                                }))
                        .Columns(columns => {
                            columns.Bound(f => f.TestDate).Width(100)
                                //.Title("Thời gian")
                                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Time").ToString())
                                .Format("{0:HH:mm}");
                    
                            columns.Bound(f => f.TestEmployeeName).Width(150)
                                //.Title("Nhân viên")
                                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Employee").ToString());
                            
                            columns.Bound(f => f.TestNumber).Width(100)
                                //.Title("Số đo")
