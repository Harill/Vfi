@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Sản phẩm tổng hợp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{


    <!-- grid Monthly -->
    <script type="text/javascript">
        var startGrid = false;

        function gridProductInventoryForMonthly_onDataBinding(args) {
            if (startGrid && !onLoading) {
                OnLoadingData();
                var productCodeNameForMonthly = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();


                var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
                if (monthlyDate === null)
                    monthlyDate = "";
                else
                    monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);

                var customerId = $("#CustomerForMonthly").data('tComboBox').value();
                if (customerId === "")
                    customerId = 0;
                var LKSX = $("input[name='chkLuyKeSX']").attr('checked');
                var LKX = $("input[name='chkLuyKeXuat']").attr('checked');
                var DHTK = $("input[name='chkDonHangThangKe']").attr('checked');
                var DHCL = $("input[name='chkDonHangConLai']").attr('checked');

                args.data = $.extend(args.data, {
                    chkLuyKeSX: LKSX,
                    chkLuyKeXuat: LKX,
                    chkDonHangThangKe: DHTK,
                    chkDonHangConLai: DHCL,
                    customerId: customerId,
                    productName: productCodeNameForMonthly,
                    monthlyDate: monthlyDate//$.telerik.formatString('{0:dd/MM/yyyy}', toDate )
                });
            }
        }

        var index = 0;

        function grid_OnDataBound() {
            OnLoadedData();
        }
        
    </script>
    <!-- report -->
    <script type="text/javascript">

        function printProductInvTotal() {
            if (!onLoading) {
                OnLoadingData();
                var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
                if (monthlyDate === null)
                    monthlyDate = "";
                else
                    monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);

                var LKSX = $("input[name='chkLuyKeSX']").attr('checked');
                var LKX = $("input[name='chkLuyKeXuat']").attr('checked');
                var DHTK = $("input[name='chkDonHangThangKe']").attr('checked');
                var DHCL = $("input[name='chkDonHangConLai']").attr('checked');

                var customerId = 0;
                $('#result').load('@Url.Action("PrintProductReportTotal", "Reporting")',
                    {
                        customerId: customerId,
                        chkLuyKeSX: LKSX,
                        chkLuyKeXuat: LKX,
                        chkDonHangThangKe: DHTK,
                        chkDonHangConLai: DHCL,
                        monthlyDate: monthlyDate
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

        function printProductInvTotalWithCustomer() {

            if (!onLoading) {
                OnLoadingData();
                var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
                if (monthlyDate === null)
                    monthlyDate = "";
                else
                    monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);

                var LKSX = $("input[name='chkLuyKeSX']").attr('checked');
                var LKX = $("input[name='chkLuyKeXuat']").attr('checked');
                var DHTK = $("input[name='chkDonHangThangKe']").attr('checked');
                var DHCL = $("input[name='chkDonHangConLai']").attr('checked');

                var productCodeNameForMonthly = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();
                var customerId = $("#CustomerForMonthly").data('tComboBox').value();
                if (customerId === "")
                    customerId = 0;
                $('#result').load('@Url.Action("PrintProductReportTotal", "Reporting")',
                    {
                        productName: productCodeNameForMonthly,
                        customerId: customerId,
                        chkLuyKeSX: LKSX,
                        chkLuyKeXuat: LKX,
                        chkDonHangThangKe: DHTK,
                        chkDonHangConLai: DHCL,
                        monthlyDate: monthlyDate
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

        function printProductInvTotal2() {

            if (!onLoading) {
                OnLoadingData();
                var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
                if (monthlyDate === null)
                    monthlyDate = "";
                else
                    monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);

                var LKSX = $("input[name='chkLuyKeSX']").attr('checked');
                var LKX = $("input[name='chkLuyKeXuat']").attr('checked');
                var DHTK = $("input[name='chkDonHangThangKe']").attr('checked');
                var DHCL = $("input[name='chkDonHangConLai']").attr('checked');

                $('#result').load('@Url.Action("PrintProductReportTotal2", "Reporting")',
                    {
                        chkLuyKeSX: LKSX,
                        chkLuyKeXuat: LKX,
                        chkDonHangThangKe: DHTK,
                        chkDonHangConLai: DHCL,
                        monthlyDate: monthlyDate
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }
        function printProductInvAllTotal() {

            if (!onLoading) {
                OnLoadingData();
                var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
                if (monthlyDate === null)
                    monthlyDate = "";
                else
                    monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);

                var LKSX = $("input[name='chkLuyKeSX']").attr('checked');
                var LKX = $("input[name='chkLuyKeXuat']").attr('checked');
                var DHTK = $("input[name='chkDonHangThangKe']").attr('checked');
                var DHCL = $("input[name='chkDonHangConLai']").attr('checked');

                $('#result').load('@Url.Action("PrintProductReportAllTotal", "Reporting")',
                    {
                        chkLuyKeSX: LKSX,
                        chkLuyKeXuat: LKX,
                        chkDonHangThangKe: DHTK,
                        chkDonHangConLai: DHCL,
                        monthlyDate: monthlyDate
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }
        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }

    </script>
}

<div class="title">
    @*Báo cáo tổng hợp sản phẩm*@
    @HttpContext.GetGlobalResourceObject("Resource", "ProductMonthlyReport")
</div>
<div class="clear"></div>
<br />

<div id="pnlInvMonthly">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">

        <fieldset>
            <legend>
                @*Tiêu chí trích lọc*@
                @HttpContext.GetGlobalResourceObject("Resource", "Filter")
            </legend>

            <div class="grid_7">
                <div class="grid_2">
                    @*@Html.Label("Mã KH")*@
                    @HttpContext.GetGlobalResourceObject("Resource", "CustomerCode2")
                </div>
                <div class="grid_4">
                    @{
                        Html.Telerik().ComboBox()
                            .Name("CustomerForMonthly")
                            .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                            .HtmlAttributes(new { style = "width: 150px" })
                            .DropDownHtmlAttributes(new { style = "width: 275px" })
                            //.ClientEvents(events => events.OnChange("customerForPeriod_onChange"))
                            .AutoFill(true)
                            .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                            .Render();
                    }
                </div>
                <div class="clear"></div><br />
                <div class="grid_2">
                    @*@Html.LabelFor(f => f.ProductCodeName)*@
                    @HttpContext.GetGlobalResourceObject("Resource", "Product")
                </div>
                <div class="grid_4">
                    @{
                        Html.Telerik().AutoComplete()
                            .Name("ProductCodeNameForMonthly")
                            .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                            .DropDownHtmlAttributes(new { style = "width: 250px; " })
                            .Encode(false)
                            .AutoFill(true)
                            .HighlightFirstMatch(true)
                            .Render();
                    }
                </div>
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("MonthlyDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
            <div class="grid_3">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2('gridProductInventoryForMonthly'); ">
                    <span class='t-icon t-insert'></span>
                    @*Làm mới*@
                    @HttpContext.GetGlobalResourceObject("Resource", "Refresh")
                <span class="loadButton"></span>
                </button>
            </div>
            <div class="grid_4">
                <label>
                    <input type="checkbox" id="chkLuyKeSX" name="chkLuyKeSX" checked />
                    Luỹ Kế SX
                    @*@HttpContext.GetGlobalResourceObject("Resource", "")*@
                </label>
                <br />
                <label>
                    <input type="checkbox" id="chkLuyKeXuat" name="chkLuyKeXuat" checked />
                    Luỹ Kế Xuất
                    @*@HttpContext.GetGlobalResourceObject("Resource", "")*@
                </label>
                <br />
                <label>
                    <input type="checkbox" id="chkDonHangThangKe" name="chkDonHangThangKe" checked />
                    Đơn Hàng Tháng Kế
                    @*@HttpContext.GetGlobalResourceObject("Resource", "")*@
                </label>
                <br />
                <label>
                    <input type="checkbox" id="chkDonHangConLai" name="chkDonHangConLai" checked />
                    Đơn Hàng Còn Lại
                    @*@HttpContext.GetGlobalResourceObject("Resource", "")*@
                </label>
            </div>

            <div class="grid_4">

                <button id="btnProductInvTotal" class="t-button" onclick=" return printProductInvTotal(); ">
                    <span class='t-icon t-insert'></span>
                    Báo cáo All (Print)
                    @*@HttpContext.GetGlobalResourceObject("Resource", "")*@
                <span class="loadButton"></span>
                </button>
            </div>
            <div class="grid_5">

                <button id="btnPrintWithCustomer" class="t-button" onclick=" return printProductInvTotalWithCustomer(); ">
                    <span class='t-icon t-insert'></span>
                    Báo cáo theo KH (Print)
                    @*@HttpContext.GetGlobalResourceObject("Resource", "")*@
                <span class="loadButton"></span>
                </button>
            </div>
            <div class="grid_4"  style="visibility:@Model.Print2">
