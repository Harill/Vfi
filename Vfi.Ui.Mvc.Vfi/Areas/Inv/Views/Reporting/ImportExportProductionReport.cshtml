                                      .Title(@HttpContext.GetGlobalResourceObject("Resource", "CreateUser").ToString());
                                  
                                  columns.Bound(f => f.ModifiedDate)
                                      //.Title("Ngày tạo")
                                      .Title(@HttpContext.GetGlobalResourceObject("Resource", "CreateDate").ToString())
                                      .Width(75)
                                      .Format("{0:dd/MM/yyyy HH:mm}");

                              })
                                   .ClientEvents(e => e.OnError("grid_OnError"))
                               .ToHtmlString()))
                .ToHtmlString()
        ))
        .Selectable()
            .Scrollable(f => f.Height(510))
            //.HtmlAttributes(new { style = "width: 950px;" })
            .Resizable(f => f.Columns(true))
            .Reorderable(f => f.Columns(true))
            .Filterable()
            .Sortable()
            .ClientEvents(events => events.OnRowSelect("grid_OnRowSelect")
                                        .OnDataBinding("grid_OnDataBinding")
                                        .OnDataBound("grid_OnDataBound")
                                        .OnError("grid_OnError"))
            .Groupable()
            .Render();
    }
</div>

