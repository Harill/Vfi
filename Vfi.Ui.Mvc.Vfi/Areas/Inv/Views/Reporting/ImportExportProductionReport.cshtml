@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Báo cáo thành phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{


    <!-- grid Monthly -->
    <script type="text/javascript">


        function grid_OnDataBinding(args) {

            if (startGrid && !onLoading) {
                OnLoadingData();
                var productCode = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();

                var customerId = $("#CustomerForMonthly").data('tComboBox').value();
                if (customerId === "")
                    customerId = 0;

                var type = $("#ReportType").data("tDropDownList").value();
                if (type === null)
                    type = 2;

                var fromDate = $("#FromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#ToDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

                args.data = $.extend(args.data, {
                    type: type,
                    customerId: customerId,
                    productName: productCode,
                    fromDate: fromDate,
                    toDate: toDate
                });
            }
            index = 0;
        }

        var index = 0;

    </script>
    <!-- report -->
    <script type="text/javascript">
        function printImportExportProduction() {

            if (!onLoading) {
                OnLoadingData();
                var type = $("#ReportType").data("tDropDownList").value();
                if (type === null)
                    type = 2;
                var fromDate = $("#FromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#ToDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

                var productCode = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();

                var customerId = $("#CustomerForMonthly").data('tComboBox').value();
                if (customerId === "")
                    customerId = 0;

                $('#result').load('@Url.Action("PrintFinishedProductionReport", "Reporting")',
                    {
                        productCode: productCode,
                        customerId: customerId,
                        type: type,
                        fromDate: fromDate,
                        toDate: toDate
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

        function reportType_onLoad() {
            var combobox = $('#ReportType').data('tDropDownList');
            var dataSource =
            [
                { Text: "Tất cả", Value: "1" },
                { Text: "Diễn biến", Value: "2" }
            ];

            combobox.dataBind(dataSource);
            combobox.select(1);
        }

        function month_onLoad() {
            var combobox = $('#Month').data('tDropDownList');
            var dataSource =
            [
                { Text: "1", Value: "1" },
                { Text: "2", Value: "2" },
                { Text: "3", Value: "3" },
                { Text: "4", Value: "4" },
                { Text: "5", Value: "5" },
                { Text: "6", Value: "6" },
                { Text: "7", Value: "7" },
                { Text: "8", Value: "8" },
                { Text: "9", Value: "9" },
                { Text: "10", Value: "10" },
                { Text: "11", Value: "11" },
                { Text: "12", Value: "12" }
            ];

            combobox.dataBind(dataSource);
            combobox.value(new Date().getMonth() + 1);
        }


        var startGrid = false;
        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }

        function grid_OnDataBound() {
            OnLoadedData();
        }

    </script>
}

<div class="title">
    @*Báo cáo xuất nhập tồn thành phẩm*@
    @HttpContext.GetGlobalResourceObject("Resource", "ImportExportProductionReport")
</div>
<div class="clear"></div>
<br />

<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">

    <div class="clear"></div>
    <fieldset>
        <legend>
            @*Tiêu chí trích lọc*@
            @HttpContext.GetGlobalResourceObject("Resource", "Filter")
        </legend>
        <div class="grid_3">
            @{
                Html.Telerik().DropDownList()
                    .Name("ReportType")
                    .HtmlAttributes(new { style = "width: 100%" })
                    .DropDownHtmlAttributes(new { style = "width: 100px" })
                    //.Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                    // .HighlightFirstMatch(true)
                    //.AutoFill(true)
                    .ClientEvents(events => events.OnLoad("reportType_onLoad"))
                    .Render();
            }
        </div>
        <div class="grid_2">
            @*@Html.Label("Mã  KH")*@
            @HttpContext.GetGlobalResourceObject("Resource", "CustomerCode2")
        </div>

        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("CustomerForMonthly")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 275px" })
                    //.ClientEvents(events => events.OnChange("customerForPeriod_onChange"))
                    .AutoFill(true)
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .Render();
            }
        </div>
        <div class="grid_2">
            @*@Html.LabelFor(f => f.ProductCodeName)*@
            @HttpContext.GetGlobalResourceObject("Resource", "ProductCode")
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().AutoComplete()
                    .Name("ProductCodeNameForMonthly")
                    .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                    .DropDownHtmlAttributes(new { style = "width: 200px; " })
                    .Encode(false)
                    .AutoFill(true)
                    .HighlightFirstMatch(true)
                    .Render();
            }
        </div>

        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("FromDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Now)
                    .Render();
            }
            @{
                Html.Telerik().DatePicker()
                    .Name("ToDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Now)
                    .Render();
            }
        </div>
        <div class="grid_3">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2('gridProductionMonthly'); ">
                <span class='t-icon t-insert'></span>
                @*Làm mới*@
                @HttpContext.GetGlobalResourceObject("Resource", "Refresh")
		<span class="loadButton"></span>
            </button>
        </div>
        <div class="grid_4">

            <button id="btnImportExportProduction" class="t-button" onclick=" return printImportExportProduction(); ">
                <span class='t-icon t-insert'></span>
                @*Xuất báo cáo*@
                @HttpContext.GetGlobalResourceObject("Resource", "PrintReport")
		<span class="loadButton"></span>
            </button>
        </div>
    </fieldset>
</div>
