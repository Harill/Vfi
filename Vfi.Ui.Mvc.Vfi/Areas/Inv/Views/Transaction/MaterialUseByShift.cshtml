<div class="clear"></div>
<div class="cover-div">
        @{
            Html.Telerik().Grid<MaterialUseInShiftDetailModel>()
                .Name("gridMaterialUse")
                .DataKeys(keys => keys.Add(f => f.DetailId).RouteKey("detailId"))
                .ToolBar(bar =>
                    {
                        //bar.Insert().ButtonType(GridButtonType.ImageAndText).Text("Thêm dòng mới");
                        bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
                            .SaveText(@HttpContext.GetGlobalResourceObject("Resource", "SaveAll").ToString())
                            .CancelText(@HttpContext.GetGlobalResourceObject("Resource", "CancelAll").ToString());

                    })
                .DataBinding(dataBindings => dataBindings.Ajax()
                                                         .Select("SelectMaterialInvOnMachineToUse", "Transaction", new { onDate = "", ca1Name = "", ca2Name = "" })
                                                         .Update("UpdateMaterialUse", "Transaction")
                )
                .Columns(columns =>
                    {
                        columns.Bound(f => f.MachineName).Width(100)
                            //.Title("Máy")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Machine").ToString())
                            .ReadOnly(true);
                        
                        columns.Bound(f => f.ProductCode).Width(150)
                            //.Title("SP đang chạy")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Product2").ToString()
                                + " "
                                + @HttpContext.GetGlobalResourceObject("Resource", "Producting").ToString()
                            )
                            .ReadOnly(true);
                        
                        columns.Bound(f => f.MaterialCode).Width(200)
                            //.Title("Mã NL")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "MaterialCode2").ToString())
                            .ReadOnly(true);
                        
                        columns.Bound(f => f.EditQuantity).Width(65)
                            //.Title("NL tối đa")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Material2").ToString()
                                + " "
                                + @HttpContext.GetGlobalResourceObject("Resource", "Max").ToString()
                            )
                            .ReadOnly(true)
                            .HtmlAttributes(new { style = "text-align:center;border-left: 1px black solid;" });
                        
                        //columns.Bound(f => f.Length).Width(40).Title("Dài").ReadOnly(true);
                        
                        //columns.Bound(f => f.LotNumber).Width(40).Title("Lô").ReadOnly(true); 
                        
                        columns.Bound(f => f.AssignQuantity).Width(65)
                            //.Title("Phát")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Assign").ToString())
                            .ReadOnly(true)
                            .Format("{0:n2}")
                            .HtmlAttributes(new { style = "text-align: right;" })
                            .Aggregate(agg => agg.Sum())
                            .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                            .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                            .FooterHtmlAttributes(new { style = "text-align: right;" });
                        
                        columns.Bound(f => f.EditQuantity2).Width(65)
                            //.Title("Tồn NL")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "MaterialInv2").ToString()
                            )
                            .ReadOnly(true)
                            .Format("{0:n2}")
                            .HtmlAttributes(new { style = "text-align: right;border-left: 1px black solid;" });
                        
                        columns.Bound(f => f.WaitingNumber).Width(65)
                            //.Title("Chờ duyệt")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "ApproveWaiting").ToString())
                            .ReadOnly(true)
                            .Format("{0:n2}")
                            .HtmlAttributes(new { style = "text-align: right;" });
                        
                        columns.Bound(f => f.EarlyQuantity).Width(65)
                            //.Title("Tồn TT")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Inv").ToString()
                                + " "
                                + @HttpContext.GetGlobalResourceObject("Resource", "Actual").ToString()
                            )
                            .ReadOnly(true)
                            .Format("{0:n2}")
                            .HtmlAttributes(new { style = "text-align: right;border-left: 1px black solid;" });
                        
                        columns.Bound(f => f.Quantity).Width(65)
                            //.Title("Ca 1")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Shift1").ToString())
                            .HeaderHtmlAttributes(new { @class = "edit-column" })
                            .HtmlAttributes(new { style = "text-align: right;border-left: 1px black solid;" })
                            .FooterHtmlAttributes(new { style = "text-align: right;" })
                            .ClientTemplate("<span name='Quantity'><#= Quantity == null ? 0.0 : $.telerik.formatString('{0:n2}', Quantity) #></span>")
                            .FooterTemplate("<span id='TotalQuantity'></span>");
                        
                        columns.Bound(f => f.Quantity2).Width(65)
                            //.Title("Ca 2")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Shift2").ToString())
                            .HeaderHtmlAttributes(new { @class = "edit-column" })
                            .HtmlAttributes(new { style = "text-align: right;" })
                            .FooterHtmlAttributes(new { style = "text-align: right;" })
                            .ClientTemplate("<span name='Quantity2'><#= Quantity2 == null ? 0.0 : $.telerik.formatString('{0:n2}', Quantity2) #></span>")
                            .FooterTemplate("<span id='TotalQuantity2'></span>");
                        
                        columns.Bound(f => f.LastQuantity).Width(65)
                            //.Title("Tồn cuối")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "LastQuantity").ToString())
                            .ReadOnly(true)
                            .HtmlAttributes(new { style = "text-align: right;border-left: 1px black solid;" })
                            .ClientTemplate("<span class='LastQuantity'></span>");
                       
                        columns.Bound(f => f.Note)
                            //.Title("Ghi chú")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Note").ToString());
                        
                        //columns.Command(commands => commands.Delete().ButtonType(GridButtonType.Image)).Width(30);
                    })
                .ClientEvents(events => events
                                            .OnDataBinding("grid_onDataBinding")
                                            .OnEdit("grid_onEdit")
                                            .OnSave("grid_onSave")
                                            .OnSubmitChanges("grid_onSubmitChanges")
                                            .OnError("grid_OnError")
                                            .OnDataBound("OnLoadedData")
                )
                .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
                .KeyboardNavigation(keys => keys.EditOnTab(true))
                .Resizable(resizing => resizing.Columns(true))
                .Scrollable(f => f.Height(510))
                // .Footer(false)
                .Render();
        }
    </div>
<div class="clear"></div><br/>