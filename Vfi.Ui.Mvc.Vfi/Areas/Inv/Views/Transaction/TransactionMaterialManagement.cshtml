@using Vfi.Server.Core.DataModel.Models.Inv
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@{
    ViewBag.Title = "QL phiếu Nguyên Liệu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">
        function transactionStatus_onChange() {
            RefreshGrid("gridTransaction");
        }


        function gridTransaction_onDataBinding(args) {
            var statusValue = $("#transactionStatus").data("tComboBox").value();

            if (statusValue === "")
                statusValue = 0;

            var fromDate = $("#fromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#toDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
            }
            args.data = $.extend({}, args.data, {
                status: statusValue,
                transactionCode: "",
                mop: true,
                fromDate: fromDate,
                toDate: toDate
            });

            var indexSignature1 = 0;
            var countSignature1 = 0;
        }

        function grid_OnRowDataBound(e) {
            var dataItem = e.dataItem;
            if (e.dataItem.EoI !== "0") {
                e.row.getElementsByClassName("t-button printcard")[0].parentNode.innerHTML = "";
                var node = document.getElementsByClassName("t-button purchasing")[indexSignature1 - countSignature1];
                if (dataItem.PurchasingSignatureType == 0) {
                    if (node) node.parentNode.innerHTML = "<span class='t-icon t-cancel'></span>";
                    countSignature1++;
                    count1++;
                } else if (dataItem.PurchasingSignatureType == 1) {
                    if (node) node.parentNode.innerHTML = "<span class='t-icon t-insert'></span>";
                    countSignature1++;
                } else if (dataItem.PurchasingSignatureType == 2) {
                } else {
                    if (node) node.parentNode.innerHTML = "";
                    countSignature1++;
                }
            }

            if (!e.dataItem.CanApprove) {
                e.row.getElementsByClassName("t-button rollback_" + e.dataItem.TransactionId)[0].parentNode.innerHTML = "";
            }
        }

        var indexSignature1 = 0;
        var countSignature1 = 0;

        var index1 = 0;
        var count1 = 0;
        function gridDetail_OnRowDataBound(e) {
            //if (e.dataItem.StatusName === "Đang giao")
            //    e.row.style.backgroundColor = "#F4FA58";

            //var today = new Date();
            //var check = e.dataItem.DueDate < today;
            //if (check)
            //    e.row.style.backgroundColor = "#FA5858";
            if (!e.dataItem.IsApprove)
                e.row.getElementsByClassName("t-button t-grid-edit t-button-icon")[0].parentNode.innerHTML = "";
        }
    </script>

    <script type="text/javascript">
        function printTransaction(transactionId) {
            alert(transactionId);
        }
        function PrintForm(val) {
            alert(val);
            $('#result').load('@Url.Action("PrintTransactionMaterial", "Inv")',
            {
                transactionId: val
            }, function () {
                var window = $('#windowReport').data('tWindow');
                window.open();
            });
        return false;
    }
    function PrintCard(val) {
        alert(val);
        $('#result').load('@Url.Action("PrintTransactionMaterialCard", "Inv")',
            {
                transactionId: val
            }, function () {
                var window = $('#windowReport').data('tWindow');
                window.open();
            });
        return false;
    }

    function Signature(transactionId) {
        $.ajax({
            type: 'post',
            data: { transactionId: transactionId },
            dataType: 'json',
            url: '@Url.Action("ImportMaterialSignature", "Transaction", new { area = "Inv" })',
            timeout: 20000,
            success: function (data) {
                if (data == 9)
                    alert("Lỗi không tìm thấy phiếu !");
                else {
                    alert("Thêm chữ ký thành công !");
                    RefreshGrid("gridTransaction");
                    indexSignature1 = 0;
                    countSignature1 = 0;
                    index1 = 0;
                    count1 = 0;
                }
            }
        });
        return false;
    }

        function RollbackTransaction(id) {
            var message = "Phục hồi lệnh trở về chưa duyệt";
            message += "\nĐồng ý ??";
            if (confirm(message)) {
                $.ajax({
                    type: 'post',
                    data: { transactionId: id },
                    dataType: 'json',
                    url: '@Url.Action("CreateRollbackTransactionMaterial", "Transaction", new { area = "Inv" })',
                    timeout: 20000,
                    success: function (res) {
                        if (res.Code === 1) {
                            alert("Đã lưu " + res.Data);
                            if (res.Message && res.Message != "") {
                                alert(res.Message);
                            }
                            RefreshGrid("gridTransaction");
                        } else {
                            alert("Lỗi! " + res.Message);
                        }
                    }
                });
            } else { }
        }
        // Loading button
        var startGrid = false;
        function RefreshGrid2(name) {
            if (!onLoading) {
                OnLoadingData();
                startGrid = true;
                RefreshGrid('gridTransaction');
            }
        }

        var onLoading = false;
        function OnLoadingData() {
            if (!onLoading) {
                onLoading = true;
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (Chờ load)";
                    loading.classList.add('loading');
                }
            }
        }
        function OnLoadedData() {
            if (onLoading) {
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    if (loading && loading.className.includes("loading")) {
                        loading.classList.remove('loading');
                        loading.innerHTML = "<span></span>";
                    }
                }
                onLoading = false;
            }
        }

    </script>

}
<div class="title">Quản lý hồ sơ thông tin lệnh về nguyên liệu</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">
    <fieldset>
        <legend>Tiêu chí trích lọc</legend>

        <div class="grid_2">
            Tình trạng giao dịch
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("transactionStatus")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxTransactionStatus", "Transaction"))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .HighlightFirstMatch(true)
                    .AutoFill(true)
                    .ClientEvents(events => events.OnChange("transactionStatus_onChange"))
                    .Render();
            }
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("fromDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today.Month + "/01/" + DateTime.Today.Year)
                    .Render();
            }
        </div>
        <div class="grid_2">
            @{
                Html.Telerik().DatePicker()
                    .Name("toDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today)
                    .Render();
            }
        </div>
        <div class="grid_4 prefix_1">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2('gridTransaction'); ">
                <span class='t-icon t-insert'></span>
                Làm mới
                <span class="twoToneButton"></span>
            </button>
        </div>
    </fieldset>
</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<TransactionModel>()
            .Name("gridTransaction")
            .DataKeys(keys => keys.Add(f => f.TransactionId).RouteKey("transactionId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("SelectTransactionReviewByStatus", "Transaction", new {
                                                         status = (byte)MyUtilities.Transaction.Status.Open,
                                                         warehouseId = 0,
                                                         mop = true,
                                                         fromDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).ToString("dd/MM/yyyy"),
                                                         toDate = DateTime.Now.ToString("dd/MM/yyyy")
                                                     })
            )
            .Columns(columns => {
                columns.Bound(f => f.TransactionCode).Width(100);
                columns.Bound(f => f.CreatedDate).Width(90)
                       .Format("{0:dd/MM/yyyy}");
                columns.Bound(f => f.EoIName).Width(100);
                columns.Bound(f => f.TotalQuality).Width(100)
                       .HeaderTemplate("Tổng SL</br>(cây)")
                       .Format("{0:n2}")
                       .HtmlAttributes(new { style = "text-align: right;" });
                //columns.Bound(f => f.TotalQualityKg).Width(100)
                //       .HeaderTemplate("Tổng SL</br>(Kg)")
                //       .Format("{0:n2}")
                //       .HtmlAttributes(new { style = "text-align: right;" });
                columns.Bound(f => f.StatusName).Width(75);
                columns.Bound(f => f.SpecialNote).Title("Ghi chú");
                columns.Bound(f => f.ModifiedUser).Width(75).Title("Người làm");
                columns.Bound(f => f.ModifiedDate).Width(90).Title("Ngày làm")
                       .Format("{0:dd/MM/yyyy HH:mm}");
                columns.Bound(f => f.TransactionId).Title("In").Width(50)
                       .ClientTemplate("<input type='button' id='id_<#= TransactionId #>' value='In' class='t-button' onclick=PrintForm(<#= TransactionId #>) />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.TransactionId).Title("Card").Width(50)
                       .ClientTemplate("<input type='button' id='id_<#= TransactionId #>' value='In' class='t-button printcard' onclick=PrintCard(<#= TransactionId #>) />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.TransactionId).Title("QL mua").Width(50)
                       .ClientTemplate("<button class='t-button purchasing' id='QLM_<#= TransactionId #>' onclick=Signature(<#= TransactionId #>) ><span class='t-icon t-insert'></span></button>")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.TransactionId).Title("").Width(50).ReadOnly(true)
                       .ClientTemplate("<input type='button' id='rollback_<#= TransactionId #>' value='Rollback' class='t-button rollback_<#= TransactionId #>' onclick='RollbackTransaction(<#= TransactionId #>)' />")
                       .HtmlAttributes(new { style = "text-align:center" });
            })
            .DetailView(details => details.ClientTemplate(
                Html.Telerik().TabStrip()
                    .Name("TabStrip_<#= TransactionId #>")
                    .SelectedIndex(0)
                    .Items(items =>
                           items.Add().Text("Thông tin chi tiết").Content(
                               Html.Telerik().Grid<TransactionDetailModel>()
                                   .Name("gridTransactionDetail_<#= TransactionId #>")
            .DataKeys(keys => keys.Add(f => f.TransactionDetailId).RouteKey("transactionDetailId"))
                                   .DataBinding(dataDindings => dataDindings.Ajax()
                                                                            .Select("SelectTransactionDetailByTransactionId", "Transaction",
                                                                                    new { transactionId = "<#= TransactionId #>" })
                                                                                    .Update("UpdateTransactionMaterialDetail", "Transaction")
                                                                                    )
                                   .Columns(columns => {
                                       columns.Command(c => c.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(50).Title("")
                                           .HtmlAttributes(new { style = "text-align:center" });
                                       columns.Bound(f => f.MaterialTypeName).Title("Loại NL").Width(80).ReadOnly(true)
                                                  .HtmlAttributes(new { style = "text-align: center;" });
                                       columns.Bound(f => f.MaterialName).Title("Tên NL").Width(75).ReadOnly(true)
                                              .FooterHtmlAttributes(new { style = "text-align: right;" })
                                              .Aggregate(agg => agg.Count())
                                              .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>");
                                       columns.Bound(f => f.DesignCode).Title("Quy cách").Width(150).ReadOnly(true);
                                       columns.Bound(f => f.Length).Width(75)
                                              .HeaderTemplate("Dài</br>(mm)");
                                       columns.Bound(f => f.VendorName).Title("NCC").Width(100).ReadOnly(true)
                                              .HtmlAttributes(new { style = "text-align: center;" });
                                       columns.Bound(f => f.UnitWeight).Width(70)
                                              .HeaderTemplate("TL</br>(kg/cây)")
                                              .HtmlAttributes(new { style = "text-align: right;" })
                                              .ClientTemplate("<#= UnitWeight == null ? 0 : $.telerik.formatString('{0:n3}', UnitWeight) #>");
                                       columns.Bound(f => f.LotNumber).Width(100)
                                              .HtmlAttributes(new { style = "text-align: center;" });
                                       columns.Bound(f => f.Quantity).Width(100)
                                              .HeaderTemplate("SL chuyển</br>(cây)")
                                              .HtmlAttributes(new { style = "text-align: right;" })
                                              .Format("{0:n2}");
                                       columns.Bound(f => f.QuantityKg).Width(100).ReadOnly(true)
                                              .HeaderTemplate("SL chuyển</br>(Kg)")
                                              .HtmlAttributes(new { style = "text-align: right;" })
                                              .Format("{0:n2}");
                                       columns.Bound(f => f.Note);
                                   })
                                       .ClientEvents(events => events
                                           .OnError("grid_OnError"))
                                   .ToHtmlString()

                               )
                    )
                    .ToHtmlString()
                                       ))
            .Selectable()
            .ClientEvents(events => events.OnError("grid_OnError")
                .OnRowSelect("grid_OnRowSelect")
                .OnRowDataBound("grid_OnRowDataBound")
                .OnDataBinding("gridTransaction_onDataBinding")
                .OnDataBound("OnLoadedData"))
            .Filterable()
                .Scrollable(f => f.Height(510))
            .Render();
    }
</div>

@{
    Html.Telerik().Window()
        .Name("windowReport")
        .Modal(true)
        .Draggable(true)
        .Content
        (
    @<text>
    <div id="result"></div>
    </text>
)
        //.ClientEvents(e => e.OnLoad("Window_onLoad"));
        .ClientEvents(e => e.OnOpen("window_onopen"))
        .Visible(false)
        .Width(960)
        .Render();
}
<script>
    function window_onopen(e) {
        //alert("b");
        $("#rptvPageImportMaterial_ReportToolbar_ExportGr_FormatList_DropDownList option[value='XLS']").remove();
        $("#rptvPageImportMaterial_ReportToolbar_ExportGr_FormatList_DropDownList option[value='RTF']").remove();
        $("#rptvPageImportMaterial_ReportToolbar_ExportGr_FormatList_DropDownList option[value='MHTML']").remove();
    }
</script>

