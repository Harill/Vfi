<div class="clear"></div>

<div class="t-info-sha" style="padding-left: 15px; width: 250px; color: Maroon;">
    @*Chi tiết lệnh xuất nhập sản phẩm*@
    @HttpContext.GetGlobalResourceObject("Resource", "OrderDetail")
</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<ProductInventoryRotateModel>()
            .Name("gridTransactionDetail")
            .ToolBar(bar => {
                    bar.Custom().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Text)
                            .Text(@HttpContext.GetGlobalResourceObject("Resource", "SaveText").ToString()).Name("A")
                       .HtmlAttributes(new { onclick = "SaveWeighingData()", href = "#" });
                    //bar.SubmitChanges().ButtonType(GridButtonType.ImageAndText).SaveText("Lưu thay đổi").CancelText("Huỷ tất cả");
                })
            //.ToolBar(bar => bar.SubmitChanges().ButtonType(GridButtonType.ImageAndText).SaveText("Lưu lại").CancelText("Huỷ bỏ"))
            .DataKeys(keys => keys.Add(f => f.TransactionProductId).RouteKey("transactionProductId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("AddTransactionWeighingProduct", "Transaction", new { productId = 0, warehouseId = 0, productWeight = 0, quantity = 0 })
                .Delete("DeleteTransactionWeighingProduct", "Transaction")
                )
            .Columns(columns => {
                columns.Bound(f => f.ProductId).Width(30).ReadOnly(true)
                    .ClientTemplate("<#= ++index #>")
                    //.HeaderTemplate("<strong>STT</strong>")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Index").ToString());
             
                columns.Bound(f => f.CustomerCode).Width(70)
                    //.HeaderTemplate("Khách hàng")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Customer").ToString())
                    .ReadOnly(true);
                
                columns.Bound(f => f.ProductCode).Width(120)
                    //.Title("Mã SP")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductCode2").ToString())
                    .ReadOnly(true);
                
                columns.Bound(f => f.ProductWeight).Width(70).ReadOnly(true)
                    //.HeaderTemplate("TL SP (g/pc)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductWeight").ToString()
                        + " (g/pc)" 
                    )
                    .Format("{0:n3}")
                    .HtmlAttributes(new { style = "text-align: right;border-right: 1px black solid;" });
                
                columns.Bound(f => f.QuantityKg).Width(90)
                    //.HeaderTemplate("Trọng lượng (kg)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "UnitWeight").ToString()
                        + " (kg)"
                    )
                    .Format("{0:n2}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                
                columns.Bound(f => f.Quantity).Width(90)
                    //.HeaderTemplate("Số lượng (pcs)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Quantity").ToString()
                        + " (pcs)"
                    )
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                
                columns.Command(commands => commands.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image).Text("")).Width(50).Title("");
            })
            .ClientEvents(events => events
                .OnDataBinding("grid_OnDataBinding")
                .OnDataBound("grid_OnDataBound")
                .OnError("grid_OnError")
            )
            .KeyboardNavigation()
            .Groupable(group => group.Groups(g => g.Add(model => model.ProductCode)))
            .Render();   
    }
</div>

<div class="clear"></div><br />