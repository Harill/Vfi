        @*<div class="grid_2_5">
            Số lượng (test)
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().NumericTextBox()
                    .Name("Quantity")
                    .MinValue(0)
                    .DecimalDigits(0)
                    .Value(0)
                    .Spinners(false)
                    .InputHtmlAttributes(new { style = "text-align:right; width:100%;" })
                    .ClientEvents(events => { events.OnChange("quantity_OnChange"); })
                    .Render();
            }
        </div>*@
