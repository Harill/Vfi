@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ImportSX1Model
@{
    ViewBag.Title = "Phiếu Nhập Kho SX 1";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script type="text/javascript">
    $(function () {
        $("#pnlAdd").hide();
        // panel effect
        $("input[name='rdoType'][value='rdoNormal']").attr('checked', 'checked');

        $("input[name='rdoType']").change(function () {

            if ($("input[name='rdoType']:checked").val() === 'rdoNormal') {

                runEffectHide("#pnlExcel", "drop");
                runEffectHide("#pnlAdd", "drop");

                setTimeout(function () {
                    runEffectShow("#pnlNormal", "drop");
                }, 1200);
            }
            else if ($("input[name='rdoType']:checked").val() === 'rdoAdd') {

                runEffectHide("#pnlExcel", "drop");
                runEffectHide("#pnlNormal", "drop");

                setTimeout(function () {
                    runEffectShow("#pnlAdd", "drop");
                }, 1200);
            }
        });
    });

</script>
<script type="text/javascript">

    function gridSmart_OnDataBinding(args) {
        var useId = $('#MaterialUseForm').data('tComboBox').value();
        if (useId === "")
            useId = 0;
        var shift = $('#Shift').data('tDropDownList').value();
        if (shift === "")
            shift = 0;
        args.data = $.extend(args.data,
        {
            useId: useId,
            shift: shift
        });
    }

    function cbo_OnDataBinding(args) {
        var materialUseDate = $("#MaterialUseDate").data("tDatePicker").value();
        if (materialUseDate === null)
            materialUseDate = "";
        else
            materialUseDate = $.telerik.formatString('{0:dd/MM/yyyy}', materialUseDate);
        args.data = $.extend(args.data,
        {
            date: materialUseDate
        });
    }

    function gridSmart_OnSave(e) {
        var dataItem = e.dataItem;
        var $productCode = $(e.cell).find('#ProductCode');
        if ($productCode.length > 0) {
            var productCode = $productCode.data("tComboBox"),
                productCodeSelectItem = productCode.selectedIndex > -1
                    ? productCode.data[productCode.selectedIndex]
                    : null;

            if (productCodeSelectItem) {
                e.values["ProductCode"] = productCodeSelectItem.Text;
                e.values["ProductId"] = productCodeSelectItem.Value;
                $.ajax({
                    type: 'post',
                    data: { productId: productCodeSelectItem.Value, machineId: e.dataItem.MachineId, materialInvId: e.dataItem.MaterialInventoryId },
                    dataType: 'json',
                    url: '@Url.Action("GetProductionWeight", "Transaction", new { area = "Inv" })',
                    timeout: 20000,
                    success: function (data) {
                        if (data === '9') {
                            alert("Lỗi! Không tìm thấy sản phẩm");
                        } else {
                            dataItem.ProductWeight = data[0];
                            e.cell.parentNode.getElementsByClassName("ProductWeight")[0].textContent = data[0];
                            dataItem.ProcessByMachineId = data[1];
                            dataItem.WarehouseExportId = data[2];
                            e.cell.parentNode.getElementsByClassName("WarehouseExportId")[0].textContent = data[2];
                            e.cell.parentNode.getElementsByClassName("WarehouseExportName")[0].textContent = data[3];
                            dataItem.ProductionRate = data[4];
                            e.cell.parentNode.getElementsByClassName("ProductionRate")[0].textContent = data[4];
                        }
                    }
                });
            } else {
                var weight = dataItem.ProductWeight;
                var number = $(e.cell).find('#ProductWeight').val();
                if (!isNaN(parseFloat(number))) {
                    weight = parseFloat(number);
                } else {
                    if (e.cell.parentNode.getElementsByClassName("ProductWeight")[0] != null)
                        weight = parseFloat(e.cell.parentNode.getElementsByClassName("ProductWeight")[0].textContent);
                    if (weight == 0)
                        return;
                    dataItem.ProductWeight = weight;
                }

                var rate = dataItem.ProductionRate;
                if (e.cell.parentNode.getElementsByClassName("ProductionRate")[0] != null)
                    rate = parseFloat(e.cell.parentNode.getElementsByClassName("ProductionRate")[0].textContent);
                dataItem.ProductionRate = rate;
            }
        }
    }

    function gridSmart_OnSubmitChanges(e) {
        var importDate = $("#ImportDate").data("tDatePicker").value();
        if (importDate === null)
            importDate = "";
        else
            importDate = $.telerik.formatString('{0:dd/MM/yyyy}', importDate);
        var useId = $('#MaterialUseForm').data('tComboBox').value();
        if (useId === "")
            useId = 0;
        var ca = $("#ShiftName").data("tAutoComplete").value();
        var message = "Ngày báo cáo: " + importDate;
        message += "\nCa: " + ca;
        message += "\nĐồng ý lưu ??";
        if (confirm(message)) {
            // Save it!
            e.values = $.extend(e.values,
                {
                    importDate: importDate,
                    useId: useId
                }
            );
        } else {
            e.preventDefault();
        }
    }

    function Shift_Onload() {
        var combobox1 = $('#Shift').data('tDropDownList');
        var dataSource =
        [
            { Text: "1", Value: "1" },
            { Text: "2", Value: "2" }
        ];

        combobox1.dataBind(dataSource);
    }
    function Shift2_Onload() {
        var combobox1 = $('#Shift2').data('tDropDownList');
        var dataSource =
        [
            { Text: "1", Value: "1" },
            { Text: "2", Value: "2" }
        ];

        combobox1.dataBind(dataSource);
    }
    function getSmartList() {
        var useId = $('#MaterialUseForm').data('tComboBox').value();
        if (useId === "")
            useId = 0;
        var shift = $('#Shift').data('tDropDownList').value();
        if (shift === "")
            shift = 0;
        RefreshGrid("gridSmartProduction");
        $.ajax({
            type: 'post',
            data: { useId: useId, shift: shift },
            dataType: 'json',
            url: '@Url.Action("GetShiftNameType", "Transaction")',
            timeout: 20000,
            success: function (data) {
                //if (data != "")
                $("#ShiftName").data("tAutoComplete").value(data);
            }
        });
    }
</script>
<script type="text/javascript">

    function gridAdd_OnSave(e) {
        var dataItem = e.dataItem;
        var $productCode = $(e.cell).find('#ProductCode');
        if ($productCode.length > 0) {
            var productCode = $productCode.data("tComboBox"),
                productCodeSelectItem = productCode.selectedIndex > -1 ? productCode.data[productCode.selectedIndex] : null;

            if (productCodeSelectItem) {
                e.values["ProductCode"] = productCodeSelectItem.Text;
                e.values["ProductId"] = productCodeSelectItem.Value;
                $.ajax({
                    type: 'post',
                    data: { productId: productCodeSelectItem.Value, machineId: e.dataItem.MachineId, materialInvId: e.dataItem.MaterialInventoryId },
                    dataType: 'json',
                    url: '@Url.Action("GetProductionWeight", "Transaction", new { area = "Inv" })',
                    timeout: 20000,
                    success: function (data) {
                        if (data === '9') {
                            alert("Lỗi! Không tìm thấy sản phẩm");
                        } else {
                            dataItem.ProductWeight = data[0];
                            e.cell.parentNode.getElementsByClassName("ProductWeight")[0].textContent = data[0];
                            dataItem.ProcessByMachineId = data[1];
                            dataItem.WarehouseExportId = data[2];
                            e.cell.parentNode.getElementsByClassName("WarehouseExportId")[0].textContent = data[2];
                            e.cell.parentNode.getElementsByClassName("WarehouseExportName")[0].textContent = data[3];
                            dataItem.ProductionRate = data[4];
                            e.cell.parentNode.getElementsByClassName("ProductionRate")[0].textContent = data[4];
                        }
                    }
                });
            }
        }
        var $machineName = $(e.cell).find('#MachineName');
        if ($machineName.length > 0) {
            var machineName = $machineName.data("tComboBox"),
                machineNameSelectItem = machineName.selectedIndex > -1 ? machineName.data[machineName.selectedIndex] : null;

            if (machineNameSelectItem) {
                e.values["MachineName"] = machineNameSelectItem.Text;
                e.values["MachineId"] = machineNameSelectItem.Value;
                if (dataItem.ProductId > 0 && dataItem.MaterialInventoryId > 0)
                    $.ajax({
                        type: 'post',
                        data: {
                            productId: dataItem.ProductId,
                            machineId: machineNameSelectItem.Value,
                            materialInvId: dataItem.MaterialInventoryId
                        },
                        dataType: 'json',
                        url: '@Url.Action("GetProductionWeight", "Transaction", new { area = "Inv" })',
                        timeout: 20000,
                        success: function (data) {
                            if (data === '9') {
                                alert("Lỗi! Không tìm thấy sản phẩm");
                                //} else if (data == '0') {
                                //    alert("Lỗi!");
                            } else {
                                dataItem.ProductWeight = data[0];
                                e.cell.parentNode.getElementsByClassName("ProductWeight")[0].textContent = data[0];
                                dataItem.ProcessByMachineId = data[1];
                                dataItem.WarehouseExportId = data[2];
                                e.cell.parentNode.getElementsByClassName("WarehouseExportId")[0].textContent = data[2];
                                e.cell.parentNode.getElementsByClassName("WarehouseExportName")[0].textContent = data[3];
                                dataItem.ProductionRate = data[4];
                                e.cell.parentNode.getElementsByClassName("ProductionRate")[0].textContent = data[4];

                            }
                        }
                    });
            }
        }
        var $materialCode = $(e.cell).find('#MaterialInventoryCode');
        if ($materialCode.length > 0) {
            var materialCode = $materialCode.data("tComboBox"),
                materialCodeSelectItem = materialCode.selectedIndex > -1 ? materialCode.data[materialCode.selectedIndex] : null;

            if (materialCodeSelectItem) {
                e.values["MaterialInventoryCode"] = materialCodeSelectItem.Text;
                e.values["MaterialInventoryId"] = materialCodeSelectItem.Value;
                if (dataItem.ProductId > 0 && dataItem.MachineId > 0)
                    $.ajax({
                        type: 'post',
                        data: {
                            productId: dataItem.ProductId,
                            machineId: dataItem.MachineId,
                            materialInvId: materialCodeSelectItem.Value
                        },
                        dataType: 'json',
                        url: '@Url.Action("GetProductionWeight", "Transaction", new { area = "Inv" })',
                        timeout: 20000,
                        success: function (data) {
                            if (data === '9') {
                                alert("Lỗi! Không tìm thấy sản phẩm");
                                //} else if (data == '0') {
                                //    alert("Lỗi!");
                            } else {
                                dataItem.ProductWeight = data[0];
                                e.cell.parentNode.getElementsByClassName("ProductWeight")[0].textContent = data[0];
                                dataItem.WarehouseExportId = data[1];
                                e.cell.parentNode.getElementsByClassName("WarehouseExportId")[0].textContent = data[1];
                                e.cell.parentNode.getElementsByClassName("WarehouseExportName")[0].textContent = data[2];
                                e.cell.parentNode.getElementsByClassName("ProductionRate")[0].textContent = data[3];
                            }
                        }
                    });
            }
        }

        var sumNumber = 0;
        var spanNumber = null;
        var i = 0;
        var innerText = "";
        var weight = dataItem.ProductWeight;
        if (e.cell.parentNode.getElementsByClassName("ProductWeight")[0] != null)
            weight = parseFloat(e.cell.parentNode.getElementsByClassName("ProductWeight")[0].textContent);
        if (weight === 0)
            return;
        dataItem.ProductWeight = weight;
        dataItem.WarehouseExportId = e.cell.parentNode.getElementsByClassName("WarehouseExportId")[0].textContent;
        var rate = dataItem.ProductionRate;
        var materialUse = dataItem.MaterialUse1;
        var quantity = dataItem.QuantityExport1;
        var pending = dataItem.QuantityPending1;
        var defect = dataItem.QuantityDefect1;
        var quantityG = 0;
        var number = $(e.cell).find('#QuantityExport2').val();
        if (!isNaN(parseInt(number))) {
            sumNumber = parseInt(number);
            if (materialUse === 0 && sumNumber !== 0) {
                e.cell.style.backgroundColor = "#F4FA58";
            } else {
                e.cell.style.backgroundColor = "";
                spanNumber = $("span[class='QuantityExport2']");
                for (i = 0; i < spanNumber.length; i++) {
                    innerText = spanNumber[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sumNumber = sumNumber + parseInt(innerText);
                }
                $("#TotalQuantityExport2").text(sumNumber);
            }
            quantity = Math.floor(number / weight);

            e.cell.parentNode.getElementsByClassName("QuantityExport1")[0].textContent = quantity;
            dataItem.QuantityExport1 = quantity;
        }
        number = $(e.cell).find('#QuantityDefect2').val();
        if (!isNaN(parseInt(number))) {
            sumNumber = parseInt(number);
            if (materialUse === 0 && sumNumber !== 0) {
                e.cell.style.backgroundColor = "#F4FA58";
            } else {
                e.cell.style.backgroundColor = "";
                spanNumber = $("span[class='QuantityDefect2']");
                for (i = 0; i < spanNumber.length; i++) {
                    innerText = spanNumber[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sumNumber = sumNumber + parseInt(innerText);
                }
                $("#TotalQuantityDefect2").text(sumNumber);
            }
            defect = Math.floor(number / weight);

            e.cell.parentNode.getElementsByClassName("QuantityDefect1")[0].textContent = defect;
            dataItem.QuantityDefect1 = defect;
        }
        number = $(e.cell).find('#QuantityPending2').val();
        if (!isNaN(parseInt(number))) {
            sumNumber = parseInt(number);
            if (materialUse === 0 && sumNumber !== 0) {
                e.cell.style.backgroundColor = "#F4FA58";
            } else {
                e.cell.style.backgroundColor = "";
                spanNumber = $("span[class='QuantityPending2']");
                for (i = 0; i < spanNumber.length; i++) {
                    innerText = spanNumber[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sumNumber = sumNumber + parseInt(innerText);
                }
                $("#TotalQuantityPending2").text(sumNumber);
            }
            pending = Math.floor(number / weight);

            e.cell.parentNode.getElementsByClassName("QuantityPending1")[0].textContent = pending;
            dataItem.QuantityPending1 = pending;
        }
        number = $(e.cell).find('#QuantityExport1').val();
        if (!isNaN(parseInt(number))) {
            quantity = parseInt(number);

            quantityG = parseInt(number * weight);
            dataItem.QuantityExport2 = quantityG;
            e.cell.parentNode.getElementsByClassName("QuantityExport2")[0].textContent = quantityG.format(0);
        }
        number = $(e.cell).find('#QuantityPending1').val();
        if (!isNaN(parseInt(number))) {
            pending = parseInt(number);

            quantityG = parseInt(number * weight);
            dataItem.QuantityPending2 = quantityG;
            e.cell.parentNode.getElementsByClassName("QuantityPending2")[0].textContent = quantityG.format(0);
        }
        number = $(e.cell).find('#QuantityDefect1').val();
        if (!isNaN(parseInt(number))) {
            defect = parseInt(number);

            quantityG = parseInt(number * weight);
            dataItem.QuantityDefect2 = quantityG;
            e.cell.parentNode.getElementsByClassName("QuantityDefect2")[0].textContent = quantityG.format(0);
        }
        var diffProduction = quantity + pending + defect - (materialUse * rate);
        e.cell.parentNode.getElementsByClassName("DiffProduction")[0].textContent = diffProduction;
        var diffMaterial = diffProduction / rate;
        e.cell.parentNode.getElementsByClassName("DiffMaterial")[0].textContent = (diffMaterial).format(2);
        if (Math.abs(diffMaterial) / materialUse < 0.1)
            e.cell.parentNode.getElementsByClassName("DiffMaterial")[0].parentNode.style.backgroundColor = "";
        else if (Math.abs(diffMaterial) / materialUse < 0.2)
            e.cell.parentNode.getElementsByClassName("DiffMaterial")[0].parentNode.style.backgroundColor = "#F4FA58";
        else
            e.cell.parentNode.getElementsByClassName("DiffMaterial")[0].parentNode.style.backgroundColor = "#FA5858";
    }

    function gridAdd_OnSubmitChanges(e) {
        var importDate = $("#ImportDate").data("tDatePicker").value();
        if (importDate === null)
            importDate = "";
        else
            importDate = $.telerik.formatString('{0:dd/MM/yyyy}', importDate);
        var materialUseDate = $("#MaterialUseDate").data("tDatePicker").value();
        if (materialUseDate === null)
            materialUseDate = "";
        else
            materialUseDate = $.telerik.formatString('{0:dd/MM/yyyy}', materialUseDate);
        var shift = $('#Shift2').data('tDropDownList').value();
        if (shift === "")
            shift = 0;
        var ca = $("#ShiftName2").data("tAutoComplete").value();
        var message = "Ngày báo cáo: " + importDate;
        message += "\nCa: " + ca;
        message += "\nĐồng ý lưu ??";
        if (confirm(message)) {
            // Save it!
            e.values = $.extend(e.values,
                {
                    importDate: importDate,
                    materialUseDate: materialUseDate,
                    shiftType: shift,
                    shiftName: ca,
                }
            );
        } else {
            e.preventDefault();
        }
    }
</script>

<div class="title">
    @*Tạo phiếu nhập sản xuất 1*@
    @HttpContext.GetGlobalResourceObject("Resource", "CreateImportSX1")
</div>

<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">

    <fieldset>
        <legend>
            @*Thông tin phiếu*@
            @HttpContext.GetGlobalResourceObject("Resource", "TransactionInformation")
        </legend>
        <div>
            <div class="grid_4">
                @*Ngày báo cáo*@
                @HttpContext.GetGlobalResourceObject("Resource", "ReportDate")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().DatePicker()
                        .Name("ImportDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
            <div class="clear" style="margin-bottom: 10px"></div>
            <div class="grid_4">
                @*Ngày sử dụng nguyên liệu*@
                @HttpContext.GetGlobalResourceObject("Resource", "UsingDate")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().DatePicker()
                        .Name("MaterialUseDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
        </div>

    </fieldset>
</div>
<div class="t-info-sha alpha grid_15">
    <div class="grid_4">
        <label>
            <input id="rdoNormal" name="rdoType" value="rdoNormal" type="radio" checked="checked" />
            @*Bình thường*@
            @HttpContext.GetGlobalResourceObject("Resource", "Normal")
        </label>
    </div>
    <div class="grid_4">

        <label>
            <input id="rdoAdd" name="rdoType" value="rdoAdd" type="radio" />
            @*Thêm sản xuất*@
            @HttpContext.GetGlobalResourceObject("Resource", "MoreProduction")
        </label>
    </div>
</div>
<div class="clear"></div>
<br />
<div id="pnlNormal">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">

        <div class="grid_2">
            @*Phiếu SDNL*@
            @HttpContext.GetGlobalResourceObject("Resource", "TransactionNumber")
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("MaterialUseForm")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxtMaterialUseForm", "Transaction", new { area = "Inv", date = "" }))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .ClientEvents(e => e.OnDataBinding("cbo_OnDataBinding"))
                    .AutoFill(true)
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .Render();
            }
        </div>
        <div class="grid_1">
            <button class="t-button" id="btnRefresh" name="btnPickupMaterialId" onclick=" RefreshCombobox('MaterialUseForm') ">
                <span class='t-icon t-refresh'></span>
            </button>
        </div>
        <div class="grid_1">
            @*Ca*@
            @HttpContext.GetGlobalResourceObject("Resource", "Shift")
        </div>
        <div class="grid_2">
            @{
                Html.Telerik().DropDownList()
                    .Name("Shift")
                    .HtmlAttributes(new { style = "width: 40px" })
                    .DropDownHtmlAttributes(new { style = "width: 40px" })
                    .ClientEvents(events => events.OnLoad("Shift_Onload"))
                    .Render();
            }
        </div>
        <div class="grid_2">
            @{
                Html.Telerik().AutoComplete()
                    .Name("ShiftName")
                    .HtmlAttributes(new { style = "width: 40px" })
                    .DropDownHtmlAttributes(new { style = "width: 40px" })
                    .Render();
            }
        </div>

        <button id="btnGetSmartList" class="t-button" onclick=" return getSmartList(); ">
            <span class='t-icon t-insert'></span>
            Lấy danh sách máy chạy trong ngày
            @*@HttpContext.GetGlobalResourceObject("Resource", "")*@
        </button>
    </div>
    <div class="clear"></div>


    <div class="cover-div">
        @{
            Html.Telerik().Grid<SmartProductionModel>()
                .Name("gridSmartProduction")
                .DataKeys(keys => keys.Add(f => f.SmartId).RouteKey("smartId"))
                .ToolBar(bar => bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
                    .SaveText(@HttpContext.GetGlobalResourceObject("Resource", "SaveAll").ToString())
                    .CancelText(@HttpContext.GetGlobalResourceObject("Resource", "CancelText").ToString()))
                .DataBinding(dataBindings => dataBindings.Ajax()
                                                         .Select("SelectMaterialInvOnMachine", "Transaction", new { useId = 0, shift = 0 })
                                                         .Update("SaveImportProduction1_Auto", "Transaction")
                )
                .Columns(columns => {
                  
                    columns.Bound(f => f.WarehouseExportId).Width(50).Title("").Hidden(true)
                               .ClientTemplate("<span class='WarehouseExportId'><#= WarehouseExportId #></span>");
                    
                    columns.Bound(f => f.MachineName).Width(90)
                        //.Title("Máy")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Machine").ToString())
                        .ReadOnly(true);
                    
                    columns.Bound(f => f.MaterialInventoryCode).Width(200)
                        //.Title("Nguyên liệu")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Material").ToString())
                        .ReadOnly(true);
                    
                    columns.Bound(f => f.ProductCode).Width(120)
                        //.Title("Sản Phẩm")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Product").ToString())
                        .HeaderHtmlAttributes(new { @class = "edit-column" });
                    
                    columns.Bound(f => f.ProductWeight).Width(60)
                        .HeaderTemplate("<strong>"
                            //+TL 
                            + @HttpContext.GetGlobalResourceObject("Resource", "Weight2").ToString()
                            + "<span style='color: red;'>(*)</span></br>(g/pc)</<strong>")
                        .HeaderHtmlAttributes(new { @class = "edit-column" })
                        .ClientTemplate("<span class='ProductWeight'><#= ProductWeight #></span>")
                        .HtmlAttributes(new { style = "text-align: right;" });
                    
                    columns.Bound(f => f.ProductionRate).Width(60).ReadOnly(true)
                        //.HeaderTemplate("<strong>ĐM</br>pcs/cây</<strong>")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductionRate2").ToString()
                            + "</br>(pcs/"
                            + @HttpContext.GetGlobalResourceObject("Resource", "Bar").ToString()
                            + ")"
                        )
                        .ClientTemplate("<span class='ProductionRate'><#= ProductionRate #></span>")
                        .HtmlAttributes(new { style = "text-align:right;" });
                    
                    columns.Bound(f => f.WarehouseExportName).Width(60)
                        //.Title("Kho")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Warehouse").ToString())
                        .ReadOnly(true)
                        .ClientTemplate("<span class='WarehouseExportName'><#= WarehouseExportName #></span>")
                        .HtmlAttributes(new { style = "border-right: solid 1px black;" });

                    columns.Bound(f => f.LotNumber).Width(120)
                        //.Title("Lô")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Lot").ToString())
                        .ReadOnly(true);
                    
                    columns.Bound(f => f.UnitMeasure).Width(60)
                        //.Title("ĐVT (*)")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Unit2").ToString()
                            + " (*)"
                        )
                        .HeaderTemplate("<strong>ĐVT</br><span style='color: red;'>(*)</span></<strong>")
                        .HeaderHtmlAttributes(new { @class = "edit-column" });
                    
                    columns.Bound(f => f.MaterialUse1).Width(60)
                        //.Title("NLSD")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "MaterialUsing").ToString())
                        .ReadOnly(true)
                        .Format("{0:n2}")
                        .HtmlAttributes(new { style = "text-align:right;" });
                    
                    columns.Bound(f => f.QuantityExport1).Width(60).ReadOnly(true)
                        .HeaderTemplate("<strong>OK</br>(Auto)</<strong>")
                        .Format("{0:n0}")
                        .HtmlAttributes(new { style = "text-align:right;" });
                    
