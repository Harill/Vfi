
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model MaterialUseInShiftModel
@{
    ViewBag.Title = "Phiếu thu hồi nguyên liệu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">

        function grid_OnDataBound(args) {
        }

        function grid_onEdit(e) {

            var dataItem = e.dataItem;
            var mode = e.mode;
            var form = e.form;
            //var cell = e.cell;

            //var orderQty = $(form).find("#OrderQty").data("tTextBox");
            //var unitPrice = $(form).find("#UnitPrice").data("tTextBox");
            if (mode == 'insert') {

            }
            if (mode == 'edit') {

            }

            var lastQuantity = $(form).find("#LastQuantity").data("tTextBox");
            var data = dataItem.AssignQuantity + dataItem.EarlyQuantity - dataItem.Quantity;
            dataItem.LastQuantity = data;
            if (lastQuantity != null) {
                lastQuantity.value(data);
            }
        }

        function grid_onDataBinding(args) {

        }

        function grid_onSave(e) {
            
            var $toMachine = $(e.cell).find('#ToMachine');
            if ($toMachine.length > 0) {
                var toMachine = $toMachine.data("tComboBox"),
                    toMachineSelectItem = toMachine.selectedIndex > -1 ? toMachine.data[toMachine.selectedIndex] : null;

                if (toMachineSelectItem) {
                    e.values["ToMachine"] = toMachineSelectItem.Text;
                    e.values["ToMachineId"] = toMachineSelectItem.Value;
                }
            }

            //tong quantityPending2 ko wan tam
            var quantityPending2 = $(e.cell).find('#Quantity').val();
            if (!isNaN(parseFloat(quantityPending2))) {
                var sumQuantityPending2 = 0;
                var spanQuantityPending2 = $("span[name='Quantity']");
                for (var i = 0; i < spanQuantityPending2.length; i++) {
                    var innerText = spanQuantityPending2[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sumQuantityPending2 = sumQuantityPending2 + parseFloat(innerText);
                }
                sumQuantityPending2 = sumQuantityPending2 + parseFloat(quantityPending2);
                $("#TotalQuantity").text(sumQuantityPending2);
            }
        }

        function grid_onSubmitChanges(e) {
            var importDate = $("#ImportDate").data("tDatePicker").value();
            if (importDate === null)
                importDate = "";
            else
                importDate = $.telerik.formatString('{0:dd/MM/yyyy}', importDate);
            e.values = $.extend(e.values,
                {
                    importDate: importDate
                }
            );

        }

    </script>
}

<div class="title">
    @*Tạo phiếu thu hồi nguyên liệu*@
    @HttpContext.GetGlobalResourceObject("Resource", "RetrieveMaterial")
</div>
<div class="t-info-sha" style="padding-left: 15px;padding-right: 15px; width:920px;">

    <fieldset>
        <legend>
            @*Thông tin phiếu*@
            @HttpContext.GetGlobalResourceObject("Resource", "TransactionInformation")
        </legend> 
            <div class="grid_7">
               
            </div>
        <div class="grid_3">
            @*Ngày thu hồi*@
            @HttpContext.GetGlobalResourceObject("Resource", "RecallDate")
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().DatePicker()
                    .Name("ImportDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today)
                    .Render();
            }
        </div>
    </fieldset>
</div>
<div class="clear"></div>
<div class="cover-div">
        @{
            Html.Telerik().Grid<MaterialUseInShiftDetailModel>()
                .Name("gridMaterialRetrieve")
                .DataKeys(keys => keys.Add(f => f.DetailId).RouteKey("detailId"))
                .ToolBar(bar => bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
                    .SaveText(@HttpContext.GetGlobalResourceObject("Resource", "SaveAll").ToString())
                    .CancelText(@HttpContext.GetGlobalResourceObject("Resource", "CancelAll").ToString()))
                .DataBinding(dataBindings => dataBindings.Ajax()
                                                         .Select("SelectAllMaterialInvOnMachine", "Transaction")
                                                         .Update("UpdateMaterialRetrieve", "Transaction")
                )
                .Columns(columns =>
                    {
                        columns.Bound(f => f.MachineName).Width(60)
                            //.Title("Máy")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Machine").ToString())
                            .ReadOnly(true);
                      
                        columns.Bound(f => f.ProductCode).Width(100)
                            //.Title("Sản Phẩm")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Product").ToString())
                            .ReadOnly(true);
                        
                        columns.Bound(f => f.MaterialCode).Width(200)
                            //.Title("Tên NL")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "MaterialName2").ToString())
                            .ReadOnly(true);
                        
                        columns.Bound(f => f.MaterialDesign).Width(50)
                            //.Title("NCC")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Vendor").ToString())
                            .ReadOnly(true);
                        
                        columns.Bound(f => f.Length).Width(50)
                            //.Title("Dài")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Length").ToString())
                            .ReadOnly(true);
                        
                        columns.Bound(f => f.LotNumber).Width(70)
                            //.Title("Lô")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Lot").ToString())
                            .ReadOnly(true);
                        
                        columns.Bound(f => f.EarlyQuantity).Width(80)
                            //.Title("Tồn kho")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Inventory").ToString())
                            .ReadOnly(true)
                            .Format("{0:n2}")
                            .HtmlAttributes(new { style = "text-align: right;" });
                        
                        columns.Bound(f => f.LastQuantity)
                            //.Title("Tồn máy")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "MachineInv").ToString())
                            .ReadOnly(true).Width(80)
                            .Format("{0:n2}")
                            .HtmlAttributes(new { style = "text-align: right;" });
                        
                        columns.Bound(f => f.WaitingNumber).Width(80)
                            //.Title("Đợi duyệt")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "ApproveWaiting").ToString())
                            .ReadOnly(true)
                            .Format("{0:n2}")
                            .HtmlAttributes(new { style = "text-align: right;" });
                        
                        columns.Bound(f => f.AssignQuantity)
                            //.Title("Tồn TT")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Inv").ToString()
                                + " "
                                + @HttpContext.GetGlobalResourceObject("Resource", "Actual2").ToString()
                            )
                            .ReadOnly(true).Width(80)
                            .Format("{0:n2}")
                            .HtmlAttributes(new { style = "text-align: right;" });
                        
                        columns.Bound(f => f.Quantity)
                            //.Title("SL thu hồi")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Quantity2").ToString()
                                + " "
                                + @HttpContext.GetGlobalResourceObject("Resource", "Recall").ToString()
                            )
                            .Width(95)
                            .HeaderHtmlAttributes(new { @class = "edit-column" })
                            .ClientTemplate("<span name='Quantity'><#= Quantity == null ? 0.0 : $.telerik.formatString('{0:n2}', Quantity) #></span>")
                            .FooterTemplate("<span id='TotalQuantity'></span>")
                            .HtmlAttributes(new { style = "text-align: right;" });
                    
                        columns.Bound(f => f.IsDestroy).Width(75)
                            //.Title("Hủy tồn")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Cancel").ToString()
                                + " "
                                + @HttpContext.GetGlobalResourceObject("Resource", "Inv").ToString()
                            )
                            .HeaderHtmlAttributes(new { @class = "edit-column" })
                            .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsDestroy' <#=IsDestroy? checked='checked' : '' #> />")
                            .HtmlAttributes(new { style = "text-align: center;" });
                     
                        columns.Bound(f => f.ToMachine).Width(100)
                            //.Title("Chuyển máy")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "MachineTransfer").ToString())
                            .HeaderHtmlAttributes(new { @class = "edit-column" })
                            .HtmlAttributes(new { style = "text-align: center;" });
                       
                        columns.Bound(f => f.Note)
                            //.Title("Ghi chú")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Note").ToString());
                
                        columns.Command(commands => commands.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(30);
                    })
                .ClientEvents(events => events
                                            .OnDataBinding("grid_onDataBinding")
                                            .OnEdit("grid_onEdit")
                                            .OnSave("grid_onSave")
                                            .OnSubmitChanges("grid_onSubmitChanges")
                                            .OnError("grid_OnError")
                                            //.OnComplete("gridOrderDetailPartial_onComplete")
                                            .OnDataBound("grid_OnDataBound")
                )
                .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
                .KeyboardNavigation(keys => keys.EditOnTab(true))
                .Resizable(resizing => resizing.Columns(true))
                .Scrollable(f => f.Height(510))
                // .Footer(false)
                .Render();
        }
    </div>
<div class="clear"></div><br/>