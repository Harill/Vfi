@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ImportSX1Model
@{
    ViewBag.Title = "Chỉnh Phiếu Nhập Kho SX 1";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script type="text/javascript">

    function gridSmart_OnDataBinding(args) {
        var importId = $('#ImportFormProduction1').data('tComboBox').value();
        if (importId === "")
            importId = 0;
        args.data = $.extend(args.data,
        {
            importId: importId
        });
        updateProducts = [];
    }

    function grid_OnRowDataBound(e) {
        var dataItem = e.dataItem; //FA5858 F4FA58
        if (dataItem.ProductionRateStatus === 1)
            e.row.getElementsByClassName("DiffMaterial")[0].parentNode.style.backgroundColor = "#F4FA58";
        else if (dataItem.ProductionRateStatus === 2)
            e.row.getElementsByClassName("DiffMaterial")[0].parentNode.style.backgroundColor = "#FA5858";
    }

    var updateProducts = [];

    function gridSmart_OnSave(e) {
        var dataItem = e.dataItem;
        var $productCode = $(e.cell).find('#ProductCode');
        if ($productCode.length > 0) {
            var productCode = $productCode.data("tComboBox"),
                productCodeSelectItem = productCode.selectedIndex > -1
                    ? productCode.data[productCode.selectedIndex]
                    : null;

            if (productCodeSelectItem) {
                e.values["ProductCode"] = productCodeSelectItem.Text;
                e.values["ProductId"] = productCodeSelectItem.Value;
                $.ajax({
                    type: 'post',
                    data: { productId: productCodeSelectItem.Value, machineId: e.dataItem.MachineId, materialInvId: e.dataItem.MaterialInventoryId },
                    dataType: 'json',
                    url: '@Url.Action("GetProductionWeight", "Transaction", new { area = "Inv" })',
                    timeout: 20000,
                    success: function (data) {
                        if (data === '9') {
                            alert("Lỗi! Không tìm thấy sản phẩm");
                        } else {
                            var updateProduct = updateProducts.filter(function (updateProduct) {
                                return updateProduct.machineId === e.dataItem.MachineId &&
                                    updateProduct.productId === productCodeSelectItem.Value &&
                                    updateProduct.materialInvId === e.dataItem.MaterialInventoryId;
                            })[0];
                            if (!updateProduct) {
                                updateProduct = {
                                    machineId: e.dataItem.MachineId,
                                    productId: productCodeSelectItem.Value,
                                    materialInvId: e.dataItem.MaterialInventoryId,
                                    ProductWeight: data[0],
                                    ProcessByMachineId: data[1],
                                    WarehouseExportId: data[2],
                                    ProductionRate: data[4]
                                };
                                updateProducts.push(updateProduct);
                            } else {
                                updateProduct = {
                                    machineId: e.dataItem.MachineId,
                                    productId: productCodeSelectItem.Value,
                                    materialInvId: e.dataItem.MaterialInventoryId,
                                    ProductWeight: data[0],
                                    ProcessByMachineId: data[1],
                                    WarehouseExportId: data[2],
                                    ProductionRate: data[4]
                                };
                            }

                            dataItem.ProductWeight = data[0];
                            e.cell.parentNode.getElementsByClassName("ProductWeight")[0].textContent = data[0];
                            dataItem.ProcessByMachineId = data[1];
                            dataItem.WarehouseExportId = data[2];
                            e.cell.parentNode.getElementsByClassName("WarehouseExportId")[0].textContent = data[2];
                            e.cell.parentNode.getElementsByClassName("WarehouseExportName")[0].textContent = data[3];
                            dataItem.ProductionRate = data[4];
                            e.cell.parentNode.getElementsByClassName("ProductionRate")[0].textContent = data[4];
                            e.cell.parentNode.getElementsByClassName("DiffProduction")[0].textContent = "";
                            e.cell.parentNode.getElementsByClassName("DiffMaterial")[0].textContent = "";
                        }
                    }
                });
            }
        } else {

            var sumNumber = 0;
            var spanNumber = null;
            var i = 0;
            var innerText = "";
            var updateProduct = updateProducts.filter(function (updateProduct) {
                return updateProduct.machineId === e.dataItem.MachineId &&
                    updateProduct.productId === e.dataItem.productId &&
                    updateProduct.materialInvId === e.dataItem.MaterialInventoryId;
            })[0];
            if (updateProduct) {
                dataItem.ProductWeight = updateProduct.ProductWeight;
                dataItem.ProductionRate = updateProduct.ProductionRate;
                dataItem.WarehouseExportId = updateProduct.WarehouseExportId;
            }
            var weight = dataItem.ProductWeight;
            if (e.cell.parentNode.getElementsByClassName("ProductWeight")[0] != null)
                weight = parseFloat(e.cell.parentNode.getElementsByClassName("ProductWeight")[0].textContent);
            if (weight == 0)
                return;
            dataItem.ProductWeight = weight;

            var rate = dataItem.ProductionRate;
            if (e.cell.parentNode.getElementsByClassName("ProductionRate")[0] != null)
                rate = parseFloat(e.cell.parentNode.getElementsByClassName("ProductionRate")[0].textContent);
            if (rate == 0)
                return;
            dataItem.ProductionRate = rate;

            dataItem.WarehouseExportId = e.cell.parentNode.getElementsByClassName("WarehouseExportId")[0].textContent;
            //var rate = dataItem.ProductionRate;
            var materialUse = dataItem.MaterialUse1;
            //var diffProduction = 0;
            //var diffMaterial = 0;
            var quantity = dataItem.QuantityExport1;
            var pending = dataItem.QuantityPending1;
            var defect = dataItem.QuantityDefect1;

            number = $(e.cell).find('#QuantityExport1').val();
            if (!isNaN(parseInt(number))) {
                quantity = parseInt(number);
            }
            number = $(e.cell).find('#QuantityPending1').val();
            if (!isNaN(parseInt(number))) {
                pending = parseInt(number);
            }
            number = $(e.cell).find('#QuantityDefect1').val();
            if (!isNaN(parseInt(number))) {
                defect = parseInt(number);
            }
            var diffProduction = quantity + pending + defect - (materialUse * rate);
            e.cell.parentNode.getElementsByClassName("DiffProduction")[0].textContent = diffProduction;
            var diffMaterial = diffProduction / rate;
            e.cell.parentNode.getElementsByClassName("DiffMaterial")[0].textContent = (diffMaterial).format(2);
            if (Math.abs(diffMaterial) / materialUse < 0.1)
                e.cell.parentNode.getElementsByClassName("DiffMaterial")[0].parentNode.style.backgroundColor = "";
            else if (Math.abs(diffMaterial) / materialUse < 0.2)
                e.cell.parentNode.getElementsByClassName("DiffMaterial")[0].parentNode.style.backgroundColor = "#F4FA58";
            else
                e.cell.parentNode.getElementsByClassName("DiffMaterial")[0].parentNode.style.backgroundColor = "#FA5858";
        }
    }

    function gridSmart_OnSubmitChanges(e) {
        var importId = $('#ImportFormProduction1').data('tComboBox').value();
        if (importId === "")
            importId = 0;
        e.values = $.extend(e.values,
            {
                importId: importId
            }
        );
    }

    function ApproveTransaction() {
        var importId = $('#ImportFormProduction1').data('tComboBox').value();
        if (importId === "")
            importId = 0;
        if (importId > 0) {
            var importCode = $('#ImportFormProduction1').data('tComboBox').text();
            if (importCode === "")
                importCode = "";
            var message = "Phiếu SX : " + importCode;
            message += "\nĐồng ý lưu ??";
            if (confirm(message)) {
                // Save it!
                $.post('@Url.Action("ApproveTransactionForImportProduction1", "Transaction")',
                        {
                            importId: importId
                        },
                        function (data) {
                            if (data === "okie") {
                                RefreshCombobox('ImportFormProduction1');
                                alert("Xác nhận duyệt thành công");
                                RefreshGrid("gridTransaction");
                            } else
                                alert(data);
                        });
            } else {
                e.preventDefault();
            }
        }
    }

    function CancelTransaction() {
        var importId = $('#ImportFormProduction1').data('tComboBox').value();
        if (importId === "")
            importId = 0;
        if (importId > 0) {
            var importCode = $('#ImportFormProduction1').data('tComboBox').text();
            if (importCode === "")
                importCode = "";
            var message = "Phiếu SX : " + importCode;
            message += "\nĐồng ý lưu ??";
            if (confirm(message)) {
                // Save it!
                $.post('@Url.Action("CancelTransactionForImportProduction1", "Transaction")',
                        {
                            importId: importId
                        },
                        function (data) {
                            if (data === "okie") {
                                RefreshCombobox('ImportFormProduction1');
                                alert("Xác nhận huỷ thành công");
                                RefreshGrid("gridTransaction");
                            } else
                                alert(data);
                        });
            } else {
                e.preventDefault();
            }
        }
    }
</script>
<script type="text/javascript">

</script>

<div class="title">
    @*Chỉnh phiếu nhập sản xuất 1*@
    @HttpContext.GetGlobalResourceObject("Resource", "UpdateImportSX1")
</div>

<div id="pnlNormal">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">

        <div class="grid_2">
            @*Phiếu SX1*@
            @HttpContext.GetGlobalResourceObject("Resource", "Production12Form")
        </div>
        <div class="grid_1">
            <button class="t-button" id="btnRefresh" name="btnPickupMaterialId" onclick=" RefreshCombobox('ImportFormProduction1') ">
                <span class='t-icon t-refresh'></span>
            </button>
        </div>
        <div class="grid_8">
            @{
                Html.Telerik().ComboBox()
                    .Name("ImportFormProduction1")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboboxOpenSavedImportProduction1", "Transaction", new { area = "Inv", date = "" }))
                    .HtmlAttributes(new { style = "width: 100%" })
                    //.DropDownHtmlAttributes(new { style = "width: 100%" })
                    .AutoFill(true)
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .Render();
            }
        </div>

        <button id="btnGetSmartList" class="t-button" onclick=" RefreshGrid('gridSmartProduction'); ">
            <span class='t-icon t-insert'></span>
            Lấy danh sách sản xuất
        </button>
        <button id="btnApprove" class="t-button" onclick=" ApproveTransaction(); ">
            <span class='t-icon t-insert'></span>
            Duyệt phiếu sản xuất
        </button>
        <button id="btnCancel" class="t-button" onclick=" CancelTransaction(); ">
            <span class='t-icon t-delete'></span>
            Huỷ phiếu sản xuất
        </button>
    </div>
    <div class="clear"></div>


    <div class="cover-div">
        @{
            Html.Telerik().Grid<SmartProductionModel>()
                .Name("gridSmartProduction")
                .DataKeys(keys => keys.Add(f => f.SmartId).RouteKey("smartId"))
                .ToolBar(bar => bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
                    .SaveText(@HttpContext.GetGlobalResourceObject("Resource", "SaveAll").ToString())
                    .CancelText(@HttpContext.GetGlobalResourceObject("Resource", "CancelText").ToString()))
                .DataBinding(dataBindings => dataBindings.Ajax()
                                                         .Select("SelectSavedOpenProduction1", "Transaction", new { importId = 0 })
                                                         .Update("UpdateSavedImportProduction1", "Transaction")
                )
                .Columns(columns => {
                    columns.Bound(f => f.WarehouseExportId).Width(50).Title("").Hidden(true)
                           .ClientTemplate("<span class='WarehouseExportId'><#= WarehouseExportId #></span>");
                 
                    columns.Bound(f => f.MachineName).Width(90)
                        //.Title("Máy")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Machine").ToString())
                        .ReadOnly(true);
                    
                    columns.Bound(f => f.MaterialInventoryCode)
                        //.Title("Nguyên liệu")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Material").ToString())
                        .ReadOnly(true);
                    
                    columns.Bound(f => f.ProductCode).Width(130)
                        //.Title("Sản Phẩm")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Product").ToString());
                    
                    columns.Bound(f => f.ProductWeight).Width(60)
                        //.Title("TL")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Weight2").ToString())
                        .ClientTemplate("<span class='ProductWeight'><#= ProductWeight #></span>")
                        .HtmlAttributes(new { style = "text-align:right;" });
                    
                    columns.Bound(f => f.ProductionRate).Width(60)
                        //.Title("ĐM")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductionRate2").ToString())
                        .ReadOnly(true)
                        .ClientTemplate("<span class='ProductionRate'><#= ProductionRate #></span>")
                        .HtmlAttributes(new { style = "text-align:right;" });
                    
                    columns.Bound(f => f.WarehouseExportName).Width(60)
                        //.Title("Kho")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Warehouse").ToString())
                        .ReadOnly(true)
                        .ClientTemplate("<span class='WarehouseExportName'><#= WarehouseExportName #></span>")
                        .HtmlAttributes(new { style = "border-right: solid 1px black;" });
                    
                    columns.Bound(f => f.MaterialUse1).Width(60)
                        //.Title("NLSD")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "MaterialUsing").ToString())
                        .ReadOnly(true)
                        .Format("{0:n2}")
                        .HtmlAttributes(new { style = "text-align:right;" });
                    
                    columns.Bound(f => f.ProductionQuantity).Width(60)
                        .Title("SP MAX")
                        //.Title(@HttpContext.GetGlobalResourceObject("Resource", "").ToString())
                        .ReadOnly(true)
                        .Format("{0:n0}")
                        .HtmlAttributes(new { style = "text-align:right;" });

                    columns.Bound(f => f.LotNumber).Width(160)
                        //.Title("Lô")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Lot").ToString())
                        .ReadOnly(true)
                        .Format("{0:n2}")
                        .HtmlAttributes(new { style = "text-align:right;" });

                    columns.Bound(f => f.QuantityExport1).Width(70).Title("OK (pcs)")
                        .HeaderHtmlAttributes(new { @class = "edit-column" })
                        .ClientTemplate("<span class='QuantityExport1'><#= QuantityExport1 == null ? 0 : $.telerik.formatString('{0:n0}', QuantityExport1) #></span>")
                        .HtmlAttributes(new { style = "text-align: right;" });
           
                    columns.Bound(f => f.QuantityPending1).Width(70)
                        //.Title("CXL (pcs)")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Pending2").ToString()
                            + " (pcs)"
                        )
                        .HeaderHtmlAttributes(new { @class = "edit-column" })
                        .ClientTemplate("<span class='QuantityPending1'><#= QuantityPending1 == null ? 0 : $.telerik.formatString('{0:n0}', QuantityPending1) #></span>")
                        .HtmlAttributes(new { style = "text-align: right;" });
                    
                    columns.Bound(f => f.QuantityDefect1).Width(70).Title("NG (pcs)")
                        .HeaderHtmlAttributes(new { @class = "edit-column" })
                        .ClientTemplate("<span class='QuantityDefect1'><#= QuantityDefect1 == null ? 0 : $.telerik.formatString('{0:n0}', QuantityDefect1) #></span>")
                        .HtmlAttributes(new { style = "text-align: right;border-right: solid 1px black;" });
                    
                    columns.Bound(f => f.DiffProduction).Width(70)
                        //.Title("Lệch SP")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Diff").ToString()
                            + " "
                            + @HttpContext.GetGlobalResourceObject("Resource", "Product2").ToString()
                        )
                        .ReadOnly(true)
                        .HtmlAttributes(new { style = "text-align:right;" })
                        .ClientTemplate("<span class='DiffProduction'><#= DiffProduction == null ? 0 : $.telerik.formatString('{0:n0}', DiffProduction) #></span>")
                        .Format("{0:n0}")
                        .Aggregate(agg => agg.Sum())
                        .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                        .HtmlAttributes(new { style = "text-align: right;" })
                        .FooterHtmlAttributes(new { style = "text-align: right;" });
                    
                    columns.Bound(f => f.DiffMaterial).Width(60)
                        //.Title("Lệch NL")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Diff").ToString()
                            + " "
                            + @HttpContext.GetGlobalResourceObject("Resource", "Material2").ToString()
                        )
                        .ReadOnly(true)
                        .HtmlAttributes(new { style = "text-align:right;" })
                        .ClientTemplate("<span class='DiffMaterial'><#= DiffMaterial == null ? 0 : $.telerik.formatString('{0:n2}', DiffMaterial) #></span>")
                        .Format("{0:n2}")
                        .Aggregate(agg => agg.Sum())
                        .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                        .HtmlAttributes(new { style = "text-align: right;border-right:1px black solid" })
                        .FooterHtmlAttributes(new { style = "text-align: right;border-right:1px black solid" });
                })
                .ClientEvents(events => events
                                            .OnDataBinding("gridSmart_OnDataBinding")
                                            .OnSave("gridSmart_OnSave")
                                            .OnRowDataBound("grid_OnRowDataBound")
                                            .OnSubmitChanges("gridSmart_OnSubmitChanges")
                                            .OnError("grid_OnError")
                )
                .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
                .KeyboardNavigation(keys => keys.EditOnTab(true))
                .Resizable(resizing => resizing.Columns(true))
                .Scrollable(f => f.Height(510))
                .Sortable()
                // .Footer(false)
                .Render();
        }
    </div>
</div>
<div class="clear"></div>
