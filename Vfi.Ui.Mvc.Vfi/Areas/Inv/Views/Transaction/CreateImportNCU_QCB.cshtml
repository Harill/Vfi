                        //.HeaderTemplate("Xuất</br>(g)")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Export").ToString()
                            + "</br>(g)"
                        )
                        .HtmlAttributes(new { style = "text-align: right;border-left:1px solid black;" })
                        .Format("{0:n0}");
                    
                    columns.Bound(f => f.ExportQuantity).Width(70).ReadOnly(true)
