@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Models
@model ExportFormTP_KD
@{
    ViewBag.Title = "Phân phiếu xuất kho";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnLoad.js")"></script>
    <script type="text/javascript">

        function transaction_OnChange() {
            RefreshGrid("grid");
        }

        var index = 0;
        function grid_OnDataBinding(args) {
            var id = $("#Transaction").data('tComboBox').value();
            if (id === "")
                id = 0;
            args.data = $.extend(args.data,
            {
                transactionId: id
            });
            index = 0;
            groupIndex = 0;
            gridData = [];
            productCode = "";
        }

        var groupIndex = 0;
        var gridData = [];
        var productCode = "";
        function grid_OnRowDataBound(e) {
            if (productCode === "") groupIndex = 0;
            var dataItem = e.dataItem;
            if (dataItem.ProductCode !== productCode) {
                groupIndex++;
                productCode = dataItem.ProductCode;
            }
            dataItem.GroupIndex = groupIndex;
            gridData.push({
                id: dataItem.ProductInvId,
                groupIndex: dataItem.GroupIndex,
                quantity: e.dataItem.Quantity,
            });
            if (dataItem.Status === 1)
                e.row.childNodes[6].style.backgroundColor = "#F4FA58";
        }

        function grid_OnSave(e) {

            var quanlity = $(e.cell).find('#Quantity').val();
            if (!isNaN(parseInt(quanlity))) {
                quanlity = parseInt(quanlity);
                var sumQuality = 0;
                var spanRequests = $("span[name='Quantity']");
                for (var i = 0; i < spanRequests.length; i++) {
                    var innerText = spanRequests[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sumQuality = sumQuality + parseInt(innerText);
                }
                sumQuality = sumQuality + quanlity;
                $("#TotalQuantity").text(sumQuality.format(0));
            }

            var entity = gridData.filter(function (dataRow) {
                return dataRow["id"] === e.dataItem.ProductInvId;
            });
            if (entity.length > 0) {
                entity = entity[0];
                entity.quantity = quanlity;
            }
            calculateSumGroup(e.dataItem.GroupIndex);
        }

        function calculateSumGroup(groupIndex) {
            sumReal = 0;
            var data = gridData.filter(function (dataRow) {
                return dataRow["groupIndex"] === groupIndex && dataRow.quantity > 0;
            });
            if (data.length <= 0) { }
            else {
                for (i = 0; i < data.length; i++) {
                    sumReal = sumReal + data[i].quantity;
                }
            }
            $("#GroupQuantity_" + groupIndex).text(sumReal.format(0));
        }

        function AddDefault() {

            if (confirm("Đồng ý lưu mặc định")) {
                $.post('@Url.Action("TransactionProductSaveDefault", "Transaction")',
                    {},
                    function(data) {
                        RefreshCombobox("Transaction");
                        RefreshGrid("grid");
                        alert(data);
                    });
            }
            return false;
        }

    </script>

}

<div class="title">
    @*Phân đơn hàng xuất kho*@
    @HttpContext.GetGlobalResourceObject("Resource", "AddTransactionDetail")
</div>

<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">

    <fieldset>
        <legend>
            @*Thông tin phiếu xuất*@
            @HttpContext.GetGlobalResourceObject("Resource", "TransactionInformation")
        </legend>
        <div class="grid_2">
            @*Số phiếu*@
            @HttpContext.GetGlobalResourceObject("Resource", "TransactionNumber")
        </div>
        <div class="grid_6">
            @{
                Html.Telerik().ComboBox()
                    .Name("Transaction")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboboxTransactionProcessing", "Transaction", new { area = "Inv" }))
                    .HtmlAttributes(new { style = "width: 215px" })
                    .DropDownHtmlAttributes(new { style = "width: 213px" })
                    .ClientEvents(events => events.OnChange("transaction_OnChange"))
                    .Render();
            }
        </div>
        <button class="t-button" id="btnRefresh" name="btnPickupMaterialId" onclick=" RefreshCombobox('Transaction') ">
            <span class='t-icon t-refresh'></span>
        </button>
    </fieldset>
</div>
<div class="clear"></div>

<div class="cover-div">
    @{
        Html.Telerik().Grid<TransactionProductModel>()
            .Name("grid")
            .ToolBar(bar =>
                {
                    bar.Custom().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Text)
                            .Text(@HttpContext.GetGlobalResourceObject("Resource", "SaveDefaultText").ToString()).Name("A")
                       .HtmlAttributes(new { onclick = "AddDefault()", href = "#" });
                    bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
                        .SaveText(@HttpContext.GetGlobalResourceObject("Resource", "SaveChangesText").ToString())
                        .CancelText(@HttpContext.GetGlobalResourceObject("Resource", "CancelAll").ToString());
                })
            .DataKeys(keys => keys.Add(f => f.ProductInvId).RouteKey("productInvId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectProductLot", "Transaction", new { area = "Inv", transactionId = 0 })
     .Update("UpdateAddTransactionDetail", "Transaction", new { area = "Inv" }))
            .Columns(columns =>
            {
                columns.Bound(f => f.ProductId).Width(40)
                    .ClientTemplate("<#= ++index #>")
                    //.HeaderTemplate("<strong>STT</strong>")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Index").ToString())
                    .HtmlAttributes(new { style = "text-align: center;" });
                
                columns.Bound(f => f.ProductCode).Width(120).ReadOnly(true)
                    //.HeaderTemplate("<strong>Mã SP</strong>")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductCode2").ToString())
                    .Aggregate(agg => agg.Count())
                    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>");
                
                columns.Bound(f => f.ProductInvLot).Width(150)
                    //.Title("Lô")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Lot").ToString())
                    .ReadOnly(true);
                
                columns.Bound(f => f.ProductWeight).Width(90).ReadOnly(true)
                    //.HeaderTemplate("TL SP</br>(g/pc)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductWeight").ToString()
                        + "</br>(g/pc)"
                    )
                    .Format("{0:n3}")
                    .HtmlAttributes(new {style = "text-align: right;"});
                
                columns.Bound(f => f.ProductInvQuantity).ReadOnly(true).Width(90)
                    //.HeaderTemplate("Tồn kho</br>(pcs)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Inventory").ToString()
                        + "</br>(pcs)"
                    )
                    .Format("{0:n0}")
                    .HtmlAttributes(new {style = "text-align: right;"});
                
                columns.Bound(f => f.TransactionProductQuantity).ReadOnly(true).Width(90)
                    //.HeaderTemplate("SL cần</br>(pcs)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "RequiredQuantity2").ToString()
                        + "</br>(pcs)"
                    )
                    .ClientTemplate("<#= TransactionProductQuantity == 0 ? '' : $.telerik.formatString('{0:n0}', TransactionProductQuantity) #>")
                    .Aggregate(agg => agg.Sum())
                    .HtmlAttributes(new {style = "text-align: right;"})
                    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .FooterHtmlAttributes(new {style = "text-align: right;"});
                
                columns.Bound(f => f.ProductInvAvailable).ReadOnly(true).Width(95)
                    //.HeaderTemplate("Có thể</br>chuyển(pcs)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "AvailableTransfer1").ToString()
                        + "</br>(pcs)"
                    )
                    .Format("{0:n0}")
                    .HtmlAttributes(new {style = "text-align: right;"});
                
                columns.Bound(f => f.Quantity).Width(90)
                    //.HeaderTemplate("SL xuất</br>(pcs)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ExportQuantity2").ToString()
                        + "</br>(pcs)"
                    )
                    //.Format("{0:n0}")
                    .HtmlAttributes(new {style = "text-align: right;"})
                    .ClientTemplate("<span name='Quantity' class='Quantity'><#= $.telerik.formatString('{0:n0}', Quantity) #></span>")
                    .Aggregate(agg => agg.Sum())
                    //.ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><span id='GroupQuantity_<#= ++groupIndex #>'><#= $.telerik.formatString('{0:n0}', Sum) #></span></div>")
                    //.ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .ClientFooterTemplate("<span id='TotalQuantity'><#= $.telerik.formatString('{0:n0}', Sum) #></span>")
                    .FooterHtmlAttributes(new {style = "text-align: right;"});
                
                columns.Bound(f => f.Note)
                    //.Title("Ghi chú")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Note").ToString());
            })
            .Resizable(f => f.Columns(true))
            .ClientEvents(events => events.OnDataBinding("grid_OnDataBinding")
                .OnRowDataBound("grid_OnRowDataBound")
                .OnSave("grid_OnSave")
                .OnError("grid_OnError"))
            .Groupable(group => group.Groups(g => g.Add(model => model.ProductCode)).Visible(false))
            .Editable(f => f.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
            .Scrollable(f => f.Height(700))
            .Render();
    }
</div>
<div class="clear"></div>
<br />
