@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@model TransactionModel
@{
    ViewBag.Title = "Nhập mua NL";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
<!-- binding -->
<script type="text/javascript">
    function gridMaterialInventory_onDataBinding(args) {
        var po = $('#PONumber').data('tComboBox').value();
        if (po === "")
            po = 0;
        args.data = $.extend(args.data, {
            purchaseOrderId: po
        });
    }
</script>

<!-- pickup material -->
<script type="text/javascript">
    function PickupMaterialId() {

        var po = $('#PONumber').data('tComboBox').value();
        if (po === "")
            po = 0;
        var $checkedRecords = $(':checked');
        //var $checkedRecords = $("input[name='chkMaterialIds']:checked");

        if ($checkedRecords.length < 1) {
            alert("Vui lọn chọn ít nhất 1 nguyên liệu");
            return;
        }

        //$.ajaxSettings.traditional = false;
        var a = {};
        var ids = "";

        for (var i = 0; i < $checkedRecords.length; i++) {
            a[i] = $checkedRecords[i].value;

            ids += $checkedRecords[i].value;
            if (i < ($checkedRecords.length - 1))
                ids += ":";
        }
        
        $("#gridMaterialInventoryDetail").data("tGrid").rebind({
            ids: ids,
            poId : po,
        });
    }
    function grid_OnSave(e) {

        var $drawerCode = $(e.cell).find('#DrawerCode');

        if ($drawerCode.length > 0) {
            var drawerCode = $drawerCode.data("tComboBox"),
                drawerCodeSelectItem = drawerCode.selectedIndex > -1 ? drawerCode.data[drawerCode.selectedIndex] : null;
            if (drawerCodeSelectItem) {
                e.values["DrawerCode"] = drawerCodeSelectItem.Text;
                e.values["DrawerId"] = drawerCodeSelectItem.Value;
            }
        } else {
            var quantity = $(e.cell).find('#QuantityKg').val();
            var text = "";
            if (!isNaN(parseInt(quantity))) {
                var sumOrderQty = 0;
                var spanOrderQtys = $("span[name='QuantityKg']");
                for (var i = 0; i < spanOrderQtys.length; i++) {
                    var innerText = spanOrderQtys[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sumOrderQty = sumOrderQty + parseInt(innerText);
                }
                sumOrderQty = sumOrderQty + parseInt(quantity);
                $("#TotalQuantityKg").text(sumOrderQty.format(2));
            }
        }
    }
</script>


<!-- client event grid material inventory -->
<script type="text/javascript">

    function gridMaterialInventoryDetail_onSubmitChanges(e) {
        var monthlyDate = $("#ImportDate").data("tDatePicker").value();
        if (monthlyDate === null)
            monthlyDate = "";
        else
            monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);
        var po = $('#PONumber').data('tComboBox').value();
        if (po === "")
            po = 0;

        var exchangeRate = $("#ExchangeRate").val();
        if (exchangeRate === null || exchangeRate == "")
            exchangeRate = 1;
        e.values = $.extend(e.values,
            {
                exportOrImport: "@Convert.ToChar(MyUtilities.Transaction.EoIEnum.Import)",
                monthlyDate: monthlyDate,
                poId: po,
                exchangeRate: exchangeRate
            }
        );
    }
    function gridMaterialInventoryDetail_OnEdit(e) {

        var dataItem = e.dataItem;
        var mode = e.mode;
        var form = e.form;
        //var cell = e.cell;

        //var orderQty = $(form).find("#OrderQty").data("tTextBox");
        //var unitPrice = $(form).find("#UnitPrice").data("tTextBox");
        var lineTotal = $(form).find("#LineTotal").data("tTextBox");
        if (mode == 'insert') {

        }
        if (mode == 'edit') {

        }

        dataItem.LineTotal = dataItem.OrderQty * dataItem.UnitPrice;
        if (lineTotal != null) {
            lineTotal.value(dataItem.LineTotal);
        }

        var price = dataItem.UnitPrice;
        if (price == 0) {
            var materialId = dataItem.MaterialId;
            if (materialId != 0) {
                $.ajax({
                    type: 'post',
                    data: { materialId: materialId },
                    dataType: 'json',
                    url: '@Url.Action("CheckMaterialUnitPrice", "Material", new {area = ""})',
                        timeout: 20000,
                        success: function (data) {
                            var linePrice = $(form).find("#UnitPrice").data("tTextBox");
                            if (linePrice != null) {
                                linePrice.value(data);
                            }
                            dataItem.UnitPrice = data;
                        }
                    });
                }
            }
        }
    function Type_OnLoad() {
        var combobox = $('#Type').data('tDropDownList');
        var dataSource =
        [
            { Text: "Nhập hàng", Value: "1" },
            { Text: "Đổi hàng", Value: "2" }
        ];

        combobox.dataBind(dataSource);
    }

    function Type_OnChange() {
        var type = $('#Type').data('tDropDownList').value();
        var po = $('#PONumber').data('tComboBox');
        //var monthlyDate = combobox.text();
        $.ajax({
            type: 'post',
            data: {
                type: type,
                classtified:1,
            },
            dataType: 'json',
            url: '@Url.Action("SelectPOorPONote", "PurchaseOrder", new {area = "Purchasing"})',
                timeout: 20000,
                success: function (data) {
                    //$('#Invoice').data('tConbobox').dataBind(data);
                    po.dataBind(data);
                    RefreshGrid("gridMaterialInventory");
                }
            });
    }

    function PONumber_onChange(e) {
        $.ajax({
            type: 'post',
            data: {
                poId: e.value,
            },
            dataType: 'json',
            url: '@Url.Action("SelectPoInfo", "PurchaseOrder", new {area = "Purchasing"})',
                timeout: 20000,
                success: function (data) {
                    if (data != null) {
                        $("label[for*='Description']").text(data[0]);
                        var note = $("#SpecialNote");
                        if (note.val() == "") {
                            note.val(data[1]);
                        }
                        RefreshGrid("gridMaterialInventory");
                        RefreshGrid("gridMaterialInventoryDetail");
                    }
                }
          });
    }
    
    function TypeRefresh() {
        var type = $('#Type').data('tDropDownList').value();
        var po = $('#PONumber').data('tComboBox');
        //po.clear();
        //var monthlyDate = combobox.text();
        $.ajax({
            type: 'post',
            data: {
                type: type,
                classtified: 1,
            },
            dataType: 'json',
            url: '@Url.Action("SelectPOorPONote", "PurchaseOrder", new {area = "Purchasing"})',
            timeout: 20000,
            success: function (data) {
                //$('#Invoice').data('tConbobox').dataBind(data);
                po.dataBind(data);
                RefreshGrid("gridMaterialInventory");
            }
        });
        
    }
    function drawerGrid_OnDataBinding(e) {
        e.data = $.extend(e.data, {
            classifiedId: 1,
        });
    }
</script>
}

<div class="title">Phiếu nhập nguyên liệu</div>

<div class="t-info-sha" style="padding-left: 15px;padding-right: 15px; width:1000px;">
    <fieldset>
        <legend>Thông tin phiếu lệnh nhập</legend>
        <div class="grid_13">
        <div class="grid_2">Hình thức:</div>
        <div class="grid_4">
            @{
                Html.Telerik().DropDownList()
                    .Name("Type")
                    //.DataBinding(binding => binding.Ajax().Select("SelectOrderApprovedDueDate", "Orders", new { area = "Sales" }))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 150px" })
                    .ClientEvents(events => events.OnLoad("Type_OnLoad").OnChange("Type_OnChange"))
                    .Render();
            }
        </div>
         <div class="grid_1">
                         <button class="t-button" id="btnRefresh" name="btnPickupMaterialId" onclick=" TypeRefresh() ">
                             <span class='t-icon t-refresh'></span>
                         </button>
                     </div>
        
       
     
        
        <div class="grid_1_5">Tỉ giá</div>
        <div class="grid_1_5">(@Html.LabelFor(f => f.Description, new {style = "width: 70px;font-weight:bold",val=" "}))</div>
        <div class="grid_1_5">
            @{
                Html.Telerik().IntegerTextBox()
                    .Name("ExchangeRate")
                    .Value(1)
                    .InputHtmlAttributes(new { style = "width: 50px" })
                    .Render();
            }
        </div>
        

        <div class="clear"></div><br />
        <div class="grid_2">Số phiếu</div>
        <div class="grid_5">
            @{
                Html.Telerik().ComboBox()
                    .Name("PONumber")
                    //.DataBinding(binding => binding.Ajax().Select("SelectComboBoxMaterialType", "Material", new { area = "" }))
                    .HtmlAttributes(new { style = "width: 150px; " })
                    .DropDownHtmlAttributes(new { style = "width: 250px; " })
                    .Encode(false)
                    .AutoFill(true)
                    .HighlightFirstMatch(true)
                    .ClientEvents(events => events.OnChange("PONumber_onChange")
                    )
                    .Render();
            }
        </div>
           <div class="grid_2">Ngày nhập</div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("ImportDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>

        </div>
        <div>
        <div class="grid_2">Ghi chú</div>
        <div class="grid_5">@Html.TextAreaFor(f => f.SpecialNote, new { style = "width: 250px; height: 50px; " , @readonly="readonly" })</div>
        </div>
    </fieldset>
</div>
<div class="clear"></div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<PurchaseOrderDetailModel>()
            .Name("gridMaterialInventory")
            .ToolBar(bar => bar.Template(
                @<text>
                     <div class="grid_7">
                         <button class="t-button" id="btnPickupMaterialId" name="btnPickupMaterialId" onclick=" PickupMaterialId() ">
                             <span class='t-icon t-insert'></span>
                             Chọn các nguyên liệu vào lưới
                         </button>
                     </div>
                     <div class="clear"></div>
                 </text>
))
            .DataKeys(keys => keys.Add(f => f.PurchaseOrderDetailId).RouteKey("purchaseOrderDetailId"))
                                       .DataBinding(dataDindings => dataDindings.Ajax()
                                                                                .Select("SelectPurchaseOrderDetailByPOId", "PurchaseOrder",
                                                                                        new { area = "Purchasing", purchaseOrderId = 0 }))
            .Columns(columns =>
                {
                    columns.Bound(f => f.PurchaseOrderDetailId).Title("Chọn").Width(75)
                           .ClientTemplate("<input type='checkbox' name='chkIds' value='<#= PurchaseOrderDetailId #>' />")
                           .HtmlAttributes(new { style = "text-align:center" });
                    columns.Bound(f => f.VendorCodeName).Width(150);
                    columns.Bound(f => f.Code).Width(150);
                    columns.Bound(f => f.Unit).Width(50).Title("ĐVT")
                           .HtmlAttributes(new { style = "text-align:center" });
                    columns.Bound(f => f.OrderQty).Title("Số lượng yêu cầu").Width(100)
                           .HtmlAttributes(new { style = "text-align:right" })
                           .ClientTemplate("<#= OrderQty == null ? 0 : $.telerik.formatString('{0:n2}', OrderQty) #>");
                    columns.Bound(f => f.RequireQty).Title("Số lượng còn lại").Width(100)
                           .HtmlAttributes(new { style = "text-align:right" })
                          .ClientTemplate("<#= RequireQty == null ? 0 : $.telerik.formatString('{0:n2}', RequireQty) #>");
                    columns.Bound(f => f.Note).Title("Ghi chú");
                })
            .Scrollable(f => f.Height(200))
            .ClientEvents(events => events.OnDataBinding("gridMaterialInventory_onDataBinding").OnError("grid_OnError"))
            //.Filterable()
            .Pageable(f => f.PageOnScroll(true).Style(Telerik.Web.Mvc.UI.GridPagerStyles.Status))
            .Render();
    }
</div>
<div class="clear"></div><br/>
<div class="t-info-sha" style="padding-left: 15px; width:250px; color: Maroon;">Chi tiết lệnh nhập nguyên liệu</div>
<div class="cover-div">
@{
    Html.Telerik().Grid<MaterialInventoryModel>()
        .Name("gridMaterialInventoryDetail")
        .ToolBar(bar => bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).SaveText("Lưu tất cả").CancelText("Xóa tất cả"))
        .DataKeys(keys => keys.Add(f => f.MaterialId).RouteKey("materialId"))
        .DataBinding(dataBindings => dataBindings.Ajax()
                                                 .Select("SelectMaterialInPO", "Inv", new {materialIds = "", poId = 0})
                                                 .Update("ImportTransactionMaterialInventoryByPO", "Transaction"))
        .Columns(columns =>
            {
                columns.Bound(f => f.MaterialCode).Width(180).ReadOnly(true)
                       .FooterHtmlAttributes(new {style = "text-align: right;"})
                       .Aggregate(agg => agg.Count())
                       .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>");

                columns.Bound(f => f.VendorName).Width(150).ReadOnly(true);
                columns.Bound(f => f.TotalQtyKg).Width(50).Title("SL đặt").ReadOnly(true)
                       .HtmlAttributes(new {style = "text-align:right"})
                       .ClientTemplate("<span name='TotalQtyKg'><#= TotalQtyKg == null ? 0 : $.telerik.formatString('{0:n0}', TotalQtyKg) #></span>");

                columns.Bound(f => f.Unit).Width(40).ReadOnly(true).Title("ĐVT")
                       .HtmlAttributes(new {style = "text-align:center"});
                columns.Bound(f => f.Length).Width(40)
                        .HeaderTemplate("Dài</br>(mm)")
                        .HeaderHtmlAttributes(new { @class = "edit-column" })
                       .HtmlAttributes(new {style = "text-align:center"});
                columns.Bound(f => f.QuantityKg).Width(50)
                       .HeaderTemplate("Số lượng</br>nhập")
                        .HeaderHtmlAttributes(new { @class = "edit-column" })
                        .HtmlAttributes(new { style = "text-align: right;" })
                       .ClientTemplate("<span name='QuantityKg'><#= QuantityKg == null ? 0 : $.telerik.formatString('{0:n3}', QuantityKg) #></span>")
                       .FooterTemplate("<span id='TotalQuantityKg'></span>");
                
                columns.Bound(f => f.UnitWeight).Width(60)
                       .HeaderTemplate("Trọng lượng</br>(kg/cây)")
                        .HeaderHtmlAttributes(new { @class = "edit-column" })
                        .HtmlAttributes(new { style = "text-align: right;" })
                       .ClientTemplate("<span name='UnitWeight'><#= UnitWeight == null ? 0 : $.telerik.formatString('{0:n4}', UnitWeight) #></span>")

                    ;
                //columns.Bound(f => f.LotNumber).Width(50)
                //       .HtmlAttributes(new {style = "text-align:right"});
                //columns.Bound(f => f.StoreCode).Width(100).Title("Sơ đồ");
                columns.Bound(f => f.DrawerCode).Width(100).Title("Lên kệ");
                columns.Bound(f => f.Note);
                columns.Command(commands => commands.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(40).Title("");
            })
        .ClientEvents(events => events
                                    .OnSubmitChanges("gridMaterialInventoryDetail_onSubmitChanges")
                                    .OnSave("grid_OnSave")
                                    .OnError("grid_OnError")
        )
        .Editable(f => f.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
        .Footer(true)
        .Render();
}
</div>