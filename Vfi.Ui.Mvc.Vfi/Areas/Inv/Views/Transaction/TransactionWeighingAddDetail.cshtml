@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@{
    ViewBag.Title = "Phân lô cân hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">

        var index = 0;

        function grid_OnDataBinding(args) {
            var warehouseIssue = $("#WarehouseIssueName").data('tComboBox').value();
            if (warehouseIssue === "")
                warehouseIssue = 0;
            args.data = $.extend(args.data,
            {
                warehouseId: warehouseIssue
            });
            index = 0;
            firstRow = "";
        }

        function warehouseIssue_onChange() {

            var warehouseIssue = $("#WarehouseIssueName").data('tComboBox').value();
            if (warehouseIssue === "" || warehouseIssue === 0) { return; }
            $.ajax({
                type: 'post',
                data: {
                    warehouseId: warehouseIssue
                },
                dataType: 'json',
                url: '@Url.Action("SelectComboBoxWarehouseRotateById", "Warehouse", new { area = "Inv" })',
                timeout: 20000,
                success: function (data) {
                    $("#WarehouseReceiptName").data('tDropDownList').dataBind(data);
                }
            });
            RefreshGrid("gridTransactionDetail");
        }

        var ids = "";
        function PickupProductId() {

            var $checkedRecords = $("input[name='chkIds']:checked")

            if ($checkedRecords.length < 1) {
                alert("Vui lọn chọn ít nhất 1 sản phẩm");
                return;
            }
            var a = {};
            ids = "";
            for (var i = 0; i < $checkedRecords.length; i++) {
                if ($checkedRecords[i] === "0") continue;
                a[i] = $checkedRecords[i].value;

                ids += $checkedRecords[i].value;
                if (i < ($checkedRecords.length - 1))
                    ids += ":";
            }
            if (confirm("Đồng ý lưu ?")) {
                OnLoadingData();
                var warehouseIssue = $("#WarehouseIssueName").data('tComboBox').value();
                if (warehouseIssue === "") { warehouseIssue = 0; }
                var warehouseReceipt = $("#WarehouseReceiptName").data('tDropDownList').value();
                if (warehouseReceipt === "") { warehouseReceipt = 0; }

                var date = $("#Date").data("tDatePicker").value();
                if (date === null) date = new Date();
                date = $.telerik.formatString('{0:dd/MM/yyyy}', date);
                $.post('@Url.Action("CreateTransactionWeighingProduct", "Transaction")',
                    {
                        ids: ids,
                        warehouseIssueId: warehouseIssue,
                        warehouseReceiptId: warehouseReceipt,
                        date: date
                    },
                    function (data) {
                        OnLoadedData();
                        if (data.Code === 1) {
                            RefreshGrid("gridTransactionDetail");
                        } else {
                            alert(data.Message);
                        }
                    });
            }
            index = 0;
        }
        var firstRow = "";
        function grid_OnRowDataBound(e) {
            if (e.dataItem.WeighingId != firstRow) {
                firstRow = e.dataItem.WeighingId;
                if (!e.dataItem.CanCreate) {
                    e.row.childNodes[7].style.backgroundColor = "#F4FA58";
                }
            } else {
                e.row.childNodes[6].innerHTML = "";
                e.row.childNodes[7].innerHTML = "";
            }
            if (e.dataItem.CanCreate) {
            } else {
                e.row.childNodes[2].innerHTML = "";
            }
        }
        function checkAll(weighingId) {
            var checkBoxes = $("input[checkName='w_" + weighingId + "']");
            for (i = 0; i < checkBoxes.length; i++) {
                checkBoxes[i].checked = true;
            }
        }

        var onLoading = false;
        function OnLoadingData() {
            if (!onLoading) {
                onLoading = true;
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (Chờ load)";
                    loading.classList.add('loading');
                }
            }
        }
        function OnLoadedData() {
            if (onLoading) {
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    if (loading && loading.className.includes("loading")) {
                        loading.classList.remove('loading');
                        loading.innerHTML = "<span></span>";
                    }
                }
                onLoading = false;
            }
        }

        var startGrid = false;
        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }
    </script>

}

<div class="title">
    @*Phân lô cân hàng*@
    @HttpContext.GetGlobalResourceObject("Resource", "TransactionWeighingAddDetail")
</div>

<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">

    <fieldset>
        <legend>
            @*Thông tin phiếu xuất*@
            @HttpContext.GetGlobalResourceObject("Resource", "TransactionInformation")
        </legend>
        <div class="grid_2">
            @*Kho*@
            @HttpContext.GetGlobalResourceObject("Resource", "Warehouse")
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("WarehouseIssueName")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxImportWarehouse", "Warehouse"))
                    .HtmlAttributes(new { style = "width: 100%" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .HighlightFirstMatch(true)
                    .AutoFill(true)
                    .ClientEvents(events => events.OnChange("warehouseIssue_onChange"))
                    .Render();                                              
            }
        </div>

        <div class="grid_2">
            @*Kho nhận*@
            @HttpContext.GetGlobalResourceObject("Resource", "ReceiptWarehouse")
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().DropDownList()
                    .Name("WarehouseReceiptName")
                    .HtmlAttributes(new { style = "width: 100%" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .Render();
            }
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("Date")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today)
                    .Render();
            }
        </div>
        
    </fieldset>
</div>
<div class="clear"></div>

<div class="t-info-sha" style="padding-left: 15px; width: 250px; color: Maroon;">
    @*Danh sách sản phẩm cân hàng*@
    @HttpContext.GetGlobalResourceObject("Resource", "ProductsSheet")
    <button class="t-button" id="btnRefresh" name="btnPickupMaterialId" onclick=" RefreshGrid2('gridTransactionDetail')">
        <span class='t-icon t-refresh'></span>
    </button>
</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<TransactionWeighingModel>()
            .Name("gridTransactionDetail")
            //.ToolBar(bar => bar.SubmitChanges().ButtonType(GridButtonType.ImageAndText).SaveText("Lưu lại").CancelText("Bỏ chọn"))
            .ToolBar(bar => bar.Template(
        @<text>
        <div class="grid_8">
            <button class="t-button" id="btnPickupProductId" name="btnPickupProductId" onclick=" PickupProductId() ">
                <span class='t-icon t-insert'></span>
                @*Tạo phiếu luân chuyển kho*@
                @HttpContext.GetGlobalResourceObject("Resource", "CreateTransferWarehouseForm")
                <span class="twoToneButton"></span>
            </button>
        </div>
        <div class="clear"></div>
        </text>
))
            .DataKeys(keys => keys.Add(f => f.IdentityWeighing).RouteKey("identityWeighing"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectTransactionWeighingProduct", "Transaction", new { warehouseId = 0, status = (byte)MyUtilities.Transaction.Status.Open, fromDate = "", toDate = "" })
                )
            .Columns(columns => {
                columns.Bound(f => f.ProductId).Width(30).ReadOnly(true)
                    .ClientTemplate("<#= ++index #>")
                    //.HeaderTemplate("<strong>STT</strong>")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Index").ToString());
              
                columns.Bound(f => f.IdentityWeighing)
                    //.Title("Chọn")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Select").ToString())
                    .Width(75)
                    .ClientTemplate("<input type='checkbox' name='chkIds' value='<#= IdentityWeighing #>' checkName='w_<#= WeighingId #>' />")
                    .HtmlAttributes(new { style = "text-align:center" });
               
                columns.Bound(f => f.CustomerCode).Width(70)
                    //.HeaderTemplate("Khách hàng")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Customer").ToString())
                    .ReadOnly(true);
               
                columns.Bound(f => f.ProductCode).Width(120)
                    //.Title("Mã SP")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductCode2").ToString())
                    .ReadOnly(true)
                    .Aggregate(agg => agg.Count())
                    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                    .FooterHtmlAttributes(new { style = "text-align: center;" });
               
                columns.Bound(f => f.UnitWeight).Width(70).ReadOnly(true)
                    //.HeaderTemplate("TL SP (g/pc)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductWeight").ToString()
                        + " (g/pc)"
                    )
                    .Format("{0:n3}")
                    .HtmlAttributes(new { style = "text-align: right;border-right: 1px black solid;" });

                columns.Bound(f => f.Weight).Width(90)
                    //.HeaderTemplate("Trọng lượng cân(kg)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "UnitWeight").ToString()
                        + " "
                        + @HttpContext.GetGlobalResourceObject("Resource", "Weighing").ToString()
                        + "(kg)"
                    )
                    .ReadOnly(true)
                    .Format("{0:n2}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                    //.Aggregate(agg => agg.Sum())
                    //.ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                    //.ClientFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                    //.FooterHtmlAttributes(new { style = "text-align: right;" });
              
                columns.Bound(f => f.Quantity).Width(90)
                    //.HeaderTemplate("Số lượng cân(pcs)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Quantity").ToString()
                        + " "
                        + @HttpContext.GetGlobalResourceObject("Resource", "Weighing").ToString()
                        + "(pcs)"
                    ).ReadOnly(true)
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                    //.Aggregate(agg => agg.Sum())
                    //.ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    //.ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    //.FooterHtmlAttributes(new { style = "text-align: right;" });

                columns.Bound(f => f.LotNumber).Width(70)
                    //.HeaderTemplate("Lô tồn kho")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Lot").ToString()
                        + " "
                        + @HttpContext.GetGlobalResourceObject("Resource", "Inventory").ToString()
                    )
                    .ReadOnly(true);
               
                columns.Bound(f => f.InvWeight).Width(90)
                    //.HeaderTemplate("Trọng lượng tồn(kg)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "UnitWeight").ToString()
                        + " "
                        + @HttpContext.GetGlobalResourceObject("Resource", "Inv").ToString()
                        + "(kg)"
                    )
                    .ReadOnly(true)
                    .Format("{0:n2}")
                    .HtmlAttributes(new { style = "text-align: right;border-right: 1px black solid;" })
                    .Aggregate(agg => agg.Sum())
                    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                    .FooterHtmlAttributes(new { style = "text-align: right;" });
            
                columns.Bound(f => f.InvQuantity).Width(90)
                    //.HeaderTemplate("Số lượng tồn(pcs)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Quantity").ToString()
                        + " "
                        + @HttpContext.GetGlobalResourceObject("Resource", "Inv").ToString()
                        + "(pcs)"
                    )
                    .ReadOnly(true)
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" })
                    .Aggregate(agg => agg.Sum())
                    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .FooterHtmlAttributes(new { style = "text-align: right;" });
               
                columns.Bound(f => f.WeighingId).Width(120).ReadOnly(true).Width(1).Title("").ClientTemplate(" ")
                    .ClientGroupHeaderTemplate("<input type='checkbox' name='chkGroups' value='0' onChange='checkAll(<#= Key #>)' />");
            })
            .ClientEvents(events => events
                .OnDataBinding("grid_OnDataBinding")
                .OnRowDataBound("grid_OnRowDataBound")
                .OnError("grid_OnError")
            )
            .KeyboardNavigation()
            .Groupable(group => group.Groups(g => g.Add(model => model.WeighingId)).Visible(false))
            .Render();   
    }
</div>

<div class="clear"></div>
<br />
