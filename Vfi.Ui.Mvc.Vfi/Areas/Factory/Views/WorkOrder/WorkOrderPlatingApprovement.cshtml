@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Duyệt gia công ngoài";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">
        function PrintForm(val) {
            var $item = $('#id_' + val);
            var $formType = $item.attr('ftype');
            $('#result').load('@Url.Action("PrintImportExportForm", "Inv", new { area="Inv"})',
                {
                    transactionId: val,
                    formType: $formType,
                }, function (data) {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }
    </script>

}

<div class="title">
    @*Duyệt gia công ngoài*@
    @HttpContext.GetGlobalResourceObject("Resource", "WorkOrderPlatingApprovement")
</div>

<div class="t-info-sha" style="padding-left: 15px; width: 550px; color: Maroon;">
    @*Danh sách lệnh*@
    @HttpContext.GetGlobalResourceObject("Resource", "OrdersSheet")
    <span class="processButton"></span></div>
