        function SaveProcess() {
            if (!onProcessing) {
                OnProcessingData();
                var workOrder = $("#WorkOrder").data('tComboBox').value();
                if (workOrder === "") workOrder = 0;
                var employee = $("#Employee").data('tComboBox').value();
                if (employee === "" || employee === "-1") employee = 0;
                var productWeight = $("#ProductWeight").data("tTextBox").value();
                if (workOrder === 0 || employee === 0 || productWeight === 0) {
                    alert("Lỗi Vui lòng điền đủ thông tin: nhân viên, trọng lượng SP");
                    OnProcessedData();
                    return;
                }
                var processDate = $("#ProcessDate").data("tDateTimePicker").value();
                if (processDate === null)
                    processDate = "";
                else
                    processDate = $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', processDate);
                $.ajax({
                    type: 'post',
                    data: {
                        routingId: workOrder,
                        employeeId: employee,
                        productWeight: productWeight,
                        machineId: 0,
                        processDate: processDate,
                        usingQuantity: dataInput.UsingQuantity,
                        goodQuantity: dataInput.GoodQuantity,
                        ngQuantity: dataInput.NGQuantity,
                        defectQuantity: dataInput.DefectQuantity,
                    },
                    dataType: 'json',
                    url: '@Url.Action("SaveWorkOrderProcess", "WorkOrder", new { area = "Factory" })',
                    timeout: 20000,
                    success: function (res) {
                        if (res.Code === 1) {
                            alert("Đã lưu " + res.Data);
                            if (res.Message && res.Message != "") {
                                alert(res.Message);
                            }
                            ClearData();
                            RefreshCombobox("WorkOrder");
                            RefreshGrid("grid");
                        } else {
                            alert("Lỗi! " + res.Message);
                        }
                        OnProcessedData();
                    }
                });

            }
        }
        

        function grid_OnDataBound() {
            OnProcessedData();
        }

        productionRate = 0;
        var dataInput = {
            UsingQuantity: 0,
            GoodQuantity: 0,
            NGQuantity: 0,
            DefectQuantity: 0,
        };
        function grid_OnSave(e) {
            var goodQuantityCell = $(e.cell).find('#GoodQuantity').val();
            var goodWeightCell = $(e.cell).find('#GoodWeight').val();
            var ngQuantityCell = $(e.cell).find('#NGQuantity').val();
            var ngWeightCell = $(e.cell).find('#NGWeight').val();
            var defectQuantityCell = $(e.cell).find('#DefectQuantity').val();
            var defectWeightCell = $(e.cell).find('#DefectWeight').val();
            var usingQuantityCell = $(e.cell).find('#UsingQuantity').val();
            var spanProduction = e.cell.parentElement.getElementsByClassName("ProductionQuantity")[0];
            var productWeight = e.dataItem.ProductWeight;
            if (!isNaN(parseInt(goodQuantityCell))) {
                dataInput.GoodQuantity = parseInt(goodQuantityCell);
                var span = e.cell.parentElement.getElementsByClassName("GoodWeight")[0];
                span.textContent = parseInt(dataInput.GoodQuantity * productWeight).format(0);
            }
            else if (!isNaN(parseInt(goodWeightCell))) {
                dataInput.GoodQuantity = parseInt(parseInt(goodWeightCell) / productWeight);
                e.dataItem.GoodQuantity = dataInput.GoodQuantity;
                var span = e.cell.parentElement.getElementsByClassName("GoodQuantity")[0];
                span.textContent = dataInput.GoodQuantity.format(0);
            }
            else if (!isNaN(parseInt(ngQuantityCell))) {
                dataInput.NGQuantity = parseInt(ngQuantityCell);
                var span = e.cell.parentElement.getElementsByClassName("NGWeight")[0];
                span.textContent = parseInt(dataInput.NGQuantity * productWeight).format(0);
            }
            else if (!isNaN(parseInt(ngWeightCell))) {
                dataInput.NGQuantity = parseInt(parseInt(ngWeightCell) / productWeight);
                e.dataItem.NGQuantity = dataInput.NGQuantity;
                var span = e.cell.parentElement.getElementsByClassName("NGQuantity")[0];
                span.textContent = dataInput.NGQuantity.format(0);
            }
            else if (!isNaN(parseInt(defectQuantityCell))) {
                dataInput.DefectQuantity = parseInt(defectQuantityCell);
                var span = e.cell.parentElement.getElementsByClassName("DefectWeight")[0];
                span.textContent = parseInt(dataInput.DefectQuantity * productWeight).format(0);
            }
            else if (!isNaN(parseInt(defectWeightCell))) {
                dataInput.DefectQuantity = parseInt(parseInt(defectWeightCell) / productWeight);
                e.dataItem.DefectQuantity = dataInput.DefectQuantity;
                var span = e.cell.parentElement.getElementsByClassName("DefectQuantity")[0];
                span.textContent = dataInput.DefectQuantity.format(0);
            }
            else if (!isNaN(parseInt(usingQuantityCell))) {
                dataInput.UsingQuantity = parseFloat(parseFloat(usingQuantityCell).toFixed(roundNumberConfig));
                //var span = e.cell.parentElement.getElementsByClassName("UsingQuantity")[0];
                //span.textContent = dataInput.UsingQuantity.format(roundNumberConfig);

                e.values["UsingQuantity"] = dataInput.UsingQuantity.format(roundNumberConfig);
                e.dataItem.UsingQuantity = dataInput.UsingQuantity;
                var production = parseInt(dataInput.UsingQuantity * productionRate);
                e.dataItem.PreviousRouteQuantity = production;
                spanProduction.textContent = production.format(0);
            }
            e.dataItem.DiffQuantity = (dataInput.GoodQuantity + dataInput.NGQuantity + dataInput.DefectQuantity)
                                        - dataInput.UsingQuantity * productionRate;

            var spanDiff = e.cell.parentElement.getElementsByClassName("DiffQuantity")[0];
            spanDiff.textContent = e.dataItem.DiffQuantity.format(0);
            spanDiff = e.cell.parentElement.getElementsByClassName("DiffQuantityKg")[0];
            spanDiff.textContent = productionRate > 0 ? (e.dataItem.DiffQuantity / productionRate).format(1) : "0";

            if (e.dataItem.DiffQuantity > 0) {
                // wrong: orange;
                spanProduction.parentNode.bgColor = "orange";
                spanDiff.parentNode.bgColor = "orange";
            }
            else if (e.dataItem.DiffQuantity < 0) {
                // not done: yellow
                spanProduction.parentNode.bgColor = "yellow";
                spanDiff.parentNode.bgColor = "";
            } else {
                // right
                spanProduction.parentNode.bgColor = "";
                spanDiff.parentNode.bgColor = "";
            }
        }

        function grid_OnRowDataBound(e) {
            e.dataItem.DiffQuantity = e.dataItem.DiffQuantity * -1;
            if (e.dataItem.DiffQuantity > 0) {
                e.row.lastChild.bgColor = 'orange';
                e.row.lastChild.childNodes[0].innerText = e.dataItem.DiffQuantity;
            }
        }
    </script>
    <script>
        function Connect() {
            //var second = $("#AutoDataSecond").data("tTextBox").value();
            //if (second > 0) {
                $.ajax({
                    type: 'post',
                    data: {},
                    dataType: 'json',
                    url: '@Url.Action("ConnectWeighingDevice", "Transaction", new { area = "Inv" })',
                    timeout: 20000,
                    success: function (data) {
                        if (data === 1) {
                            alert("Kết nối thành công");
                            //connect_OnChange(true);
                            stopInterval = false;
                            var interval = setInterval(function () {
                                GetWeighingValue();
                                if (stopInterval) clearInterval(interval);
                            }, 3000);
                        } else if (data === 8) {
                            alert("Kết nối bị lỗi! Vui lòng rút đầu USB và cắm lại");
                        } else if (data === 9) {
                            alert("Không tìm thấy thiết bị");
                        } else { alert("Kết nối không thành công"); }
                    }
                });
            //} else {
            //    alert("Lỗi! Vui lòng chỉnh tự động nạp > 0");
            //}
        }

        function DisConnect() {
            stopInterval = true;
            $.ajax({
                type: 'post',
                data: {},
                dataType: 'json',
                url: '@Url.Action("DisConnectWeighingDevice", "Transaction", new { area = "Inv" })',
                timeout: 20000,
                success: function (data) {
                    if (data === 1) {
                        //$("#btnConnect")[0].removeAttribute("style");
                        //connect_OnChange(false);
                        alert("Đã ngắt kết nối");
                    } else { alert("Ngắt kết nối không thành công"); }
                }
            });
        }

        var quantity = 0;
        var weight = 0;
        function GetWeighingValue() {
            var unitWeight = $("#ProductWeight").data("tTextBox").value();
            var packageWeight = $("#PackageWeight").data("tTextBox").value();
            //var tolerance = $("#Tolerance").data("tTextBox").value();
            $.ajax({
                type: 'post',
                data: {},
                dataType: 'json',
                url: '@Url.Action("GetWeighingValue", "Transaction", new { area = "Inv" })',
                timeout: 4000,
                success: function (data) {
                    if (data >= 0) {
                        weight = data * 1000 - packageWeight;
                        $("#WeighValue")[0].innerText = data.format(2);
                        if (unitWeight > 0) {
                            if (quantity != weight / unitWeight) {
                                quantity = weight / unitWeight;
                                if (quantity < 0) quantity = 0;
                                $("#QuantityValue")[0].innerText = (quantity).format(0);
                                dataInput.GoodQuantity = quantity.format(0);
                                RefreshGrid("grid");
                            }
                        } else {
                            $("#QuantityValue")[0].innerText = "0";
                        }
                    }
                }
            });
        }

    </script>
    <script>
        function setDecimalDigits() {
            var numberTextBox = $("#UsingQuantity").data("tTextBox");
            numberTextBox.digits = roundNumberConfig;
        }

        function number_OnLoad(e) {
            setDecimalDigits();
        }
    </script>
}

