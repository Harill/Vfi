@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Phát NL theo WO";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnProcess.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnLoad.js")"></script>
    <script type="text/javascript">

        $(document).ready(function () {
            roundNumberConfig = @Model
            loadEmployeeLogin();
        });

        function loadEmployeeLogin() {
            $.ajax({
                type: 'post',
                data: {},
                dataType: 'json',
                url: '@Url.Action("GetComboBoxEmployeeLogin", "Employee", new { area = "Sales" })',
                timeout: 20000,
                success: function (data) {
                    //a
                    var cbo = $('#Employee').data('tComboBox');
                    cbo.dataBind(data);
                    if (cbo.selectedIndex > -1) {

                        var selected = cbo.data[cbo.selectedIndex];

                        if (selected != undefined) {
                            cbo.value(selected.Value);
                            cbo.text(selected.Text);
                            cbo.selectedIndex = cbo.selectedIndex;
                            cbo.previousValue = selected.Value;
                        } else {
                            cbo.value(-1);
                            cbo.text("");
                        }
                    } else {
                        cbo.value(-1);
                        cbo.text("");
                    }
                }
            });
        }

        function CreateWorkOrderMaterialAssignment() {
            if (!onProcessing) {
                OnProcessingData();
                var $checkedRecords = $("input[name='chkIds']:checked")

                if ($checkedRecords.length < 1) {
                    alert("Vui lọn chọn ít nhất 1 kệ");
                    OnProcessedData();
                    return;
                }

                var a = {};
                checkedRecords = "";
                for (var i = 0; i < $checkedRecords.length; i++) {
                    if ($checkedRecords[i] === "0") continue;
                    a[i] = $checkedRecords[i].value;

                    checkedRecords += $checkedRecords[i].value;
                    if (i < ($checkedRecords.length - 1))
                        checkedRecords += ":";
                }
                var employee = $('#Employee').data('tComboBox').value();
                if (employee === "") {
                    employee = 0;
                }
                if (checkedRecords.length > 0 && employee > 0) {
                    $.ajax({
                        type: 'post',
                        data: { ids: checkedRecords, employeeId: employee, },
                        dataType: 'json',
                        url: '@Url.Action("AssignMaterialWorkOrders", "WorkOrder", new { area = "Factory" })',
                        timeout: 20000,
                        success: function (res) {
                            if (res.Code === 1) {
                                alert("Hoàn thành lưu " + res.Data);
                                RefreshGrid("grid");
                            } else {
                                alert(res.Message);
                            }
                            OnProcessedData();
                        }
                    });
                } else {
                    alert("Lỗi! Vui lòng chọn nguyên liệu cần phát và nhân viên!");
                    OnProcessedData();
                }
            }
            return false;
        }

        function printWOAssignMaterial() {
            if (!onLoading) {
                OnLoadingData();
                var printDate = $("#PrintDate").data("tDatePicker").value();
                if (printDate === null)
                    printDate = new Date();
                else
                    printDate = $.telerik.formatString('{0:dd/MM/yyyy}', printDate);
                var isAll = $("input[name='chkAll']").attr('checked');
                var haveInventory = $("input[name='chkInventory']").attr('checked');
                var haveWorkOrder = $("input[name='chkWorkOrder']").attr('checked');
                $('#result').load('@Url.Action("PrintWOAssignMaterial", "WorkOrder")',
                    {
                        printDate: printDate,
                        isAll: isAll,
                        haveInventory: haveInventory,
                        haveWorkOrder: haveWorkOrder
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

        function printWOMaterialUse() {
            if (!onLoading) {
                OnLoadingData();
                var printDate = $("#PrintDate").data("tDatePicker").value();
                if (printDate === null)
                    printDate = new Date();
                else
                    printDate = $.telerik.formatString('{0:dd/MM/yyyy}', printDate);
                $('#result').load('@Url.Action("PrintWOMaterialUse", "WorkOrder", new { area = "Factory" })',
                    {
                        date: printDate
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

        function printBarcode() {
            if (!onLoading) {
                OnLoadingData();
                var $checkedRecords = $("input[name='chkIds']:checked")

                if ($checkedRecords.length < 1) {
                    alert("Vui lọn chọn ít nhất 1 kệ");
                    OnProcessedData();
                    return;
                }

                var a = {};
                checkedRecords = "";
                for (var i = 0; i < $checkedRecords.length; i++) {
                    if ($checkedRecords[i] === "0") continue;
                    a[i] = $checkedRecords[i].value;

                    checkedRecords += $checkedRecords[i].value;
                    if (i < ($checkedRecords.length - 1))
                        checkedRecords += ":";
                }
                $('#result').load('@Url.Action("PrintBarcode", "WorkOrder", new { area = "Factory" })',
                    {
                        ids: checkedRecords
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }
    </script>
}

<div class="title">@HttpContext.GetGlobalResourceObject("Resource", "WorkOrderMaterialAssignment")</div>

<div class="t-info-sha" style="padding-left: 15px;padding-right: 15px;">
    
        <div class="grid_1">@HttpContext.GetGlobalResourceObject("Resource", "Date")</div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("PrintDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today)
                    .Render();
            }
        </div>
        <button id="btnPrintAssign" class="t-button" onclick="printWOAssignMaterial();">
            <span class='t-icon t-insert'></span>
            @*In Phát nguyên liệu*@
             @HttpContext.GetGlobalResourceObject("Resource", "Print") @HttpContext.GetGlobalResourceObject("Resource", "AssignMaterial")
            <span class="loadButton"></span>
        </button>
        <label>
            <input type="checkbox" id="chkAll" name="chkAll" />
            @HttpContext.GetGlobalResourceObject("Resource", "AllMachine")
        </label>
        <label>
            <input type="checkbox" id="chkInventory" name="chkInventory" checked />
            @HttpContext.GetGlobalResourceObject("Resource", "HaveInventory")
        </label>
        <label>
            <input type="checkbox" id="chkWorkOrder" name="chkWorkOrder" checked />
            @HttpContext.GetGlobalResourceObject("Resource", "HaveWO")
        </label>
        <div class="clear"></div><br />
    
        
        <button id="btnPrintUsing" class="t-button" onclick="printWOMaterialUse();">
            <span class='t-icon t-insert'></span>
            @*In nguyên liệu sử dụng*@
            @HttpContext.GetGlobalResourceObject("Resource", "Print") @HttpContext.GetGlobalResourceObject("Resource", "MaterialUsed")
            <span class="loadButton"></span>
        </button>
        <button id="btnPrintBarcode" class="t-button" onclick="printBarcode();">
            <span class='t-icon t-insert'></span>
            @*In barcode*@
             @HttpContext.GetGlobalResourceObject("Resource", "Print") barcode
            <span class="loadButton"></span>
        </button>
        <div class="clear"></div><br />

    <fieldset>
        <legend>@HttpContext.GetGlobalResourceObject("Resource", "Information")</legend> 
        <div class="grid_2">@HttpContext.GetGlobalResourceObject("Resource", "Employee")</div>
        <div class="grid_4">
            @{
                    Html.Telerik().ComboBox()
                        .Name("Employee")
                        //.DataBinding(binding => binding.Ajax().Select("SelectComboBoxEmployee", "Employee", new { area = "Sales" }).Delay(350))
                        .HtmlAttributes(new { style = "width: 100%" })
                        //.DropDownHtmlAttributes(new { style = "width: 150px" })
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .HighlightFirstMatch(true)
                        .AutoFill(true)
                        .Render();
                }
        </div>
    </fieldset>
</div>
<div class="clear"></div>
<br />
<div class="cover-div">
    @{
        Html.Telerik().Grid<WorkOrderRoutingModel>()
            .Name("grid")
            .DataKeys(key => key.Add(f => f.RoutingId).RouteKey("routingId"))
            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectWorkOrderMaterialAssignment", "WorkOrder", new { area = "Factory" })
                                          .Delete("CancelWorkOrderMaterialAssignment", "WorkOrder", new { area = "Factory" })
           )
            .Columns(columns => {
                //columns.Command(command => command.Edit().ButtonType(GridButtonType.Image))
                //       .Width(50).Title("")
                //       .HtmlAttributes(new { style = "text-align:center" });

                columns.Bound(f => f.RoutingId)
                    //.Title("Chọn")
                    .Width(75)
                    .HeaderTemplate(
                        "<button class='t-button' onclick='CreateWorkOrderMaterialAssignment()'>"
                        + @HttpContext.GetGlobalResourceObject("Resource", "Select").ToString()
                        + "</button>"
                        + "<span class='processButton'></span>"
                    )
                    .ClientTemplate("<input type='checkbox' name='chkIds' class='chkId' value='<#= RoutingId #>' />")
                    .HtmlAttributes(new { style = "text-align:center" })
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Select").ToString());

                //columns.Bound(f => f.RoutingId).Title("STT").Width(30).ReadOnly(true)
                //    .ClientTemplate("<#= ++index #>")
                //       .HeaderHtmlAttributes(new { style = "font-weight: bold" })
                //       .HtmlAttributes(new { style = "font-weight: center;" });
                columns.Bound(f => f.SerialNumber).Title("Work Order").Width(100).ReadOnly(true);
                columns.Bound(f => f.MachineName)
                    //.Title("Máy")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Machine").ToString())
                    .Width(100)
                    .ReadOnly(true);
                
                columns.Bound(f => f.ProductCode)
                    //.Title("Sản phẩm")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Product").ToString())
                    .Width(150).ReadOnly(true);
                
                columns.Bound(f => f.MaterialInvCode)
                    //.Title("Nguyên liệu")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Material").ToString())
                    .Width(270).ReadOnly(true);
                
                columns.Bound(f => f.PlannedCost)
                    //.Title("Số lượng</br>(cây)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Quantity").ToString() 
                        + "<br>"
                        + @HttpContext.GetGlobalResourceObject("Resource", "Bar").ToString()
                        )
                    .Width(70).ReadOnly(true);
                columns.Bound(f => f.MoreInfo)
                    //.Title("Ghi chú")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Note").ToString())
                    .ReadOnly(true);

                columns.Command(c => c.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image))
                    //.Title("Hủy")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Cancel").ToString())
                    .Width(50);
            })
            .Selectable()
            .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
            .ClientEvents(e => e.OnError("grid_OnError"))
            .Scrollable(f => f.Height("auto"))
            .Sortable()
            .Filterable()
            .Resizable(resizing => resizing.Columns(true))
            .Scrollable()
            .Render();
    }
</div>

<!-- windown -->
@{
    Html.Telerik().Window()
        .Name("windowReport")
        .Modal(true)
        .Draggable(true)
        .Content
        (
    @<text>
    <div id="result"></div>
    </text>
        )
        //.ClientEvents(e => e.OnLoad("Window_onLoad"));
        .Visible(false)
        .Width(960)
        .Render();
}

