<div class="cover-div">
    @{
        Html.Telerik().Grid<WorkOrderRoutingModel>()
            .Name("grid")
            .ToolBar(bar => bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
                .SaveText(@HttpContext.GetGlobalResourceObject("Resource", "SaveText").ToString())
                .CancelText(@HttpContext.GetGlobalResourceObject("Resource", "CancelText").ToString())
                )
            .DataKeys(keys => keys.Add(f => f.RoutingId).RouteKey("routingId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectWorkOrderProcess", "WorkOrder", new { area = "Factory", routingId = 0, productWeight = 0, weight = 0 })
                .Update("ImportWorkOrderProcess", "WorkOrder", new { area = "Factory", productWeight = 0 })
                )
            .Columns(columns => {
                columns.Bound(f => f.ProductWeight).Width(90)
                    //.HeaderTemplate("Trọng lượng</br>Sản phẩm</br>(g/pc)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductWeight").ToString()
                        + "</br>(g/pc)"
                    )
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .Format("{0:n4}")
                    .HtmlAttributes(new { style = "text-align: center;" });
             
                columns.Bound(f => f.PlannedCost).Width(90)
                    //.HeaderTemplate("Số lượng</br>nhận</br>xử lý")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ReceivedProcessedQuantity").ToString())
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
               
                columns.Bound(f => f.PreviousRouteQuantity).Width(90)
                    //.HeaderTemplate("Số lượng</br>cần</br>xử lý")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "NeededProcessedQuantity").ToString())
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .Format("{0:n0}")
                    .ClientTemplate("<span class='ProductionQuantity'><#=  $.telerik.formatString('{0:n0}', PreviousRouteQuantity) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;border-right:1px solid black;" });
               
                columns.Bound(f => f.GoodQuantity).Width(90)
                    //.HeaderTemplate("Hàng</br>OK</br>(pcs)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "GoodQuantity").ToString())
                    .HeaderHtmlAttributes(new { @class = "good-column" })
                    .ClientTemplate("<span class='GoodQuantity'><#=  $.telerik.formatString('{0:n0}', GoodQuantity) #></span>")
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
             
                columns.Bound(f => f.GoodWeight).Width(90)
                    //.HeaderTemplate("Hàng</br>OK</br>(g)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "GoodWeight").ToString())
                    .HeaderHtmlAttributes(new { @class = "good-column" })
                    .Format("{0:n0}")
                    .ClientTemplate("<span class='GoodWeight'><#=  $.telerik.formatString('{0:n0}', GoodWeight) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;border-right:1px solid black;" });
                
                columns.Bound(f => f.NGQuantity).Width(90)
                    //.HeaderTemplate("Hàng</br>CPL</br>(pcs)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "NGQuantity").ToString())
                    .HeaderHtmlAttributes(new { @class = "ng-column" })
                    .Format("{0:n0}")
                    .ClientTemplate("<span class='NGQuantity'><#=  $.telerik.formatString('{0:n0}', NGQuantity) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;" });
              
                columns.Bound(f => f.NGWeight).Width(90)
                    //.HeaderTemplate("Hàng</br>CPL</br>(g)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "NGWeight").ToString())
                    .HeaderHtmlAttributes(new { @class = "ng-column" })
                    .Format("{0:n0}")
                    .ClientTemplate("<span class='NGWeight'><#=  $.telerik.formatString('{0:n0}', NGWeight) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;border-right:1px solid black;" });

                columns.Bound(f => f.DefectQuantity).Width(90)
                    //.HeaderTemplate("Phế phẩm</br>(pcs)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "DefectQuantity1").ToString())
                    .HeaderHtmlAttributes(new { @class = "defect-column" })
                    .Format("{0:n0}")
                    .ClientTemplate("<span class='DefectQuantity'><#=  $.telerik.formatString('{0:n0}', DefectQuantity) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;" });
              
                columns.Bound(f => f.DefectWeight).Width(90)
                    //.HeaderTemplate("Phế phẩm</br>(g)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "DefectWeight1").ToString())
                    .HeaderHtmlAttributes(new { @class = "defect-column" })
                    .Format("{0:n0}")
                    .ClientTemplate("<span class='DefectWeight'><#=  $.telerik.formatString('{0:n0}', DefectWeight) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;border-right:1px solid black;" });
               
                columns.Bound(f => f.DiffQuantity).Width(90)
                    //.HeaderTemplate("Còn lại</br>YC - TT (pcs)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "LeftOver").ToString()
                        + "</br>"
                        + @HttpContext.GetGlobalResourceObject("Resource", "RequestActual").ToString() 
                        + " (pcs)" 
                    )
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { @class = "good-column" })
                    .Format("{0:n0}")
                    .ClientTemplate("<span class='DiffQuantity'><#= DiffQuantity #></span>")
                    .HtmlAttributes(new { style = "text-align: right;" });
            })
            .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
            .ClientEvents(events => events
                .OnDataBinding("grid_OnDataBinding")
                .OnSave("grid_OnSave")
                .OnDataBound("grid_OnDataBound")
                .OnRowDataBound("grid_OnRowDataBound")
                .OnSubmitChanges("grid_OnSubmitChanges")
                .OnError("grid_OnError")
            )
            .KeyboardNavigation()
            .Render();   
    }
</div>

<div class="clear"></div><br />