@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Làm sạch sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .fieldheader {
        /*height: 150px;*/
        padding-left: 15px;
        padding-right: 15px;
        float: left;
    }

    .fieldheader1 {
        width: 35%;
        min-width: 420px;
        margin-right: 10px;
    }

    .fieldheader2 {
        width: 20%;
        margin-right: 10px;
    }

    .fieldheader3 {
        width: 35%;
    }
</style>
@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnLoad.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnProcess.js")"></script>
    <script type="text/javascript">

        $(document).ready(function () {
            loadEmployeeLogin();
        });

        function loadEmployeeLogin() {
            $.ajax({
                type: 'post',
                data: {},
                dataType: 'json',
                url: '@Url.Action("GetComboBoxEmployeeLogin", "Employee", new { area = "Sales" })',
                timeout: 20000,
                success: function (data) {
                    //a
                    var cbo = $('#Employee').data('tComboBox');
                    cbo.dataBind(data);
                    if (cbo.selectedIndex > -1) {

                        var selected = cbo.data[cbo.selectedIndex];

                        if (selected != undefined) {
                            cbo.value(selected.Value);
                            cbo.text(selected.Text);
                            cbo.selectedIndex = cbo.selectedIndex;
                            cbo.previousValue = selected.Value;
                        } else {
                            cbo.value(-1);
                            cbo.text("");
                        }
                    } else {
                        cbo.value(-1);
                        cbo.text("");
                    }
                }
            });
        }
        function workOrder_OnChange() {
            if (!onLoading) {
                OnLoadingData();
                var workOrder = $("#WorkOrder").data('tComboBox').value();
                if (workOrder === "") workOrder = 0;
                $.ajax({
                    type: 'post',
                    data: { routingId: workOrder },
                    dataType: 'json',
                    url: '@Url.Action("CheckWorkOrderRoutingInfo", "WorkOrder", new { area = "Factory" })',
                    timeout: 20000,
                    success: function (res) {
                        //OnLoadedData();
                        if (res.Code === 1) {
                            $("#SerialNumber")[0].innerText = res.Data.SerialNumber;
                            $("#ProductCode")[0].innerText = res.Data.ProductCode;

                            $("#RoutingName")[0].innerText = res.Data.RoutingName;
                            $("#NextRouteName")[0].innerText = res.Data.NextRouteName;

                            $("#WorkOrderQuantity")[0].innerText = res.Data.PlannedCost.format(0);
                            $("#ProductionQuantity")[0].innerText = res.Data.UsingQuantity.format(0);

                            $("#ProductWeight").val(res.Data.ProductWeight);
                            $("#ProductWeight").data("tTextBox").$text[0].innerHTML = res.Data.ProductWeight.format(4);

                            $("#MaterialInvCode")[0].innerText = res.Data.MaterialInvCode;
                            quantity = 0;
                            weight = 0;
                            $("#WeighValue")[0].innerText = "0.00";
                            $("#QuantityValue")[0].innerText = "0";
                            RefreshGrid("grid");
                            OnLoadedData();
                        } else {
                            alert("Lỗi! " + res.Message);
                        }
                    }
                });
            }
        }

        function grid_OnDataBinding(e) {

            var workOrder = $("#WorkOrder").data('tComboBox').value();
            if (workOrder === "") workOrder = 0;
            var productWeight = $("#ProductWeight").data("tTextBox").value();
            e.data = $.extend(e.data, {
                routingId: workOrder,
                productWeight: productWeight,
                weight: weight,
            });
        }

        function grid_OnSave(e) {
            var goodQuantity = $(e.cell).find('#GoodQuantity').val();
            var goodWeight = $(e.cell).find('#GoodWeight').val();
            var ngQuantity = $(e.cell).find('#NGQuantity').val();
            var ngWeight = $(e.cell).find('#NGWeight').val();
            var defectQuantity = $(e.cell).find('#DefectQuantity').val();
            var defectWeight = $(e.cell).find('#DefectWeight').val();
            var usingQuantity = $(e.cell).find('#UsingQuantity').val();
            var productWeight = e.dataItem.ProductWeight;
            var total = 0;
            if (!isNaN(parseInt(goodQuantity))) {
                goodQuantity = parseInt(goodQuantity);
                goodWeight = parseInt(goodQuantity * e.dataItem.ProductWeight);
                e.dataItem.GoodWeight = goodWeight;
                var span = e.cell.parentElement.getElementsByClassName("GoodWeight")[0];
                span.textContent = goodWeight.format(0);
                total = goodQuantity + e.dataItem.NGQuantity + e.dataItem.DefectQuantity;
            }
            else if (!isNaN(parseInt(goodWeight))) {
                goodWeight = parseInt(goodWeight);
                goodQuantity = parseInt(goodWeight / productWeight);
                e.dataItem.GoodQuantity = goodQuantity;
                var span = e.cell.parentElement.getElementsByClassName("GoodQuantity")[0];
                span.textContent = goodQuantity.format(0);
                total = goodQuantity + e.dataItem.NGQuantity + e.dataItem.DefectQuantity;
            }
            else if (!isNaN(parseInt(ngQuantity))) {
                ngQuantity = parseInt(ngQuantity);
                ngWeight = parseInt(ngQuantity * e.dataItem.ProductWeight);
                e.dataItem.NGWeight = ngWeight;
                var span = e.cell.parentElement.getElementsByClassName("NGWeight")[0];
                span.textContent = ngWeight.format(0);
                total = e.dataItem.GoodQuantity + ngQuantity + e.dataItem.DefectQuantity;
            }
            else if (!isNaN(parseInt(ngWeight))) {
                ngWeight = parseInt(ngWeight);
                ngQuantity = parseInt(ngWeight / productWeight);
                e.dataItem.NGQuantity = ngQuantity;
                var span = e.cell.parentElement.getElementsByClassName("NGQuantity")[0];
                span.textContent = ngQuantity.format(0);
                total = e.dataItem.GoodQuantity + ngQuantity + e.dataItem.DefectQuantity;
            }
            else if (!isNaN(parseInt(defectQuantity))) {
                defectQuantity = parseInt(defectQuantity);
                defectWeight = parseInt(defectQuantity * e.dataItem.ProductWeight);
                e.dataItem.DefectWeight = defectWeight;
                var span = e.cell.parentElement.getElementsByClassName("DefectWeight")[0];
                span.textContent = defectWeight.format(0);
                total = e.dataItem.GoodQuantity + e.dataItem.NGQuantity + defectQuantity;
            }
            else if (!isNaN(parseInt(defectWeight))) {
                defectWeight = parseInt(defectWeight);
                defectQuantity = parseInt(defectWeight / productWeight);
                e.dataItem.DefectQuantity = defectQuantity;
                var span = e.cell.parentElement.getElementsByClassName("DefectQuantity")[0];
                span.textContent = defectQuantity.format(0);
                total = e.dataItem.GoodQuantity + e.dataItem.NGQuantity + defectQuantity;
            }
            e.dataItem.UsingQuantity = total;

            e.dataItem.DiffQuantity = e.dataItem.PreviousRouteQuantity - total;
            var spanDiff = e.cell.parentElement.getElementsByClassName("DiffQuantity")[0];
            spanDiff.textContent = e.dataItem.DiffQuantity.format(0);

            var spanProduction = e.cell.parentElement.getElementsByClassName("ProductionQuantity")[0];
            if (e.dataItem.DiffQuantity < 0) {
                // wrong: orange;
                spanDiff.parentNode.bgColor = "orange";
                spanProduction.parentNode.bgColor = "yellow";
            }
            else if (e.dataItem.DiffQuantity > 0) {
                // not done: yellow
                spanProduction.parentNode.bgColor = "yellow";
                spanDiff.parentNode.bgColor = "";
            } else {
                // right
                spanProduction.parentNode.bgColor = "";
                spanDiff.parentNode.bgColor = "";
            }
        }

        function grid_OnSubmitChanges(e) {
            if (!onProcessing) {
                OnProcessingData();
                var workOrder = $("#WorkOrder").data('tComboBox').value();
                if (workOrder === "") workOrder = 0;
                var employee = $("#Employee").data('tComboBox').value();
                if (employee === "") employee = 0;
                var productWeight = $("#ProductWeight").data("tTextBox").value();
                if (employee === 0 || productWeight == 0) {
                    alert("Vui lòng điền đủ thông tin: nhân viên, trọng lượng SP");
                    OnProcessedData();
                    e.preventDefault();
                }
                else {
                    e.values = $.extend(e.values,
                        {
                            routingId: workOrder,
                            employeeId: employee,
                            machineId: 0,
                            productWeight: productWeight,
                        });
                }
            } else {
                e.preventDefault();
            }
        }

        function grid_OnDataBound() {
            OnProcessedData();
        }
        function grid_OnRowDataBound(e) {
            if (e.dataItem.DiffQuantity < 0) {
                e.row.lastChild.bgColor = 'orange';
            }
        }
    </script>

    <script>
        function Connect() {
            //var second = $("#AutoDataSecond").data("tTextBox").value();
            //if (second > 0) {
            $.ajax({
                type: 'post',
                data: {},
                dataType: 'json',
                url: '@Url.Action("ConnectWeighingDevice", "Transaction", new { area = "Inv" })',
                    timeout: 20000,
                    success: function (data) {
                        if (data === 1) {
                            alert("Kết nối thành công");
                            //connect_OnChange(true);
                            stopInterval = false;
                            var interval = setInterval(function () {
                                GetWeighingValue();
                                if (stopInterval) clearInterval(interval);
                            }, 3000);
                        } else if (data === 8) {
                            alert("Kết nối bị lỗi! Vui lòng rút đầu USB và cắm lại");
                        } else if (data === 9) {
                            alert("Không tìm thấy thiết bị");
                        } else { alert("Kết nối không thành công"); }
                    }
                });
            //} else {
            //    alert("Lỗi! Vui lòng chỉnh tự động nạp > 0");
            //}
            }

            function DisConnect() {
                stopInterval = true;
                $.ajax({
                    type: 'post',
                    data: {},
                    dataType: 'json',
                    url: '@Url.Action("DisConnectWeighingDevice", "Transaction", new { area = "Inv" })',
                timeout: 20000,
                success: function (data) {
                    if (data === 1) {
                        //$("#btnConnect")[0].removeAttribute("style");
                        //connect_OnChange(false);
                        alert("Đã ngắt kết nối");
                    } else { alert("Ngắt kết nối không thành công"); }
                }
            });
        }

        var quantity = 0;
        var weight = 0;
        function GetWeighingValue() {
            var unitWeight = $("#ProductWeight").data("tTextBox").value();
            var packageWeight = $("#PackageWeight").data("tTextBox").value();
            //var tolerance = $("#Tolerance").data("tTextBox").value();
            $.ajax({
                type: 'post',
                data: {},
                dataType: 'json',
                url: '@Url.Action("GetWeighingValue", "Transaction", new { area = "Inv" })',
                timeout: 4000,
                success: function (data) {
                    if (data >= 0) {
                        weight = data * 1000 - packageWeight;
                        $("#WeighValue")[0].innerText = data.format(2);
                        if (unitWeight > 0) {
                            if (quantity != weight / unitWeight) {
                                quantity = weight / unitWeight;
                                if (quantity < 0) quantity = 0;
                                $("#QuantityValue")[0].innerText = (quantity).format(0);
                                RefreshGrid("grid");
                            }
                        } else {
                            $("#QuantityValue")[0].innerText = "0";
                        }
                    }
                }
            });
        }

    </script>
}

