@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@model WorkOrderRoutingModel
@{
    ViewBag.Title = "Thẻ Work Order ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .fieldheader {
        /*height: 150px;*/
        padding-left: 15px;
        padding-right: 15px;
        float: left;
    }

    .fieldheader1 {
        width: 35%;
        min-width: 420px;
        margin-right: 10px;
    }

    .fieldheader2 {
        width: 20%;
        margin-right: 10px;
    }

    .fieldheader3 {
        width: 35%;
    }
</style>
@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnLoad.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnProcess.js")"></script>
    <script type="text/javascript">

        $(document).ready(function () {
            document.getElementById("RoutingSerial").focus();
        });
        var workOrderId = 0;
        function grid_OnDataBinding(e) {
            if (workOrderId > 0) {
                e.data = $.extend(e.data, {
                    ids: workOrderId,
                });
            }
        }

    </script>

    <script>
        function workOrderOnChange() {
            var routingSerial = $("#RoutingSerial").val();
            //alert(routingSerial);
            $.ajax({
                type: 'post',
                data: { serialNumber: routingSerial },
                dataType: 'json',
                url: '@Url.Action("CheckWorkOrderInfoBySerialNumber", "WorkOrder", new { area = "Factory" })',
                timeout: 20000,
                success: function (res) {
                    //OnLoadedData();
                    if (res.Code === 1) {
                        //routingId = res.Data.RoutingId;
                        workOrderId = res.Data.WorkOrderId;
                        $("#ProductCode")[0].innerText = res.Data.ProductCode;
                        $("#MaterialName")[0].innerText = res.Data.MaterialName;
                        if (res.Data.RoutingName) {
                            $("#StatusName")[0].innerText = res.Data.StatusName + ": " + res.Data.RoutingName;
                        } else {
                            $("#StatusName")[0].innerText = res.Data.StatusName;
                        }
                        $("#OrderQty")[0].innerText = res.Data.OrderQty;
                        $("#MaterialPlan")[0].innerText = res.Data.MaterialPlan;
                        $("#GoodQuantity")[0].innerText = res.Data.GoodQuantity;
                        $("#NGQuantity")[0].innerText = res.Data.NGQuantity;
                        $("#DefectQuantity")[0].innerText = res.Data.DefectQuantity;
                        var totalQuantity = res.Data.GoodQuantity + res.Data.NGQuantity + res.Data.DefectQuantity;
                        $("#TotalQuantity")[0].innerText = totalQuantity;

                        $("#DiffQuantity")[0].innerText = res.Data.OrderQty - totalQuantity;
                        var materialRate = res.Data.MaterialPlan > 0 ? res.Data.OrderQty / res.Data.MaterialPlan : 0;
                        $("#DiffMaterial")[0].innerText = materialRate > 0
                            ? ((res.Data.OrderQty - totalQuantity) / materialRate).toFixed(1)
                            : 0;
                        RefreshGrid('grid');
                        //$("#RoutingName")[0].innerText = res.Data.RoutingName;
                        //$("#NextRouteName")[0].innerText = res.Data.NextRouteName;

                        //$("#WorkOrderQuantity")[0].innerText = res.Data.PlannedCost.format(0);
                        //plannedCost = res.Data.PlannedCost;
                        //document.getElementById("MaterialInvCode").focus();
                        //OnLoadedData();
                    } else {
                        alert("Lỗi! " + res.Message);
                    }
                }
            });
        }

    </script>
}

