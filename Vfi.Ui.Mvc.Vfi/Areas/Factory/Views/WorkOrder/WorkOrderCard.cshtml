                    //.Title("Công đoạn")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Stage").ToString());
                
                columns.Bound(f => f.StatusName).Width(70)
                    //.Title("Tình trạng")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Status").ToString())
                    .ReadOnly(true)
                    .HtmlAttributes(new { style = "border-right:1px solid black;" });
                
                columns.Bound(f => f.PlannedCost).Width(65)
                    //.Title("Kế</br>hoạch")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Planned").ToString())
                    .ReadOnly(true)
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align:right;" });
                
                columns.Bound(f => f.ActualCost).Width(65)
                    //.Title("Thực</br>tế")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Actual").ToString())
                    .ReadOnly(true)
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align:right;" });
                
