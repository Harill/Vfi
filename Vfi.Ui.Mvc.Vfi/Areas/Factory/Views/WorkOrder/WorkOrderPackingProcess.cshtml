@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Đóng gói WO";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .fieldheader {
        /*height: 150px;*/
        padding-left: 15px;
        padding-right: 15px;
        float: left;
    }

    .fieldheader1 {
        width: 35%;
        min-width: 420px;
        margin-right: 10px;
    }

    .fieldheader2 {
        width: 20%;
        margin-right: 10px;
    }

    .fieldheader3 {
        width: 35%;
    }
</style>
@section Scripts{
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnLoad.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnProcess.js")"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            loadEmployeeLogin();
        });

        function loadEmployeeLogin() {
            $.ajax({
                type: 'post',
                data: {},
                dataType: 'json',
                url: '@Url.Action("GetComboBoxEmployeeLogin", "Employee", new { area = "Sales" })',
                timeout: 20000,
                success: function (data) {
                    //a
                    var cbo = $('#Employee').data('tComboBox');
                    cbo.dataBind(data);
                    if (cbo.selectedIndex > -1) {

                        var selected = cbo.data[cbo.selectedIndex];

                        if (selected != undefined) {
                            cbo.value(selected.Value);
                            cbo.text(selected.Text);
                            cbo.selectedIndex = cbo.selectedIndex;
                            cbo.previousValue = selected.Value;
                        } else {
                            cbo.value(-1);
                            cbo.text("");
                        }
                    } else {
                        cbo.value(-1);
                        cbo.text("");
                    }
                }
            });
        }
        function workOrder_OnChange() {
            if (!onLoading) {
                OnLoadingData();
                var workOrder = $("#WorkOrder").data('tComboBox').value();
                if (workOrder === "") workOrder = 0;
                $.ajax({
                    type: 'post',
                    data: { routingId: workOrder },
                    dataType: 'json',
                    url: '@Url.Action("CheckWorkOrderRoutingInfo", "WorkOrder", new { area = "Factory" })',
                    timeout: 20000,
                    success: function (res) {
                        //OnLoadedData();
                        if (res.Code === 1) {
                            $("#SerialNumber")[0].innerText = res.Data.SerialNumber;
                            $("#ProductCode")[0].innerText = res.Data.ProductCode;

                            $("#RoutingName")[0].innerText = res.Data.RoutingName;
                            $("#NextRouteName")[0].innerText = res.Data.NextRouteName;

                            $("#WorkOrderQuantity")[0].innerText = res.Data.PlannedCost.format(0);
                            $("#ProductionQuantity")[0].innerText = res.Data.UsingQuantity.format(0);
                            $("#ProductWeight").val(res.Data.ProductWeight);
                            $("#ProductWeight").data("tTextBox").$text[0].innerHTML = res.Data.ProductWeight.format(4);

                            $("#MaterialInvCode")[0].innerText = res.Data.MaterialInvCode;
                            if (res.Data.PackingInfo) {
                                $("#FuelFullCodeName")[0].innerText = res.Data.PackingInfo.FuelFullCode;
                                $("#Quota")[0].innerText = res.Data.PackingInfo.Quota.format(0);
                                $("#CrossWeight")[0].innerText = res.Data.PackingInfo.CrossWeight.format(0);
                                $("#Quantity").val(res.Data.PackingInfo.Quota);
                                $("#Quantity").data("tTextBox").$text[0].innerHTML = res.Data.PackingInfo.Quota.format(0);
                            }
                            OnLoadedData();
                        } else {
                            alert("Lỗi! " + data.Message);
                        }
                    }
                });
            }
        }
        var quantity = 0;
        function Add() {
            quantity = $("#Quantity").data("tTextBox").value();
            RefreshGrid("grid");
        }

        function grid_OnDataBinding(e) {

            var workOrder = $("#WorkOrder").data('tComboBox').value();
            if (workOrder === "") workOrder = 0;
            var productWeight = $("#ProductWeight").data("tTextBox").value();
            var multiple = $("#Multiple").data("tTextBox").value();
            e.data = $.extend(e.data, {
                routingId: workOrder,
                productWeight: productWeight,
                packageWeight: 0,
                quantity: quantity,
                multiple: multiple
            });
            quantity = 0;
            destroyQuantity = 0;
        }

        function grid_OnRowDataBound(e) {
            if (e.dataItem.PreviousRouteQuantity < 0) {
                var span = e.row.getElementsByClassName("RequireQuantity")[0];
                span.parentNode.bgColor = "indianred";
            }
            if (e.dataItem.UsingQuantity > e.dataItem.PreviousRouteQuantity + e.dataItem.NGQuantity - e.dataItem.DefectQuantity) {
                var span = e.row.getElementsByClassName("MaxQuantity")[0];
                var span2 = e.row.getElementsByClassName("UsingQuantity")[0];
                span.parentNode.bgColor = "lightyellow";
                span2.parentNode.bgColor = "lightyellow";
            }
        }
        function grid_OnSave(e) {
            //var goodQuantity = $(e.cell).find('#GoodQuantity').val();
            //var goodWeight = $(e.cell).find('#GoodWeight').val();
            //var ngQuantity = $(e.cell).find('#NGQuantity').val();
            //var usingQuantity = $(e.cell).find('#UsingQuantity').val();
            var defectQuantity = $(e.cell).find('#DefectQuantity').val();
            var productWeight = e.dataItem.ProductWeight;
            var total = 0;
            var add = 0;
            //if (!isNaN(parseInt(goodQuantity))) {
            //    goodQuantity = parseInt(goodQuantity);
            //    goodWeight = parseInt(goodQuantity * e.dataItem.ProductWeight);
            //    var span = e.cell.parentElement.getElementsByClassName("GoodWeight")[0];
            //    span.textContent = goodWeight.format(0);
            //    total = goodQuantity + e.dataItem.NGQuantity + e.dataItem.DefectQuantity;
            //    add = e.dataItem.NGQuantity + e.dataItem.DefectQuantity;
            //}
            //else if (!isNaN(parseInt(goodWeight))) {
            //    goodWeight = parseInt(goodWeight);
            //    goodQuantity = parseInt(goodWeight / productWeight);
            //    var span = e.cell.parentElement.getElementsByClassName("GoodQuantity")[0];
            //    span.textContent = goodQuantity.format(0);
            //    total = goodQuantity + e.dataItem.NGQuantity + e.dataItem.DefectQuantity;
            //    add = e.dataItem.NGQuantity + e.dataItem.DefectQuantity;
            //}
            //else if (!isNaN(parseInt(ngQuantity))) {
            //    ngQuantity = parseInt(ngQuantity);
            //    total = e.dataItem.GoodQuantity + ngQuantity - e.dataItem.DefectQuantity;
            //    add = ngQuantity - e.dataItem.DefectQuantity;
            //}
            //else
            if (!isNaN(parseInt(defectQuantity))) {
                defectQuantity = parseInt(defectQuantity);
                //if (defectQuantity > 0 && e.dataItem.PreviousRouteQuantity > e.dataItem.RequireQuantity) {
                //    alert("Lỗi! Chỉ có thể hủy tồn ở đóng gói cuối");
                //    e.preventDefault();
                //}
                total = e.dataItem.GoodQuantity + e.dataItem.NGQuantity - defectQuantity;
                add = e.dataItem.NGQuantity - defectQuantity;
                destroyQuantity = defectQuantity;
            }
            e.dataItem.UsingQuantity = total;

            var spanMax = e.cell.parentElement.getElementsByClassName("MaxQuantity")[0];
            var spanUsing = e.cell.parentElement.getElementsByClassName("UsingQuantity")[0];
            if (e.dataItem.UsingQuantity > e.dataItem.PlannedCost) {
                // over packing quantity
                spanMax.parentNode.bgColor = "lightyellow";
                spanUsing.textContent = e.dataItem.UsingQuantity.format(0);
            } else {
                // right
                spanMax.parentNode.bgColor = "";
            }
            //var spanRequire = e.cell.parentElement.getElementsByClassName("RequireQuantity")[0];
            //if (e.dataItem.PreviousRouteQuantity + add >= 0) {
            //    spanRequire.parentNode.bgColor = "";
            //}
            //else {
            //    spanRequire.parentNode.bgColor = "indianred";
            //}
        }
        var destroyQuantity = 0;
        function SaveData() {
            if (!onProcessing) {
                OnProcessingData();
                var workOrder = $("#WorkOrder").data('tComboBox').value();
                if (workOrder === "") workOrder = 0;
                var employee = $("#Employee").data('tComboBox').value();
                if (employee === "") employee = 0;
                var productWeight = $("#ProductWeight").data("tTextBox").value();
                if (employee == 0 || productWeight == 0) {
                    alert("Lỗi! Chưa nhập đủ thông tin: nhân viên, trọng lượng");
                    OnProcessedData();
                }
                else if (confirm("Đồng ý lưu ?")) {
                    $.post('@Url.Action("ImportWorkOrderPackingProcess", "WorkOrder")',
                        {
                            routingId: workOrder,
                            employeeId: employee,
                            productWeight: productWeight,
                            destroyQuantity: destroyQuantity,
                        },
                        function (res) {
                            if (res.Code === 1) {
                                destroyQuantity = 0;
                                RefreshGrid("grid");
                                alert("Hoàn thành lưu " + res.Data);
                            } else {
                                alert("Lỗi! " + res.Message);
                            }
                            OnProcessedData();
                        });
                }
            }
            return false;
        }
    </script>
}

