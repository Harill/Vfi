<div class="cover-div">
    @{
        Html.Telerik().Grid<WorkOrderRoutingModel>()
            .Name("grid")
            //.ToolBar(bar => bar.SubmitChanges().ButtonType(GridButtonType.ImageAndText).SaveText("Lưu lại").CancelText("Huỷ bỏ"))
            .ToolBar(bar => {
                bar.Custom().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Text)
                        //.Text("Lưu dữ liệu cân")
                        .Text(@HttpContext.GetGlobalResourceObject("Resource", "SaveData").ToString())
                        .Name("A")
                   .HtmlAttributes(new { onclick = "SaveData()", href = "#" });
                //bar.SubmitChanges().ButtonType(GridButtonType.ImageAndText).SaveText("Lưu thay đổi").CancelText("Huỷ tất cả");
            })
            .DataKeys(keys => keys.Add(f => f.RoutingId).RouteKey("routingId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectWorkOrderPackingProcess", "WorkOrder", new { area = "Factory", routingId = 0, productWeight = 0, packageWeight = 0, quantity = 0, multiple= 1 })
                //.Update("ImportWorkOrderPackingProcess", "WorkOrder", new { area = "Factory", productWeight = 0 })
                )
            .Columns(columns => {
                columns.Bound(f => f.ProductWeight).Width(90)
                    //.HeaderTemplate("Trọng lượng</br>Sản phẩm</br>(g/pc)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductWeight2").ToString())
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .Format("{0:n4}")
                    .HtmlAttributes(new { style = "text-align: center;" });
               
                columns.Bound(f => f.PlannedCost).Width(90)
                    //.HeaderTemplate("Số lượng</br>nhận</br>xử lý")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ReceivedProcessedQuantity").ToString())
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    //.Format("{0:n0}")
                    .ClientTemplate("<span class='MaxQuantity'><#=  $.telerik.formatString('{0:n0}', PlannedCost) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;" });
                
                columns.Bound(f => f.RequireQuantity).Width(90)
                    //.HeaderTemplate("Số lượng</br>cần</br>xử lý")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "NeededProcessedQuantity").ToString())
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    //.Format("{0:n0}")
                    .ClientTemplate("<span class='RequireQuantity'><#=  $.telerik.formatString('{0:n0}', RequireQuantity) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;border-right:1px solid black;" });
             
                columns.Bound(f => f.UsingQuantity).Width(90)
                    //.HeaderTemplate("Số lượng</br>đóng gói</br>(pcs)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Quantity").ToString()
                        + "</br>"
                        + @HttpContext.GetGlobalResourceObject("Resource", "Packing").ToString()
                        + "</br>(pcs)"
                    ).ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .Format("{0:n0}")
                    .ClientTemplate("<span class='UsingQuantity'><#=  $.telerik.formatString('{0:n0}', UsingQuantity) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;" });
              
                columns.Bound(f => f.UsingWeight).Width(90)
                    //.HeaderTemplate("Trọng lượng</br>đóng gói</br>(g)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Weight1").ToString()
                        + "</br>"
                        + @HttpContext.GetGlobalResourceObject("Resource", "Packing").ToString()
                        + "</br>(g)"
                    )
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;border-right:1px solid black;" })
                    .Aggregate(agg => agg.Sum())
                    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .FooterHtmlAttributes(new { style = "text-align: right;" });
              
                columns.Bound(f => f.GoodQuantity).Width(90)
                    //.HeaderTemplate("Số lượng</br>đóng</br>(pcs)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Quantity").ToString()
                        + "</br>(pcs)"
                    )
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { @class = "good-column" })
                    .ClientTemplate("<span class='GoodQuantity'><#=  $.telerik.formatString('{0:n0}', GoodQuantity) #></span>")
                    //.Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" })
                    .Aggregate(agg => agg.Sum())
                    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .FooterHtmlAttributes(new { style = "text-align: right;" });
             
                columns.Bound(f => f.NGQuantity).Width(90)
                    //.HeaderTemplate("Nhập thêm</br>(pcs)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Addition").ToString()
                        + "</br>(pcs)"
                    )
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { @class = "ng-column" })
                    .ClientTemplate("<span class='NGQuantity'><#=  $.telerik.formatString('{0:n0}', NGQuantity) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;border-right:1px solid black;" });
             
                columns.Bound(f => f.DefectQuantity).Width(90)
                    //.HeaderTemplate("Xuất hủy</br>(pcs)</br>(*)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "CancelExport").ToString()
                        + "</br>(pcs)(*)"
                    )
                    .HeaderHtmlAttributes(new { @class = "defect-column" })
                    .ClientTemplate("<span class='DefectQuantity'><#=  $.telerik.formatString('{0:n0}', DefectQuantity) #></span>")
                    .HtmlAttributes(new { style = "text-align: right;" });
            })
            .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
            .ClientEvents(events => events
                .OnDataBinding("grid_OnDataBinding")
                .OnSave("grid_OnSave")
                    .OnRowDataBound("grid_OnRowDataBound")
                .OnError("grid_OnError")
            )
            .KeyboardNavigation()
            .Render();   
    }
</div>
<div class="clear"></div><br />