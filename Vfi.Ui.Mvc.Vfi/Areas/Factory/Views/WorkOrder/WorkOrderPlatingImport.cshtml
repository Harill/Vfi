@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Nhập gia công ngoài";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .fieldheader {
        /*height: 150px;*/
        padding-left: 15px;
        padding-right: 15px;
        float: left;
    }

    .fieldheader1 {
        width: 35%;
        min-width: 420px;
        margin-right: 10px;
    }

    .fieldheader2 {
        width: 20%;
        margin-right: 10px;
    }

    .fieldheader3 {
        width: 35%;
    }
</style>
@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnLoad.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnProcess.js")"></script>
    <script type="text/javascript">

        $(document).ready(function () {
            loadEmployeeLogin();
        });

        function loadEmployeeLogin() {
            $.ajax({
                type: 'post',
                data: {},
                dataType: 'json',
                url: '@Url.Action("GetComboBoxEmployeeLogin", "Employee", new { area = "Sales" })',
                timeout: 20000,
                success: function (data) {
                    //a
                    var cbo = $('#Employee').data('tComboBox');
                    cbo.dataBind(data);
                    if (cbo.selectedIndex > -1) {

                        var selected = cbo.data[cbo.selectedIndex];

                        if (selected != undefined) {
                            cbo.value(selected.Value);
                            cbo.text(selected.Text);
                            cbo.selectedIndex = cbo.selectedIndex;
                            cbo.previousValue = selected.Value;
                        } else {
                            cbo.value(-1);
                            cbo.text("");
                        }
                    } else {
                        cbo.value(-1);
                        cbo.text("");
                    }
                }
            });
        }
        function plating_OnChange() {
            RefreshGrid("grid");
        }

        function grid_OnDataBinding(args) {
            var exportId = $("#TransactionPlating").data('tComboBox').value();
            if (exportId === "") exportId = 0;
            args.data = $.extend(args.data, {
                exportId: exportId,
            });
        }

        function grid_OnSubmitChanges(e) {
            if (!onProcessing) {
                OnProcessingData();
                var exportId = $("#TransactionPlating").data('tComboBox').value();
                if (exportId === "") exportId = 0;
                var employee = $("#Employee").data('tComboBox').value();
                if (employee === "") employee = 0;
                var processDate = $("#ExportDate").data("tDateTimePicker").value();
                if (processDate === null)
                    processDate = "";
                else
                    processDate = $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', processDate);
                var note = $('#Note').val();
                if (employee <= 0 || exportId <= 0) {
                    alert("Vui lòng điền đủ thông tin: PXK, nhân viên");
                    OnProcessedData();
                    e.preventDefault();
                }
                else {
                    e.values = $.extend(e.values, {
                        employeeId: employee,
                        exportId: exportId,
                        processDate: processDate,
                        note: note
                    });
                }
            } else {
                e.preventDefault();
            }
        }

        function grid_OnRowDataBound(e) {
            if (!e.dataItem.CanChose)
                e.row.getElementsByClassName("chkAdd")[0].outerHTML = "";
        }

        function grid_OnDataBound() {
            OnProcessedData();
        }
    </script>

}

<div class="title">
   @* Nhập gia công ngoài*@
    @HttpContext.GetGlobalResourceObject("Resource", "WorkOrderPlatingImport")
</div>
<div class="clear"></div>
<br />

<div class="t-info-sha fieldheader fieldheader1">
    <fieldset>
        <legend>
            @*Thông tin*@ 
            @HttpContext.GetGlobalResourceObject("Resource", "Information") Work Order</legend>
        <div class="grid_3">
            @*Chọn phiếu*@
            @HttpContext.GetGlobalResourceObject("Resource", "Select")
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("TransactionPlating")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxWorkOrderPlatingExport", "WorkOrder", new { area = "Factory" })
                    .Delay(350))
                    .HtmlAttributes(new { style = "width: 100%" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .HighlightFirstMatch(true)
                    .ClientEvents(events => events.OnChange("plating_OnChange"))
                    .AutoFill(true)
                    .Render();
            }
        </div>
        <div class="grid_3_5">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshCombobox('TransactionPlating'); ">
                <span class='t-icon t-refresh'></span>
                <span class="loadButton"></span>
            </button>
        </div>
        <div class="clear"></div>
            
        <div class="grid_3">
            @*Ngày nhập kho*@
            @HttpContext.GetGlobalResourceObject("Resource", "ImportDate")
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().DateTimePicker()
                    .Name("ExportDate")
                    .Format("dd/MM/yyyy HH:mm")
                    .Value(DateTime.Now)
                    .Render();
            }
        </div>
    </fieldset>
</div>

<div class="t-info-sha fieldheader fieldheader2">
    <fieldset>
        <legend>
            @*Ghi chú*@
            @HttpContext.GetGlobalResourceObject("Resource", "Note")
        </legend>
        <div>@Html.TextArea("Note", new  { style="min-width: 265px; min-height: 56px;" })</div>
    </fieldset>
</div>

<div class="t-info-sha fieldheader fieldheader3">
    <fieldset>
        <legend>
            @*Thông tin*@
            @HttpContext.GetGlobalResourceObject("Resource", "Infomation")
        </legend>
        <div class="grid_2">
            @*Nhân viên*@
            @HttpContext.GetGlobalResourceObject("Resource", "Employee")
        </div>
        <div class="grid_4">
            @{
                    Html.Telerik().ComboBox()
                        .Name("Employee")
                        //.DataBinding(binding => binding.Ajax().Select("SelectComboBoxEmployee", "Employee", new { area = "Sales" }).Delay(350))
                        .HtmlAttributes(new { style = "width: 100%" })
                        //.DropDownHtmlAttributes(new { style = "width: 150px" })
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .HighlightFirstMatch(true)
                        .AutoFill(true)
                        .Render();
                }
        </div>
        <div class="clear"></div>
        
    </fieldset>
</div>

<div class="clear"></div>
<br />

<div class="cover-div">
    @{
        Html.Telerik().Grid<WorkOrderPlatingDetailModel>()
            .Name("grid")
            .ToolBar(bar => bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
                .SaveText(@HttpContext.GetGlobalResourceObject("Resource", "SaveText").ToString())
                .CancelText(@HttpContext.GetGlobalResourceObject("Resource", "CancelText").ToString())
                )
            .DataKeys(keys => keys.Add(f => f.DetailId).RouteKey("detailId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectWorkOrderPlatingExportDetails", "WorkOrder", new { area = "Factory", exportId = 0 })
                .Update("CreateWorkOrderPlatingImport", "WorkOrder", new { area = "Factory" })
                )
            .Columns(columns => {

                columns.Bound(f => f.CanAdd).Width(50)
                    //.Title("Chọn")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Select").ToString())
                    .HeaderHtmlAttributes(new { @class = "edit-column" })
                    .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsRotateAll_<#= DetailId #>' class='chkAdd' <#=CanAdd? checked='checked' : '' #> />")
                    .HtmlAttributes(new { style = "text-align: center;" });

                columns.Bound(f => f.RoutingLot).Width(80)
                    //.HeaderTemplate("Số</br>WO")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "WorkOrderNumber2").ToString())
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .HtmlAttributes(new { style = "text-align: center;" });
               
                columns.Bound(f => f.ProductCode).Width(100)
                    //.HeaderTemplate("Mã</br>SP")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductCode1").ToString())
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .HtmlAttributes(new { style = "text-align: center;border-right: 1px solid black;" });

                columns.Bound(f => f.PlatingCode).Width(90)
                    //.HeaderTemplate("Mã</br>gia công")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "PlatingCode1").ToString())
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" });
            
                columns.Bound(f => f.Thickness).Width(75)
                    ////.HeaderTemplate("Độ dày</br>(µm)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Thickness").ToString()
                        + "</br>(µm)"
                    )
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" });
              
                columns.Bound(f => f.SaltSprayTime).Width(75)
                    //.HeaderTemplate("Phun muối</br>(h)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "SaltSpray").ToString()
                        + "</br>(h)"
                    )
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" });
              
                columns.Bound(f => f.SpecialRequest).Width(75)
                    //.Title("Yêu cầu")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Request").ToString())
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" });
               
                columns.Bound(f => f.Sample).Width(75)
                    //.Title("Mẫu SP")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductSample2").ToString())
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" });
              
                columns.Bound(f => f.TestingEquipment).Width(75)
                    //.Title("Thiết bị KT")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "TestingEquipment2").ToString())
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .HtmlAttributes(new { style = "border-right: 1px solid black;" });
                
                columns.Bound(f => f.ProductWeight).Width(90)
                    //.HeaderTemplate("Trọng lượng</br>Sản phẩm</br>(g/pc)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductWeight2").ToString()
                        + "</br>(g/pc)"
                    )
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .Format("{0:n4}")
                    .HtmlAttributes(new { style = "text-align: center;" });
                
                columns.Bound(f => f.PlannedCost).Width(90)
                    //.HeaderTemplate("Số lượng</br>gia công</br>(pcs)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "FlatingQuantity2").ToString()
                        + "</br>(pcs)"
                    )
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                
                columns.Bound(f => f.PlannedWeight).Width(90)
                    //.HeaderTemplate("Trọng lượng</br>gia công</br>(g)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "FlatingWeight2").ToString()
                        + "</br>(g)"
                    )
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" })
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
               
                columns.Bound(f => f.UsingWeight).Width(90)
                    //.HeaderTemplate("Trọng lượng</br>cân</br>(g)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Weight1").ToString()
                        + "</br>(g)"
                    )
                    .HeaderHtmlAttributes(new { @class = "good-column", style = "text-align: center;" })
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                
                columns.Bound(f => f.Unit).Width(50)
                    //.Title("ĐVT")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "UnitMeasureName1").ToString())
                    .ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "text-align: center;" });
               
                columns.Bound(f => f.Note).Width(150)
                    //.Title("Ghi</br>chú")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Note").ToString())
                    .HeaderHtmlAttributes(new { @class = "good-column" })
                    .HeaderHtmlAttributes(new { style = "text-align: center;" });
               
                columns.Bound(f => f.ProductInvId).Hidden(true);
                
            })
            .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
            .ClientEvents(events => events
                .OnDataBinding("grid_OnDataBinding")
                .OnDataBound("grid_OnDataBound")
                .OnRowDataBound("grid_OnRowDataBound")
                .OnSubmitChanges("grid_OnSubmitChanges")
                .OnError("grid_OnError")
            )
            .Groupable(group => group.Groups(g => g.Add(model => model.ProductCode)))
            .KeyboardNavigation()
            .Render();   
    }
</div>

<div class="clear"></div><br />