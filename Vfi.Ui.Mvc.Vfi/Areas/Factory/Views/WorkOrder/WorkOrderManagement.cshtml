@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "WorkOrderManagement";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script type="text/javascript" src="@Url.Content("~/Scripts/OnLoad.js")"></script>
<script type="text/javascript">

    function grid_OnDataBinding(args) {
        if (startGrid) {
            var status = $("#Status").data("tComboBox").value();
            if (status === "")
                status = 0;
            var customerId = $("#Customer").data('tComboBox').value();
            if (customerId === "") {
                customerId = 0;
            }
            var machineId = $("#Machine").data('tComboBox').value();
            if (machineId === "") {
                machineId = 0;
            }
            var productCode = $("#ProductCodeName").data("tAutoComplete").value();
            var fromDate = $("#FromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            var toDate = $("#ToDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else
                toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
            args.data = $.extend(args.data, {
                customerId: customerId,
                machineId: machineId,
                productCode: productCode,
                status: status,
                fromDate: fromDate,
                toDate: toDate,
            });
        }
    }

    function grid_OnDataBound() {
        OnLoadedData();
    }
    var startGrid = false;
    function RefreshGrid2(name) {
        if (!onLoading) {
            OnLoadingData();
            startGrid = true;
            $("#" + name).data("tGrid").ajaxRequest();
        }
    }


    var onLoading = false;
    function OnLoadingData() {
        if (!onLoading) {
            onLoading = true;
            var loadings = document.querySelectorAll('.twoToneButton');
            for (var i = 0; i < loadings.length; i++) {
                var loading = loadings[i];
                loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (Chờ load)";
                loading.classList.add('loading');
            }
        }
    }
    function OnLoadedData() {
        if (onLoading) {
            var loadings = document.querySelectorAll('.twoToneButton');
            for (var i = 0; i < loadings.length; i++) {
                var loading = loadings[i];
                if (loading && loading.className.includes("loading")) {
                    loading.classList.remove('loading');
                    loading.innerHTML = "<span></span>";
                }
            }
            onLoading = false;
        }
    }

    function EditWorkOrders(id) {
        var $checkedRecords = $("input[name='chkIds" + id + "']:checked");

        if ($checkedRecords.length < 1) {
            alert("Vui lọn chọn ít nhất 1 Work Order");
            return;
        }

        var a = {};
        checkedRecords = "";
        for (var i = 0; i < $checkedRecords.length; i++) {
            if ($checkedRecords[i] === "0") continue;
            a[i] = $checkedRecords[i].value;

            checkedRecords += $checkedRecords[i].value;
            if (i < ($checkedRecords.length - 1))
                checkedRecords += ":";
        }
        if (checkedRecords.length > 0) {
            var link = '@Url.Action("EditWorkOrder", "WorkOrder", new { area = "Factory" })';
            window.location.href = link + "?ids=" + checkedRecords;
        }
        return false;
    }

    function AddWorkOrder(orderDetailId) {
        var link = '@Url.Action("AddWorkOrder", "WorkOrder", new { area = "Factory" })';
        window.location.href = link + "?orderDetailId=" + orderDetailId;
    }

    function gridRouting_OnEdit(e) {

        var dataItem = e.dataItem;
        var mode = e.mode;
        var form = e.form;
        if (mode == 'insert') {
            workOrderId = e.currentTarget.id.split("_")[1];
        }
        if (mode == 'edit') {
            var nodes = $(form).find('#RoutingName');
            nodes[0].parentNode.parentNode.innerHTML = dataItem.RoutingName;
        }
    }
    function gridRouting_OnRowDataBound(e) {
        if (!e.dataItem.CanCancel) {
            e.row.getElementsByClassName("t-button t-grid-delete t-button-icon")[0].parentNode.innerHTML = "";
            e.row.getElementsByClassName("t-button t-grid-edit t-button-icon")[0].parentNode.innerHTML = "";
        }
    }
    var workOrderId = 0;
    function woRoute_OnDataBinding(e) {
        e.data = $.extend({}, e.data, { workOrderId: workOrderId });

    }
    function Print(id) {
        $('#result').load('@Url.Action("PrintWorkOrder", "WorkOrder")',
        {
            workOrderId: id
        }, function () {
            var window = $('#windowReport').data('tWindow');
            window.open();
        });
        return false;
    }

</script>

<div class="title">@HttpContext.GetGlobalResourceObject("Resource", "WorkOrderManagement")</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">
        <fieldset>
            <legend>@HttpContext.GetGlobalResourceObject("Resource", "Filter")</legend>
            <div class="grid_2">@HttpContext.GetGlobalResourceObject("Resource", "Customer"):</div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Customer")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxWorkOrderCustomer", "Customer", new { area = "Sales" }))
                        .HtmlAttributes(new { style = "width: 100%" })
                        .DropDownHtmlAttributes(new { style = "min-width: 375px" })
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>
            <div class="grid_1_5">@HttpContext.GetGlobalResourceObject("Resource", "Product"):</div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeName")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxWorkOrderProduct", "Product", new { area = ""}))
                        .HtmlAttributes(new { style = "width: 100%" })
                        .DropDownHtmlAttributes(new { style = "min-width: 250px" })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            <div class="grid_1_5">
                @HttpContext.GetGlobalResourceObject("Resource", "Machine"):
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Machine")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxMachineAllProduction", "Machine", new { area = "Factory" }))
                        .HtmlAttributes(new { style = "width: 100%" })
                        //.DropDownHtmlAttributes(new { style = "width: 100%" })
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>
            <div class="grid_1">
                @HttpContext.GetGlobalResourceObject("Resource", "Status"):
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Status")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxWorkOrderStatus", "WorkOrder"))
                        .HtmlAttributes(new { style = "width: 150px" })
                        .DropDownHtmlAttributes(new { style = "width: 250px" })
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .HighlightFirstMatch(true)
                        .AutoFill(true)
                        .Render();
                }
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("FromDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today.Month + "/01/" + DateTime.Today.Year)
                        .Render();
                }
            <div class="clear"></div>
                @{
                    Html.Telerik().DatePicker()
                        .Name("ToDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
            <div class="grid_3">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2('grid'); ">
                    <span class='t-icon t-insert'></span>
                    @HttpContext.GetGlobalResourceObject("Resource", "Refresh")

                    <span class="twoToneButton"></span>
                </button>
            </div>
        </fieldset>
</div>


