                                                            .HtmlAttributes(new { style = "text-align: center;" })
                                                            .Aggregate(agg => agg.Sum())
                                                            .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                                            .FooterHtmlAttributes(new { style = "text-align: center;" });
                                                        
                                                        columns.Bound(f => f.NGWeight)
                                                            //.Title("TL CPL</br>(g)")
                                                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "NGWeight").ToString())
                                                            .ReadOnly(true).Width(70)
                                                            .HeaderHtmlAttributes(new { @class = "ng-column" })
                                                            .Format("{0:n0}")
                                                            .HtmlAttributes(new { style = "text-align: center;border-right:1px solid black;" })
                                                            .Aggregate(agg => agg.Sum())
                                                            .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                                            .FooterHtmlAttributes(new { style = "text-align: center;" });
                                                        
                                                        columns.Bound(f => f.DefectQuantity)
                                                            //.Title("SL PP</br>(pcs)")
                                                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "DefectQuantity1").ToString())
                                                            .Width(70)
                                                            .HeaderHtmlAttributes(new { @class = "defect-column" })
                                                            .Format("{0:n0}")
                                                            .HtmlAttributes(new { style = "text-align: center;" })
                                                            .Aggregate(agg => agg.Sum())
                                                            .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                                            .FooterHtmlAttributes(new { style = "text-align: center;" });
                                                        
                                                        columns.Bound(f => f.DefectWeight)
                                                            //.Title("TL PP</br>(g)")
                                                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "DefectWeight1").ToString())
                                                            .ReadOnly(true).Width(70)
                                                            .HeaderHtmlAttributes(new { @class = "defect-column" })
                                                            .Format("{0:n0}")
                                                            .HtmlAttributes(new { style = "text-align: center;border-right:1px solid black;" })
                                                            .Aggregate(agg => agg.Sum())
                                                            .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                                            .FooterHtmlAttributes(new { style = "text-align: center;" });

                                                        columns.Bound(f => f.EmployeeName)
                                                            //.Title("Nhân viên")
                                                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Employee").ToString())
                                                            .Width(100).ReadOnly(true)
                                                            .HtmlAttributes(new { style = "text-align: center;" });
                                                    })

                                                    .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
                                                    .ClientEvents(e => e.OnError("grid_OnError"))
                                                    //.Pageable(page => page.PageSize(10))
                                                    .ToHtmlString()
                                                )).ToHtmlString()))
                                                          
                                            .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
                                            .ClientEvents(e => e.OnError("grid_OnError")
                                                .OnEdit("gridRouting_OnEdit")
                                                .OnRowDataBound("gridRouting_OnRowDataBound")
                                                )
                                            //.Pageable(page => page.PageSize(10))
                                            .ToHtmlString()
                                        )).ToHtmlString()))
            .ClientEvents(events => events.OnError("grid_OnError")
                                          .OnRowSelect("grid_OnRowSelect")
                                          .OnDataBinding("grid_OnDataBinding")
                                          .OnDataBound("OnLoadedData")
                                          )
            .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
            .Selectable()
            .Scrollable(f => f.Height(510))
            .Resizable(f => f.Columns(true))
            .Reorderable(f => f.Columns(true))
            .Filterable()
            .Groupable(group => group.Groups(g => g.Add(model => model.ProductCode)).Visible(false))
            .Sortable()
            .Render();
    }
</div>

