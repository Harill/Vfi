@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnLoad.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnProcess.js")"></script>
    <script type="text/javascript">

        $(document).ready(function () {
            loadEmployeeLogin();
            clearWorkOrderInfo();
            document.getElementById("RoutingSerial").focus();
        });

        function loadEmployeeLogin() {
            $.ajax({
                type: 'post',
                data: {},
                dataType: 'json',
                url: '@Url.Action("GetComboBoxEmployeeLogin", "Employee", new { area = "Sales" })',
                timeout: 20000,
                success: function (data) {
                    //a
                    var cbo = $('#Employee').data('tComboBox');
                    cbo.dataBind(data);
                    if (cbo.selectedIndex > -1) {

                        var selected = cbo.data[cbo.selectedIndex];

                        if (selected != undefined) {
                            cbo.value(selected.Value);
                            cbo.text(selected.Text);
                            cbo.selectedIndex = cbo.selectedIndex;
                            cbo.previousValue = selected.Value;
                        } else {
                            cbo.value(-1);
                            cbo.text("");
                        }
                    } else {
                        cbo.value(-1);
                        cbo.text("");
                    }
                }
            });
        }

        @*        function grid_OnDataBinding(e) {
            if (routingId > 0) {
                e.data = $.extend(e.data, {
                    routingId: routingId,
                });
            }
        }

        function saveProcess() {
            $.ajax({
                type: 'post',
                data: { },
                dataType: 'json',
                url: '@Url.Action("CreateAssignWorkOrderMaterial", "WorkOrder", new { area = "Factory" })',
                    timeout: 20000,
                    success: function (res) {
                        if (res.Code === 1) {
                            alert("Đã lưu " + res.Data);
                            if (res.Message && res.Message != "") {
                                alert(res.Message);
                            }
                            ClearData();
                            RefreshCombobox("WorkOrder");
                            RefreshGrid("grid");
                        } else {
                            alert("Lỗi! " + res.Message);
                        }
                        OnProcessedData();
                    }
            });
        }


        function grid_OnSubmitChanges(e) {
            if (!onProcessing) {
                OnProcessingData();
                var workOrder = $("#WorkOrder").data('tComboBox').value();
                if (workOrder === "") workOrder = 0;
                var employee = $("#Employee").data('tComboBox').value();
                if (employee === "") employee = 0;
                var productWeight = $("#ProductWeight").data("tTextBox").value();
                if (employee === 0 || productWeight == 0) {
                    alert("Vui lòng điền đủ thông tin: nhân viên, trọng lượng SP");
                    OnProcessedData();
                    e.preventDefault();
                }
                else {
                    e.values = $.extend(e.values,
                        {
                            routingId: workOrder,
                            employeeId: employee,
                            machineId: 0,
                            productWeight: productWeight,
                        });
                }
            } else {
                e.preventDefault();
            }
        }

        function grid_OnDataBound() {
            OnProcessedData();
            clearWorkOrderInfo();
            clearMaterialInvInfo();
            document.getElementById("RoutingSerial").focus();
        }
        function grid_OnRowDataBound(e) {
            if (e.dataItem.DiffQuantity < 0) {
                e.row.lastChild.bgColor = 'orange';
            }
        }*@
    </script>

    <script>

        var materialInvId = 0;
        var plannedCost = 0;
        var routingId = 0;
        function workOrderOnChange() {
            var routingSerial = $("#RoutingSerial").val();
            //alert(routingSerial);
            $.ajax({
                type: 'post',
                data: { serialNumber: routingSerial },
                dataType: 'json',
                url: '@Url.Action("CheckWorkOrderRoutingInfoBySerialNumber", "WorkOrder", new { area = "Factory" })',
                timeout: 20000,
                success: function (res) {
                    //OnLoadedData();
                    if (res.Code === 1) {
                        routingId = res.Data.RoutingId;
                        $("#ProductCode")[0].innerText = res.Data.ProductCode;

                        $("#RoutingName")[0].innerText = res.Data.RoutingName;
                        $("#NextRouteName")[0].innerText = res.Data.NextRouteName;

                        $("#WorkOrderQuantity")[0].innerText = res.Data.PlannedCost.format(0);
                        plannedCost = res.Data.PlannedCost;
                        materialInvId = res.Data.MaterialInvId;
                        clearMaterialInvInfo();
                        document.getElementById("MaterialInvCode").focus();
                        //OnLoadedData();
                    } else {
                        var url = '@Url.Content("~/Resources/wo_error.mp3")';
                        //var audio = new Audio('https://docs.google.com/uc?export=download&id=11VRt5QgoJC3_Rd9oya-0WxJIoLAp3Byb');
                        var audio = new Audio(url);
                        audio.play();
                        alert("Lỗi! " + res.Message);
                    }
                }
            });
        }
        function materialInvOnChange() {
            var materialInvCode = $("#MaterialInvCode").val();
            $.ajax({
                type: 'post',
                data: { serialNumber: materialInvCode },
                dataType: 'json',
                url: '@Url.Action("CheckMaterialInventory", "WorkOrder", new { area = "Factory" })',
                timeout: 20000,
                success: function (res) {
                    //OnLoadedData();
                    if (res.Code === 1) {
                        $("#MaterialCode")[0].innerText = res.Data.MaterialCode;
                        $("#MaterialLot")[0].innerText = res.Data.LotNumber;
                        $("#MaterialInvQuantity")[0].innerText = res.Data.TotalQty.format(2);
                        $("#MaterialInvKg")[0].innerText = res.Data.TotalQtyKg.format(2);
                        if (res.Data.MaterialInventoryId === materialInvId) {
                            if (res.Data.TotalQty <= plannedCost) {
                                var audio = new Audio('https://docs.google.com/uc?export=download&id=1UpzMB5NHWew3Up0LpqbgfIBSbBq_Jjx7');
                                audio.play();
                                alert("Lỗi! Nguyên liệu không đủ tồn kho");
                            } else {
                                //alert("Chúc mừng bạn đã làm đúng gòi");
                                var employee = $('#Employee').data('tComboBox').value();
                                if (employee === "" || employee < 0) {
                                    alert("Lỗi! Chưa chọn nhân viên.");
                                }
                                $.ajax({
                                    type: 'post',
                                    data: { ids: routingId, employeeId: employee, },
                                    dataType: 'json',
                                    url: '@Url.Action("AssignMaterialWorkOrders", "WorkOrder", new { area = "Factory" })',
                                    timeout: 20000,
                                    success: function (res) {
                                        if (res.Code === 1) {
                                            //alert("Hoàn thành lưu " + res.Data);
                                            var url = '@Url.Content("~/Resources/success.mp3")';
                                            var audio = new Audio(url);
                                            audio.play();
                                            document.getElementById("RoutingSerial").focus();
                                            clearWorkOrderInfo();
                                        } else {
                                            alert(res.Message);
                                        }
                                        OnProcessedData();
                                    }
                                });
                            }
                        }
                        else {
                            var url = '@Url.Content("~/Resources/material_error.mp3")';
                            var audio = new Audio(url);
                            //var audio = new Audio('https://docs.google.com/uc?export=download&id=1UpzMB5NHWew3Up0LpqbgfIBSbBq_Jjx7');
                            audio.play();
                            alert("Sai nguyên liệu sử dụng trong của Work Order");
                            document.getElementById("MaterialInvCode").focus();
                            document.getElementById("MaterialInvCode").setSelectionRange(0, materialInvCode.length);
                        }
                    } else {
                        var url = '@Url.Content("~/Resources/material_error.mp3")';
                        var audio = new Audio(url);
                        //var audio = new Audio('https://docs.google.com/uc?export=download&id=1UpzMB5NHWew3Up0LpqbgfIBSbBq_Jjx7');
                        audio.play();
                        alert("Lỗi! " + res.Message);
                    }
                }
            });
            //alert(materialInvCode);
        }
    </script>

    <script>
        function clearWorkOrderInfo() {
            document.getElementById("RoutingSerial").value = '';
            $("#ProductCode")[0].innerText = '~~';
            $("#RoutingName")[0].innerText = '~~';
            $("#NextRouteName")[0].innerText = '~~';
            $("#WorkOrderQuantity")[0].innerText = '0';
            plannedCost = 0;
            materialInvId = 0;
            routingId = 0;
            clearMaterialInvInfo();
        }
        function clearMaterialInvInfo() {
            document.getElementById("MaterialInvCode").value = '';
            $("#MaterialCode")[0].innerText = '~~';
            $("#MaterialLot")[0].innerText = '~~';
            $("#MaterialInvQuantity")[0].innerText = '0';
            $("#MaterialInvKg")[0].innerText = '0';
        }
    </script>
}

