                columns.Bound(f => f.MachineName)
                    //.Title("Máy")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Machine").ToString())
                    .Width(120).ReadOnly(true);
                
                columns.Bound(f => f.Date)
                    //.Title("Ngày")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Date").ToString())
                    .Width(120).ReadOnly(true)
                    .Format("{0:dd/MM/yyyy HH:mm}")
                    .HtmlAttributes(new { style = "text-align: center;border-right:1px solid black;" });
                
                columns.Bound(f => f.StatusName).Width(100)
                    //.Title("Tình trạng")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Status").ToString());
                
