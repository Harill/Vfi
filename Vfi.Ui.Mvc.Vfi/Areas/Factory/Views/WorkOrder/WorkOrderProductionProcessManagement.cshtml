@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@{
    ViewBag.Title = "DS nhập liệu công đoạn 1";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnLoad.js")"></script>
    <script type="text/javascript">

        function grid_OnDataBinding(args) {
            if (startGrid && !onLoading) {
                OnLoadingData();
                var status = $("#Status").data("tComboBox").value();
                if (status === "")
                    status = 0;
                var fromDate = $("#FromDate").data("tDateTimePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', fromDate);
                var toDate = $("#ToDate").data("tDateTimePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', toDate);
                var productCode = $("#ProductCodeName").data("tAutoComplete").value();
                args.data = $.extend(args.data, {
                    status: status,
                    productCode: productCode,
                    fromDate: fromDate,
                    toDate: toDate,
                    config: "{IsProduction:true}"
                });
            }
        }

        function grid_OnDataBound() {
            OnLoadedData();
        }

        var startGrid = false;
        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }
    </script>
}
<div class="title">Danh sách nhập liệu công đoạn 1</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">
        <fieldset>
            <legend>Tiêu chí trích lọc</legend>
        <div class="grid_2">Sản phẩm:</div>
        <div class="grid_4">
            @{
                Html.Telerik().AutoComplete()
                    .Name("ProductCodeName")
                    .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv", new { area = "Inv" }))
                    .HtmlAttributes(new { style = "width: 100%" })
                    .DropDownHtmlAttributes(new { style = "min-width: 250px" })
                    .Encode(false)
                    .AutoFill(true)
                    .HighlightFirstMatch(true)
                    .Render();
            }
        </div>
        <div class="grid_2">
            Tình trạng
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("Status")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxWorkOrderStatus", "WorkOrder"))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .HighlightFirstMatch(true)
                    .AutoFill(true)
                    .Render();
            }
        </div>
            <div class="grid_4">
                @{
                    Html.Telerik().DateTimePicker()
                        .Name("FromDate")
                        .Format("dd/MM/yyyy HH:mm")
                        .Value(DateTime.Today.AddDays(-1))
                        .Render();
                }
            <div class="clear"></div>
                @{
                    Html.Telerik().DateTimePicker()
                        .Name("ToDate")
                        .Format("dd/MM/yyyy HH:mm")
                        .Value(DateTime.Now)
                        .Render();
                }
            </div>
            <div class="grid_3">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2('grid'); ">
                    <span class='t-icon t-insert'></span>
                    Làm mới
                <span class="loadButton"></span>
                </button>
            </div>
        </fieldset>
    </div>

<div class="cover-div">
    @{
        Html.Telerik().Grid<WorkOrderProcessModel>()
            .Name("grid")
            .DataKeys(keys => keys.Add(f => f.ProcessId).RouteKey("processId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectWorkOrderProcesses", "WorkOrder",
                new { area = "Factory", status = 0 })
            )
            .Columns(columns => {
                columns.Bound(f => f.ProductCode).Title("Sản phẩm").Width(120).ReadOnly(true);
                columns.Bound(f => f.WorkOrderSerial).Title("Số WO").Width(120).ReadOnly(true);
                columns.Bound(f => f.MachineName).Title("Máy").Width(120).ReadOnly(true);
                columns.Bound(f => f.Date).Title("Ngày").Width(120).ReadOnly(true)
                    .Format("{0:dd/MM/yyyy HH:mm}")
                    .HtmlAttributes(new { style = "text-align: center;border-right:1px solid black;" });
                columns.Bound(f => f.StatusName).Width(100).Title("Tình trạng");
                //columns.Bound(f => f.Shift).Title("Ca").Width(40).ReadOnly(true);
                columns.Bound(f => f.UsingQuantity).Title("Sử dụng</br>(cây)").ReadOnly(true).Width(50)
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: center;border-right:1px solid black;" })
                    .Aggregate(agg => agg.Sum())
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .FooterHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.GoodQuantity).Title("SL OK</br>(pcs)").Width(70)
                    .HeaderHtmlAttributes(new { @class = "good-column" })
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: center;" })
                    .Aggregate(agg => agg.Sum())
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .FooterHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.GoodWeight).Title("TL OK</br>(g)").ReadOnly(true).Width(70)
                    .HeaderHtmlAttributes(new { @class = "good-column" })
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: center;border-right:1px solid black;" })
                    .Aggregate(agg => agg.Sum())
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .FooterHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.NGQuantity).Title("SL CPL</br>(pcs)").Width(70)
                    .HeaderHtmlAttributes(new { @class = "ng-column" })
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: center;" })
                    .Aggregate(agg => agg.Sum())
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .FooterHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.NGWeight).Title("TL CPL</br>(g)").ReadOnly(true).Width(70)
                    .HeaderHtmlAttributes(new { @class = "ng-column" })
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: center;border-right:1px solid black;" })
                    .Aggregate(agg => agg.Sum())
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .FooterHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.DefectQuantity).Title("SL PP</br>(pcs)").Width(70)
                    .HeaderHtmlAttributes(new { @class = "defect-column" })
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: center;" })
                    .Aggregate(agg => agg.Sum())
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .FooterHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.DefectWeight).Title("TL PP</br>(g)").ReadOnly(true).Width(70)
                    .HeaderHtmlAttributes(new { @class = "defect-column" })
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: center;border-right:1px solid black;" })
                    .Aggregate(agg => agg.Sum())
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .FooterHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.DiffQuantity).Title("Chênh lệch</br>TT-DM").ReadOnly(true).Width(70)
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: center;" })
                    .Aggregate(agg => agg.Sum())
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .FooterHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(f => f.DiffPercent).Title("Chênh lệch</br>(%)").ReadOnly(true).Width(70)
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: center;border-right:1px solid black;" });
                //.Aggregate(agg => agg.Average())
                //.ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Average) #>")
                //.FooterHtmlAttributes(new { style = "text-align: center;" });

                columns.Bound(f => f.EmployeeName).Title("Nhân viên").ReadOnly(true)
                    .HtmlAttributes(new { style = "text-align: center;" });
            })
            .Reorderable(f => f.Columns(true))
            .Sortable()
            .Groupable()
            .Filterable()
            .Selectable()
            .ClientEvents(events => events
                .OnRowSelect("grid_OnRowSelect")
                .OnDataBinding("grid_OnDataBinding")
                .OnDataBound("grid_OnDataBound")
                .OnError("grid_OnError"))
            .Render();
    }
</div>
