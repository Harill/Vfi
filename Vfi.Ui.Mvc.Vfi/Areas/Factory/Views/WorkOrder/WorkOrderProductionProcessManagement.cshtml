@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@{
    ViewBag.Title = "DS nhập liệu công đoạn 1";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnLoad.js")"></script>
    <script type="text/javascript">

        function grid_OnDataBinding(args) {
            if (startGrid && !onLoading) {
                OnLoadingData();
                var status = $("#Status").data("tComboBox").value();
                if (status === "")
                    status = 0;
                var fromDate = $("#FromDate").data("tDateTimePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', fromDate);
                var toDate = $("#ToDate").data("tDateTimePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', toDate);
                var productCode = $("#ProductCodeName").data("tAutoComplete").value();
                args.data = $.extend(args.data, {
                    status: status,
                    productCode: productCode,
                    fromDate: fromDate,
                    toDate: toDate,
                    config: "{IsProduction:true}"
                });
            }
        }

        function grid_OnDataBound() {
            OnLoadedData();
        }

        var startGrid = false;
        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }
    </script>
}
<div class="title">@HttpContext.GetGlobalResourceObject("Resource", "WorkOrderProductionProcessManagement")</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">
        <fieldset>
            <legend>@HttpContext.GetGlobalResourceObject("Resource", "Filter")</legend>
        <div class="grid_2">@HttpContext.GetGlobalResourceObject("Resource", "Product"):</div>
        <div class="grid_4">
            @{
                Html.Telerik().AutoComplete()
                    .Name("ProductCodeName")
                    .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv", new { area = "Inv" }))
                    .HtmlAttributes(new { style = "width: 100%" })
                    .DropDownHtmlAttributes(new { style = "min-width: 250px" })
                    .Encode(false)
                    .AutoFill(true)
                    .HighlightFirstMatch(true)
                    .Render();
            }
        </div>
        <div class="grid_2">
            @*Tình trạng*@
            @HttpContext.GetGlobalResourceObject("Resource", "Status"):
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("Status")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxWorkOrderStatus", "WorkOrder"))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .HighlightFirstMatch(true)
                    .AutoFill(true)
                    .Render();
            }
        </div>
            <div class="grid_4">
                @{
                    Html.Telerik().DateTimePicker()
                        .Name("FromDate")
                        .Format("dd/MM/yyyy HH:mm")
                        .Value(DateTime.Today.AddDays(-1))
                        .Render();
                }
            <div class="clear"></div>
                @{
                    Html.Telerik().DateTimePicker()
                        .Name("ToDate")
                        .Format("dd/MM/yyyy HH:mm")
                        .Value(DateTime.Now)
                        .Render();
                }
            </div>
            <div class="grid_3">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2('grid'); ">
                    <span class='t-icon t-insert'></span>
                    @*Làm mới*@
                    @HttpContext.GetGlobalResourceObject("Resource", "Refresh")
                <span class="loadButton"></span>
                </button>
            </div>
        </fieldset>
    </div>

<div class="cover-div">
    @{
        Html.Telerik().Grid<WorkOrderProcessModel>()
            .Name("grid")
            .DataKeys(keys => keys.Add(f => f.ProcessId).RouteKey("processId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectWorkOrderProcesses", "WorkOrder",
                new { area = "Factory", status = 0 })
            )
            .Columns(columns => {
                columns.Bound(f => f.ProductCode)
                    //.Title("Sản phẩm")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Product").ToString())
                    .Width(120).ReadOnly(true);
                
