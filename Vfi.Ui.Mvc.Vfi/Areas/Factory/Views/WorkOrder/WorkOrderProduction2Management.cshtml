@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@{
    ViewBag.Title = "DS lệnh công đoạn 2";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnLoad.js")"></script>
    <script type="text/javascript">
        
        $(document).ready(function () {
            loadWO_Summary();
        });
        
        function loadWO_Summary() {
            $.ajax({
                type: 'post',
                data: { configStr: '{IsProduction2: true}' },
                dataType: 'json',
                url: '@Url.Action("GetWOSummary", "WorkOrder", new { area = "Factory" })',
                timeout: 20000,
                success: function (res) {
                    if (res.Code === 1) {
                        $("#wo_onProcess")[0].innerText = res.Data.DM.format(0);
                        $("#wo_inventory")[0].innerText = res.Data.NS.format(0);

                    } else {
                        alert("Lỗi! " + res.Message);
                    }
                }
            });   
        }

        function grid_OnDataBinding(args) {
            if (startGrid && !onLoading) {
                OnLoadingData();
                var status = $("#Status").data("tComboBox").value();
                if (status === "")
                    status = 0;
                var fromDate = $("#FromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#ToDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                var productCode = $("#ProductCodeName").data("tAutoComplete").value();
                args.data = $.extend(args.data, {
                    status: status,
                    productCode: productCode,
                    fromDate: fromDate,
                    toDate: toDate
                });
            }
        }

        function grid_OnRowDataBound(e) {
            if(e.dataItem.Status != @Convert.ToInt32(MyUtilities.WorkOrder.Status.InProcess)){            
                e.row.childNodes[e.row.childNodes.length - 1].innerHTML = "";
        }
        }

        function ForceFinish(routingId) {
            $.ajax({
                type: 'post',
                data: { routingId: routingId },
                dataType: 'json',
                url: '@Url.Action("ForceFinishWorkOrderRouting", "WorkOrder", new { area = "Factory" })',
                timeout: 20000,
                success: function (res) {
                    if (res.Code === 1) {
                        alert(res.Message);
                        RefreshGrid("grid");
                    } else {
                        alert("Lỗi! " + res.Message);
                    }
                }
            });
        }

        function grid_OnDataBound() {
            OnLoadedData();
        }

        var startGrid = false;
        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }
    </script>
}
<div class="title">
    @*Danh sách lệnh công đoạn 2*@
    @HttpContext.GetGlobalResourceObject("Resource", "WorkOrderProduction2Management")
</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">
    <fieldset>
        <legend>
            @*Tiêu chí trích lọc*@
            @HttpContext.GetGlobalResourceObject("Resource", "Filter")
        </legend>
        <div class="grid_2">
            @*Sản phẩm:*@
            @HttpContext.GetGlobalResourceObject("Resource", "Product"):
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().AutoComplete()
                    .Name("ProductCodeName")
                    .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv", new { area = "Inv" }))
                    .HtmlAttributes(new { style = "width: 100%" })
                    .DropDownHtmlAttributes(new { style = "min-width: 250px" })
                    .Encode(false)
                    .AutoFill(true)
                    .HighlightFirstMatch(true)
                    .Render();
            }
        </div>
        <div class="grid_2">
            @*Tình trạng*@
            @HttpContext.GetGlobalResourceObject("Resource", "Status"):
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("Status")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxWorkOrderStatus", "WorkOrder"))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .HighlightFirstMatch(true)
                    .AutoFill(true)
                    .Render();
            }
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("FromDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today.Month + "/01/" + DateTime.Today.Year)
                    .Render();
            }
            <div class="clear"></div>
            @{
                Html.Telerik().DatePicker()
                    .Name("ToDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today)
                    .Render();
            }
        </div>
        <div class="grid_3">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2('grid'); ">
                <span class='t-icon t-insert'></span>
                @*Làm mới*@
                @HttpContext.GetGlobalResourceObject("Resource", "Refresh")
                <span class="loadButton"></span>
            </button>
        </div>
        <div class="grid_2">
            @*Tổng WO đang xử lý*@
            @HttpContext.GetGlobalResourceObject("Resource", "TotalWOAreProcessing")
        </div>
        <div class="grid_3" style="font-size: large;">
            <span id="wo_onProcess">~~</span>
        </div>
        <div class="grid_2">
            @HttpContext.GetGlobalResourceObject("Resource", "TotalWOAreWaiting")
            @*Tổng WO đang tồn kho*@
        </div>
        <div class="grid_3" style="font-size: large;">
            <span id="wo_inventory">~~</span>
        </div>
    </fieldset>
</div>

<div class="cover-div">
