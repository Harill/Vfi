                    .Format("{0:dd/MM/yyyy HH:mm}");
                
                columns.Bound(f => f.ActualEndDate)
                    //.Title("Ngày<br/>kết thúc")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "EndDate").ToString())
                    .Width(80).ReadOnly(true)
                    .ClientTemplate("<#= ActualEndDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', ActualEndDate) #>");
                
