@using Telerik.Web.Mvc.UI
@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Models.Production
@{
    ViewBag.Title = "QL công đoạn SP Sx2";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .highslide-container div {
        font-family: Verdana, Helvetica;
        font-size: 10pt;
    }

    .highslide-container table {
        background: none;
    }

    .highslide {
        outline: none;
        text-decoration: none;
    }

        .highslide img {
            border: 2px solid silver;
        }

        .highslide:hover img {
            border-color: gray;
        }

    .highslide-active-anchor img {
        visibility: hidden;
    }

    .highslide-gallery .highslide-active-anchor img {
        border-color: black;
        visibility: visible;
        cursor: default;
    }

    .highslide-image {
        border-width: 2px;
        border-style: solid;
        border-color: white;
    }

    .highslide-wrapper, .highslide-outline {
        background: white;
    }

    .glossy-dark {
        background: #111;
    }

    .highslide-number {
        display: none;
        font-weight: bold;
        color: gray;
        font-size: .9em;
    }

    .highslide-caption {
        display: none;
        font-size: 1em;
        padding: 5px;
        width: 100%;
        text-align: center;
        font-weight: bold;
        /*background: white;*/
    }

    .highslide-heading {
        display: none;
        font-weight: bold;
        margin: 0.4em;
    }

    .highslide-dimming {
        /*position: absolute;*/
        background: black;
    }

    a.highslide-full-expand {
        display: block;
        margin: 0 10px 10px 0;
        width: 34px;
        height: 34px;
    }

    .highslide-loading {
        display: block;
        color: black;
        font-size: 9px;
        font-weight: bold;
        text-transform: uppercase;
        text-decoration: none;
        padding: 3px;
        border: 1px solid white;
        background-color: white;
        padding-left: 22px;
        background-repeat: no-repeat;
        background-position: 3px 1px;
    }

    a.highslide-credits,
    a.highslide-credits i {
        padding: 2px;
        color: silver;
        text-decoration: none;
        font-size: 10px;
        display: none;
    }

        a.highslide-credits:hover,
        a.highslide-credits:hover i {
            color: white;
            background-color: gray;
        }

    .highslide-move, .highslide-move * {
        cursor: move;
    }

    .highslide-viewport {
        display: none;
        position: fixed;
        width: 100%;
        height: 100%;
        z-index: 1;
        background: none;
        left: 0;
        top: 0;
    }

    .highslide-overlay {
        display: none;
    }

    .hidden-container {
        display: none;
    }
    /* Example of a semitransparent, offset closebutton */
    .closebutton {
        position: relative;
        top: -15px;
        left: 15px;
        width: 30px;
        height: 30px;
        cursor: pointer;
        /* NOTE! For IE6, you also need to update the highslide-ie6.css file. */
    }

    .highslide-controls {
        display: none;
    }
</style>
@section Scripts{
    <script type="text/javascript">
        function gridProduct_OnDataBinding(args) {
            var statusValue = $("#Status").data("tComboBox").value();
            if (statusValue === "")
                statusValue = 0;
            var customer = $("#Customer").data("tComboBox").value();
            if (customer === "")
                customer = 0;
            var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
            args.data = $.extend(args.data, {
                customerId: customer,
                status: statusValue,
                productCode: productCodeName
            });
        }

        function gridProductionSection_OnDataBinding() {
            index = 0;
            count = 0;
        }

        var index = 0;
        var count = 0;

        function gridProductionSection_OnRowDataBound(e) {
            var dataItem = e.dataItem;
            if (dataItem.PermisstionType == 1) {
                this.getElementsByClassName("t-button t-grid-edit t-button-icon")[index - count].parentNode.innerHTML = "";
                count++;
            }
            index++;
        }

        function gridProductionPlating_OnDataBinding() {
            indexP = 0;
            countP = 0;
        }

        var indexP = 0;
        var countP = 0;

        function gridProductionPlating_OnRowDataBound(e) {
            var dataItem = e.dataItem;
            if (dataItem.PermisstionType == 1) {
                this.getElementsByClassName("t-button t-grid-edit t-button-icon")[indexP - countP].parentNode.innerHTML = "";
                countP++;
            }
            indexP++;
        }

        function gridProductionSection_OnSave(e) {
        }

        function gridProductionSection_OnEdit(e) {
            var mode = e.mode;
            var form = e.form;
            var dataItem = e.dataItem;
            if (mode == 'edit') {

                //if ((dataItem.PermisstionType == 1 || dataItem.StatusColor == 2)) {
               var  nodes = $(form).find('#SectionName');
               nodes[0].parentNode.parentNode.innerHTML = dataItem.SectionName;
               if (dataItem.Productivity >0)
                   {nodes = $(form).find('#Productivity');
                   nodes[0].parentNode.parentNode.innerHTML = dataItem.Productivity;
               }
                //nodes = $(form).find('#MaterialCode');
                //nodes[0].parentNode.parentNode.innerHTML = dataItem.MaterialCode;
                //}
                //if (dataItem.StatusColor == 2) {
                //}
            }

        }

        function gridProduct_onEdit(e) {
            var mode = e.mode;
            var form = e.form;

            var statusName = $(form).find('#StatusName');
            //var statusNameData = $(form).find('#StatusName').data('tComboBox');

            if (mode == 'insert') {

            } else if (mode == 'edit') {
                var dataItem = e.dataItem;
                if (dataItem.Status != 5) {
                    var nodes = this.getElementsByClassName("t-widget t-combobox t-header");
                    nodes[0].parentNode.innerHTML = "<strong>" + statusName.val() + "</strong>";
                }
            }
        }

        //   MaterialNameDesign OutDiameterDesign ShapeDesign DiameterTypeDesign

        function CheckUpdate(data) {
            var a = "";
            if (data.Diameter == 0)
                a += "\nThiếu cập nhật đường kính";
            if (data.Length == 0)
                a += "\nThiếu cập nhật chiều dài";
            if (data.ProcessingTypeName == "" || data.ProcessingTypeName == null)
                a += "\nThiếu cập nhật loại máy";
            if (data.KnifeCut == 0)
                a += "\nThiếu cập nhật chiều dài dao cắt";
            if (data.Productivity == 0)
                a += "\nThiếu cập nhật năng suất";
            if (data.MilProductivity == 0)
                a += "\nThiếu cập nhật năng suất";
            if (data.ProductionRate == 0)
                a += "\nThiếu cập nhật định mức";
            if (data.MaterialNameDesign == "" || data.MaterialNameDesign == null)
                a += "\nThiếu cập nhật tên nguyên liệu thiết kế";
            if (data.OutDiameterDesign == 0)
                a += "\nThiếu cập nhật đường kính nguyên liệu";
            if (data.ShapeDesign == "" || data.ShapeDesign == null)
                a += "\nThiếu cập nhật hình dạng nguyên liệu";
            if (data.DiameterTypeDesign == "" || data.DiameterTypeDesign == null)
                a += "\nThiếu cập nhật dung sai nguyên liệu";
            if (a == "")
                a += "Oke";
            return a;
        }

        function status_onChange() {
            RefreshGrid("gridProduct");
        }

        function customer_onChange() {
            RefreshGrid("gridProduct");
        }

        function gridProductionProcess_OnDataBinding() {
            indexP2 = 0;
            countP2 = 0;
        }

        var indexP2 = 0;
        var countP2 = 0;

        function gridProductionProcess_OnRowDataBound(e) {
            var dataItem = e.dataItem;
            switch (dataItem.WarehouseId) {
            case 5:
                indexP2++;
                break;
            case 12:
                indexP2++;
                break;
            default:
                this.getElementsByClassName("t-icon t-plus")[indexP2 - countP2].parentNode.innerHTML = "";
                countP2++;
                indexP2++;
                break;
            }
        }

        function gridProductionProcess_OnSave(e) {
            indexP2 = 0;
            countP2 = 0;
        }
    </script>

    <script type="text/javascript">
        hs.graphicsDir = '';
        hs.align = 'center';
        hs.transitions = ['expand', 'crossfade'];
        hs.outlineType = '';
        hs.fadeInOut = true;
        hs.numberPosition = 'caption';
        hs.dimmingOpacity = 0.75;

        // Add the controlbar
        if (hs.addSlideshow)
            hs.addSlideshow({
                //slideshowGroup: 'group1',
                interval: 5000,
                repeat: false,
                useControls: true,
                fixedControls: 'fit',
                overlayOptions: {
                    opacity: .75,
                    position: 'bottom center',
                    hideOnMouseOut: true
                }
            });
    </script>
}
<div class="title">Quản lý thông tin sản phẩm</div>
<div id="pnlInvPeriod">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: auto;">

        <fieldset>
            <legend>Tiêu chí trích lọc</legend>

            <div class="grid_1">
                Mã KH
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Customer")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                        .HtmlAttributes(new { style = "width: 150px" })
                        .DropDownHtmlAttributes(new { style = "width: 250px" })
                        .ClientEvents(events => events.OnChange("customer_onChange"))
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>
            <div class="grid_2">
                Tình trạng sản phẩm
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Status")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxProductStatus", "Product", new {area = ""}))
                        .HtmlAttributes(new {style = "width: 100%"})
                        .DropDownHtmlAttributes(new {style = "width: 250px"})
                        .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                        .HighlightFirstMatch(true)
                        .AutoFill(true)
                        .ClientEvents(events => events.OnChange("status_onChange"))
                        .Render();
                }
            </div>
            <div class="grid_1">Sản phẩm</div>
            <div class="grid_5">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeName")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv", new { area = "Inv" }))
                        .HtmlAttributes(new { style = "width: 150px; " })
                        .DropDownHtmlAttributes(new { style = "width: 250px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Value("")
                        //.ClientEvents(events => events.OnClose("ProductCodeName_OnClose"))
                        .Render();
                }
            </div>
            <button id="btnRefresh" class='t-button' onclick=" return RefreshGrid('gridProduct'); ">
                <span class='t-icon t-insert'></span>
                Làm mới
            </button>
        </fieldset>
    </div>
</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<ProductModel>()
            .Name("gridProduct")
            .DataKeys(key => key.Add(f => f.ProductId).RouteKey("productId"))

            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectProduct", "Product", new {area = "", active = true, status = 0, customerId = -1, productCode = "",productId = 0, productName = ""})
            )
            .Columns(columns =>
                {
                    //columns.Bound(f => f.Upload2D).Width(40).Title("Bản vẽ").ReadOnly(true)
                    //       .ClientTemplate("<a id='<#=ProductId#>' href='" + Url.Content("~/Content/FileUpload/Drawing/") + "<#=Upload2D#>?<#=UploadDate#>' class='highslide' onclick='return hs.expand(this)'>" +
                    //                       "<img src='" + Url.Content("~/Content/FileUpload/Drawing/") + "<#=Upload2D#>?<#=UploadDate#>' height='40' width='40' title='Mở lớn'/>" +
                    //                       "</a><div class='highslide-caption'><#= ProductCode #></div>");
                    //columns.Bound(f => f.UploadReal).Width(40).Title("Hình SP").ReadOnly(true)
                    //       .ClientTemplate("<a id='<#=ProductId#>' href='" + Url.Content("~/Content/FileUpload/Drawing/") + "<#=UploadReal#>?<#=UploadDate#>' class='highslide' onclick='return hs.expand(this)'>" +
                    //                       "<img src='" + Url.Content("~/Content/FileUpload/Drawing/") + "<#=UploadReal#>?<#=UploadDate#>' height='40' width='40' title='Mở lớn'/>" +
                    //                       "</a><div class='highslide-caption'><#= ProductCode #></div>");
                    columns.Bound(f => f.CustomerCode).Width(50).ReadOnly(true)
                           .HeaderTemplate("<strong>Mã</br>KH</strong>")
                           .HeaderHtmlAttributes(new {style = "text-align:center;"})
                           .HtmlAttributes(new {style = "text-align:center;"})
                           .ClientTemplate("<strong><#= CustomerCode #></strong>");
                    columns.Bound(f => f.ProductCode).Width(100).ReadOnly(true)
                           .HeaderTemplate("<strong>Mã</br>SP</strong>")
                           .HeaderHtmlAttributes(new {style = "text-align:center"})
                           .ClientTemplate("<strong><#= ProductCode #></strong>")
                           .Aggregate(agg => agg.Count())
                               .FooterHtmlAttributes(new { style = "text-align: right;" })
                           .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                        ;
                    columns.Bound(f => f.ForecastsQuality).Width(70)
                           .HeaderTemplate("Dự báo</br>sản xuất")
                           .Format("{0:n0}")
                           .HtmlAttributes(new {style = "text-align:right;"});
                    columns.Bound(f => f.SectionCount).Width(70).ReadOnly(true)
                           .HeaderTemplate("Tổng</br>công đoạn");
                })
             .DetailView(details2 => details2.ClientTemplate(
                                        Html.Telerik().TabStrip()
                                            .Name("TabStrip_<#= ProductId #>")
                                            .SelectedIndex(0)
                                            .Items(items3 => items3.Add().Text("Công đoạn")
                                                .Content(
                                                Html.Telerik().Grid<ProductionSectionModel>()
                                                    .Name("gridProductionSection_<#= ProductId #>")
                                                    .DataKeys(key => key.Add(f => f.ProductionSectionId).RouteKey("productionSectionId"))
                                                    .ToolBar(
                                                        toolbar =>
                                                        toolbar.Insert().Text("Thêm mới").ButtonType(GridButtonType.ImageAndText).ImageHtmlAttributes(new { style = "margin-left:0px;" }))
                                                    .DataBinding(
                                                        dataBinding => dataBinding.Ajax()
                                                                                  .Select("SelectProductionSectionByProcess", "Product", new { area = "", productId = "<#= ProductId #>", warehouseId = 12 })
                                                                                  .Insert("InsertProductionSectionByProcess", "Product", new { area = "", productId = "<#= ProductId #>", warehouseId = 12 })
                                                                                  .Update("EditProductionSectionByProcess", "Product", new { area = "", productId = "<#= ProductId #>", warehouseId = 12 })
                                                    )
                                                    .Columns(columns =>
                                                    {
                                                        columns.Command(command =>
                                                                        command
                                                                        .Edit().ButtonType(GridButtonType.Image).UpdateText("Cập nhật").CancelText("Hủy").Text("Sửa").InsertText("Thêm mới")
                                                            ).Width(50).Title("").HtmlAttributes(new { style = "text-align:center" });
                                                        columns.Bound(f => f.SectionName).Width(120)
                                                               .Title("Tên công đoạn");
                                                        columns.Bound(f => f.SectionIndex).Width(50).Title("Tiến trình")
                                                            .HtmlAttributes(new { style = "text-align:center;" });
                                                        columns.Bound(f => f.Productivity).Width(50).Title("Năng suất")
                                                               .Title("Năng suất")
                                                               .Format("{0:n2}")
                                                               .HtmlAttributes(new { style = "text-align:right;" });
                                                        columns.Bound(f => f.Weight).Width(50).Title("TL đầu ra")
                                                            .Format("{0:n3}").HtmlAttributes(new { style = "text-align:right;" });
                                                        columns.Bound(f => f.Description).Width(100).Title("Mô tả");
                                                        columns.Bound(f => f.UpdateDate).Width(70).Title("Ngày thêm")
                                                               .ReadOnly(true)
                                                               .Format("{0:dd/MM/yyyy}");
                                                        columns.Bound(f => f.UpdateUser).Width(60).Title("Người thêm").ReadOnly(true);
                                                        columns.Bound(f => f.Active).Width(40)
                                                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                                                               .HtmlAttributes(new { style = "text-align:center" });
                                                        //columns.Command(commands => commands.Delete().ButtonType(GridButtonType.Image)).Width(30).Title("");
                                                    })
                                                    .Editable(editing => editing.Mode(GridEditMode.InLine))
                                                    .ClientEvents(e => e.OnRowDataBound("gridProductionSection_OnRowDataBound")
                                                                        .OnDataBinding("gridProductionSection_OnDataBinding")
                                                                        .OnEdit("gridProductionSection_OnEdit")
                                          .OnSave("gridProductionSection_OnSave")
                                          .OnError("grid_OnError")
                                                                        )
                                                    .ToHtmlString()
                                                                 )
                                            )
                                            .ToHtmlString()
                                                                ))
            .ClientEvents(events => events.OnDataBinding("gridProduct_OnDataBinding")
                                          .OnEdit("gridProduct_onEdit")
                                          .OnError("grid_OnError")
                                          .OnRowSelect("grid_OnRowSelect")
                                          )
            .Editable(editing => editing.Mode(GridEditMode.InLine))
            .Selectable()
            .Scrollable(f => f.Height(610))
            .HtmlAttributes(new {style = "width: auto;"})
            .Resizable(f => f.Columns(true))
            .Reorderable(f => f.Columns(true))
            .Filterable()
            .Sortable()
            .Render();
    }
</div>
