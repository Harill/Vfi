@using Telerik.Web.Mvc.UI
@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@model MachineDiagram
@{
    ViewBag.Title = "Production Testing";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .highslide-container div {
        font-family: Verdana, Helvetica;
        font-size: 10pt;
    }

    .highslide-container table {
        background: none;
    }

    .highslide {
        outline: none;
        text-decoration: none;
    }

        .highslide img {
            border: 2px solid silver;
        }

        .highslide:hover img {
            border-color: gray;
        }

    .highslide-active-anchor img {
        visibility: hidden;
    }

    .highslide-gallery .highslide-active-anchor img {
        border-color: black;
        visibility: visible;
        cursor: default;
    }

    .highslide-image {
        border-width: 2px;
        border-style: solid;
        border-color: white;
    }

    .highslide-wrapper, .highslide-outline {
        background: white;
    }

    .glossy-dark {
        background: #111;
    }

    .highslide-number {
        display: none;
        font-weight: bold;
        color: gray;
        font-size: .9em;
    }

    .highslide-caption {
        display: none;
        font-size: 1em;
        padding: 5px;
        width: 100%;
        text-align: center;
        font-weight: bold;
        /*background: white;*/
    }

    .highslide-heading {
        display: none;
        font-weight: bold;
        margin: 0.4em;
    }

    .highslide-dimming {
        /*position: absolute;*/
        background: black;
    }

    a.highslide-full-expand {
        display: block;
        margin: 0 10px 10px 0;
        width: 34px;
        height: 34px;
    }

    .highslide-loading {
        display: block;
        color: black;
        font-size: 9px;
        font-weight: bold;
        text-transform: uppercase;
        text-decoration: none;
        padding: 3px;
        border: 1px solid white;
        background-color: white;
        padding-left: 22px;
        background-repeat: no-repeat;
        background-position: 3px 1px;
    }

    a.highslide-credits,
    a.highslide-credits i {
        padding: 2px;
        color: silver;
        text-decoration: none;
        font-size: 10px;
        display: none;
    }

        a.highslide-credits:hover,
        a.highslide-credits:hover i {
            color: white;
            background-color: gray;
        }

    .highslide-move, .highslide-move * {
        cursor: move;
    }

    .highslide-viewport {
        display: none;
        position: fixed;
        width: 100%;
        height: 100%;
        z-index: 1;
        background: none;
        left: 0;
        top: 0;
    }

    .highslide-overlay {
        display: none;
    }

    .hidden-container {
        display: none;
    }
    /* Example of a semitransparent, offset closebutton */
    .closebutton {
        position: relative;
        top: -15px;
        left: 15px;
        width: 30px;
        height: 30px;
        cursor: pointer;
        /* NOTE! For IE6, you also need to update the highslide-ie6.css file. */
    }

    .highslide-controls {
        display: none;
    }
</style>
<script type="text/javascript" src="@Url.Content("~/Scripts/easytimer.min.js")"   ></script>
@section Scripts{
    <script type="text/javascript">
        hs.graphicsDir = '';
        hs.align = 'center';
        hs.transitions = ['expand', 'crossfade'];
        hs.outlineType = '';
        hs.fadeInOut = true;
        hs.numberPosition = 'caption';
        hs.dimmingOpacity = 0.75;

        // Add the controlbar
        if (hs.addSlideshow)
            hs.addSlideshow({
                //slideshowGroup: 'group1',
                interval: 5000,
                repeat: false,
                useControls: true,
                fixedControls: 'fit',
                overlayOptions: {
                    opacity: .75,
                    position: 'bottom center',
                    hideOnMouseOut: true
                }
            });
    </script>
    <script type="text/javascript">
        
        $(document).ready(function () {
            timerTarget();
            $('#timer').html(new Date().getHours()+":00");
        });
        function timerTarget() {
            var timer = new easytimer.Timer();
            timer.start();
            timer.addEventListener('hoursUpdated', function (e) {
                $('#timer').html(new Date().getHours()+":00");
            });
        }

        function grid_OnSubmitChanges(e) {
            var warehouse = $('#Warehouse').data('tDropDownList').value();
            if (warehouse === "") {
                warehouse = 0;
            }
            var employee = $('#Employee').data('tComboBox').value();
            if (employee === "") {
                employee = 0;
            }
            e.values = $.extend(e.values,
                {
                    forWarehouseId: warehouse,
                    employeeId: employee,
                });
        }
        
        function grid_OnEdit(e) {
            var $machineName = $(e.cell).find('#MachineName');
            var typeIds = [];
            if(e.dataItem.TypeIds.length >0) {
                typeIds = e.dataItem.TypeIdsStr;
            }
            if ($machineName.length > 0) {
                var cboMachineName = $machineName.data("tComboBox");
                //var typeIds = e.dataItem.TypeIds.map(x=> x.);
                $.ajax({
                    type: 'post',
                    data: { typeIds: typeIds },
                    dataType: 'json',
                    url: '@Url.Action("SelectComboBoxMachineQcByType2", "Machine", new { area = "Factory" })',
                timeout: 20000,
                success: function(data) {
                    cboMachineName.dataBind(data);
                }
                });
            }
        }

        function grid_OnSave(e) {
            var $machineName = $(e.cell).find('#MachineName');
            if ($machineName.length > 0) {
                var machineName = $machineName.data("tComboBox"),
                    machineNameSelectItem = machineName.selectedIndex > -1 ? machineName.data[machineName.selectedIndex] : null;

                if (machineNameSelectItem) {
                    e.values["MachineName"] = machineNameSelectItem.Text;
                    e.values["MachineId"] = machineNameSelectItem.Value;

                }
            }else{
                var number = $(e.cell).find('#TestNumber').val();
                if (!isNaN(parseFloat(number))) {
                    number = parseFloat(number);
                    if(number < e.dataItem.MinNumber || number > e.dataItem.MaxNumber) {
                        e.cell.style.backgroundColor = "#ff1e1e";
                    }else if(number === e.dataItem.MinNumber || number === e.dataItem.MaxNumber) {
                        e.cell.style.backgroundColor = "Orange";
                    }
                    else{
                        e.cell.style.backgroundColor = "";
                    }
                }
            }
        }

        function grid_OnRowDataBound(e){
            if(e.dataItem.TestName.includes("▲")){
                e.row.childNodes[1].childNodes[0].style.backgroundColor = "Yellow";
            }
            
        }
        
    </script>
}
<span id="machineId" hidden>@Model.MachineId</span>
<span id="productId" hidden>@Model.ProductId</span>
<div class="title">Đo kiểm sản xuất</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">

    <fieldset>
        <legend>Thông tin</legend>
        <div class="grid_24">
        <div class="grid_3">Máy:</div>
        <div class="grid_3">Sản phẩm</div>
        <div class="grid_3">Thời gian</div>
        <div class="grid_4">Trực thuộc</div>
        <div class="grid_4">Nhân viên đo</div>
        <div class="clear"></div>

        <div class="grid_3">
            <h1>@Model.MachineName</h1>
        </div>
        <div class="grid_3">
            <h1>@Model.ProductCode</h1>
        </div>
        <div class="grid_3">
            <h1 id="timer"></h1>
        </div>
        <div class="grid_4">
            <h3>
                @{
                    Html.Telerik().DropDownList()
                        .Name("Warehouse")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxWarehouseSameType", "Warehouse", new { area = "Inv", warehouseId = @Model.WarehouseId }))
                        //.HtmlAttributes(new { style = "width: 200px" })
                        .DropDownHtmlAttributes(new { style = "width: 150px" })
                        .Render();
                }
            </h3>
        </div>
        <div class="grid_6">
            <h3>
                @{
                    Html.Telerik().ComboBox()
                        .Name("Employee")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxEmployeeByWarehouseId", "Employee", new { area = "Sales", warehouseId = 0 }).Delay(350))
                        .HtmlAttributes(new { style = "width: 100%" })
                        //.DropDownHtmlAttributes(new { style = "width: 150px" })
                        .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                        .HighlightFirstMatch(true)
                        .AutoFill(true)
                        .Render();
                }</h3>
        </div>
        @{
            if (@Model.Notes.Any()) {
                <div class="clear"></div>
                <div class="grid_3"><h1>Ghi chú</h1></div>
                <div style="float:left;">
                    @{
                        foreach (var note in @Model.Notes) {
                            <h2>@note</h2>
                        }    
                    }
                </div>
            }
        }
        </div>
@*        Ban ve Ky thuat*@
        <div>
            @{
                if (@Model.ProductImgs.Any()) {
                    <div style="float:left;">
                        @{
                            foreach (var productImg in @Model.ProductImgs) {
                                <a href='@Url.Content("~/Content/FileUpload/ProductImg/" + productImg.ImgUrl + "?" + productImg.UploadDate)' class='highslide' onclick='return hs.expand(this)'>
                                    <img src='@Url.Content("~/Content/FileUpload/ProductImg/" + productImg.ImgUrl + "?" + productImg.UploadDate)' title='Mở lớn' alt="@Model.ProductCode"
                                       @* height='40' width='40' *@
                                        style="max-height:120px; max-width:160px;"
                                        />
                                </a>
                            }    
                        }
                    </div>
                }
            }
        </div>
         <div class="grid_2_5"><h3>Ngoại quan ===></h3></div>

@*        Ban ve QC*@
                <div>
            @{
                if (@Model.QcImgs.Any()) {
                    <div style="float:left;">
                        @{
                            foreach (var qcImg in @Model.QcImgs) {
                                <a href='@Url.Content("~/Content/FileUpload/QcImg/" + qcImg.ImgUrl + "?" + qcImg.UploadDate)' class='highslide' onclick='return hs.expand(this)'>
                                    <img src='@Url.Content("~/Content/FileUpload/QcImg/" + qcImg.ImgUrl + "?" + qcImg.UploadDate)' title='Mở lớn' alt="@Model.ProductCode"
                                       @* height='40' width='40' *@
                                        style="max-height:120px; max-width:160px;"
                                        />
                                </a>
                            }    
                        }
                    </div>
                }
            }
        </div>

    </fieldset>
</div>

@*<div class="title">Đo kiểm sản phẩm</div>*@
<div class="cover-div">
    @{
        Html.Telerik().Grid<RealTestingModel>()
            .Name("gridMachinePlan")
            .DataKeys(key => key.Add(f => f.ReferenceTestingDetailId).RouteKey("referenceTestingDetailId"))
            .ToolBar(bar => bar.SubmitChanges().ButtonType(GridButtonType.ImageAndText).SaveText("Lưu lại").CancelText("Huỷ bỏ"))
            .DataBinding(
                dataBinding => dataBinding.Ajax()
                            .Select("SelectProductionTestingProduction1", "Production", new { productId = @Model.ProductId, warehouseId = @Model.WarehouseId })
                            .Update("SaveProductionTestingProduction1", "Production", new { machineId = @Model.MachineId, productId = @Model.ProductId, warehouseId = @Model.WarehouseId })
              )
            .Columns(columns => {
                //columns.Command(command =>
                //                command.Edit().ButtonType(GridButtonType.ImageAndText).UpdateText("Cập nhật").CancelText("Hủy").Text("Sửa")
                //    ).Width(98).Title("").HtmlAttributes(new { style = "text-align:center" });

                columns.Bound(f => f.TestCode).Width(50).Title("STT").ReadOnly(true);
                columns.Bound(f => f.TestName).Width(200).Title("Quy cách").ReadOnly(true)
                       .ClientTemplate("<strong><#= TestName #></strong>");
                columns.Bound(f => f.TestRate).Width(70).Title("Tần suất").ReadOnly(true);
                columns.Bound(f => f.MinNumber).Width(70).Title("MIN").ReadOnly(true);
                columns.Bound(f => f.MaxNumber).Width(70).Title("MAX").ReadOnly(true);
                columns.Bound(f => f.TestNumber).Width(100).Title("Số đo")
                       .ClientTemplate("<span class='TestNumber'><#= TestNumber #></span>");

                columns.Bound(f => f.MachineTypeName).Width(300).Title("Loại dụng cụ").ReadOnly(true)
                       .ClientTemplate("<strong><#= MachineTypeName #></strong>");
                columns.Bound(f => f.MachineName).Title("Dụng cụ");

            })
            .Editable(editing => editing.Mode(GridEditMode.InCell))
            .KeyboardNavigation()
            .ClientEvents(e => e.OnError("grid_OnError")
                .OnSave("grid_OnSave")
                .OnEdit("grid_OnEdit")
                .OnRowDataBound("grid_OnRowDataBound")
                .OnSubmitChanges("grid_OnSubmitChanges"))
            .Render();
    }
</div>
