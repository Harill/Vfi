
@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Outside Process Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="title">@HttpContext.GetGlobalResourceObject("Resource", "OutsideProcessManagement")</div>

<div class="cover-div">
@{
    Html.Telerik().Grid<OutsideProcessModel>()
        .Name("grid")
        .DataKeys(keys => keys.Add(f => f.ProcessId).RouteKey("processId"))
        .ToolBar(
            toolbar =>
            toolbar.Insert().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
                .Text(@HttpContext.GetGlobalResourceObject("Resource", "NewText").ToString())
                .ImageHtmlAttributes(new { style = "margin-left:0px;" }))
        .DataBinding(dataBinding => dataBinding.Ajax()
            .Select("SelectOutsideProcess", "Production", new { area = "Factory" })
            .Insert("InsertOutsideProcess", "Production", new { area = "Factory" })
            .Update("UpdateOutsideProcess", "Production", new { area = "Factory" })
        )
        .Columns(columns => {
            columns.Command(cmd => cmd.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image))
                   .Width(100)
                   .HtmlAttributes(new { style = "text-align:center;" });
            columns.Bound(f => f.Name)
                   //.Title("Tên")
                   .Title(@HttpContext.GetGlobalResourceObject("Resource", "Name").ToString());
            columns.Bound(f => f.Price).Width(100)
                   //.Title("Giá (USD/kg)")
                   .Title(@HttpContext.GetGlobalResourceObject("Resource", "Price1").ToString());
            columns.Bound(f => f.Active).Width(100)
                   //.Title("Kích hoạt")
                   .Title(@HttpContext.GetGlobalResourceObject("Resource", "Active").ToString());
            columns.Bound(f => f.ModifiedDate).Width(100)
                   //.Title("Ngày làm")
                   .ReadOnly(true)
                   .Format("{0:dd/MM/yyyy HH:mm}")
                   .Title(@HttpContext.GetGlobalResourceObject("Resource", "ModifiedDate").ToString());
            columns.Bound(f => f.ModifiedUser).Width(100)
                   //.Title("Người làm")
                   .ReadOnly(true)
                   .Format("{0:dd/MM/yyyy HH:mm}")
                   .Title(@HttpContext.GetGlobalResourceObject("Resource", "ModifiedUser").ToString());
        })
        .ClientEvents(events => events.OnError("grid_OnError"))
        .Render();
}
</div>

