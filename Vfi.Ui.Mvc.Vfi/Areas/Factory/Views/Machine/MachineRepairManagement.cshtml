                Phân công sửa máy
                <span class="loadButton"></span>
            </button>
            </div>
    <div class="clear"></div>
       
    
            <div class="grid_1">
                @*Ca*@
                @HttpContext.GetGlobalResourceObject("Resource", "Shift")
            </div>
            <div class="grid_1">
            @{
                Html.Telerik().IntegerTextBox()
