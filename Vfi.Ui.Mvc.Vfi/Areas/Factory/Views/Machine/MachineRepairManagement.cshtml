</div>
<div class="clear"></div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<MachineRepairFormModel>()
            .Name("gridMachine")
            .DataKeys(key => key.Add(f => f.FormId).RouteKey("formId"))
            .DataKeys(key => key.Add(f => f.MachineId).RouteKey("machineId"))
            .DataKeys(key => key.Add(f => f.HowToFix).RouteKey("howToFix"))
            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectMachineErrorState", "Machine", new {machineId = 0, fromDate = "", toDate = "", status = -1}))
            .Columns(columns =>
                {
                    columns.Bound(f => f.MachineName).Width(70)
                        //.Title("Máy")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Machine").ToString())
                        .ClientTemplate("<strong><#= MachineName #></strong>")
                        .Aggregate(agg => agg.Count())
                        .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:0}', Count) #>");
                    
                    columns.Bound(f => f.ProductCode).Width(90)
                        //.Title("SP")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Product2").ToString())
                        .ReadOnly(true);
                    
                    columns.Bound(f => f.StateName).Width(130)
                        //.Title("Tình trạng")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "State").ToString())
                        .ClientTemplate("<strong><#= StateName #></strong>");
                    
                    columns.Bound(f => f.ErrorCause).Width(125)
                        //.Title("Nguyên nhân")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Error").ToString());
                    
                    columns.Bound(f => f.ErrorQuantity).Width(50)
                        //.Title("SL lỗi")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "ErrorQuantity2").ToString())
                        .Format("{0:n0}");
                    
                    columns.Bound(f => f.EmployeeName).Width(100)
                        //.Title("CN sửa")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "RepairEmployee2").ToString());
                    
                    columns.Bound(f => f.StatusName).Width(75).Title("");
                    
                    columns.Bound(f => f.CauseDate).Width(85)
                        //.Title("Ngày lỗi")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "CauseDate").ToString())
                        .ReadOnly(true)
                        .Format("{0:dd/MM/yyyy HH:mm}");
                    
                    columns.Bound(f => f.CreateUser).Width(85)
                        //.Title("NV KT")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "CheckingEmployee2").ToString())
                        .ReadOnly(true)
                        .HtmlAttributes(new {style = "border-right:1px solid black;"});
                    
                    columns.Bound(f => f.Note).Width(125)
                        //.Title("Ghi chú")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Note").ToString());
                    
                    columns.Bound(f => f.CreateDate).Width(85)
                        //.Title("Ngày tạo")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "CreateDate").ToString())
                        .ReadOnly(true)
                        .Format("{0:dd/MM/yyyy HH:mm}");
                })
                .DetailView(details => details.ClientTemplate(

                    Html.Telerik().Grid<RepairFormDetailModel>()
                        .Name("gridMachineRepair<#= FormId #>")
                        .DataKeys(key => key.Add(f => f.DetailId).RouteKey("detailId"))
                        .DataBinding(dataDindings => dataDindings.Ajax()
                                                                 .Select("SelectMachineErrorStateDetail", "Machine", new { formId = "<#= FormId #>" }))
                        .Columns(columns =>
                            {
                                columns.Bound(f => f.Shift).Width(35)
                                    .Title("Ca")
                                    //.Title(@HttpContext.GetGlobalResourceObject("Resource", "Shift").ToString())
                                    ;
                    
                                columns.Bound(f => f.EmployeeName).Width(100)
                                    .Title("CN sửa")
                                    //.Title(@HttpContext.GetGlobalResourceObject("Resource", "RepairEmployee2").ToString())
                                    ;
                                
                                columns.Bound(f => f.HowToFix)
                                    .Title("Khắc phục")
                                    .Width(125)
                                    //.Title(@HttpContext.GetGlobalResourceObject("Resource", "HowToFix").ToString())
                                    ;
                                
                                columns.Bound(f => f.FixQuantity).Width(50)
                                    .Title("SL chỉnh")
                                    //.Title(@HttpContext.GetGlobalResourceObject("Resource", "AdjustQuantity").ToString())
                                    .Format("{0:n0}");
                                
                                columns.Bound(f => f.StartDateString).Width(85)
                                    .Title("Bắt đầu sửa")
                                    //.Title(@HttpContext.GetGlobalResourceObject("Resource", "BeginRepair").ToString())
                                    .ReadOnly(true)
                                    .HtmlAttributes(new {style = "border-right:1px solid black;"});

                                columns.Bound(f => f.StatusName).Width(65).Title("");
                                
                                columns.Bound(f => f.FinishDateString).Width(85)
                                    .Title("Hoàn thành")
                                    //.Title(@HttpContext.GetGlobalResourceObject("Resource", "Finish").ToString())
                                    .ReadOnly(true)
                                    .HtmlAttributes(new {style = "border-right:1px solid black;"});
                                
                                columns.Bound(f => f.FixTime).Width(50)
                                    .Title("TG sửa")
                                    //.Title(@HttpContext.GetGlobalResourceObject("Resource", "RepairTime").ToString())
                                    .ReadOnly(true)
                                    .HtmlAttributes("<#= FixTimeString  #>")
                                    .Format("{0:n0}")
                                    .HtmlAttributes(new {style = "text-align:right;"})
                                    .Aggregate(agg => agg.Sum())
                                    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                    .FooterHtmlAttributes(new {style = "text-align:right;"});
                                
                                columns.Bound(f => f.Timing).Width(50)
                                    .Title("ĐM TG")
                                    //.Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductionRate2").ToString()
                                    //    + " "
                                    //    + @HttpContext.GetGlobalResourceObject("Resource", "Time2").ToString()
                                    //)
                                    .ReadOnly(true)
                                    .Format("{0:n0}")
                                    .HtmlAttributes(new {style = "text-align:right;"});
                                
                                columns.Bound(f => f.MoreTime).Width(50)
                                    .Title("Bù ĐM")
                                    //.Title(@HttpContext.GetGlobalResourceObject("Resource", "").ToString())
                                    .ReadOnly(true)
                                    .Format("{0:n0}")
                                    .HtmlAttributes(new {style = "text-align:right;"});
                                
                                columns.Bound(f => f.DiffTime).Width(50)
                                    .Title("TG mất")
                                    //.Title(@HttpContext.GetGlobalResourceObject("Resource", "").ToString())
                                    .ReadOnly(true)
                                    .Format("{0:n0}")
                                    .HtmlAttributes(new {style = "text-align:right;"})
                                    .Aggregate(agg => agg.Sum())
                                    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                    .FooterHtmlAttributes(new {style = "text-align:right;"});
                                
                                columns.Bound(f => f.DiffProductQuantity).Width(50)
                                    .Title("SL mất")
                                    //.Title(@HttpContext.GetGlobalResourceObject("Resource", "").ToString())
                                    .ReadOnly(true)
                                    .Format("{0:n0}")
                                    .HtmlAttributes(new {style = "text-align:right;"})
                                    .Aggregate(agg => agg.Sum())
                                    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                    .FooterHtmlAttributes(new {style = "text-align:right;"});
                                
                                columns.Bound(f => f.DiffPoint).Width(50)
                                    .Title("Điếm mất")
                                    //.Title(@HttpContext.GetGlobalResourceObject("Resource", "").ToString())
                                    .ReadOnly(true)
                                    .Format("{0:n3}")
                                    .HtmlAttributes(new {style = "text-align:right;"})
                                    .Aggregate(agg => agg.Sum())
                                    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n3}', Sum) #>")
                                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n3}', Sum) #>")
                                    .FooterHtmlAttributes(new {style = "text-align:right;"});
                            })
            .ClientEvents(e => e.OnError("grid_OnError"))
                        .ToHtmlString()))
            .Selectable()
            .Groupable()
            .Editable(editing => editing.Mode(GridEditMode.InLine))
            .Scrollable(f => f.Height(510))
            .ClientEvents(e => e.OnError("grid_OnError")
                .OnDataBinding("grid_OnDataBinding")
                .OnRowSelect("grid_OnRowSelect")
                .OnDataBound("grid_OnDataBound"))
            .Sortable()
            .Filterable()
            .Reorderable(grid => grid.Columns(true))
            .Resizable(resizing => resizing.Columns(true))
            .Render();
    }
</div>

