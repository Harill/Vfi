@using Telerik.Web.Mvc.UI
@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Phiếu sửa máy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section Scripts{
    
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnLoad.js")"></script>

    <!-- grid Monthly -->
    <script type="text/javascript">

        function grid_OnDataBinding(args) {

            //var getAll = $("input[name='chkGetAll']").attr('checked');
            //var productCodeNameForMonthly = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();
            
            if (startGrid && !onLoading) {
                OnLoadingData();
                var machineId = $("#cboMachine").data('tComboBox').value();
                if (machineId === "")
                    machineId = 0;
                var status = $("#cboStatus").data('tComboBox').value();
                if (status === "")
                    status = 0;
                var fromDate = $("#FromDate").data("tDateTimePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', fromDate);

                var toDate = $("#ToDate").data("tDateTimePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', toDate);


                args.data = $.extend(args.data, {
                    status: status,
                    machineId: machineId,
                    fromDate: fromDate,
                    toDate: toDate
                });
            }
        }


        function grid_OnDataBound() {
            OnLoadedData();
        }
        function machineType_onload() {
            var combobox = $('#MachineType').data('tComboBox');
            var dataSource =
            [
                { Text: "All", Value: "All" },
                { Text: "Cames", Value: "Cames" },
                { Text: "CNC", Value: "CNC" },
                { Text: "Phay CNC", Value: "Phay CNC" }
            ];
            combobox.dataBind(dataSource);
        }
        var startGrid = false;
        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }
    </script>

    <script>

        function printErrorMachineList() {

            if (!onLoading) {
                OnLoadingData();
                var machine = $('#Machine').data('tComboBox').text();
                var isState = $("input[name='chkState']").attr('checked');
                $('#result').load('@Url.Action("PrintErrorMachineList", "Machine")',
                    {
                        machineName: machine,
                        isState: isState,
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
                return false;
            }
        }
        function printJobAssignment() {

            if (!onLoading) {
                OnLoadingData();
                var fromDate = $("#FromDate2").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', fromDate);

                var toDate = $("#ToDate2").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', toDate);
                $('#result').load('@Url.Action("PrintJobAssignment", "Machine")',
                    {
                        fromDate: fromDate,
                        toDate: toDate,
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
                return false;
            }
        }
        function printMachineStateHandover() {

            if (!onLoading) {
                OnLoadingData();
                var shift = $("#Shift").val();
                if (shift === null || shift == "")
                    shift = 1;
                var printDate = $("#PrintDate").data("tDatePicker").value();
                if (printDate === null)
                    printDate = "";
                else
                    printDate = $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', printDate);
                $('#result').load('@Url.Action("PrintMachineStateHandover", "Machine")',
                    {
                        shift: shift,
                        printDate: printDate
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
                return false;
            }
        }
        function print() {

            if (!onLoading) {
                OnLoadingData();
                var fromDate = $("#FromDate").data("tDateTimePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', fromDate);

                var toDate = $("#ToDate").data("tDateTimePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', toDate);

                $('#result').load('@Url.Action("PrintMachineRepair2", "Machine")',
                    {
                        fromDate: fromDate,
                        toDate: toDate
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
                return false;
            }
        }
        function printTechnicalHandover() {

            if (!onLoading) {
                OnLoadingData();
                var machineType = $("#MachineType").data("tComboBox").value();
                if (machineType === null || machineType === "")
                    machineType = 0;
                $('#result').load('@Url.Action("PrintTechnicalHandover", "Machine")',
                    {
                        machineType: machineType,
                        printDate: ""
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
                return false;
            }
        }
    </script>
}

<div class="title">
    @*Quản lý thông tin máy*@
