     <div class="grid_4">
            @{
                Html.Telerik().DatePicker()
                    .Name("PrintDate")
                    .Format("dd/MM/yyyy")
                    .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.Now.Day))
                    .Render();
            }
        </div>
         <div class="grid_7">
              <button id="btnPrintMachineStateHandover" class="t-button" onclick=" return printMachineStateHandover(); ">
                <span class='t-icon t-insert'></span>
                Tình trạng bàn giao ca
                <span class="loadButton"></span>
