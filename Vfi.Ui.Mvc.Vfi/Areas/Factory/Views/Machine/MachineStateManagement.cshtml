@using Telerik.Web.Mvc.UI
@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "QL Tình trạng máy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript" src="@Url.Content("~/Scripts/jscolor.js")"   ></script>
    
    <script type="text/javascript">

        function grid_OnSubmitChanges(e) {
            var colorPick = $("#ColorPick").text();
            e.values = $.extend(e.values,
                {
                    colorPick: colorPick
                }
            );
        }

        function grid_OnEdit(e) {
            var mode = e.mode;
            //var form = e.form;
            if (mode == 'edit') {
                document.getElementById("ColorPick").value = e.dataItem.WarrningColor;
                document.getElementById("ColorPick").style["background-color"] = '#' + e.dataItem.WarrningColor;
            }
        }

        function grid_OnSave(e) {
            e.values.WarrningColor = document.getElementById("ColorPick").value;
        }

        function grid_OnRowDataBound(e) {
            e.row.childNodes[2].style.backgroundColor = "#" + e.dataItem.WarrningColor;
            e.row.childNodes[2].style.borderBottom = "1px #d6e5f3 solid";
        }
    </script>
}
    <style></style>

    <div class="title">
        @*Quản lý thông tin tình trạng máy*@
        @HttpContext.GetGlobalResourceObject("Resource", "MachineStateManagement")
    </div>
            @Html.TextBox("ColorPick",null,new { @class = "ColorTool"})
    @*Click here: <input id='ColorPick' class="ColorTool" value="66ff00"/>*@

    <div class="cover-div">
        @{
            Html.Telerik().Grid<MachineStateModel>()
                .Name("griState")
                .DataKeys(key => key.Add(f => f.StateId).RouteKey("stateId"))
                .ToolBar(
                    toolbar =>
                    toolbar.Insert().ButtonType(GridButtonType.ImageAndText)
                    .Text(@HttpContext.GetGlobalResourceObject("Resource", "NewText").ToString())
                    .ImageHtmlAttributes(new {style = "margin-left:0px;"}))
                .DataBinding(
                    dataBinding => dataBinding.Ajax()
                                              .Select("SelectMachineState", "Machine")
                                              .Insert("InsertMachineState", "Machine")
                                              .Update("UpdateMachineState", "Machine"))
                .Columns(columns =>
                    {
                        columns.Command(command =>
                                        command.Edit().ButtonType(GridButtonType.Image)
                            ).Width(50).Title("").HtmlAttributes(new { style = "text-align:center" });
                        columns.Bound(f => f.StateCode).Width(150).Title("Code");
                  
                        columns.Bound(f => f.Description)
                            //.Title("Mô tả lỗi")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "ErrorDescription").ToString())
                            .ClientTemplate("<strong><#= Description #></strong>");
                   
                        columns.Bound(f => f.NameEN)
                            //.Title("Mô tả lỗi (EN)")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "ErrorDescription").ToString() + " (EN)")
                            .ClientTemplate("<strong><#= NameEN #></strong>");
                      
                        columns.Bound(f => f.EstimateTime)
                            //.Title("Ước lượng<br/>TG")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "EstimateTime3").ToString())
                            .Width(100)
                            .Format("{0:n0}")
                            .HtmlAttributes(new { style = "text-align: right;" });
                      
                        columns.Bound(f => f.IsSetProduct)
                            //.Title("Thiết lập<br/>SP")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "SettingUpProduct3").ToString())
                            .Width(75)
                            .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsSetProduct' <#=IsSetProduct? checked='checked' : '' #> />")
                            .HtmlAttributes(new { style = "text-align:center" });
                     
                        columns.Bound(f => f.Active).Width(75)
                               .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                               .HtmlAttributes(new { style = "text-align:center" });
                        
                        columns.Bound(f => f.ModifiedDate).Width(85)
                            //.Title("Ngày tạo")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "ModifiedDate").ToString())
                            .ReadOnly(true)
                            .Format("{0:dd/MM/yyyy HH:mm:ss}");
                      
                        columns.Bound(f => f.ModifiedUser).Width(85)
                            //.Title("Người tạo")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "ModifiedUser").ToString())
                            .ReadOnly(true);

                    }) 
                .Editable(editing => editing.Mode(GridEditMode.InLine))
                //.Pageable(page => page.PageSize(20))
                .Scrollable(f => f.Height("auto"))
                //.HtmlAttributes(new {style = "width: 950px;"})
                .Sortable()
                .Filterable()
                .Resizable(resizing => resizing.Columns(true))
                .ClientEvents(e => e.OnError("grid_OnError")
                                    .OnSubmitChanges("grid_OnSubmitChanges")
                                    .OnRowSelect("grid_OnRowSelect")
                                    .OnEdit("grid_OnEdit")
                                    .OnSave("grid_OnSave")
                                    .OnRowDataBound("grid_OnRowDataBound"))
                .Render();
        }
    </div>