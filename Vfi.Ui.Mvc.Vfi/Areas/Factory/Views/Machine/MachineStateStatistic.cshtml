@using Telerik.Web.Mvc.UI
@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@{
    ViewBag.Title = "Thống kê tình trạng máy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript">
        function grid_OnDataBinding(args) {
            var fromDate = $("#FromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            var toDate = $("#ToDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else
                toDate = $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', toDate);

            args.data = $.extend(args.data, {
                fromDate: fromDate,
                toDate: toDate
            });
            index = 0;
        }
        var index = 0;
        
        function grid_OnDataBound(data) {

            var grid = $(this).data("tGrid");
            var data = grid.dataSource._data;
            if (data && data.length > 0) {
                for (var i = 0; i < data.length; i++) {
                    var dataItem = data[i];
                    $(".RunTimeStrs")[i].textContent = (7200 - dataItem.aggregates.FixTime.Sum).format(0);
                    $(".NotRunTimePercentedStrs")[i].textContent = (dataItem.aggregates.FixTime.Sum / 7200 * 100).format(1) + '%';
                    $(".RunTimePercentedStrs")[i].textContent = ((1 - dataItem.aggregates.FixTime.Sum / 7200) * 100).format(1) + '%';
                }
            }
            //$("#CountingAvailableStatus")[0].innerHTML =
            //(" <img src='/vfi/Resources/approve_icon.jpg' height='15' width='15'> " +
            //    normal +
            //    " <img src='/vfi/Resources/warning_icon.jpg' height='15' width='15'> " +
            //    warning +
            //    " <img src='/vfi/Resources/notapprove_icon.jpg' height='15' width='15'> " +
            //    notApprove);
            //$("#VfLateCount")[0].innerHTML = (" <img style='background-color:#F4FA58;' height='15' width='15'> " + vfLate);
        }
    </script>
}

<div class="title">Thống kê tình trạng máy</div>
<div class="clear"></div>
<br />

<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">
    
    <fieldset>
        <legend>Tiêu chí trích lọc</legend>
        
     <div class="grid_4">
            @{
                Html.Telerik().DatePicker()
                    .Name("FromDate")
                    .Format("dd/MM/yyyy")
                    .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.Now.Day))
                    .Render();
            }
        </div>
     <div class="grid_4">
            @{
                Html.Telerik().DatePicker()
                    .Name("ToDate")
                    .Format("dd/MM/yyyy")
                    .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.Now.Day))
                    .Render();
            }
        </div>
        <div class="grid_3">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridMachine'); ">
                <span class='t-icon t-insert'></span>
                Làm mới
            </button>
        </div>
    </fieldset>
</div>
<div class="clear"></div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<MachineStateStatisticModel>()
            .Name("gridMachine")
            .DataKeys(key => key.Add(f => f.MachineId).RouteKey("machineId"))
            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectMachineStateStatistic", "Machine", new { shift = 0, printDate = "" }))         //MachineStateStatisticModel
            .Columns(columns =>
                {

                    columns.Bound(f => f.MachineId).Width(40).Title("STT").ReadOnly(true)
                        .ClientTemplate("<#= ++index #>");
                    columns.Bound(f => f.MachineName).Width(70).Title("Máy")
                           .ClientTemplate("<strong><#= MachineName #></strong>")
                           .Aggregate(agg => agg.Count())
                           .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                           .ClientFooterTemplate("<#= $.telerik.formatString('{0:0}', Count) #>");
                    columns.Bound(f => f.ProductCode).Width(70).Title("SP");

                    columns.Bound(f => f.StateCode).Width(150).Title("Tình trạng");
                    columns.Bound(f => f.ErrorCause).Width(150).Title("Nguyên nhân lỗi");
                    columns.Bound(f => f.HowToFix).Width(150).Title("Cách sửa");
                    columns.Bound(f => f.StatusName).Width(100).Title("Trạng thái");
                    columns.Bound(f => f.CauseDate).Width(85).Title("Ngày lỗi").ReadOnly(true)
                           .Format("{0:dd/MM/yyyy HH:mm}");
                    columns.Bound(f => f.EstimateTime).Width(70).Title("KH sửa<br>(p)").ReadOnly(true)
                           .Format("{0:n0}")
                           .HtmlAttributes(new { style = "text-align:right;" })
                           .Aggregate(agg => agg.Sum())
                           .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                           .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                           .FooterHtmlAttributes(new { style = "text-align:right;" });
                    columns.Bound(f => f.FixTime).Width(70).Title("TT sửa<br>(p)").ReadOnly(true)
                           //.ClientTemplate("<#= FixTimeString  #>")
                           .Format("{0:n0}")
                           .HtmlAttributes(new { style = "text-align:right;" })
                           .Aggregate(agg => agg.Sum())
                           .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                           .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                           .FooterHtmlAttributes(new { style = "text-align:right;" });
                    //columns.Bound(f => f.FixTimeHhMm).Width(70).Title("TT sửa").ReadOnly(true)
                    //       .ClientTemplate("<#= FixTimeString  #>")
                    //       .HtmlAttributes(new { style = "text-align:right;" });
                    columns.Bound(f => f.DiffEstimateTime).Width(70).Title("Lệch<br>(p)").ReadOnly(true)
                           .Format("{0:n0}")
                           .HtmlAttributes(new { style = "text-align:right;" })
                           .Aggregate(agg => agg.Sum())
                           .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                           .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                           .FooterHtmlAttributes(new { style = "text-align:right;" });

                    columns.Bound(f => f.StartDate).Width(85).Title("BĐ sửa").ReadOnly(true)
                           .Format("{0:dd/MM/yyyy HH:mm}");
                    columns.Bound(f => f.FinishDate).Width(85).Title("KT sửa").ReadOnly(true)
                        .ClientTemplate("<#= FinishDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy HH:mm}', FinishDate) #>");

                    columns.Bound(f => f.EmployeeRepairName).Width(150).Title("NV sửa máy");
                    columns.Bound(f => f.EmployeeQcName).Width(150).Title("NV QC");
                    columns.Bound(f => f.Note).Title("Ghi chú");
                    columns.Bound(f => f.RunTimeStr).Width(75).Title("Thời gian<br/>máy chạy")
                        .ClientGroupFooterTemplate("<span class='RunTimeStrs'>0</span>")
                        .FooterHtmlAttributes(new { style = "text-align: center;" });
                    columns.Bound(f => f.RunTimePercentedStr).Width(75).Title("Máy chạy<br/>(%)")
                        .ClientGroupFooterTemplate("<span class='RunTimePercentedStrs'>0</span>")
                        .FooterHtmlAttributes(new { style = "text-align: center;" });
                    columns.Bound(f => f.NotRunTimePercentedStr).Width(75).Title("Máy ngưng<br/>(%)")
                        .ClientGroupFooterTemplate("<span class='NotRunTimePercentedStrs'>0</span>")
                        .FooterHtmlAttributes(new { style = "text-align: center;" });
                })
            .Scrollable(f => f.Height(510))
            .ClientEvents(e => e.OnError("grid_OnError")
                .OnDataBinding("grid_OnDataBinding")
                .OnDataBound("grid_OnDataBound")
                .OnRowSelect("grid_OnRowSelect"))
            .Filterable()
            .Groupable(group => group.Groups(g => g.Add(model => model.MachineName)).Visible(false))
            .Sortable()
            .Reorderable(grid => grid.Columns(true))
            .Resizable(resizing => resizing.Columns(true))
            .Render();
    }
</div>

    <!-- windown -->
    @{
        Html.Telerik().Window()
            .Name("windowReport")
            .Modal(true)
            .Draggable(true)
            .Content
            (
                @<text>
                     <div id="result"></div>
                 </text>
            )
            //.ClientEvents(e => e.OnLoad("Window_onLoad"));
            .Visible(false)
            .Width(960)
            .Render();
    }

    <style type="text/css">
        #windowReport {
            /*
            float: right;
            Position: relative;
            */
            min-height: 580px;
            top: 15%;
        }

        #result {
            height: 520px;
            overflow: hidden;
        }

        #ReportBody {
            padding-bottom: 25px;
            margin-bottom: 25px;
        }

        .tb-witdh td {
            width: 55px;
        }
    </style>
