@section Scripts{
    <script type="text/javascript">
        function gridTrackUpMachine_OnDataBinding(e) {
            var MachineId = $("#MachineCbo").data('tComboBox').value();
            if (MachineId === "")
                MachineId = 0;

            var fromDate = $("#fromDate").data("tDatePicker").value();
            var toDate = $("#toDate").data("tDatePicker").value();

            e.data = $.extend(e.data, {
                machineId: MachineId,
                fromDate: formatDate(fromDate),
                toDate: formatDate(toDate)
            });
        }


        function formatDate(d) {
            if (!d) return "";
            var day = ("0" + d.getDate()).slice(-2);
            var month = ("0" + (d.getMonth() + 1)).slice(-2);
            var year = d.getFullYear();
            return day + "/" + month + "/" + year;
        }
        //function gridInventory_OnDataBinding(e) {
        //    var ProductId = $("#ProductCode").data("tAutoComplete").value();
        //    var MachineId = $("#MachineCbo").data('tComboBox').value();
        //    if (MachineId === "")
        //        MachineId = 0;
        //    e.data = $.extend(e.data, {
        //        machineId: MachineId,
        //        productId: ProductId
        //    });
        //}

        function gridDetail_OnDataBinding(e) {
            var masterRow = $(e.target).closest(".t-detail-row").prev();
            var grid = $("#gridTrackUpMachine").data("tGrid");
            var dataItem = grid.dataItem(masterRow);

            var fromDate = $("#fromDate").data("tDatePicker").value();
            var toDate = $("#toDate").data("tDatePicker").value();

            e.data = $.extend(e.data, {
                machineId: dataItem.MachineId,
                fromDate: formatDate(fromDate),
                toDate: formatDate(toDate)
            });
        }

        // to mau
        function grid_OnRowDataBound(e) {
            var dataItem = e.dataItem;
            var cell = e.row.cells[1]; // cột [2]

            if (!dataItem || !cell) return;

            if (dataItem.MachineState === "Bình thường") {
                cell.style.backgroundColor = "#1bc44e";
            }
            else if (dataItem.MachineState === "Lên máy") {
                cell.style.backgroundColor = "#03dffc";
            }
            else if (dataItem.MachineState === "Hư nặng") {
                cell.style.backgroundColor = "#546466";
            }
            else if (dataItem.MachineState === "Đủ hàng") {
                cell.style.backgroundColor = "#f1f522";
            }
            else if (dataItem.MachineState === "Thiếu NL/NS") {
                cell.style.backgroundColor = "#f2d3e7";
            }
            else if (dataItem.MachineState === "Máy trống") {
                cell.style.backgroundColor = "#f2edee";
            }
            else if (dataItem.MachineState === "Đang khắc phục") {
                cell.style.backgroundColor = "#f29327";
            }
            else {
                cell.style.backgroundColor = "#d9504c";
            }
        }




        function RefreshGrid(gridName) {
            var grid = $("#" + gridName).data("tGrid");
            if (grid) grid.ajaxRequest();
        }

        function RefreshGrids2(name) {
            RefreshGrid(name);
        }


        function grid_OnError(e) { }

        // dem ma SP khong trung`
        function getDistinctCount(data, field) {
            var values = {};
            for (var i = 0; i < data.length; i++) {
                values[data[i][field]] = true;
            }
            return Object.keys(values).length;
        }



    </script>
}

<div class="title">Báo cáo sản xuất tổng hợp</div>
<div class="clear"></div>
<br/>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: auto;">
    <fieldset>
        <legend>Tiêu chí trích lọc</legend>

        <div class="grid_1">
            Máy
        </div>
        <div class="grid_4">
             @{
                 Html.Telerik().ComboBox()
                     .Name("MachineCbo")
                     .DataBinding(binding => binding.Ajax().Select("SelectComboBoxMachineAllProduction", "Machine", new { area = "Factory" }))
                     .HtmlAttributes(new { style = "width: 140px" })
                     .DropDownHtmlAttributes(new { style = "width: 138px" })
                     .AutoFill(true)
                     .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                     .Render();
            }
        </div>

         <div class="grid_2">
                @{
                    Html.Telerik().DatePicker()
                        .Name("fromDate")
                        .Format("dd/MM/yyyy")
                        .Value(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1))
                        .Render();
                }
            <div class="clear"></div>
                @{
                    Html.Telerik().DatePicker()
                        .Name("toDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today.AddDays(-1))
                        .Render();
                }
         </div>
        
        <div class="grid_2 prefix_1">        
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrids2('gridTrackUpMachine'); ">
                <span class='t-icon t-insert'></span>
                Tìm
            </button>
        </div>


        <div class ="TongSP grid_9 prefix_1">
            Tổng GT SP = (Tổng GT (OK + CPL)) / Tổng chi phí
            <div class ="notclear clear"></div>
                <div class ="SP13 grid_2 "> >= 1.3</div>
                <div class ="SP113 grid_2 "> < 1.3</div>
                <div class ="SP1 grid_2"> <= 1 </div>
                <div class ="SP09 grid_2"> <= 0.9 </div>
        </div>

        <div class ="TLNG grid_4">
            TL NG (%)
            <div class ="clear"></div>
            <div class ="NG01"> >= 0% </div>
            <div class ="NG30"> >= 3% </div>
            <div class ="NG50"> >= 5% </div>
        </div>
                

        <div class ="HSSDMay grid_4">
             HSSD máy  (%)
            <div class ="clear"></div>
            <div class ="HS100"> > 70% </div>
            <div class ="HS70"> <= 70% </div>
            <div class ="HS50"> <= 50% </div>
        </div>


        <div class ="TLHH grid_4">
             TL hao hụt (%)
            <div class ="clear"></div> 
            <div class ="HH03"> -3%<=  X <=3% </div>
            <div class ="HH35"> -5%<=  X <=5%   </div>
            <div class ="HH50"> X< -5% và X >5%  </div>
        </div>
       
        
         <div class ="TGSX grid_13">
             Chênh lệch TGSX (h)  = (TGSX TT - TGSX) / TGSX TT
            <div class ="notclear clear"></div> 
            <div class ="grid_3">    </div>
            <div class ="TG00 grid_4"> -10% < X < 10%  </div>
            <div class ="TG10 grid_4"> -20% <= X <= 20% </div>
            <div class ="TG20 grid_4"> X < -20% và X > 20%  </div>
        </div>



    </fieldset>
</div>
