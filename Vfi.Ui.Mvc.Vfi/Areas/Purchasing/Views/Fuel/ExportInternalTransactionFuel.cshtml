@using Vfi.Server.Core.DataModel.Models.Inv
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@model MaterialInventoryModel
@{
    ViewBag.Title = "Xuất kho nhiên liệu (NB)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
<!-- binding -->
<script type="text/javascript">
    function gridFuelInventory_onDataBinding(args) {
        var vendorId = $("#FuelVendor").data('tComboBox').value();
        if (vendorId === "")
            vendorId = 0;
        var fuelCode = $("#FuelCode").data("tAutoComplete").value();
        args.data = $.extend(args.data, {
            vendorId: vendorId,
            fuelCode: fuelCode
        });
    }
</script>

<!-- pickup material -->
<script type="text/javascript">
    function PickupId() {
        var $checkedRecords = $(':checked');
        if ($checkedRecords.length < 1) {
            alert("Vui lọn chọn ít nhất 1 nguyên liệu");
            return;
        }
        var a = {};
        var ids = "";
        for (var i = 0; i < $checkedRecords.length; i++) {
            a[i] = $checkedRecords[i].value;

            ids += $checkedRecords[i].value;
            if (i < ($checkedRecords.length - 1))
                ids += ":";
        }
        
        $("#gridFuelInventoryDetail").data("tGrid").rebind({
            invIds: ids,
        });
    }
</script>

<!-- client event grid material inventory -->
<script type="text/javascript">

    function gridFuelInventoryDetail_onSubmitChanges(e) {
        var monthlyDate = $("#ExportDate").data("tDatePicker").value();
        if (monthlyDate === null)
            monthlyDate = "";
        else
            monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);
        
        e.values = $.extend(e.values,
            {
                exportOrImport: "@Convert.ToChar(MyUtilities.Transaction.EoIEnum.Export)",
                exportDate: monthlyDate
            }
        );
    }
    function FuelVendor_OnChange() {
        RefreshGrid("gridFuelInventory");
    }
</script>
}

<div class="title">
    @*Xuất hủy nhiên liệu*@
    @HttpContext.GetGlobalResourceObject("Resource", "ExportInternalTransactionFuel")
</div>

<div class="t-info-sha" style="padding-left: 15px;padding-right: 15px; width:920px;">
    <fieldset>
        <legend>
            @*Thông tin xuất*@
            @HttpContext.GetGlobalResourceObject("Resource", "ExportFormInformation")
        </legend>
           
             <div class="grid_3">
                 @*Nhà cung ứng:*@
                 @HttpContext.GetGlobalResourceObject("Resource", "Vendor")
             </div>
        <div class="grid_7">
            @{
                Html.Telerik().ComboBox()
                    .Name("FuelVendor")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxFuelVendor", "Vendor", new { area = "Purchasing"}))
                    .HtmlAttributes(new { style = "width: 250px" })
                    .DropDownHtmlAttributes(new { style = "width: 325px" })
                    .AutoFill(true)
                    .Filterable(f=>f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .ClientEvents(e => e.OnChange("FuelVendor_OnChange"))
                    .Render();
            }
        </div>
        <div class="grid_2">
            @*Nhiên liệu:*@
            @HttpContext.GetGlobalResourceObject("Resource", "Fuel")
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().AutoComplete()
                    .Name("FuelCode")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxAllFuel", "Material", new {area = ""}).Delay(350))
                    .HtmlAttributes(new {style = "width: 150px"})
                    .DropDownHtmlAttributes(new {style = "width: 250px"})
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .HighlightFirstMatch(true)
                    .AutoFill(true)
                    .Render();
            }
        </div>
        <div class="grid_2">
            @{
                Html.Telerik().DatePicker()
                    .Name("ExportDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today)
                    .Render();
            }
        </div>
        
            <div class="grid_3 prefix_1">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridFuelInventory'); ">
                    <span class='t-icon t-insert'></span>
                    @*Làm mới*@
                    @HttpContext.GetGlobalResourceObject("Resource", "Refresh")
                </button>
            </div>
    </fieldset>
</div>
<div class="clear"></div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<TransactionFptDetailModel>()
            .Name("gridFuelInventory")
            .ToolBar(bar => bar.Template(
                @<text>
                     <div class="grid_7">
                         <button class="t-button" id="btnPickupId" name="btnPickupId" onclick=" PickupId() ">
                             <span class='t-icon t-insert'></span>
                             @*Chọn các nguyên liệu vào lưới*@
                             @HttpContext.GetGlobalResourceObject("Resource", "SelectFuelIntoNet")
                         </button>
                     </div>
                     <div class="clear"></div>
                 </text>
))
            .DataKeys(keys => keys.Add(f => f.FuelInvId).RouteKey("fuelInvId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("SelectExportFuelInv", "Fuel", new { fuelCode = "", vendorId = 0}))
            .Columns(columns =>
                {
                    columns.Bound(f => f.FuelInvId)
                        //.Title("Chọn")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Select").ToString())
                        .Width(75)
                        .ClientTemplate("<input type='checkbox' name='chklIds' value='<#= FuelInvId #>' />")
                        .HtmlAttributes(new { style = "text-align:center" });
                   
                    columns.Bound(f => f.FuelFullCodeName)
                        //.Title("Mã nhiên liệu")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "FuelCode").ToString());
                    
                    columns.Bound(f => f.VendorCodeName)
                        //.Title("NCC")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Vendor2").ToString());
                    
                    columns.Bound(f => f.LotNumber)
                        //.Title("Lô")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Lot").ToString());
                    
                    columns.Bound(f => f.TransactionDate).Width(90)
                        //.Title("Ngày nhập")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "ImportDate").ToString())
                        .Format("{0:dd/MM/yyyy}");
                    
                    columns.Bound(f => f.TotalInv)
                        //.Title("Tổng tồn")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "TotalInv").ToString())
                        .HtmlAttributes(new { style = "text-align:right;" })
                        .Format("{0:n1}");
                   
                    columns.Bound(f => f.UnitMeasure)
                        //.Title("ĐVT")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Unit2").ToString());
                })
            .Scrollable(f => f.Height(200))
            .ClientEvents(events => events.OnError("grid_OnError").OnDataBinding("gridFuelInventory_onDataBinding"))
            //.Filterable()
            //.Pageable(f => f.PageOnScroll(true).Style(GridPagerStyles.Status))
            .Render();
    }
</div>
<div class="clear"></div><br/>
<div class="t-info-sha" style="padding-left: 15px; width:250px; color: Maroon;">
    @*Chi tiết lệnh nhập nguyên liệu*@
    @HttpContext.GetGlobalResourceObject("Resource", "FuelInpurOrderDetail")
</div>
<div class="cover-div">
@{
    Html.Telerik().Grid<TransactionFptDetailModel>()
        .Name("gridFuelInventoryDetail")
        .ToolBar(bar => bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
            .SaveText(@HttpContext.GetGlobalResourceObject("Resource", "SaveAll").ToString())
            .CancelText(@HttpContext.GetGlobalResourceObject("Resource", "Cancel").ToString()))
            
        .DataKeys(keys => keys.Add(f => f.FuelInvId).RouteKey("fuelInvId"))
        .DataBinding(dataBindings => dataBindings.Ajax()
            .Select("SelectExportInputFuelInventory", "Fuel", new { invIds = "" })
            .Update("ExportTransactionFuelInventory", "Fuel", new { isInternal = true }))
        .Columns(columns => {
            columns.Bound(f => f.VendorCodeName).Width(250)
                //.Title("NCC")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Vendor2").ToString())
                .ReadOnly(true);
          
            columns.Bound(f => f.FuelFullCodeName).Width(250)
                //.Title("Mã nhiên liệu")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "FuelCode").ToString())
                .ReadOnly(true);
          
            columns.Bound(f => f.UnitMeasure).Width(70)
                //.Title("ĐVT")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Unit2").ToString())
                .ReadOnly(true);
            
            columns.Bound(f => f.TotalInv).Width(70).ReadOnly(true)
                //.HeaderTemplate("Tồn kho")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Inventory").ToString())
                .Format("{0:n1}")
                .HtmlAttributes(new { style = "text-align:right" });
           
            columns.Bound(f => f.LotNumber).Width(50).ReadOnly(true)
                //.Title("Lô")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Lot").ToString());
          
            columns.Bound(f => f.TransactionDate).Width(90).ReadOnly(true)
                //.Title("Ngày nhập")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "ImportDate").ToString())
                .Format("{0:dd/MM/yyyy}");
         
            columns.Bound(f => f.Quantity).Width(70)
                //.HeaderTemplate("Số lượng")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Quantity").ToString())
                .HtmlAttributes(new { style = "text-align:right" })
                .ClientTemplate("<span name='Quantity'><#= Quantity == null ? 0 : $.telerik.formatString('{0:n1}', Quantity) #></span>")
                .FooterTemplate("<span id='TotalQuantity'></span>");
         
            columns.Bound(f => f.IsDestroy).Width(50)
                //.Title("Hết tồn")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "StockOut").ToString())
                .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsDestroy' <#=IsDestroy? checked='checked' : '' #> />")
                .HtmlAttributes(new { style = "text-align:center" });
         
            columns.Bound(f => f.Note)
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Note").ToString());
          
            columns.Command(commands => commands.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(40).Title("");
        })
        .ClientEvents(events => events
            .OnSubmitChanges("gridFuelInventoryDetail_onSubmitChanges")
            .OnError("grid_OnError"))
        .Editable(f => f.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
        // .Footer(true)
        .Render();   
}
</div>