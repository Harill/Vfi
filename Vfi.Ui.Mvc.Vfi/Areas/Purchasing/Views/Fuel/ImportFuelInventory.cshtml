@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@{
    ViewBag.Title = "Nhập Kho Nhiên Liệu & Bao Bì & Hóa Chất";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
   
    <script type="text/javascript">

        var orderQty = {};
        var unitPrice = {};
        var productIds = {};
        productIds[0] = 0;

        function grid_onSave(e) {
            // bind data
            var $fuelFullCodeName = $(e.cell).find('#FuelFullCodeName');

            if ($fuelFullCodeName.length > 0) {
                var fuelFullCodeName = $fuelFullCodeName.data("tComboBox"),
                    fuelFullCodeNameSelectItem = fuelFullCodeName.selectedIndex > -1 ? fuelFullCodeName.data[fuelFullCodeName.selectedIndex] : null;

                if (fuelFullCodeNameSelectItem) {
                    e.values["FuelFullCodeName"] = fuelFullCodeNameSelectItem.Text;
                    e.values["FuelId"] = fuelFullCodeNameSelectItem.Value;

                    var flag = true;
                    for (var obj in productIds) {
                        if (obj == fuelFullCodeNameSelectItem.Value) {
                            flag = false;
                            break;
                        }
                    }
                    if (flag == true) {
                        productIds[fuelFullCodeNameSelectItem.Value] = fuelFullCodeNameSelectItem.Value;
                    } else {
                        //e.preventDefault();
                        alert("đã tồn tại sản phẩm trong danh sách");
                    }
                }
            }
           
            var sum = 0;
            var cell = $(e.cell).find('#Quantity').val();
            if (!isNaN(parseInt(cell))) {
               var span = $("span[name='Quantity']");
                for (var i = 0; i < span.length; i++) {
                   var innerText = span[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sum = sum + parseInt(innerText);
                }
                sum = sum + parseInt(cell);
                $("#TotalQuantity").text(sum);
                $("#CountFuel").text(i + 1);
            }
        }

        function grid_onSubmitChanges(e) {
            var fuelVendor = $("#FuelVendor").data("tComboBox").value();
            if (fuelVendor === "") {
                fuelVendor = 0;
            }
            var importDate = $("#ImportDate").data("tDatePicker").value();
            if (importDate === null)
                importDate = "";
            else
                importDate = $.telerik.formatString('{0:dd/MM/yyyy}', importDate);

            e.values = $.extend(e.values,
                {
                    fuelVendor: fuelVendor,
                    importDate: importDate,
                    poId: 0,
                    exchangeRate: 1,
                }
            );

            productIds = {};
        }

        function grid_OnError(args) {
            if (args.textStatus == "modelstateerror" && args.modelState) {
                var message = "Errors:\n";
                $.each(args.modelState, function(key, value) {
                    if ('errors' in value) {
                        $.each(value.errors, function() {
                            message += this + "\n";
                        });
                    }
                });
                args.preventDefault();
                alert(message);
            }
        }

    </script>
}

    <div class="title">
        @*Nhập kho nhiên liệu & bao bì & hóa chất*@
        @HttpContext.GetGlobalResourceObject("Resource", "ImportFuelInventory")
    </div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">

    <fieldset>
        <legend>
            @*Thông tin phiếu nhập*@
            @HttpContext.GetGlobalResourceObject("Resource", "ImportFormInformation")
        </legend> 
        <div class="grid_3">
            @*Nhà cung ứng:*@
            @HttpContext.GetGlobalResourceObject("Resource", "Vendor")
        </div>
        <div class="grid_7">
            @{
                Html.Telerik().ComboBox()
                    .Name("FuelVendor")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxFuelVendor", "Vendor", new { area = "Purchasing"}))
                    .HtmlAttributes(new { style = "width: 250px" })
                    .DropDownHtmlAttributes(new { style = "width: 325px" })
                    .AutoFill(true)
                    .Filterable(f=>f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .Render();
            }
        </div>
        <div class="grid_3">
            @*Ngày nhập kho*@
            @HttpContext.GetGlobalResourceObject("Resource", "ImportDate")
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().DatePicker()
                    .Name("ImportDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today)
                    .Render();
            }
        </div>
    </fieldset>
</div>
    <div class="clear"></div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<TransactionFptDetailModel>()
            .Name("gridImportFuel")
            .DataKeys(keys => keys.Add(f => f.FptId).RouteKey("fptId"))
            .ToolBar(bar =>
                {
                    bar.Insert().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
                        .Text(@HttpContext.GetGlobalResourceObject("Resource", "NewText").ToString());
                    bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
                        .SaveText(@HttpContext.GetGlobalResourceObject("Resource", "SaveAll").ToString())
                        .CancelText(@HttpContext.GetGlobalResourceObject("Resource", "CancelText").ToString());

                })
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("SelectImportFuel", "Fuel")
                                                     .Update("UpdateImportFuel", "Fuel", new { isInternal = false })
            )
            .Columns(columns =>
                {
                    columns.Bound(f => f.FuelFullCodeName).Width(250)
                        //.Title("Mã")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Code").ToString())
                        .FooterTemplate("<span id='CountFuel'></span>");
                   
                    //columns.Bound(f => f.LotNumber).Width(70).Title("Lô");
                   
                    columns.Bound(f => f.Quantity).Width(100)
                        //.Title("Số lượng")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Quantity").ToString())
                        .ClientTemplate("<span name='Quantity'><#= Quantity == null ? 0 : $.telerik.formatString('{0:n}', Quantity) #></span>")
                        .FooterTemplate("<span id='TotalQuantity'></span>");

                    columns.Bound(f => f.UnitPrice).Width(100)
                        //.Title("Đơn giá (VNĐ)")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "UnitPrice").ToString()
                            + " (VND)"
                        )
                        .ClientTemplate("<span name='UnitPrice'><#= UnitPrice == null ? 0 : $.telerik.formatString('{0:n0}', UnitPrice) #></span>");

                    columns.Bound(f => f.UnitMeasure).Width(120)
                        //.Title("ĐVT")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Unit2").ToString());

                    columns.Bound(f => f.LotNumber).Width(50)
                        //.Title("Lô")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Lot").ToString())
                        .HtmlAttributes(new { style = "text-align:right" });
                   
                    columns.Bound(f => f.Note)
                        //.Title("Ghi chú")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Note").ToString());
                    
                    columns.Command(commands => commands.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(50)
                        //.Title("Xóa")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Delete1").ToString());
                })
            .ClientEvents(events => events
                                        .OnSave("grid_onSave")
                                        .OnSubmitChanges("grid_onSubmitChanges")
                                        .OnError("grid_OnError")
            )
            .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
            .KeyboardNavigation()
            //.Footer(false)
            .Render();
    }
</div>
    <div class="clear"></div><br/>