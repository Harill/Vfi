        var orderQty = {};
        var unitPrice = {};
        var materialIds = {};
        materialIds[0] = 0;

        function gridPurchaseOrderDetailPartial_onSave(e) {
            // bind data
            var $toolCodeName = $(e.cell).find('#ToolCodeName');

            if ($toolCodeName.length > 0) {
                var toolCodeName = $toolCodeName.data("tComboBox"),
                    toolCodeNameSelectItem = toolCodeName.selectedIndex > -1 ? toolCodeName.data[toolCodeName.selectedIndex] : null;

                if (toolCodeNameSelectItem) {
                    e.values["ToolCodeName"] = toolCodeNameSelectItem.Text;
                    e.values["ToolId"] = toolCodeNameSelectItem.Value;

                    var flag = true;
                    for (var obj in materialIds) {
                        if (obj == toolCodeNameSelectItem.Value) {
                            flag = false;
                            break;
                        }
                    }
                    if (flag == true) {
                        materialIds[toolCodeNameSelectItem.Value] = toolCodeNameSelectItem.Value;
                    } else {
                        //e.preventDefault();
                        alert("đã tồn tại công cụ trong danh sách");
                    }
                }
            }

            // // 
            var $lineTotal = $(e.cell).find('#LineTotal');
            if ($lineTotal.length > 0) {
                var lineTotal = $lineTotal.data("tTextBox");


                e.values["LineTotal"] = lineTotal.value();

                //lineTotal.value(e.values["LineTotal"]);
            }

            // bind data
        }

        function gridPurchaseOrderDetailPartial_onSubmitChanges(e) {

            var flag = InputValidation();

            if (flag == false)
                e.preventDefault();
            else {

               // var shipDate = $("#ShipDate").data("tDatePicker").value();

                var vendorCodeName = $('#VendorCodeName').data('tDropDownList').value();
                var shipMethodName = $('#ShipMethodName').data('tDropDownList').value();
                var deliveryMethodName = $('#DeliveryMethodName').data('tDropDownList').value();
                var packagedMethodName = $('#PackagedMethodName').data('tDropDownList').value();
                var paymentMethodName = $('#PaymentMethodName').data('tDropDownList').value();
                var currencyCode = $('#CurrencyCode').data('tDropDownList').value();
                var employeeName = $('#EmployeeName').val();
                var tolerance = $('#Tolerance').val();
                var note = $('#Note').val();

                e.values = $.extend(e.values,
                    {
                        shipDate: "",
                        vendorId: vendorCodeName,
                        shipMethodId: shipMethodName,
                        deliveryMethodId: deliveryMethodName,
                        packagedMethodId: packagedMethodName,
                        paymentMethodId: paymentMethodName,
                        employeeName: employeeName,
                        tolerance: tolerance,
                        currencyCode:currencyCode,
                        note: note
                    }
                );
            }
        }
        function gridPurchaseOrderDetailPartial_OnLoad() {
            $('#Tolerance').val(10);
        }
    </script>

    <script type="text/javascript">
        function InputValidation() {
            var strMsgAlert = "";

            //var shipDate = $("#ShipDate").data("tDatePicker").value();

            var vendorCodeName = $('#VendorCodeName').data('tDropDownList').value();
            var shipMethodName = $('#ShipMethodName').data('tDropDownList').value();
            var deliveryMethodName = $('#DeliveryMethodName').data('tDropDownList').value();
            var packagedMethodName = $('#PackagedMethodName').data('tDropDownList').value();
            var paymentMethodName = $('#PaymentMethodName').data('tDropDownList').value();
            var currencyCode = $('#CurrencyCode').data('tDropDownList').value();
            var employeeName = $('#EmployeeName').val();
            var tolerance = $('#Tolerance').val();

            //if (shipDate == null || shipDate === "") {
            //    strMsgAlert += "Vui lòng chọn ngày giao hàng.\t\r\n";
            //}
            if (vendorCodeName === "") {
                strMsgAlert += "Vui lòng chọn nhà cung cấp.\t\r\n";
            }
            if (shipMethodName === "") {
                strMsgAlert += "Vui lòng chọn phương thức vận chuyển.\t\r\n";
            }
            if (deliveryMethodName === "") {
                strMsgAlert += "Vui lòng chọn phương thức giao hàng.\t\r\n";
            }
            if (packagedMethodName === "") {
                strMsgAlert += "Vui lòng chọn phương thức đóng gói.\t\r\n";
            }
            if (currencyCode === "") {
                strMsgAlert += "Vui lòng chọn đơn vị tính.\t\r\n";
            }
            if (paymentMethodName === "") {
                strMsgAlert += "Vui lòng chọn phương thức thanh toán.\t\r\n";
            }
            if (employeeName === "") {
                strMsgAlert += "Vui lòng điền tên nhân viên.\t\r\n";
            }
            if (tolerance === "") {
                strMsgAlert += "Vui lòng nhập dung sai.\t\r\n";
            }

            if (strMsgAlert === "")
                return true;

            alert(strMsgAlert);
            return false;
        }
    </script>

}


