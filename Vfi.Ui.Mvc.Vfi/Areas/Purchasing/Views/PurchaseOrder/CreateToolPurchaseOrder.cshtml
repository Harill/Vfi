<div class="clear"></div>


<div class="cover-div">
    @{
        Html.Telerik().Grid<PurchaseOrderDetailModel>()
            .Name("gridPurchaseOrderDetailPartial")
            .DataKeys(keys => keys.Add(f => f.PurchaseOrderDetailId).RouteKey("purchaseOrderDetailId"))
            .ToolBar(bar =>
                         {
                             bar.Insert().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).Text("Thêm mới");
                             bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).Text("Lưu lại");
                         })
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectPurchaseOrderDetail", "PurchaseOrder")
                .Update("UpdateToolPurchaseOrderDetail", "PurchaseOrder")
            )
            .Columns(columns =>
            {
                //columns.Bound(f => f.MaterialClassifiedName).Width(175);
                //columns.Bound(f => f.MaterialTypeName).Width(175);
                columns.Bound(f => f.ToolCodeName).Width(275);
                columns.Bound(f => f.OrderQty).Width(115)
                    .ClientTemplate("<#= OrderQty == null ? 0 : $.telerik.formatString('{0:n}', OrderQty) #>");

                columns.Bound(f => f.UnitPrice).Width(115)
                    .ClientTemplate("<#= UnitPrice == null ? 0 : $.telerik.formatString('{0:n}', UnitPrice) #>");
                columns.Bound(f => f.LineTotal).Width(115)
                    .ClientTemplate("<#= LineTotal == null ? 0 : $.telerik.formatString('{0:n}', LineTotal) #>");

                columns.Bound(f => f.Unit).Width(115);
                columns.Bound(f => f.DueDate).Width(98)
                       .ClientTemplate("<#= DueDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', DueDate) #>");
                //columns.Bound(f => f.Active).Width(45)
                //    .ClientTemplate("<input type='checkbox' name='Active' <#=Active? checked='checked' : '' #> />")
                //    .HtmlAttributes(new { style = "text-align:center" });
                //columns.Command(command =>
                //    command.Edit().ButtonType(GridButtonType.ImageAndText)
                //).Width(98).Title("Commands").HtmlAttributes(new { style = "text-align:center" });
                columns.Command(commands => commands.Delete()).Width(98).Title("Commands");
            })
            .ClientEvents(events => events
                .OnLoad("gridPurchaseOrderDetailPartial_OnLoad")
                .OnEdit("gridPurchaseOrderDetailPartial_onEdit")
                .OnSave("gridPurchaseOrderDetailPartial_onSave")
                .OnSubmitChanges("gridPurchaseOrderDetailPartial_onSubmitChanges")
                .OnError("grid_OnError")
            )
            .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
            .KeyboardNavigation()
            .Footer(false)
            .Render();
    }
</div>
