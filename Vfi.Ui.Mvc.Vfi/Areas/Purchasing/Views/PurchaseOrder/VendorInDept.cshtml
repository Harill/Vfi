@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@{
    ViewBag.Title = "Công nợ NCC";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">

        function grid_OnDataBinding(args) {

            var vendorId = $('#VendorCodeName').data('tDropDownList').value();
            if (vendorId == "")
                vendorId = 0;
            var fromDate = $("#fromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#toDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
            }
            args.data = $.extend(args.data, {
                vendorId:vendorId,
                fromDate: fromDate,
                toDate: toDate,
            });

        }        

        function materialClassified_OnChange() {
            var classified = $('#MaterialClassifiedName').data('tDropDownList').value();
            var vendor = $('#VendorCodeName').data('tDropDownList');
            //var monthlyDate = combobox.text();
            $.ajax({
                type: 'post',
                data: { classified: classified },
                dataType: 'json',
                url: '@Url.Action("SelectComboBoxVendorByClassified", "PurchaseOrder", new {area = "Purchasing"})',
                timeout: 20000,
                success: function (data) {
                    //$('#Invoice').data('tConbobox').dataBind(data);
                    vendor.dataBind(data);
                }
            });
        }
        // loading button

        function grid_OnDataBound() {
            OnLoadedData();
        }

        var onLoading = false;
        function OnLoadingData() {
            if (!onLoading) {
                onLoading = true;
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (Chờ load)";
                    loading.classList.add('loading');
                }
            }
        }
        function OnLoadedData() {
            if (onLoading) {
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    if (loading && loading.className.includes("loading")) {
                        loading.classList.remove('loading');
                        loading.innerHTML = "<span></span>";
                    }
                }
                onLoading = false;
            }
        }
        var startGrid = false;
        function RefreshGrid2(name) {
            if (!onLoading) {
                OnLoadingData();
                startGrid = true;
                RefreshGrid('gridPO');
            }
        }
    </script>
}

<div class="title">Công nợ nhà cung cấp</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 1000px;">
    
    <fieldset>
        <legend>Tiêu chí trích lọc</legend>
        
            <div class="grid_1">Loại</div>
            <div class="grid_5">
            @{
                Html.Telerik().DropDownList()
                    .Name("MaterialClassifiedName")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxMaterialClassified", "Material",new {area=""}))
                    .HtmlAttributes(new { style = "width: 175px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .ClientEvents(e => e.OnChange("materialClassified_OnChange"))
                    .Render();                                              
            }
        </div>
            <div class="grid_3">Nhà cung cấp</div>
        <div class="grid_6">
            @{
                Html.Telerik().DropDownList()
                    .Name("VendorCodeName")
                    //.DataBinding(binding => binding.Ajax().Select("SelectComboBoxMaterialVendor", "Vendor"))
                    .HtmlAttributes(new { style = "width: 175px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    //.ClientEvents(e => e.OnChange("vendor_OnChange"))
                    .Render();                                              
            }
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("fromDate")
                    .Format("dd/MM/yyyy")
                    .Value(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1))
                    .Render();
            }
        </div>
        <div class="grid_2">
            @{
                Html.Telerik().DatePicker()
                    .Name("toDate")
                    .Format("dd/MM/yyyy")
                    .Value(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1))
                    .Render();
            }
        </div>

        <div class="grid_3 prefix_1">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2('gridPO'); ">
                <span class='t-icon t-insert'></span>
                Làm mới
                <span class="twoToneButton"></span>
            </button>
        </div>
    </fieldset>
</div>
