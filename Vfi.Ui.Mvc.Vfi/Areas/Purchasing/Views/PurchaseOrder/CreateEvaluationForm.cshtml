                                            .FooterHtmlAttributes(new { style = "text-align: center;" });

                                        columns.Bound(f => f.OrderQuantity).Title("Order Quantity").ReadOnly(true).Width(70)
                                            .HtmlAttributes(new { style = "text-align: right; " })
                                            .Format("{0:n1}")
                                            .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                            .FooterHtmlAttributes(new { style = "text-align: right; font-weight:bold; " })
                                            .Aggregate(agg => agg.Sum());
                                        columns.Bound(f => f.ReceivedQuantity).Title("Delivered Quantity").ReadOnly(true).Width(70)
