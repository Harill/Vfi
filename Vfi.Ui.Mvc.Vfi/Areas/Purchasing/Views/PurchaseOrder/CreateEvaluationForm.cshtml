@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@model PurchaseOrderModel
@{
    ViewBag.Title = "Create Evaluation-Form";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">

        function gridEvaluationForm_OnDataBinding(args) {
            var toolName = $("#ToolName").data('tAutoComplete').value();
            var typeId = $("#ToolType").data('tComboBox').value();
            if (typeId === "")
                typeId = 0;
            var type = $('#Type').data('tDropDownList').value();
            if (type === "")
                type = 0;
            args.data = $.extend(args.data, {
                vendorId: 0,
                toolCode: toolName,
                typeId: typeId,
                type: type,
                productId: 0
            });
        }

        function ToolType_OnChange() {
            RefreshGrid("gridToolInventory");
        }





        var orderQty = {};
        var unitPrice = {};
        var materialIds = {};
        classifiedId = 0;
        materialIds[0] = 0;

        function grid_OnSave(e) {
            // bind data
            var $note = $(e.cell).find('input[name="Note"]');
            var $pricePoint = $(e.cell).find('input[name="PricePoint"]');
            var $techSpPoint = $(e.cell).find('input[name="TechSpPoint"]');


            if ($note.length > 0) {
                var noteVal = $note.text();
                e.values["Note"] = noteVal;
            }

            if ($pricePoint.length > 0) {
                var pricePointVal = $pricePoint.val();
                e.values["PricePoint"] = pricePointVal ? parseFloat(pricePointVal) : 0;
            }

            if ($techSpPoint.length > 0) {
                var techSpPointVal = $techSpPoint.val();
                e.values["TechSpPoint"] = techSpPointVal ? parseFloat(techSpPointVal) : 0;
            }
        }


        function grid_OnSubmitChanges(e) {
            var materialClassified = $('#MaterialClassifiedName').data('tComboBox').value();
            var vendorId = $('#VendorCodeName').data('tComboBox').value();
            var fromDate = $('#fromDate').val();
            var toDate = $('#toDate').val();
            var note = $('#Note').val();

            e.values = $.extend(e.values, {
                materialClassified: materialClassified,
                vendorId: vendorId,
                fromDate: fromDate,
                toDate: toDate,
                note: note,
        });
        }


        function grid_OnDataBinding(args) {
                var vendorId = $("#VendorCodeName").data("tComboBox").value();
                if (vendorId === null) {
                    vendorId = 0;
                }
                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else {
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                }
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else {
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                }
                var materialClassifiedId = $("#MaterialClassifiedName").data("tComboBox").value();
                if (materialClassifiedId === null) {
                    materialClassifiedId = 0;
                }

                args.data = $.extend(args.data,
                {
                    vendorId: vendorId,
                    fromDate: fromDate,
                    toDate: toDate,
                    materialClassifiedId: materialClassifiedId,
                });
            console.log("Values gửi lên:", args.data);
        }




        function materialClassified_OnChange() {
            var classified = $('#MaterialClassifiedName').data('tComboBox').value();
            var vendor = $('#VendorCodeName').data('tComboBox');
            //var monthlyDate = combobox.text();
            $.ajax({
                type: 'post',
                data: { classified: classified },
                dataType: 'json',
                url: '@Url.Action("SelectComboBoxVendorByClassified", "PurchaseOrder", new {area = "Purchasing"})',
                timeout: 20000,
                success: function (data) {
                    vendor.dataBind(data);
                }
            });
        }

        // Ngăn việc refresh Page
        function RefreshGrid(gridName) {
            $("#" + gridName).data("tGrid").ajaxRequest();
            return false; // ngăn submit form
        }



        //Đếm
        var CountLateDelivery = 0, CountLessThanOrder = 0; CountNG = 0;

        // Đếm cho từng dòng
        function grid_OnRowDataBound(e) {
            var dataItem = e.dataItem;

            if (dataItem.CountLateDelivery == 1) {
                CountLateDelivery++;
            }
            if (dataItem.CountLessThanOrder == 1) {
                CountLessThanOrder++;
            }
            if (dataItem.CountNG == 1) {
                CountNG++;
            }
        }

        // Sau khi grid bind xong
        function grid_OnDataBound(e) {
            // Gán số liệu tổng vào footer
            $("#CountLateDelivery").text(CountLateDelivery);
            $("#CountLessThanOrder").text(CountLessThanOrder);
            $("#CountNG").text(CountNG);

            // Reset biến tổng
            CountLateDelivery = 0;
            CountLessThanOrder = 0;
            CountNG = 0;
        }

        function RefreshAllGridsAuto() {
            // Tìm tất cả các phần tử có data("tGrid")
            $(".t-grid").each(function () {
                var grid = $(this).data("tGrid");
                if (grid) {
                    grid.ajaxRequest();
                }
            });
        }



    </script>
}

<div class="title">Create Evaluation-Form</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: auto;">

    <fieldset>
        <legend>Evaluation-Form Information</legend>

        <div class="grid_1">Type:</div>
            <div class="grid_5">
            @{
                Html.Telerik().ComboBox()
                    .Name("MaterialClassifiedName")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxMaterialClassified", "Material",new {area=""}))
                    .HtmlAttributes(new { style = "width: 175px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .ClientEvents(e => e.OnChange("materialClassified_OnChange"))
                    .Render();                                              
            }
        </div>
            <div class="grid_1_5">Supplier:</div>
        <div class="grid_6">
            @{
                Html.Telerik().ComboBox()
                    .Name("VendorCodeName")
                    //.DataBinding(binding => binding.Ajax().Select("SelectComboBoxMaterialVendor", "Vendor"))
                    .HtmlAttributes(new { style = "width: 175px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    //.ClientEvents(e => e.OnChange("vendor_OnChange"))
                    .Render();                                              
            }
        </div>
        <div class="grid_1">From:</div>
        <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("fromDate")
                        .Format("dd/MM/yyyy")
                        .Value(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1))
                        .Render();
                } 
         </div>



         <div class="grid_1">To:</div>
         <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("toDate")
                        .Format("dd/MM/yyyy")
                        .Value(new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.Today.Day))
                        .Render();
                }
         </div>


         <div class="grid_1_5">Note:</div>
         <div class="grid_7">@Html.TextAreaFor(f => f.Note, new {@class = "multi-line"})</div>


@*        <div class =" ""grid_2">
             <button id="btnRefresh" class='t-button' onclick=" return RefreshGrid('grid2'); ">
                 <span class='t-icon t-insert'></span>
                  Làm mới
             </button>
         </div>*@
        <button onclick="RefreshAllGridsAuto();">
             Check Point
        </button>


    </fieldset>
</div>


<div class="clear"></div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<EvaluationFormModel>()
            .Name("grid")
            .DataKeys(keys => keys.Add(f => f.FormId).RouteKey("formId"))
            .ToolBar(bar => {
                bar.Insert().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).Text("New");
                bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).SaveText("Save").CancelText("Cancel");
            })
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectEvaluationForm", "PurchaseOrder")
                .Update("CreateNewEvaluationForm", "PurchaseOrder")
            )
            .Columns(columns => {
                columns.Bound(f => f.PricePoint).Width(200).Title("Competitivity (Point: 0-5-10)")
                       .HtmlAttributes(new { style = "text-align: center; font-weight:bold;" });
                columns.Bound(f => f.TechSpPoint).Width(200).Title("Technical Support(Point: 0-5-10)")
                       .HtmlAttributes(new { style = "text-align: center; font-weight:bold;" });
                columns.Command(commands => commands.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(70).Title("Cancel")
                       .HtmlAttributes(new { style = "text-align: center; " });
            })
            .ClientEvents(events => events
                .OnSave("grid_OnSave")
                .OnSubmitChanges("grid_OnSubmitChanges")
                .OnError("grid_OnError")
            )
            .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
            .KeyboardNavigation()
            .Footer(true)
            .Render();
    }
</div>
