                columns.Bound(f => f.PlaceCStr).Width(100).ReadOnly(true).Title("Late 3-5 Times (10 Point)")
                       .HtmlAttributes(new { style = "text-align: center; font-weight:bold; background-color:orange; font-size:16px;" });

                columns.Bound(f => f.PlaceDStr).Width(100).ReadOnly(true).Title("Late > 5 Times (0 Point)")
                       .HtmlAttributes(new { style = "text-align: center; font-weight:bold; background-color:red; color: white; font-size:16px;" });

                columns.Bound(f => f.Count).Hidden(true);
            })
            .ClientEvents(events => events
                .OnDataBinding("grid_OnDataBinding")
                .OnError("grid_OnError")
            )
            //.Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
