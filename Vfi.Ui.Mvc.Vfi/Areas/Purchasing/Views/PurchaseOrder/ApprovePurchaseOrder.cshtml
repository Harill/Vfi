@using Vfi.Server.Core.DataModel.Models.Inv
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@{
    ViewBag.Title = "Duyệt PO";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
<script type="text/javascript">
   
    function Grid_OnSave(e) {
        var value = e.values;
        var shipDate = value.ShipDate;
        shipDate = $.telerik.formatString('{0:dd/MM/yyyy}', shipDate);
        var purchaseOrderId = value.PurchaseOrderId;
        e.data = $.extend(e.data, {
            purchaseOrderId: purchaseOrderId,
            shipDate: shipDate,
        });
        RefreshGrid("gridTransaction");
        
    }

    function SplitOrderDetails(purchaseOrderId) {
        var $detailIds = $("input[name='chkDetailIds']:checked");
        alert($detailIds.length);
        var ids = {};
        for (var i = 0; i < $detailIds.length; i++) {
            ids[i] = $detailIds[i].value;
        }
        try {
            $.ajax({
                type: 'post',
                data: {
                    purchaseOrderId: purchaseOrderId,
                    detailIds: ids,
                },
                dataType: 'json',
                url: '@Url.Action("SplitPurchaseOrderDetails", "PurchaseOrder")',
                    timeout: 20000,
                    success: function (data) {
                        //alert(data);
                        if (data == 1) {
                            alert("Tách thành công!");
                            RefreshGrid("gridTransaction");
                        }
                        else if (data == 0) {
                            alert("Không tách được đơn hàng");
                        }
                        else if (data == 2) {
                            alert("Không được chọn tách tất cả chi tiết");
                        }
                        //else if (data == 2) {
                        //    $('#lookupTransactionCodeExisted').attr('class', 'imgUnAvailable');
                        //    $('#txtTransactionCodeHidden').val(0);
                        //}
                    }
                });



            } catch (err) { alert("Co Loi !"); }
            return false;
    }

    function PrintPOFormEN(val) {
        alert(val);
        $('#result').load('@Url.Action("PrintPurchaseOrderEN", "PurchaseOrder", new { area = "Purchasing" })',
                {
                    purchaseOrderId: val
                }, function () {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
    }


    function AprrovePo(val) {
        alert(val);
        $('#result').load('@Url.Action("ApprovePO", "PurchaseOrder", new { area = "Purchasing" })',
                {
                    purchaseOrderId: val
                },
                function () {
                    RefreshGrid("gridTransaction");
                }

                );
        return false;
    }



</script>
}

<div class="title">
    @*Duyệt phiếu mua nguyên liệu*@
    @HttpContext.GetGlobalResourceObject("Resource", "ApprovePurchaseOrder")

</div>

<div class="t-info-sha" style="padding-left: 15px; width:250px; color: Maroon;">
    @*Sổ lệnh*@
    @HttpContext.GetGlobalResourceObject("Resource", "OrdersSheet")
</div>
