  <script type="text/javascript">

      function materialClassified_OnChange() {
          var classified = $('#MaterialClassifiedName').data('tDropDownList').value();
          var vendor = $('#VendorCodeName').data('tComboBox');
          $.ajax({
              type: 'post',
              data: { classified: classified },
              dataType: 'json',
              url: '@Url.Action("SelectComboBoxVendorByClassified", "PurchaseOrder", new { area = "Purchasing" })',
                timeout: 20000,
                success: function (data) {
                    vendor.dataBind(data);
                    RefreshGrid("grid");
                }
            });
        }
        var classifiedId = 0;


        function grid_OnDataBinding(args) {
            //var statusValue = $("#Status").data("tComboBox").value();
            //if (statusValue === "")
            //    statusValue = 0;

            var classified = $("#MaterialClassifiedName").data("tDropDownList").value();
            if (classified === "")
                classified = 0;
            var vendor = $("#VendorCodeName").data("tComboBox").value();
            if (vendor === "")
                vendor = 0;
            var inquiryNumber = $("#InquiryNumber").data("tAutoComplete").value();
            var revisionNumber = $("#RevisionNumber").data("tAutoComplete").value();

            args.data = $.extend({}, args.data, {
                classified: classified,
                //status: statusValue,
                vendorId: vendor,
                inquiryNumber: inquiryNumber,
                revisionNumber : revisionNumber,

            });
        }


        function grid_OnRowDataBound(e) {
            var dataItem = e.dataItem;
            var $row = $(e.row);

            // màu trạng thái
            if (dataItem.State == 1) {
                $row.children().eq(5).css("background-color", "#FA5858");
            } else if (dataItem.State == 2) {
                $row.children().eq(5).css("background-color", "yellow");
            }
            var startIndex = 13;

            var greenBackgroud = "#67e672";
            var redBackground = "#FA5858";

            if (Number.isInteger(dataItem.ProgressState)) {
                // TH1: số lẻ nguyên (1,3,5,7,9,11)
                var count = (dataItem.ProgressState + 1) / 2;
                for (var i = 0; i < count; i++) {
                    $row.children().eq(startIndex + i).addClass("greenBackgroud");
                }
            } else if (dataItem.ProgressState % 1 === 0.5) {
                // TH2: số thập phân .5 (5.5, 7.5, 9.5)
                // tô ô 16 và 17 màu đỏ
                $row.children().eq(startIndex).addClass("redBackground");
                $row.children().eq(startIndex + 1).addClass("redBackground");

                // sau đó tô tiếp như TH1
                var count = (Math.floor(dataItem.ProgressState) + 1) / 2;
                for (var i = 0; i < count; i++) {
                    $row.children().eq(startIndex + i).addClass("greenBackgroud");
                }
            }
            }



            // xử lý nút ký
            //var $btn = $row.find(".t-button.purchasing");
            //var $chk = $row.find(".chkCheck");

            //if (dataItem.PurchasingSignatureType == 0) {
            //    $btn.parent().html("<span class='t-icon t-cancel'></span>");
            //    $chk.remove();
            //}
            //else if (dataItem.PurchasingSignatureType == 1) {
            //    $btn.parent().html("<span class='t-icon t-insert'></span>");
            //}
            //else if (dataItem.PurchasingSignatureType == 2) {
            //    $chk.remove();
            //}
            //else {
            //    $btn.parent().html("");
            //}


        function vendor_OnChange() {
            RefreshGrid("grid");
        }
        //function status_OnChange() {
        //    RefreshGrid("grid");
        //}

        function vendorGrid_OnDataBinding(e) {
            e.data = $.extend(e.data, {
                classified: classifiedId,
            });
        }
    </script>


