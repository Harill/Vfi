<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">
<div class="clear"></div>

     @{
         Html.Telerik().Grid<PoProgressModel>()
                .Name("grid")
                .DataKeys(keys => keys.Add(f => f.InquiryId).RouteKey("inquiryId"))
                .DataBinding(dataBindings => dataBindings.Ajax()
                    .Select("SelectPoProgress", "PurchaseOrder", new {
                        classified = 0,
                        type = 0,
                        vendorId = 0,
                        //status = 0
                        inquiryNumber = "",
                        revisionNumber = "",
                        //fromDate = "",
                        //toDate = ""
                    })
                )
                .Columns(columns => {
                    columns.Bound(f => f.index).Width(35).Title("STT").ReadOnly(true)
                         .HtmlAttributes(new { style = "border-bottom:1px black solid; text-align: center;" })
                         .Aggregate(agg => agg.Count())
                         .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                         .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                         .FooterHtmlAttributes(new { style = "text-align: center; font-weight:bold; " });
                    
                    columns.Bound(f => f.InquiryNumber).Width(80).Title("Số yêu cầu").ReadOnly(true)
                         .HtmlAttributes(new { style = "font-weight:bold; border-bottom:1px black solid; " });
                    
                    columns.Bound(f => f.ClassifiedName).Width(100).Title("Phân loại").ReadOnly(true)
                         .HtmlAttributes(new { style = "border-bottom:1px black solid; " });

                    //columns.Bound(f => f.TypeName).Width(90).Title("Loại").ReadOnly(true)
                    //     .HtmlAttributes(new { style = "border-bottom:1px black solid; " });
                    
                    columns.Bound(f => f.ReferenceName).Width(150).Title("Tên").ReadOnly(true)
                         .HtmlAttributes(new { style = "border-bottom:1px black solid; " });
                    
                    columns.Bound(f => f.ReferenceCode).Width(170).Title("Mã").ReadOnly(true)
                         .HtmlAttributes(new { style = "border-bottom:1px black solid; " });

                    columns.Bound(f => f.TotalInv).Width(60).Title("Tồn kho").ReadOnly(true)
                         .HtmlAttributes(new { style = "text-align: right; border-bottom:1px black solid" })
                         .Format("{0:n2}");
                    
                    columns.Bound(f => f.Unit).Width(40).Title("ĐVT")
                         .HtmlAttributes(new { style = "border-bottom:1px black solid; border-right:1px black solid;" });

                    
                    // Y/C
                    columns.Bound(f => f.VendorCode).Width(120).Title("NCC")
                         .HtmlAttributes(new { style = "border-bottom:1px black solid; border-left:1px black solid;" });
                
                    columns.Bound(f => f.OrderQty).Width(60).Title("SL").ReadOnly(true)
                        .HtmlAttributes(new { style = "border-bottom:1px black solid; text-align: right;" })
                        .Format("{0:n2}")
                        .Aggregate(agg => agg.Sum())
                        .FooterHtmlAttributes(new { style = "text-align: right;" })
                        .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>");

                    //columns.Bound(f => f.UnitPrice).Width(100).Title("ĐG")
                    //    .HtmlAttributes(new { style = "text-align: right; border-bottom:1px black solid;" })
                    //    .ClientTemplate("<#= UnitPriceStr #>");

                    //columns.Bound(f => f.Currency).Width(50).Title("Tiền tệ")
                    //    .HtmlAttributes(new { style = "border-bottom:1px black solid; " });

                    //columns.Bound(f => f.Price).Width(100).Title("TT").ReadOnly(true)
                    //    .ClientTemplate("<#= PriceStr #>")
                    //    .HtmlAttributes(new { style = "text-align: right; border-bottom:1px black solid;  " })
                    //    .Format("{0:n0}")
                    //    .Aggregate(agg => agg.Sum())
                    //    .FooterHtmlAttributes(new { style = "text-align: right;" })
                    //    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    //    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>");

                    columns.Bound(f => f.DueDate).Width(75).Title("Ngày YC")
                        .HtmlAttributes(new { style = "border-bottom:1px black solid; border-right:1px black solid; " })
                        .ClientTemplate("<#= DueDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', DueDate) #>");

                    
                    
                    // MH
                    columns.Bound(f => f.RevisionNumber).Width(85).Title("Số đơn")
                        .HtmlAttributes(new { style = "border-bottom:1px black solid; font-weight:bold; border-left:1px black solid;" });

                    //columns.Bound(f => f.PurchaseDetailId).Width(85).Title("Id")
                    //    .HtmlAttributes(new { style = "border-bottom:1px black solid; font-weight:bold; border-left:1px black solid;" });

                    columns.Bound(f => f.DeliveryDate).Width(75).Title("Ngày xác nhận</br>giao hàng")
                        .ClientTemplate("<#= DeliveryDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', DeliveryDate) #>")
                        .HtmlAttributes(new { style = "border-bottom:1px black solid;  border-right:1px black solid; " });
                    
                    columns.Bound(f => f.Nulla).Width(60).Title("(1)").ReadOnly(true)
                        .Filterable(false)
                        .HtmlAttributes(new { style = "border-bottom:1px black solid; " });

                    columns.Bound(f => f.Nulla).Width(60).Title("(2)").ReadOnly(true)
                        .Filterable(false)
                        .HtmlAttributes(new { style = "border-bottom:1px black solid; " });

                    columns.Bound(f => f.Nulla).Width(60).Title("(3)").ReadOnly(true)
                        .Filterable(false)
                        .HtmlAttributes(new { style = "border-bottom:1px black solid; " });

                    columns.Bound(f => f.Nulla).Width(60).Title("(4)").ReadOnly(true)
                        .Filterable(false)
                        .HtmlAttributes(new { style = "border-bottom:1px black solid; " });

                    columns.Bound(f => f.StringReceivedQty).Width(60).Title("(5)").ReadOnly(true)
                        .Filterable(false)
                        .HtmlAttributes(new { style = "border-bottom:1px black solid; text-align: right; " });

                    columns.Bound(f => f.ImportDateStr).Width(70).Title("(6)").ReadOnly(true)
                        .HtmlAttributes(new { style = "border-bottom:1px black solid; text-align: right; " })                       
                        .Filterable(false);
                        
                })
                .ClientEvents(events => events
                    .OnDataBinding("grid_OnDataBinding")
                    .OnRowDataBound("grid_OnRowDataBound")
                    .OnError("grid_OnError")
                )
                .Groupable(group => group.Groups(g => g.Add(model => model.ClassifiedName)))
                //.Scrollable(f => f.Height("auto"))
                .Scrollable(f => f.Height(700))
                .Sortable()
                //.Filterable()
                .Resizable(resizing => resizing.Columns(true))
                .Footer(true)
                .Render();
        }
</div>

 