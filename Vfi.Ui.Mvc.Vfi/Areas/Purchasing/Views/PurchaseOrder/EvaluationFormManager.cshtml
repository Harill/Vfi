<script>
    function window_onopen(e) {
        //alert("b");
        $("#rptvPagePrintEvaluationForm_ReportToolbar_ExportGr_FormatList_DropDownList option[value='CSV']").remove();
        $("#rptvPagePrintEvaluationForm_ReportToolbar_ExportGr_FormatList_DropDownList option[value='XLS']").remove();
        $("#rptvPagePrintEvaluationForm_ReportToolbar_ExportGr_FormatList_DropDownList option[value='RTF']").remove();
        $("#rptvPagePrintEvaluationForm_ReportToolbar_ExportGr_FormatList_DropDownList option[value='IMAGE']").remove();
        $("#rptvPagePrintEvaluationForm_ReportToolbar_ExportGr_FormatList_DropDownList option[value='MHTML']").remove();
        $("#rptvPagePrintEvaluationForm_ReportToolbar_ExportGr_FormatList_DropDownList option[value='XPS']").remove();
