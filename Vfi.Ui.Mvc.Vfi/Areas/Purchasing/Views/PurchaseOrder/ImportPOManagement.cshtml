                    columns.Bound(f => f.Price).Title("Thành tiền").Width(110)
                           .Format("{0:n0}")
                           .HtmlAttributes(new { style = "text-align: right;" })
                           .Aggregate(agg => agg.Sum())
                           .FooterHtmlAttributes(new { style = "text-align: right;" })
                           .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                           .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>");

                    columns.Bound(f => f.VendorName)
                           .Title("Nhà cung cấp")
                           .Width(120)
                           .FooterTemplate("<span style='color:green'>Đúng hạn: <span id='VendorOnTimeFooter'></span></span>")
                           //.ClientGroupFooterTemplate("<span style='color:green'>Đúng hạn: <span id='VendorOnTimeGroup'></span></span>")
                           .FooterHtmlAttributes(new { style = "text-align: center;" });

                    columns.Bound(f => f.VendorDeliveryOnDate)
