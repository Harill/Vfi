@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@{
    ViewBag.Title = "Theo dõi NCC";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>


</style>
@section Scripts{
    <script type="text/javascript">

        function grid_OnDataBinding(args) {

            var classified = $('#MaterialClassifiedName').data('tComboBox').value();
            if (classified === "")
                classified = 0;
            var vendor = $('#VendorCodeName').data('tComboBox').value();
            if (vendor === "")
                vendor = 0;
            var fromDate = $("#fromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#toDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
            }
            args.data = $.extend(args.data, {
                classifiedId: classified,
                vendorId:vendor,
                fromDate: fromDate,
                toDate: toDate
            });

        }
        // start OTD

        var vendorOnTime = 0, vendorLate = 0;

        // Đếm cho từng dòng
        function grid_OnRowDataBound(e) {
            var dataItem = e.dataItem;

            if (dataItem.VendorDeliveryOnDate) {
                vendorLate++;
            }
            else {
                vendorOnTime++;
            }
        }

        // Sau khi grid bind xong
        function grid_OnDataBound(e) {
            // Gán số liệu tổng vào footer
            $("#VendorOnTimeFooter").text(vendorOnTime);
            $("#VendorLateFooter").text(vendorLate);

            // Reset biến tổng
            vendorOnTime = 0;
            vendorLate = 0;

        }
        // end OTD

        //----------------------------------------------

        // start NGString
        var NGQuanlity = 0, OKQuanlity = 0;
        function grid_GridBound(e) {
            var dataItem = e.dataItem;

            if (dataItem.NGString) {
                NGQuanlity++;
            }
            else {
                OKQuanlity++;
            }
        }

        // Sau khi grid bind xong
        function grid_OnGridBound(e) {
            // Gán số liệu tổng vào footer
            $("#NGFooter").text(NGQuanlity);
            $("#OKFooter").text(OKQuanlity);

            // Reset biến tổng
            NGQuanlity = 0;
            OKQuanlity = 0;

        }
        //end NG


        function materialClassified_OnChange() {
            var classified = $('#MaterialClassifiedName').data('tComboBox').value();
            var vendor = $('#VendorCodeName').data('tComboBox');
            //var monthlyDate = combobox.text();
            $.ajax({
                type: 'post',
                data: { classified: classified },
                dataType: 'json',
                url: '@Url.Action("SelectComboBoxVendorByClassified", "PurchaseOrder", new {area = "Purchasing"})',
                timeout: 20000,
                success: function (data) {
                    //$('#Invoice').data('tConbobox').dataBind(data);
                    vendor.dataBind(data);
                }
            });
        }
    </script>
}

<div class="title">
    @*Theo dõi Nhà Cung Cấp*@
    @HttpContext.GetGlobalResourceObject("Resource", "ImportPOManagement")
</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">
    
    <fieldset>
        <legend>
            @*Tiêu chí trích lọc*@
            @HttpContext.GetGlobalResourceObject("Resource", "Filter")
        </legend>
        <div class="grid_1">
            @*Loại*@
            @HttpContext.GetGlobalResourceObject("Resource", "Type")
        </div>
            <div class="grid_5">
            @{
                Html.Telerik().ComboBox()
                    .Name("MaterialClassifiedName")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxMaterialClassified", "Material",new {area=""}))
                    .HtmlAttributes(new { style = "width: 175px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .ClientEvents(e => e.OnChange("materialClassified_OnChange"))
                    .Render();                                              
            }
        </div>
            <div class="grid_1">
                @*NCC*@
                @HttpContext.GetGlobalResourceObject("Resource", "Vendor2")
            </div>
        <div class="grid_6">
            @{
                Html.Telerik().ComboBox()
                    .Name("VendorCodeName")
                    //.DataBinding(binding => binding.Ajax().Select("SelectComboBoxMaterialVendor", "Vendor"))
                    .HtmlAttributes(new { style = "width: 175px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    //.ClientEvents(e => e.OnChange("vendor_OnChange"))
                    .Render();                                              
            }
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("fromDate")
                    .Format("dd/MM/yyyy")
                    .Value(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1))
                    .Render();
            }
        </div>
        <div class="grid_2">
            @{
                Html.Telerik().DatePicker()
                    .Name("toDate")
                    .Format("dd/MM/yyyy")
                    .Value(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1))
                    .Render();
            }
        </div>

        <div class="grid_3 prefix_1">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridPO'); ">
                <span class='t-icon t-insert'></span>
                @*Làm mới*@
                @HttpContext.GetGlobalResourceObject("Resource", "Refresh")
            </button>
        </div>
    </fieldset>
</div>
<div class="clear"></div>

