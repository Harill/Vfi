                               "<span style='color:red'>Trễ hạn</span>" +
                               "<# } else { #>" +
                               "<span style='color:green'>Đúng hạn</span>" +
                               "<# } #>")
                           .HtmlAttributes(new { style = "text-align:center;" })
                           .FooterTemplate("<span style='color:red'>Trễ hạn: <span id='VendorLateFooter'></span></span>")
                           //.ClientGroupFooterTemplate("<span style='color:red'>Trễ hạn: <span id='VendorLateGroup'></span></span>")
                           .FooterHtmlAttributes(new { style = "text-align: center;" });



                    //columns.Bound(f => f.VendorDeliveryOnDateValue).Title("OTD Value")
                    //       .Width(85)
                    //       .ReadOnly(true)
                    //       .Hidden(true)
                    //       .Aggregate(agg => agg.Count())
                    //       .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>")

                    //       ;
                                        
                    //columns.Bound(f => f.Tax).Title("VAT").Width(85)
                    //       .Format("{0:n0}")
                    //       .HtmlAttributes(new { style = "text-align: right;" })
                    //       .Aggregate(agg => agg.Sum())
                    //       .FooterHtmlAttributes(new { style = "text-align: right;" })
                    //       .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    //       .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>");

                    //columns.Bound(f => f.TaxInvoiceNumber).Title("Hóa đơn").Width(120);
                    //columns.Bound(f => f.TaxInvoiceDateString).Title("Ngày lập").Width(90);
                    columns.Bound(f => f.Qc).Title("Chất lượng").Width(35);
                    columns.Bound(f => f.Note).Title("Ghi chú").Width(150);
                })
                .Groupable()
            .Reorderable(f => f.Columns(true))
                .Scrollable(f => f.Height("auto"))
            .Scrollable(f => f.Height(650))
            .Resizable(f => f.Columns(true))
            .Sortable()
            .Groupable(group => group.Groups(g => g.Add(model => model.VendorName)))
            .Filterable()
            .ClientEvents(events => events.OnDataBinding("grid_OnDataBinding")
                                          .OnError("grid_OnError")
                                          .OnRowDataBound("grid_OnRowDataBound")
                                          .OnDataBound("grid_OnDataBound")
                                          )
                                          
            .Render();
    }
</div>

