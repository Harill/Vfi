        var productId = 0;

        function gridPlatingDetail_onSave(e) {
            var $productCode = $(e.cell).find('#ProductCode');
            var $platingCode = $(e.cell).find('#PlatingCode');
            var $exportDate = $(e.cell).find('#ExportDateRequirement');
            var $importDate = $(e.cell).find('#ImportDateRequirement');

            if ($productCode.length > 0) {
                var productCode = $productCode.data("tComboBox"),
                    productCodeSelectItem = productCode.selectedIndex > -1 ? productCode.data[productCode.selectedIndex] : null;

                if (productCodeSelectItem) {
                    e.values["ProductCode"] = productCodeSelectItem.Text;
                    e.values["ProductId"] = productCodeSelectItem.Value;
                    productId = productCodeSelectItem.Value;
                    $.ajax({
                        type: 'post',
                        data: { productId: productCodeSelectItem.Value },
                        dataType: 'json',
                        url: '@Url.Action("GetProductPlatingCode", "Product",new{area=""})',
                        timeout: 20000,
                        success: function(data) {
                            if (data === '9') {
                                alert("Lỗi! Không tìm thấy sản phẩm ! Liên hệ admin");
                            } else if (data === '8') {
                                alert("Lỗi! Sản phẩm không có xi mạ ! Liên hệ admin");
                            } else if (data === '0') {
                                alert("Lỗi!");
                            } else {
                                e.cell.parentElement.childNodes[1].textContent = data[1];
                                e.dataItem.PlatingId = data[0];
                                e.dataItem.PlatingCode = data[1];
                                e.cell.parentElement.childNodes[2].textContent = data[2];
                                e.dataItem.Thickness = data[2];
                                e.cell.parentElement.childNodes[3].textContent = data[3];
                                e.dataItem.SaltSprayTime = data[3];
                                e.cell.parentElement.childNodes[4].textContent = data[4];
                                e.dataItem.SpecialRequest = data[4];
                                e.cell.parentElement.childNodes[5].textContent = data[5];
                                e.dataItem.Sample = data[5];
                                e.cell.parentElement.childNodes[6].textContent = data[6];
                                e.dataItem.TestingEquipment = data[6];
                                e.cell.parentElement.childNodes[7].textContent = data[7];
                                e.dataItem.Unit = data[7];
                                e.cell.parentElement.childNodes[8].textContent = data[8];
                                e.dataItem.UnitPrice = data[8];
                            }
                        }
                    });
                }
            } else if ($platingCode.length > 0) {
                var platingCode = $platingCode.data("tComboBox"),
                    platingCodeSelectItem = platingCode.selectedIndex > -1 ? platingCode.data[platingCode.selectedIndex] : null;

                if (platingCodeSelectItem) {
                    e.values["PlatingCode"] = platingCodeSelectItem.Text;
                    e.values["PlatingId"] = platingCodeSelectItem.Value;
                    $.ajax({
                        type: 'post',
                        data: { platingId: platingCodeSelectItem.Value },
                        dataType: 'json',
                        url: '@Url.Action("GetPlatingInfo", "PurchaseOrder",new{area="Purchasing"})',
                        timeout: 20000,
                        success: function(data) {
                            if (data === '9') {
                                alert("Lỗi! Không tìm thấy sản phẩm ! Liên hệ admin");
                            } else if (data === '8') {
                                alert("Lỗi! Sản phẩm không có xi mạ ! Liên hệ admin");
                            } else if (data === '0') {
                                alert("Lỗi!");
                            } else {
                                e.cell.parentElement.childNodes[2].textContent = data[2];
                                e.dataItem.Thickness = data[2];
                                e.cell.parentElement.childNodes[3].textContent = data[3];
                                e.dataItem.SaltSprayTime = data[3];
                                e.cell.parentElement.childNodes[4].textContent = data[4];
                                e.dataItem.SpecialRequest = data[4];
                                e.cell.parentElement.childNodes[5].textContent = data[5];
                                e.dataItem.Sample = data[5];
                                e.cell.parentElement.childNodes[6].textContent = data[6];
                                e.dataItem.TestingEquipment = data[6];
                                e.cell.parentElement.childNodes[7].textContent = data[7];
                                e.dataItem.Unit = data[7];
                                e.cell.parentElement.childNodes[8].textContent = data[8];
                                e.dataItem.UnitPrice = data[8];
                            }
                        }
                    });

                }
            } else if ($exportDate.length > 0) {
                e.values["ExportDate"] = $exportDate.data("tDatePicker").value();
            } else if ($importDate.length > 0) {
                e.values["ImportDate"] = $importDate.data("tDatePicker").value();
            }
        }


        function gridPlatingDetail_onSubmitChanges(e) {

            var flag = InputValidation();

            if (!flag)
                e.preventDefault();
            else {

                // var shipDate = $("#ShipDate").data("tDatePicker").value();

                var vendorCodeName = $('#VendorCodeName').data('tDropDownList').value();
                var currencyCode = $('#CurrencyCode').data('tDropDownList').value();
                var platingType = $('#PlatingType').data('tDropDownList').value();
                var exchangeRate = $("#ExchangeRate").val();
                var note = $('#Note').val();

                e.values = $.extend(e.values,
                    {
                        shipDate: "",
                        vendorId: vendorCodeName,
                        platingType:platingType,
                        exchangeRate: exchangeRate,
                        currencyCode:currencyCode,
                        note: note
                    }
                );
            }
        }
        function plating_OnDataBinding(e) {
            //alert(e);
            //var productId = e.currentTarget.value;
            e.data = $.extend(e.data, {
                productId: productId
            });
        }
        function InputValidation() {
            var strMsgAlert = "";

            var vendorCodeName = $('#VendorCodeName').data('tDropDownList').value();
           
            var currencyCode = $('#CurrencyCode').data('tDropDownList').value();
            var tolerance = $('#Tolerance').val();
            if (vendorCodeName === "") {
                strMsgAlert += "Vui lòng chọn nhà cung cấp.\t\r\n";
            }
            if (currencyCode === "") {
                strMsgAlert += "Vui lòng chọn đơn vị tính.\t\r\n";
            }
            if (tolerance === "") {
                strMsgAlert += "Vui lòng nhập dung sai.\t\r\n";
            }

            if (strMsgAlert === "")
                return true;

            alert(strMsgAlert);
            return false;
        }
        function vendor_onChange() {
            var vendorId = $(this).data('tDropDownList').value();

            $.ajax({
                type: 'post',
                data: { vendorId: vendorId },
                dataType: 'json',
                url: '@Url.Action("GetPlatingInfoById", "PurchaseOrder")',
                timeout: 20000,
                success: function (data) {
                    if (data === '9') {
                        alert("Lỗi! Không tìm thấy khách hàng ! Liên hệ admin");
                    } else if (data === '0') {
                        alert("Lỗi!");
                    } else {
                        $("#PlatingType").data("tDropDownList").$text[0].innerHTML = data.PlatingTypeName;
                        $("#PlatingType").val(data.PlatingType);
                        $("#CurrencyCode").data("tDropDownList").$text[0].innerHTML = data.CurrencyCodeName;
                        $("#CurrencyCode").val(data.CurrencyCode);
                        $("#ExchangeRate").val(data.ExchangeRate);
                        $("#ExchangeRate").data("tTextBox").$text[0].innerHTML = data.ExchangeRate;
                    }
                }
            });
            return false;
        }
    </script>


<div class="title">
   @* Tạo phiếu gia công ngoài*@
    @HttpContext.GetGlobalResourceObject("Resource", "CreatePlatingForm")
</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">

    <fieldset>
        <legend>
            @*Thông tin phiếu*@
            @HttpContext.GetGlobalResourceObject("Resource", "InformationForm")
        </legend>
        
        <div class="grid_5">
            @*Nhà cung cấp*@
            @HttpContext.GetGlobalResourceObject("Resource", "Vendor")
        </div>
        
          <div class="grid_4">
              @*Loại gia công*@
              @HttpContext.GetGlobalResourceObject("Resource", "Type")
          </div>
          <div class="grid_4">
              @*Tiền tệ*@
              @HttpContext.GetGlobalResourceObject("Resource", "Currency")
          </div>
        <div class="grid_2">
            @*Tỉ giá*@
            @HttpContext.GetGlobalResourceObject("Resource", "ExchangeRate")
        </div>
        
        <div class="grid_5">
            @*Ghi Chú*@
            @HttpContext.GetGlobalResourceObject("Resource", "Note")
        </div>
        <div class="clear"></div>
        <div class="grid_5">
            @{
                Html.Telerik().DropDownList()
                    .Name("VendorCodeName")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxPlatingVendor", "Vendor"))
                    .HtmlAttributes(new { style = "width: 175px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .ClientEvents(events => events.OnChange("vendor_onChange"))
                    .Render();                                              
            }
        </div>
           <div class="grid_4">
            @{
                Html.Telerik().DropDownList()
                    .Name("PlatingType")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxPlatingType", "PurchaseOrder", new { area = "Purchasing" }))
                    .DropDownHtmlAttributes(new { style = "width: 150px" })
                    .Render();
            }
        </div> 
        <div class="grid_4">
            @{
                Html.Telerik().DropDownList()
                    .Name("CurrencyCode")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCurrency", "Currency", new { area = "" }))
                    .DropDownHtmlAttributes(new { style = "width: 150px" })
                    .SelectedIndex(3)
                    .Render();
            }
        </div> 
        <div class="grid_2">
             @{
                    Html.Telerik().NumericTextBox()
                        .Name("ExchangeRate")
                        .Value(1)
                        .MinValue(1)
                        .DecimalDigits(0)
                        .HtmlAttributes(new { style = "width: 100%" })
                        .InputHtmlAttributes(new { style = "width: 100%" })
                         
                        .Render();
                }
            </div>
        <div class="grid_5">@Html.TextArea("Note", new {@class = "multi-line"})</div>
    </fieldset>
</div>
<div class="clear"></div>


<div class="cover-div">
    @{
        Html.Telerik().Grid<PlatingDetailModel>()
            .Name("gridPlatingDetail")
            .DataKeys(keys => keys.Add(f => f.DetailId).RouteKey("detailId"))
            .ToolBar(bar =>
                {
                    bar.Insert().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
                        .Text(@HttpContext.GetGlobalResourceObject("Resource", "NewText").ToString());
                    bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
                        .Text(@HttpContext.GetGlobalResourceObject("Resource", "SaveText").ToString());
                })
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("SelectPlatingDetail", "PurchaseOrder")
                                                     .Update("CreatePlatingDetail", "PurchaseOrder")
            )
            .Columns(columns =>
                {
                    //columns.Bound(f => f.MaterialClassifiedName).Width(175);
                    //columns.Bound(f => f.MaterialTypeName).Width(175);
                    columns.Bound(f => f.ProductCode).Width(200)
                        //.Title("Mã SP")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductCode").ToString())
                        ;
                   
                    columns.Bound(f => f.PlatingCode).Width(115)
                        //.Title("Mã xi mạ")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "PlatingCodeB").ToString())
                        ;

                    columns.Bound(f => f.Thickness).Width(100)
                        //.HeaderTemplate("Độ dày</br>(µm)")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Thickness").ToString()
                            + "</br>(µm)"
                        )
                        ;
                  
                    columns.Bound(f => f.SaltSprayTime).Width(100)
                        //.HeaderTemplate("Phun muối</br>(h)")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "SaltSpray").ToString() 
                            + "</br>(h)"
                            )
                        ;
                 
                    columns.Bound(f => f.SpecialRequest).Width(100)
                        //.Title("Yêu cầu")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Request").ToString())
                        ;
                 
                    columns.Bound(f => f.Sample).Width(100)
                        //.Title("Mẫu SP")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductSample1").ToString())
                        ;
                  
                    columns.Bound(f => f.TestingEquipment).Width(100)
                        //.Title("Thiết bị KT")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "TestingEquipment1").ToString())
                        ;

                    columns.Bound(f => f.Unit).Width(90)
                        //.Title("ĐVT")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Unit2").ToString())
                        ;
                   
                    columns.Bound(f => f.UnitPrice).Width(115)
                        //.Title("Đơn giá")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "UnitPrice").ToString())
                        .Format("{0:n}");
                  
                    columns.Bound(f => f.QuantityRequirement).Width(115)
                        //.Title("SL")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Quantity").ToString())
                        .Format("{0:n}");
                   
                    columns.Bound(f => f.ExportDateRequirement).Width(115)
                        //.Title("Ngày xuất")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "ExportDate").ToString())
                        .ClientTemplate("<#= ExportDateRequirement == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', ExportDateRequirement) #>");
                   
                    columns.Bound(f => f.ImportDateRequirement).Width(115)
                        //.Title("Ngày giao")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "DeliveryDate").ToString())
                        .ClientTemplate("<#= ImportDateRequirement == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', ImportDateRequirement) #>");
                    
                    columns.Bound(f => f.Note).Width(90)
                        //.Title("Ghi chú")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Note").ToString())
                        ;
                   
                    columns.Command(commands => commands.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(50).Title("");
                })
            .ClientEvents(events => events.OnEdit("gridPlatingDetail_onEdit")
                                          .OnSave("gridPlatingDetail_onSave")
                                          .OnSubmitChanges("gridPlatingDetail_onSubmitChanges")
                                          .OnError("grid_OnError")
            )
            .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
            .KeyboardNavigation()
            .Footer(false)
            .Render();
    }
</div>
<div class="clear"></div>
<br />
