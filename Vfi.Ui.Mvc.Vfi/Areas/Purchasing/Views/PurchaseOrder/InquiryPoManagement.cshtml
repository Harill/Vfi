@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@model PurchaseOrderModel
@{
    ViewBag.Title = "Quản lý phiếu yêu cầu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">

        function materialClassified_OnChange() {
            var classified = $('#MaterialClassifiedName').data('tDropDownList').value();
            var vendor = $('#VendorCodeName').data('tDropDownList');
            $.ajax({
                type: 'post',
                data: { classified: classified },
                dataType: 'json',
                url: '@Url.Action("SelectComboBoxVendorByClassified", "PurchaseOrder", new { area = "Purchasing" })',
                timeout: 20000,
                success: function (data) {
                    vendor.dataBind(data);
                    //RefreshGrid("grid");
                }
            });
        }
        var classifiedId = 0;
        function grid_OnEdit(e) {
            classifiedId = e.dataItem.ClassifiedId;
        }

        function grid_OnDataBinding(args) {
            var statusValue = $("#Status").data("tComboBox").value();
            if (statusValue === "")
                statusValue = 0;

            var classified = $("#MaterialClassifiedName").data("tDropDownList").value();
            if (classified === "")
                classified = 0;

            var vendor = $("#VendorCodeName").data("tDropDownList").value();
            if (vendor === "")
                vendor = 0;

            var fromDate = $("#fromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#toDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
            }
            args.data = $.extend({}, args.data, {
                classified: classified,
                status: statusValue,
                vendorId: vendor,
                fromDate: fromDate,
                toDate: toDate
            });
        }

        function vendorGrid_OnDataBinding(e) {
            e.data = $.extend(e.data, {
                classified: classifiedId,
            });
        }
    </script>

}


<div class="title">
    @*Quản lý phiếu yêu cầu*@
    @HttpContext.GetGlobalResourceObject("Resource", "InquiryPoManagement")
</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">

    <fieldset>
        <legend>
            @*Thông tin phiếu yêu cầu*@
            @HttpContext.GetGlobalResourceObject("Resource", "Information") @HttpContext.GetGlobalResourceObject("Resource", "InquiryForm")
        </legend>

        <div class="grid_5">
            @*@Html.LabelFor(f => f.MaterialClasstifiedName)*@
             @HttpContext.GetGlobalResourceObject("Resource", "MaterialClassified")
        </div>
        <div class="grid_6">
            @*@Html.LabelFor(f => f.VendorCodeName)*@
            @HttpContext.GetGlobalResourceObject("Resource", "Vendor")
           @* <button class="t-button" id="btnTypeRefresh" name="btnPickupMaterialId" onclick=" TypeRefresh() ">
                <span class='t-icon t-refresh'></span>
            </button>*@
        </div>

        @*<div class="grid_5">@Html.LabelFor(f => f.CurrencyCode)</div>*@

        <div class="clear"></div>
        <div class="grid_5">
            @{
                Html.Telerik().DropDownList()
                    .Name("MaterialClassifiedName")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxMaterialClassified", "Material", new { area = "" }))
                    .HtmlAttributes(new { style = "width: 175px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .ClientEvents(e => e.OnChange("materialClassified_OnChange"))
                    .Render();                                              
            }
        </div>
        <div class="grid_6">
            @{
                Html.Telerik().DropDownList()
                    .Name("VendorCodeName")
                    //.DataBinding(binding => binding.Ajax().Select("SelectComboBoxMaterialVendor", "Vendor"))
                    .HtmlAttributes(new { style = "width: 175px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    //.ClientEvents(e => e.OnChange("vendor_OnChange"))
                    .Render();                                              
            }
        </div>
       @* <div class="grid_5">
            @{
                Html.Telerik().DropDownList()
                    .Name("CurrencyCode")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCurrency", "Currency", new { area = "" }))
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .Render();
            }
        </div>*@
        
        <div class="grid_2">
            @*Tình trạng*@
            @HttpContext.GetGlobalResourceObject("Resource", "Status")
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("Status")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxAllInquiryStatus", "PurchaseOrder", new { area = "Purchasing" }))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .HighlightFirstMatch(true)
                    .AutoFill(true)
                    .Render();
            }
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("fromDate")
                    .Format("dd/MM/yyyy")
                    .Value(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1))
                    .Render();
            }
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("toDate")
                    .Format("dd/MM/yyyy")
                    .Value(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1))
                    .Render();
            }
        </div>
        <div class="grid_1">
            <button class="t-button" id="btnGridRefresh" name="btnPickupMaterialId" onclick=" RefreshGrid('grid') ">
                <span class='t-icon t-refresh'>Làm mới</span>
            </button>
        </div>
        <div class="grid_6">
            <button class="t-button" id="btnPrintForm" name="btnPickupId" onclick=" printInquiryForm() ">
                <span class='t-icon t-insert'></span>
                @*In Phiếu Yêu Cầu*@
                @HttpContext.GetGlobalResourceObject("Resource", "Print")  @HttpContext.GetGlobalResourceObject("Resource", "InquiryForm")
            </button>
        </div>
    </fieldset>
</div>
<div class="clear"></div>


<div class="cover-div">
    @{
        Html.Telerik().Grid<InquiryPoModel>()
            .Name("grid")
            .DataKeys(keys => keys.Add(f => f.InquiryId).RouteKey("inquiryId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectInquiryPo", "PurchaseOrder", new
                {
                    classified = 0,
                    type = 0,
                    vendorId = 0,
                    status = 0,
                    fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("dd/MM/yyyy"),
                    toDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1).ToString("dd/MM/yyyy")
                })
            )
            .Columns(columns =>
            {
                //columns.Bound(f => f.InquiryId).Title("Chọn").Width(50).ReadOnly(true)
                //    .ClientTemplate("<input type='checkbox' name='chkIds' value='<#= InquiryId #>' />")
                //    .HtmlAttributes(new { style = "text-align:center" });
                //columns.Command(command => command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image))
                //    .Width(50).Title("Sửa")
                //    .HtmlAttributes(new { style = "text-align:center" });
       
                columns.Bound(f => f.InquiryNumber).Width(90)
                    //.Title("Số yêu cầu")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "InquiryNumber").ToString());
        
                columns.Bound(f => f.ClassifiedName).Width(100)
                    //.Title("Phân loại")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "MaterialClassified").ToString())
                    .ReadOnly(true);
        
                columns.Bound(f => f.TypeName).Width(100)
                    //.Title("Loại")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Type").ToString())
                    .ReadOnly(true);
       
                columns.Bound(f => f.VendorCode).Width(120)
                    //.Title("NCC")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Vendor2").ToString());
         
                columns.Bound(f => f.ReferenceCode).Width(180)
                    //.Title("Mã")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Code").ToString())
                    .ReadOnly(true);
            
                columns.Bound(f => f.Unit).Width(40)
                    //.Title("ĐVT")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Unit2").ToString());
                
                columns.Bound(f => f.Currency).Width(50)
                    //.Title("Tiền tệ")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Currency").ToString());
              
                columns.Bound(f => f.UnitPrice).Width(70)
                    //.Title("Đơn giá")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "UnitPrice").ToString())
                    .HtmlAttributes(new { style = "text-align: right;" })
                    .ClientTemplate("<#= UnitPriceStr #>");
                
                columns.Bound(f => f.OrderQty).Width(70)
                    //.Title("SL")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Quantity").ToString())
                    .HtmlAttributes(new { style = "text-align: right;" })
                    .Format("{0:n0}")
                    .Aggregate(agg => agg.Sum())
                    .FooterHtmlAttributes(new { style = "text-align: right;" })
                    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>");

                columns.Bound(f => f.Price).Width(100)
                    //.Title("Tổng tiền")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "TotalAmount").ToString())
                    .ReadOnly(true)
                    .HtmlAttributes(new { style = "text-align: right;" })
                    .Format("{0:n0}")
                    .Aggregate(agg => agg.Sum())
                    .FooterHtmlAttributes(new { style = "text-align: right;" })
                    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>");

                columns.Bound(f => f.DueDate).Width(90)
                    //.Title("Ngày YC")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "OrderedDate").ToString())
                    .ClientTemplate("<#= DueDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', DueDate) #>");
        
                columns.Bound(f => f.TotalInv).Width(70)
                    //.Title("Tồn kho")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Inv").ToString())
                    .ReadOnly(true)
                    .HtmlAttributes(new { style = "text-align: right;" })
                    .Format("{0:n2}");
            
                columns.Bound(f => f.Note).Width(120)
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Note").ToString())
                    .HtmlAttributes(new { style = "text-align: left; border-right:1px black solid;" });
                
                //columns.Command(commands => commands.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(70).Title("");


                columns.Bound(f => f.ApprovedPo).Width(100)
                    //.Title("Người duyệt/hủy")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ApprovedUser").ToString())
                    .ReadOnly(true);
           
                columns.Bound(f => f.DateApproved).Width(80)
                    //.Title("Ngày duyệt/hủy")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ApprovedDate").ToString())
                    .ReadOnly(true)
                    .ClientTemplate("<#= DateApproved == null ? '' : $.telerik.formatString('{0:HH:mm dd/MM/yyyy }', DateApproved) #>")
                    .HtmlAttributes(new { style = "text-align: center; border-right:1px black solid;" });
                
                columns.Bound(f => f.ManagerConfirm).Width(80)
                    //.Title("Người xác nhận")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ManagerConfirm").ToString())
                    .ReadOnly(true);
               
                columns.Bound(f => f.DateConfirm).Width(80)
                    //.Title("Ngày xác nhận")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ConfirmDate").ToString())
                    .ReadOnly(true)
                    .ClientTemplate("<#= DateConfirm == null ? '' : $.telerik.formatString('{0:HH:mm dd/MM/yyyy }', DateConfirm) #>")
                    .HtmlAttributes(new { style = "text-align: center; border-right:1px black solid;" });


                columns.Bound(f => f.CreaterName).Width(80)
                    //.Title("Người lập phiếu")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "CreateUser").ToString())
                    .ReadOnly(true);
             
                columns.Bound(f => f.ModifiedDate).Width(80)
                    //.Title("Ngày lập phiếu")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "CreateDate").ToString())
                    .ReadOnly(true)
                    .ClientTemplate("<#= ModifiedDate == null ? '' : $.telerik.formatString('{0:HH:mm dd/MM/yyyy }', ModifiedDate) #>")
                    .HtmlAttributes(new { style = "text-align: center; " });
            })
            .ClientEvents(events => events
                .OnDataBinding("grid_OnDataBinding")
                .OnEdit("grid_OnEdit")
                .OnError("grid_OnError")
            )
            .Groupable(group => group.Groups(g => g.Add(model => model.ClassifiedName)))
            .Resizable(f => f.Columns(true))
            .Scrollable(f => f.Height("auto"))
            .Footer(true)
            .Render();
    }
</div>
