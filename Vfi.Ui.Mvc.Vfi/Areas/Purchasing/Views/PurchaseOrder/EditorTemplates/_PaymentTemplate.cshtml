@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@using System.Web.Mvc

@{
    Html.Telerik().ComboBox()
        .Name("paymentMethodId") // phải trùng với tham số trong action
        .DataBinding(binding => binding.Ajax()
            .Select("SelectComboBoxPaymentMethod", "Method",
                new { area = "Purchasing", typeId = MethodEnumTypeId.PaymentMethod }))
        .BindTo(new SelectList(Enumerable.Empty<object>(), "PaymentMethodId", "PaymentMethodName"))
        //.Value(Model != null && Model.paymentMethodId != null
        //   ? Model.paymentMethodId.ToString()
        //   : string.Empty)
        
        .HtmlAttributes(new { style = "width: 150px" })
        .DropDownHtmlAttributes(new { style = "width: 250px" })
        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
        .HighlightFirstMatch(true)
        .AutoFill(true)
        .Render();
}
