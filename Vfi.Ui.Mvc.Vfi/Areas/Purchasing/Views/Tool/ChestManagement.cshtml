@using Vfi.Ui.Mvc.Vfi.Models
@{
    ViewBag.Title = "Tủ công cụ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="title">Quản lý thông tin tủ công cụ</div>

<div class="cover-div">
@{
    Html.Telerik().Grid<ChestModel>()
        .Name("gridTooll")
        .DataKeys(key => key.Add(f => f.ChestId).RouteKey("chestId"))
        .ToolBar(
            toolbar =>
                toolbar.Insert().ButtonType(GridButtonType.ImageAndText).ImageHtmlAttributes(new {style = "margin-left:0px;"}))
        .DataBinding(
            dataBinding => dataBinding.Ajax()
                .Select("SelectChest", "Material", new {area = ""})
                .Insert("InsertChest", "Material", new {area = ""})
                .Update("UpdateChest", "Material", new {area = ""}))
        .Columns(columns =>
        {
            columns.Command(command =>
                command.Edit().ButtonType(GridButtonType.Image).UpdateText("Cập nhập").InsertText("Thêm").CancelText("Hủy").Text("Sửa")
                ).Width(50).Title("").HtmlAttributes(new {style = "text-align:center"});

            columns.Bound(f => f.ChestName).Width(150)
                .HeaderTemplate("Tên tủ");
            columns.Bound(f => f.Description)
                .HeaderTemplate("Mô tả");
            columns.Bound(f => f.ToolActive).Width(50)
                .ClientTemplate("<input type='checkbox' disabled='disabled' name='ToolActive' <#=ToolActive? checked='checked' : '' #> />")
                .HtmlAttributes(new {style = "text-align:center"});

            columns.Bound(f => f.ModifiedUser).Width(75).Title("Người làm").ReadOnly(true);
            columns.Bound(f => f.ModifiedDate).Width(100).Title("Ngày làm").ReadOnly(true);
        })
        .Editable(editing => editing.Mode(GridEditMode.InLine))
        .ClientEvents(events => events.OnError("grid_OnError"))
        .Scrollable(f => f.Height(500))
        .Sortable()
        .Filterable()
        .Resizable(f => f.Columns(true))
        .Reorderable(f => f.Columns(true))
        .Footer(true)
        .Render();
}
</div>

