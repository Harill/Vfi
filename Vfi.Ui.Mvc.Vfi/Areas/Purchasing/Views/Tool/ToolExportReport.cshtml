@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@model MaterialInventoryModel
@{
    ViewBag.Title = "Công cụ xuất kho";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- $.() -->


    <!-- binding -->
    <script type="text/javascript">

        var startGrid = false;
        var index = 0;
        function ToolType_OnChange() {
            RefreshGrid("gridInventory");
        }
        function gridInventory_OnDataBinding(args) {

            if (startGrid) {
                var toolType = $("#ToolType").data('tComboBox').value();
                if (toolType === "")
                    toolType = 0;

                //var materialName = $("#MaterialCodeName").data("tAutoComplete").value();
                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else {
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                }
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else {
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                }
                var toolName = $("#ToolName").data('tAutoComplete').value();
                args.data = $.extend(args.data,
                {
                    toolName: toolName,
                    toolTypeId: toolType,
                    fromDate: fromDate,
                    toDate: toDate
                });
                index = 0;
            }
        }

    </script>

    <!-- report -->
    <script type="text/javascript">

        function printMaterialInvTotalInMonth() {
            var fromDate = $("#fromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#toDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
            }
            $('#result').load('@Url.Action("PrintToolInvTotalInMonth", "Tool")',
                {
                    fromDate: fromDate,
                    toDate: toDate
                },
                function () {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }

        function RefreshGrid2() {
            startGrid = true;
            RefreshGrid("gridInventory");
        }

        function printAssignProductionTool() {
            $('#result').load('@Url.Action("PrintAssignProductionTool", "Tool")',
                {
                }, function () {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }
    </script>

}

<div class="title">
    @*Tổng hợp xuất kho công cụ*@
    @HttpContext.GetGlobalResourceObject("Resource", "ToolExportReport")
</div>

<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 1020px;">
    <div class="grid_7">
        <button id="btnMaterialInv" class="t-button" onclick=" return printAssignProductionTool(); ">
            <span class='t-icon t-insert'></span>
            In phát công cụ sản xuất
@*@HttpContext.GetGlobalResourceObject("Resource", "")*@
        </button>
    </div>
    <div class="clear"></div>
    <br />
    <fieldset>
        <legend>
            @*Tiêu chí trích lọc*@
            @HttpContext.GetGlobalResourceObject("Resource", "Filter")
        </legend>
        <div class="grid_3">
            @*Loại công cụ*@
            @HttpContext.GetGlobalResourceObject("Resource", "ToolType")
        </div>
        <div class="grid_6">
            @{
                Html.Telerik().ComboBox()
                    .Name("ToolType")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxToolType", "Tool", new { area = "Purchasing" }))
                    .HtmlAttributes(new { style = "width: 100%" })
                    //.DropDownHtmlAttributes(new { style = "width: 100%" })
                    .AutoFill(true)
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .ClientEvents(e => e.OnChange("ToolType_OnChange"))
                    .Render();
            }
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("fromDate")
                    .Format("dd/MM/yyyy")
                    .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
                    .Render();
            }
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("toDate")
                    .Format("dd/MM/yyyy")
                    .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(1).AddSeconds(-1))
                    .Render();
            }
        </div>
        <div class="grid_2_5">
            @*Tên công cụ*@
            @HttpContext.GetGlobalResourceObject("Resource", "ToolName")
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().AutoComplete()
                    .Name("ToolName")
                    .HtmlAttributes(new { style = "width: 100%" })
                    .Render();
            }
        </div>
        <div class="grid_3">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2(); ">
                <span class='t-icon t-insert'></span>
                @*Làm mới*@
                @HttpContext.GetGlobalResourceObject("Resource", "Refresh")
            </button>
        </div>
    </fieldset>

</div>
<div class="clear"></div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<TransactionFptDetailModel>()
            .Name("gridInventory")
            .DataKeys(keys => keys.Add(f => f.ToolInvId).RouteKey("toolInvId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectToolExportTotal", "Tool",
                    new
                    {
                        toolName = "",
                        toolTypeId = -1,
                        fromDate = 1 + "/" + DateTime.Now.Month + "/" + DateTime.Now.Year,
                        toDate = DateTime.Now.ToString("dd/MM/yyyy")
                    })
            )

            .Columns(columns =>
            {
                columns.Bound(f => f.ToolName).Width(50).ReadOnly(true)
                    //.Title("STT")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Index").ToString())
                    .ClientTemplate("<#= ++index #>");
                
                columns.Bound(f => f.ToolName).Width(100)
                    //.Title("Tên công cụ")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ToolName").ToString())
                    .HtmlAttributes(new {style = "font-weight:bold;"});
             
                columns.Bound(f => f.ToolFullCodeName).Width(200)
                    //.Title("Mã công cụ")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ToolCode").ToString())
                    .HtmlAttributes(new { style = "font-weight:bold;" })
                    .Aggregate(agg => agg.Count())
                    .ClientGroupFooterTemplate("<#= Count #>")
                    .ClientFooterTemplate("<#= Count #>");
               
                columns.Bound(f => f.VendorCode).Width(55).ReadOnly(true)
                    //.Title("NCC")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Vendor2").ToString());
                
                columns.Bound(f => f.LotNumber)
                    //.Title("Lô")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Lot").ToString())
                    .Width(70).ReadOnly(true);
                
                //columns.Bound(f => f.UnitMeasure).Title("ĐVT").Width(50).ReadOnly(true);
                
                columns.Bound(f => f.Quantity).Width(50).ReadOnly(true)
                    //.HeaderTemplate("<strong>SL</strong>")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Quantity2").ToString())
                    .HtmlAttributes(new { style = "text-align: right;" })
                    .Format("{0:n1}")
                    .Aggregate(agg => agg.Sum())
                    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                    .FooterHtmlAttributes(new { style = "text-align: right;" });
               
                //
                columns.Bound(f => f.TransactionDate).Width(100)
                    //.Title("Ngày xuất")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ExportDate").ToString())
                    .Format("{0:dd/MM/yyyy}");
             
                columns.Bound(f => f.MachineName).Width(75)
                    //.Title("Máy")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Machine").ToString())
                    .HtmlAttributes(new { style = "font-weight:bold;" });
                
                columns.Bound(f => f.ProductCode).Width(100)
                    //.Title("SP")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Product2").ToString())
                    .HtmlAttributes(new { style = "font-weight:bold;" });
                
                columns.Bound(f => f.QuotaQuantity).Width(70)
                    //.Title("ĐM")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductionRate2").ToString())
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                
                columns.Bound(f => f.RequiredQuantity).Width(70)
                    //.Title("SL SX")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Quantity2").ToString()
                        + " "
                        + @HttpContext.GetGlobalResourceObject("Resource", "Production2").ToString()
                    )
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                
                columns.Bound(f => f.TransactionCode).Width(100).ReadOnly(true)
                    //.Title("Số phiếu")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "TransactionNumber").ToString());
                
                columns.Bound(f => f.EoIName).Width(80).ReadOnly(true)
                    //.Title("Loại xuất")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Type").ToString()
                        + " "
                        + @HttpContext.GetGlobalResourceObject("Resource", "Export").ToString()
                    );
                
                columns.Bound(f => f.Department).Width(120).ReadOnly(true)
                    //.Title("BP đề xuất")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProposedDepartment2").ToString());
                
                columns.Bound(f => f.Note).Width(120).ReadOnly(true)
                    //.HeaderTemplate("Ghi chú")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Note").ToString());
            })
            .Scrollable(f => f.Height(510))
            //.HtmlAttributes(new { style = "width: 950px;" })
            .Resizable(f => f.Columns(true))
            .Reorderable(f => f.Columns(true))
            .Filterable()
            .Sortable()
            .Groupable()
            .ClientEvents(events => events.OnError("grid_OnError")
                .OnDataBinding("gridInventory_OnDataBinding"))
            .Render();
    }
</div>

<!-- windown -->
@{
    Html.Telerik().Window()
        .Name("windowReport")
        .Modal(true)
        .Draggable(true)
        .Content
        (
    @<text>
    <div id="result"></div>
    </text>
)
        //.ClientEvents(e => e.OnLoad("Window_onLoad"));
        .Visible(false)
        .Width(960)
        .Render();
}

<style type="text/css">
    #windowReport {
        /*
            float: right;
            Position: relative;
            */
        min-height: 580px;
        top: 15%;
    }

    #result {
        height: 520px;
        overflow: hidden;
    }

    #ReportBody {
        padding-bottom: 25px;
        margin-bottom: 25px;
    }

    .tb-witdh td {
        width: 55px;
    }
</style>

