@using Vfi.Server.Core.DataModel.Models.Inv
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@model TransactionModel
@{
    ViewBag.Title = "Nhập mua công cụ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- binding -->
    <script type="text/javascript">
        function gridPoDetail_OnDataBinding(args) {
            var po = $('#PONumber').data('tComboBox').value();
            if (po === "")
                po = 0;
            args.data = $.extend(args.data, {
                purchaseOrderId: po
            });
            index = 0;
            count = 0;
        }

        var index = 0;
        var count = 0;
        function gridPoDetail_OnRowDataBound(e) {
            var dataItem = e.dataItem; //FA5858 F4FA58
            if (dataItem.RequireQty == 0) {
                e.row.childNodes[0].innerHTML = "";
            }
        }
    </script>

    <!-- pickup material -->
    <script type="text/javascript">
        function PickupId() {

            var po = $('#PONumber').data('tComboBox').value();
            if (po === "")
                po = 0;
            var $checkedRecords = $(':checked');
            //var $checkedRecords = $("input[name='chkMaterialIds']:checked");
            if ($checkedRecords.length < 1) {
                alert("Vui lọn chọn ít nhất 1 nguyên liệu");
                return;
            }
            //$.ajaxSettings.traditional = false;
            var a = {};
            var ids = "";
            for (var i = 0; i < $checkedRecords.length; i++) {
                a[i] = $checkedRecords[i].value;

                ids += $checkedRecords[i].value;
                if (i < ($checkedRecords.length - 1))
                    ids += ":";
            }
            $("#gridFuel").data("tGrid").rebind({
                ids: ids,
                poId: po,
            });
        }

        function grid_OnSave(e) {
            var quantity = $(e.cell).find('#Quantity').val();
            if (e.dataItem.RequiredQuantity < quantity)
                alert("Nhập quá số lượng còn thiếu!");
            //var text = "";
            if (!isNaN(parseInt(quantity))) {
                var sumOrderQty = 0;
                var spanOrderQtys = $("span[name='Quantity']");
                for (var i = 0; i < spanOrderQtys.length; i++) {
                    var innerText = spanOrderQtys[i].innerText;
                    innerText = innerText.replace(/,/g, '');
                    sumOrderQty = sumOrderQty + parseFloat(innerText);
                }
                sumOrderQty = sumOrderQty + parseFloat(quantity);
                $("#TotalQuantity").text(sumOrderQty.format(0));
            }
        }
    </script>


    <!-- client event grid material inventory -->
    <script type="text/javascript">

        function grid_OnSubmitChanges(e) {
            var monthlyDate = $("#ImportDate").data("tDatePicker").value();
            if (monthlyDate === null)
                monthlyDate = "";
            else
                monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);
            var po = $('#PONumber').data('tComboBox').value();
            if (po === "")
                po = 0;

            var exchangeRate = $("#ExchangeRate").val();
            if (exchangeRate === null || exchangeRate == "")
                exchangeRate = 1;
            e.values = $.extend(e.values,
                {
                    exportOrImport: "@Convert.ToChar(MyUtilities.Transaction.EoIEnum.Import)",
                    importDate: monthlyDate,
                    exchangeRate: exchangeRate,
                    vendor: 0,
                    poId: po,
                });
        }

        function Type_OnLoad() {
            var combobox = $('#Type').data('tDropDownList');
            var dataSource =
            [
                { Text: "Nhập hàng", Value: "1" },
                { Text: "Đổi hàng", Value: "2" }
            ];
            combobox.dataBind(dataSource);
            //$("#ExchangeRate").val(1);
        }

        function Type_OnChange() {
            var type = $('#Type').data('tDropDownList').value();
            var po = $('#PONumber').data('tComboBox');
            //var monthlyDate = combobox.text();
            $.ajax({
                type: 'post',
                data: {
                    type: type,
                    classtified: 3,
                },
                dataType: 'json',
                url: '@Url.Action("SelectPOorPONote", "PurchaseOrder", new {area = "Purchasing"})',
                timeout: 20000,
                success: function(data) {
                    //$('#Invoice').data('tConbobox').dataBind(data);
                    po.dataBind(data);
                    RefreshGrid("gridPoDetail");
                }
            });
        }

        function PONumber_onChange(e) {
            RefreshGrid("gridPoDetail");
            $.ajax({
                type: 'post',
                data: {
                    poId: e.value,
                },
                dataType: 'json',
                url: '@Url.Action("SelectPoInfo", "PurchaseOrder", new {area = "Purchasing"})',
                timeout: 20000,
                success: function (data) {
                    if (data != null) {
                        $("label[for*='Description']").text(data[0]);
                        var note = $("#SpecialNote");
                        if (note.val() == "") {
                            note.val(data[1]);
                        }
                    }
                }
             });
        }

        function TypeRefresh() {
            var type = $('#Type').data('tDropDownList').value();
            var po = $('#PONumber').data('tComboBox');
            //po.clear();
            //var monthlyDate = combobox.text();
            $.ajax({
                type: 'post',
                data: {
                    type: type,
                    classtified: 3,
                },
                dataType: 'json',
                url: '@Url.Action("SelectPOorPONote", "PurchaseOrder", new {area = "Purchasing"})',
                timeout: 20000,
                success: function(data) {
                    //$('#Invoice').data('tConbobox').dataBind(data);
                    po.dataBind(data);
                    RefreshGrid("gridPoDetail");
                }
            });

        }

        function gridPoDetail_OnDataBinding(args) {
            var po = $('#PONumber').data('tComboBox').value();
            console.log("PO value:", po);

            if (po === "")
                po = 0;

            args.data = $.extend(args.data, {
                purchaseOrderId: po
            });
        }
    </script>
}

<div class="title">
    @*Phiếu nhập công cụ*@
    @HttpContext.GetGlobalResourceObject("Resource", "ImportTransactionTool")
</div>

<div class="t-info-sha" style="padding-left: 15px;padding-right: 15px; width: 1000px ">
   
    <fieldset>
        <legend>
            @*Thông tin phiếu lệnh nhập*@
            @HttpContext.GetGlobalResourceObject("Resource", "ImportFormInformation")
        </legend>
        <div class="grid_14">
        <div class="grid_2">
            @*Hình thức:*@
            @HttpContext.GetGlobalResourceObject("Resource", "Method")
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().DropDownList()
                    .Name("Type")
                    //.DataBinding(binding => binding.Ajax().Select("SelectOrderApprovedDueDate", "Orders", new { area = "Sales" }))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 150px" })
                    .ClientEvents(events => events.OnLoad("Type_OnLoad").OnChange("Type_OnChange"))
                    .Render();
            }
        </div>
         <div class="grid_2">
                         <button class="t-button" id="btnRefresh" name="btnPickupMaterialId" onclick=" TypeRefresh() ">
                             <span class='t-icon t-refresh'></span>
                         </button>
                     </div>
        
       
     
        
        <div class="grid_2">
            @*Tỉ giá*@
            @HttpContext.GetGlobalResourceObject("Resource", "ExchangeRate")
        </div>
        @*<div class="grid_1_5">(@Html.LabelFor(f => f.Description, new {style = "width: 70px;font-weight:bold",val=" "}))</div>*@
        <div class="grid_2">
            @{
                Html.Telerik().IntegerTextBox()
                    .Name("ExchangeRate")
                    .Value(1)
                    .InputHtmlAttributes(new { style = "width: 50px" })
                    .Render();
            }
        </div>
        

        <div class="clear"></div><br />
        <div class="grid_2">
            @*Số phiếu*@
            @HttpContext.GetGlobalResourceObject("Resource", "TransactionNumber")
        </div>
        <div class="grid_6">
            @{
                Html.Telerik().ComboBox()
                    .Name("PONumber")
                    //.DataBinding(binding => binding.Ajax().Select("SelectComboBoxMaterialType", "Material", new { area = "" }))
                    .HtmlAttributes(new { style = "width: 220px; " })
                    .DropDownHtmlAttributes(new { style = "width: 250px; " })
                    .Encode(false)
                    .AutoFill(true)
                    .HighlightFirstMatch(true)
                    .ClientEvents(events => events.OnChange("PONumber_onChange")
                    )
                    .Render();
            }
        </div>
           <div class="grid_2">
               @*Ngày nhập*@
               @HttpContext.GetGlobalResourceObject("Resource", "ImportDate")
           </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("ImportDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>

        </div>
        <div>
        <div class="grid_2">
            @*Ghi chú*@
            @HttpContext.GetGlobalResourceObject("Resource", "Note")
        </div>
        <div class="grid_5">@Html.TextAreaFor(f => f.SpecialNote, new { style = "width: 250px; height: 50px; " , @readonly="readonly" })</div>
        </div>
    </fieldset>
</div>
<div class="clear"></div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<PurchaseOrderDetailModel>()
            .Name("gridPoDetail")
            .ToolBar(bar => bar.Template(
                @<text>
                     <div class="grid_7">
                         <button class="t-button" id="btnPickupId" name="btnPickupId" onclick=" PickupId() ">
                             <span class='t-icon t-insert'></span>
                             @*Chọn các nhiên liệu vào lưới*@
                             @HttpContext.GetGlobalResourceObject("Resource", "SelectToolIntoNet")
                         </button>
                     </div>
                     <div class="clear"></div>
                 </text>
))
            .DataKeys(keys => keys.Add(f => f.PurchaseOrderDetailId).RouteKey("purchaseOrderDetailId"))
                                       .DataBinding(dataDindings => dataDindings.Ajax()
                                                                                .Select("SelectPurchaseOrderDetailByPOId", "PurchaseOrder",
                                                                                        new { area = "Purchasing"}))
            .Columns(columns =>
                {
                    columns.Bound(f => f.PurchaseOrderDetailId)
                        //.Title("Chọn")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Select").ToString())
                        .Width(75)
                        .ClientTemplate("<input type='checkbox' name='chkIds' value='<#= PurchaseOrderDetailId #>' />")
                        .HtmlAttributes(new { style = "text-align:center" });
                   
                    columns.Bound(f => f.VendorCodeName)
                        //.Title("NCC")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Vendor2").ToString())
                        .Width(120);
                    
                    columns.Bound(f => f.Name)
                        //.Title("Tên công cụ")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "ToolName").ToString())
                        .Width(150);
                    
                    columns.Bound(f => f.Code)
                        //.Title("Mã công cụ")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "ToolCode").ToString())
                        .Width(200);
                    
                    columns.Bound(f => f.Unit)
                        //.Title("ĐVT")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Unit2").ToString())
                        .Width(70)
                        .HtmlAttributes(new { style = "text-align:center" });
                    
                    //columns.Bound(f => f.LotNumber);
                    
                    columns.Bound(f => f.OrderQty)
                        //.Title("Số lượng</br>yêu cầu")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "RequestQuantity1").ToString())
                        .Width(100)
                        .HtmlAttributes(new { style = "text-align:right" })
                        .ClientTemplate("<#= OrderQty == null ? 0 : $.telerik.formatString('{0:n2}', OrderQty) #>");
                    
                    columns.Bound(f => f.RequireQty)
                        //.Title("Số lượng</br>còn lại")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "LeftOverQuantity1").ToString())
                        .Width(100)
                        .HtmlAttributes(new { style = "text-align:right" })
                        .ClientTemplate("<#= RequireQty == null ? 0 : $.telerik.formatString('{0:n2}', RequireQty) #>");

                    columns.Bound(f => f.Note)
                        //.Title("Ghi chú")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Note").ToString());
                })
            .Scrollable(f => f.Height(200))
            .ClientEvents(events => events.OnDataBinding("gridPoDetail_OnDataBinding")
            .OnRowDataBound("gridPoDetail_OnRowDataBound")
            .OnError("grid_OnError"))
            //.Filterable()
            //.Pageable(f => f.PageOnScroll(true).Style(GridPagerStyles.Status))
            .Render();
    }
</div>
<div class="clear"></div><br/>
<div class="t-info-sha" style="padding-left: 15px; width:250px; color: Maroon;">
    @*Chi tiết lệnh nhập nguyên liệu*@
    @HttpContext.GetGlobalResourceObject("Resource", "ToolInpurtOrderDetail").ToString()
</div>
<div class="cover-div">
@{
    Html.Telerik().Grid<TransactionFptDetailModel>()
        .Name("gridFuel")
        .ToolBar(bar=>bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
            .SaveText(@HttpContext.GetGlobalResourceObject("Resource", "SaveAll").ToString())
            .CancelText(@HttpContext.GetGlobalResourceObject("Resource", "CancelAll").ToString()))
        .DataKeys(keys => keys.Add(f => f.FuelId).RouteKey("fuelId"))
        .DataBinding(dataBindings => dataBindings.Ajax()
            .Select("SelectToolInPo", "Tool", new { ids = "", poId = 0 })
            .Update("UpdateImportTool", "Tool"))
        .Columns(columns => {
           
            columns.Bound(f => f.ToolName).Width(120).ReadOnly(true)
                //.Title("Tên")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Name").ToString());
              
            columns.Bound(f => f.ToolFullCodeName).Width(200).ReadOnly(true)
                //.Title("Mã công cụ")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "ToolCode").ToString())
                .FooterHtmlAttributes(new {style = "text-align: right;"})
                .Aggregate(agg => agg.Count())
                .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>");
            
            columns.Bound(f => f.VendorName).Width(150).ReadOnly(true)
                //.Title("NCC")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Vendor2").ToString());
            
            columns.Bound(f => f.RequiredQuantity).Width(70)
                //.Title("Số lượng đặt")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "OrderedQuantity").ToString())
                .ReadOnly(true)
                .HtmlAttributes(new { style = "text-align:right" })
                .ClientTemplate("<#= RequiredQuantity == null ? 0 : $.telerik.formatString('{0:n1}', RequiredQuantity) #>");

            
            columns.Bound(f => f.UnitMeasure).Width(70).ReadOnly(true)
                //.Title("ĐVT")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Unit2").ToString())
                .HtmlAttributes(new { style = "text-align:center" });
            
            columns.Bound(f => f.Quantity).Width(100)
                //.HeaderTemplate("Số lượng nhập")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "ReceivedQuantity").ToString())
                .HeaderHtmlAttributes(new { @class = "edit-column" })
                .HtmlAttributes(new { style = "text-align: right;" })
                .ClientTemplate("<span name='Quantity'><#= Quantity == null ? 0 : $.telerik.formatString('{0:n1}', Quantity) #></span>")
                .FooterTemplate("<span id='TotalQuantity'></span>");
            
            //columns.Bound(f => f.LotNumber).Width(50).Title("Lô")
            //               .HtmlAttributes(new { style = "text-align:right" });
            
            columns.Bound(f => f.Note)
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Note").ToString());
            
            columns.Command(commands => commands.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(40).Title("");
        })
        .ClientEvents(events => events
            .OnSubmitChanges("grid_OnSubmitChanges")
            .OnSave("grid_OnSave")
            .OnError("grid_OnError")
        )
        .Editable(f=>f.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
        .Footer(true)
        .Render();   
}
</div>