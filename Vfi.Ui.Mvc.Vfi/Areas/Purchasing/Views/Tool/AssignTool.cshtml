@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@*@model MaterialInventoryModel*@
@{
    ViewBag.Title = "Xuất công cụ (SX1)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- binding -->
    <script type="text/javascript">

        function machine_OnChange(e) {
            var product = $('#Product').data('tComboBox');
            if (e.currentTarget.value === "") {
                productSelectId = 0;
                product.value(-1);
                product.text("");
            }
            $.ajax({
                type: 'post',
                data: { machineId: e.currentTarget.value },
                dataType: 'json',
                url: '@Url.Action("GetProductOnMachine", "Tool", new {area = "Purchasing"})',
                timeout: 20000,
                success: function (data) {
                    //a
                    product.dataBind(data);
                    if (product.selectedIndex > -1) {
                        //if (!data || data.length === 0) {

                        var selected = product.data[product.selectedIndex];             // selected = lay ma sp
                        //var selected = product.dataItem(product.selectedIndex);

                        if (selected != undefined) {
                            productSelectId = selected.Value;

                            //product.value(selected.value); 
                            product.value(selected.Value);

                            product.text(selected.Text);


                            product.previousValue = selected.Value;
                        } else {
                            product.value(-1);
                            product.text("");
                        }
                    } else {
                        product.value(-1);
                        product.text("");
                    }
                    RefreshGrid("gridToolInventory");
                }
            });
        }


        var productSelectId = 0;
        var isbinding = true;

        function Product_OnChange(e) {
            if (e.currentTarget.value !== "")
                isbinding = false;
            if (!isbinding) {
                productSelectId = e.currentTarget.value;
                RefreshGrid("gridToolInventory");
            }
        }
    </script>

    <!-- pickup material -->
    <script type="text/javascript">
        function grid_OnDataBinding(e) {

            var machineId = $("#Machine").data('tComboBox').value();
            if (machineId === "")
                machineId = 0;
            e.data = $.extend(e.data, {
                productId: productSelectId,
                machineId: machineId
            });
        }
        function grid_OnSubmitChanges(e) {
            var exportDate = $("#ExportDate").data("tDatePicker").value();
            if (exportDate === null)
                exportDate = "";
            else
                exportDate = $.telerik.formatString('{0:dd/MM/yyyy}', exportDate);
            var machineId = $("#Machine").data('tComboBox').value();
            if (machineId === "")
                machineId = 0;
            var description = $("#Description").val();
            var department = $("#Department").val();
            e.values = $.extend(e.values,
                {
                    exportDate: exportDate,
                    machineId:machineId,
                    productId: productSelectId,
                    department: department,
                    description: description
                }
            );
        }


        // Tô màu khi "Còn tồn" ít hơn "Tồn kho"

        function grid_OnRowDataBound(e) {
            var dataItem = e.dataItem; //FA5858 F4FA58
            // to mau
            if (dataItem.AvailInv !== dataItem.TotalInv) {
                e.row.childNodes[7].style.backgroundColor = "#F4FA58";
            }
            else if (dataItem.TotalInv == 0) {
                e.row.childNodes[6].style.backgroundColor = "#F4FA58";
            }

            if (dataItem.NG == true && dataItem.Lock == true) {
                $(e.row).css({
                    "background-color": "#ba3636", // đỏ
                    "color": "#FFFFFF"             // chữ trắng
                });
            }
            else if (dataItem.NG == true && dataItem.Lock == false) {
                $(e.row).css({
                    "background-color": "#dea452", // đỏ nhat.

                });
            }
            else if (dataItem.NG == false && dataItem.Lock == true) {
                $(e.row).css({
                    "background-color": "#8d02f0", // Tim'
                    "color": "#FFFFFF"             // chữ trắng
                });
            }
        }


        //Tô màu khi lô Công cụ bị NG

        //function grid_OnRowData(e) {
        //    var dataItem = e.dataItem;

        //    // Nếu NG == true thì tô đỏ toàn bộ hàng và đổi chữ sang trắng
        //    if (dataItem.NG === true) {
        //        $(e.row).css({
        //            "background-color": "#ba3636", // đỏ
        //            "color": "#FFFFFF"             // chữ trắng
        //        });
        //    }
        //}




    </script>
}

<div class="title">
    @*Xuất công cụ Sx1 (Cames + CNC)*@
    @HttpContext.GetGlobalResourceObject("Resource", "AssignTool") (Cames + CNC)
</div>

<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 960px;">
    <fieldset>
        <legend>
            @*Thông tin phiếu xuất*@
            @HttpContext.GetGlobalResourceObject("Resource", "ExportFormInformation")
        </legend>
        <div class="grid_15">
            <div class="grid_7">
                
            <div class="grid_3">
                @*Ngày xuất*@
                @HttpContext.GetGlobalResourceObject("Resource", "ExportDate")
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("ExportDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
                <div class="clear"></div>
                <br/>
                <div class="grid_3">
                    @*Bộ phận đề xuất*@
                    @HttpContext.GetGlobalResourceObject("Resource", "ProposedDepartment")
                </div>
                <div class="grid_3">
                    @{
                        Html.Telerik().AutoComplete()
                            .Name("Department")
                            .DataBinding(binding => binding.Ajax().Select("SelectComboBoxDepartment", "Material", new {area = ""}))
                            .HtmlAttributes(new {style = "width: 130px"})
                            .DropDownHtmlAttributes(new {style = "width: 130px"})
                            .AutoFill(true)
                            .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                            .Render();
                    }

                </div>
                <div class="clear"></div>
                <br/>
                <div class="grid_3">
                    @*Máy*@
                    @HttpContext.GetGlobalResourceObject("Resource", "Machine")
                </div>
                <div class="grid_3_5">
                    @{
                        Html.Telerik().ComboBox()
                            .Name("Machine")
                            .DataBinding(binding => binding.Ajax().Select("SelectComboBoxMachine", "Machine", new {area = "Factory"}))
                            .HtmlAttributes(new {style = "width: 130px"})
                            .DropDownHtmlAttributes(new {style = "width: 130px"})
                            .AutoFill(true)
                            .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                            .ClientEvents(e => e.OnChange("machine_OnChange"))
                            .Render();
                    }
                </div>
                <div class="clear"></div>
                <br/>
                <div class="grid_3">
                    @*Sản phẩm*@
                    @HttpContext.GetGlobalResourceObject("Resource", "Product")
                </div>
                <div class="grid_3_5">
                    @{
                        Html.Telerik().ComboBox()
                            .Name("Product")
                            .DataBinding(binding => binding.Ajax().Select("SelectComboBoxProduct", "Product", new {area = ""}))
                            .HtmlAttributes(new {style = "width: 130px"})
                            .DropDownHtmlAttributes(new {style = "width: 130px"})
                            .AutoFill(true)
                            .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                            .ClientEvents(e => e.OnChange("Product_OnChange"))
                            .Render();
                    }
                </div>
            </div>
            <div class="grid_4">
                <div class="grid_2">
                    @*Nội dung*@
                    @HttpContext.GetGlobalResourceObject("Resource", "TheContent")
                </div>
                <div class="grid_7">@Html.TextArea("Description", new { @class = "multi-line", style = "height:70px" })</div>
            </div>
        </div>
        <div class="grid_3">
            <div class="grid_3">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridToolInventory'); ">
                    <span class='t-icon t-insert'></span>
                    @*Làm mới*@
                    @HttpContext.GetGlobalResourceObject("Resource", "Refresh")
                </button>
            </div>
        </div>

    </fieldset>
</div>
<div class="clear"></div>
<br />
<div class="t-info-sha" style="padding-left: 15px; width: 250px; color: Maroon;">
    @*Chi tiết lệnh nhập nguyên liệu*@
    @HttpContext.GetGlobalResourceObject("Resource", "ToolInputOrderDetail")
</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<TransactionFptDetailModel>()
            .Name("gridToolInventory")
            .ToolBar(bar => bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
                .SaveText(@HttpContext.GetGlobalResourceObject("Resource", "SaveAll").ToString())
                .CancelText(@HttpContext.GetGlobalResourceObject("Resource", "Cancel").ToString()))
            .DataKeys(keys => keys.Add(f => f.ToolInvId).RouteKey("toolInvId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectAssignToolProduction", "Tool", new {machineId = 0, productId = 0 })
                .Update("UpdateAssignToolProduction", "Tool"))                  // luu them productionToolId
            .Columns(columns =>
            {
                columns.Bound(f => f.VendorName).Width(100)
                    //.Title("NCC")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Vendor2").ToString())
                    .ReadOnly(true);
             
                columns.Bound(f => f.FptTypeName).Width(100)
                    //.Title("Loại")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Type").ToString())
                    .ReadOnly(true);
                
                columns.Bound(f => f.ToolFullCodeName).Width(200)
                    //.Title("Công cụ")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Tools").ToString())
                    .ReadOnly(true);
                
                columns.Bound(f => f.UnitMeasure).Width(50)
                    //.Title("ĐVT")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Unit2").ToString())
                    .ReadOnly(true);
                
                columns.Bound(f => f.LotNumber).Width(60).ReadOnly(true)
                    //.Title("Lô")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Lot").ToString());
                
                columns.Bound(f => f.TaxInvoiceDateString).Width(70).ReadOnly(true)
                    //.Title("Ngày nhập")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ImportDate").ToString())
                    .HtmlAttributes(new { style = "border-right: solid 1px black;" });
                
                columns.Bound(f => f.TotalInv).Width(70).ReadOnly(true)
                    //.HeaderTemplate("Tồn kho")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Inventory").ToString())
                    .Format("{0:n1}")
                    .HtmlAttributes(new { style = "text-align:right" });
                
                columns.Bound(f => f.AvailInv).Width(70).ReadOnly(true)
                    //.HeaderTemplate("Còn tồn")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "HaveInventory").ToString())
                    .Format("{0:n1}")
                    .HtmlAttributes(new { style = "text-align:right" });
                
                columns.Bound(f => f.Quantity).Width(70)
                    //.HeaderTemplate("SL Phát")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "AssignQuantity2").ToString()
                    )
                    .HeaderHtmlAttributes(new { @class = "edit-column" })
                    .HtmlAttributes(new { style = "text-align:right;border-right: solid 1px black;" })
                    .ClientTemplate("<span name='Quantity'><#= Quantity == null ? 0 : $.telerik.formatString('{0:n1}', Quantity) #></span>")
                    .FooterTemplate("<span id='TotalQuantity'></span>");

                //columns.Bound(f => f.MachineInv).Width(50).ReadOnly(true)
                //    .HeaderTemplate("Tồn máy")
                //    .Format("{0:n1}")
                //    .HtmlAttributes(new { style = "text-align:right" });
                //columns.Bound(f => f.MachineUse).Width(60)
                //    .HeaderTemplate("Sử dụng")
                //    .HeaderHtmlAttributes(new { @class = "edit-column" })
                //    .HtmlAttributes(new { style = "text-align:right;" })
                //       .ClientTemplate("<span name='MachineUse'><#= MachineUse == null ? 0 : $.telerik.formatString('{0:n1}', MachineUse) #></span>")
                //       .FooterTemplate("<span id='TotalUse'></span>");
                //columns.Bound(f => f.MachineReturn).Width(60)
                //    .HeaderTemplate("Trả về")
                //    .HeaderHtmlAttributes(new { @class = "edit-column" })
                //    .HtmlAttributes(new { style = "text-align:right;" })
                //       .ClientTemplate("<span name='MachineReturn'><#= MachineReturn == null ? 0 : $.telerik.formatString('{0:n1}', MachineReturn) #></span>")
                //       .FooterTemplate("<span id='TotalReturn'></span>");
              
                columns.Bound(f => f.NG).Hidden(true);
              
                columns.Bound(f => f.Lock).Hidden(true);
               
                columns.Bound(f => f.Note)
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Note").ToString());
               
                columns.Bound(f => f.StatusName).Width(360)
                    //.Title("Ghi chú công cụ")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ToolNote").ToString())
                    .ReadOnly(true);
                
                //columns.Command(commands => commands.Delete().ButtonType(GridButtonType.Image)).Width(40).Title("");
            })
            .ClientEvents(events => events
                .OnSubmitChanges("grid_OnSubmitChanges")
                .OnDataBinding("grid_OnDataBinding")
                .OnRowDataBound("grid_OnRowDataBound")
                .OnError("grid_OnError")
            )
            .Editable(f => f.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
             //.Footer(true)
            .Render();   
    }
</div>
