@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@model MaterialInventoryModel
@{
    ViewBag.Title = "Xuất công cụ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- binding -->
    <script type="text/javascript">
        function gridToolInventory_OnDataBinding(args) {
            //var vendorId = $("#Vendor").data('tComboBox').value();
            //if (vendorId === "")
            //    vendorId = 0;
            var typeId = $("#ToolType").data('tComboBox').value();
            if (typeId === "")
                typeId = 0;
            //var productId = $("#Product").data('tComboBox').value();
            //if (productId === "")
            //    productId = 0;
            //if (isbinding)
            //productId = productSelectId;
            //var toolCode = $("#ToolCode").data("tAutoComplete").value();
            args.data = $.extend(args.data, {
                vendorId: 0,
                toolCode: "",
                typeId: typeId,
                productId: productSelectId
            });
        }

        function ToolType_OnChange() {
            RefreshGrid("gridToolInventory");
        }

        function Machine_OnChange(e) {
            var product = $('#Product').data('tComboBox');
            if (e.currentTarget.value == "") {
                productSelectId = 0;
                product.value(-1);
                product.text("");
                RefreshGrid("gridToolInventory");
            }
            $.ajax({
                type: 'post',
                data: { machineId: e.currentTarget.value },
                dataType: 'json',
                url: '@Url.Action("GetProductOnMachine", "Tool", new {area = "Purchasing"})',
                timeout: 20000,
                success: function (data) {
                    //a
                    //var product = $('#Product').data('tComboBox');
                    product.dataBind(data);
                    if (product.selectedIndex > -1) {
                        var selected = product.data[product.selectedIndex];
                        if (selected != undefined) {
                            productSelectId = selected.Value;
                            //product.$element[0].value = selected.value;
                            //product.$text[0].value = selected.Text;
                            product.value(selected.value);
                            product.text(selected.Text);
                            product.selectedIndex = product.selectedIndex;
                            product.previousValue = selected.value;
                        } else {
                            product.value(-1);
                            product.text("");
                        }
                    } else {
                        product.value(-1);
                        product.text("");
                    }
                    RefreshGrid("gridToolInventory");
                }
            });
        }

        var productSelectId = 0;
        var isbinding = true;

        function Product_OnChange(e) {
            if (e.currentTarget.value !== "")
                isbinding = false;
            if (!isbinding) {
                productSelectId = e.currentTarget.value;
                RefreshGrid("gridToolInventory");
            }
        }
    </script>

    <!-- pickup material -->
    <script type="text/javascript">
        function PickupId() {
            var $checkedRecords = $(':checked');
            if ($checkedRecords.length < 1) {
                alert("Vui lọn chọn ít nhất 1 nguyên liệu");
                return;
            }
            var a = {};
            var ids = "";
            for (var i = 0; i < $checkedRecords.length; i++) {
                a[i] = $checkedRecords[i].value;

                ids += $checkedRecords[i].value;
                if (i < ($checkedRecords.length - 1))
                    ids += ":";
            }
            var machineId = $("#Machine").data('tComboBox').value();
            if (machineId === "")
                machineId = 0;
            var productId = $("#Product").data('tComboBox').value();
            if (productId === "")
                productId = 0;
            $("#gridToolInventoryDetail").data("tGrid").rebind({
                invIds: ids,
                machineId: machineId,
                productId: productId
            });
        }
        function gridToolInventoryDetail_OnSave(e) {
            var $machineName = $(e.cell).find('#MachineName');

            if ($machineName.length > 0) {
                var machineName = $machineName.data("tComboBox"),
                    machineNameSelectItem = machineName.selectedIndex > -1 ? machineName.data[machineName.selectedIndex] : null;

                if (machineNameSelectItem) {
                    e.values["MachineName"] = machineNameSelectItem.Text;
                    e.values["MachineId"] = machineNameSelectItem.Value;
                }
            }
            var $productCode = $(e.cell).find('#ProductCode');

            if ($productCode.length > 0) {
                var productCode = $productCode.data("tComboBox"),
                    productCodeSelectItem = productCode.selectedIndex > -1 ? productCode.data[productCode.selectedIndex] : null;

                if (productCodeSelectItem) {
                    e.values["ProductCode"] = productCodeSelectItem.Text;
                    e.values["ProductId"] = productCodeSelectItem.Value;
                }
            }
        }
        function gridToolInventoryDetail_OnSubmitChanges(e) {
            var exportDate = $("#ExportDate").data("tDatePicker").value();
            if (exportDate === null)
                exportDate = "";
            else
                exportDate = $.telerik.formatString('{0:dd/MM/yyyy}', exportDate);
            var machineId = $("#Machine").data('tComboBox').value();
            if (machineId === "")
                machineId = 0;
            var department = $("#Department").val();
            var description = $("#Description").val();
            e.values = $.extend(e.values,
                {
                    exportOrImport: "@Convert.ToChar(MyUtilities.Transaction.EoIEnum.Export)",
                    exportDate: exportDate,
                    productId: productSelectId,
                    machineId:machineId,
                    department: department,
                    description: description
                }
            );
        }

    </script>
}

<div class="title">Xuất công cụ</div>

<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 960px;">
    <fieldset>
        <legend>Thông tin phiếu xuất</legend>
        <div class="grid_14">
            <div class="grid_3">Bộ phận đề xuất</div>
            <div class="grid_4">@Html.TextBox("Department")</div>
            <div class="grid_2">Ngày xuất</div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("ExportDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
            <div class="clear"></div>
            <br />
            <div class="grid_7">
                <div class="grid_3">Loại công cụ</div>
                <div class="grid_3_5">
                    @{
                        Html.Telerik().ComboBox()
                            .Name("ToolType")
                            .DataBinding(binding => binding.Ajax().Select("SelectComboBoxToolType", "Tool", new { area = "Purchasing" }))
                            .HtmlAttributes(new { style = "width: 130px" })
                            .DropDownHtmlAttributes(new { style = "width: 130px" })
                            .AutoFill(true)
                            .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                            .ClientEvents(e => e.OnChange("ToolType_OnChange"))
                            .Render();
                    }
                </div>
                <div class="clear"></div>
                <br />
                <div class="grid_3">Máy</div>
                <div class="grid_3_5">
                    @{
                        Html.Telerik().ComboBox()
                            .Name("Machine")
                            .DataBinding(binding => binding.Ajax().Select("SelectComboBoxMachine", "Machine", new { area = "Factory" }))
                            .HtmlAttributes(new { style = "width: 130px" })
                            .DropDownHtmlAttributes(new { style = "width: 130px" })
                            .AutoFill(true)
                            .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                            .ClientEvents(e => e.OnChange("Machine_OnChange"))
                            .Render();
                    }
                </div>
                <div class="clear"></div>
                <br />
                <div class="grid_3">Sản phẩm</div>
                <div class="grid_3_5">
                    @{
                        Html.Telerik().ComboBox()
                            .Name("Product")
                            .DataBinding(binding => binding.Ajax().Select("SelectComboBoxProduct", "Product", new { area = "" }))
                            .HtmlAttributes(new { style = "width: 130px" })
                            .DropDownHtmlAttributes(new { style = "width: 130px" })
                            .AutoFill(true)
                            .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                            .ClientEvents(e => e.OnChange("Product_OnChange"))
                            .Render();
                    }
                </div>
            </div>
            <div class="grid_4">
                <div class="grid_2">Nội dung</div>
                <div class="grid_7">@Html.TextArea("Description", new { @class = "multi-line", style = "height:70px" })</div>
            </div>
        </div>
        <div class="grid_3">
            <div class="grid_3">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridToolInventory'); ">
                    <span class='t-icon t-insert'></span>
                    Làm mới
                </button>
            </div>
        </div>

    </fieldset>
</div>
<div class="clear"></div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<TransactionFptDetailModel>()
            .Name("gridToolInventory")
            .ToolBar(bar => bar.Template(
        @<text>
        <div class="grid_7">
            <button class="t-button" id="btnPickupId" name="btnPickupId" onclick=" PickupId() ">
                <span class='t-icon t-insert'></span>
                Chọn các công cụ vào lưới
            </button>
        </div>
        <div class="clear"></div>
        </text>
))
            .DataKeys(keys => keys.Add(f => f.ToolInvId).RouteKey("toolInvId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("SelectExportToolInv", "Tool", new { toolCode = "", vendorId = 0, typeId = 0, productId = 0 }))
            .Columns(columns =>
                {
                    columns.Bound(f => f.ToolInvId).Title("Chọn").Width(75)
                           .ClientTemplate("<input type='checkbox' name='chklIds' value='<#= ToolInvId #>' />")
                           .HtmlAttributes(new { style = "text-align:center" });
                    columns.Bound(f => f.ToolFullCodeName).Width(150).Title("Mã công cụ");
                    columns.Bound(f => f.VendorCodeName).Width(150).Title("Nhà cung cấp");
                    columns.Bound(f => f.LotNumber).Width(75).Title("Lô");
                    columns.Bound(f => f.TotalInv).Width(75).Title("Tổng tồn")
                        .HtmlAttributes(new { style = "text-align:right;" })
                           .Format("{0:n1}");
                    columns.Bound(f => f.UnitMeasure).Title("ĐVT").Width(75);
                })
            .Scrollable(f => f.Height(200))
            .ClientEvents(events => events.OnDataBinding("gridToolInventory_OnDataBinding").OnError("grid_OnError"))
            //.Filterable()
            //.Pageable(f => f.PageOnScroll(true).Style(GridPagerStyles.Status))
            .Render();
    }
</div>
<div class="clear"></div>
<br />
<div class="t-info-sha" style="padding-left: 15px; width: 250px; color: Maroon;">Chi tiết lệnh nhập nguyên liệu</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<TransactionFptDetailModel>()
            .Name("gridToolInventoryDetail")
            .ToolBar(bar => bar.SubmitChanges().ButtonType(GridButtonType.ImageAndText).SaveText("Lưu tất cả").CancelText("Hủy"))
            .DataKeys(keys => keys.Add(f => f.ToolInvId).RouteKey("toolInvId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectExportToolInventory", "Tool", new { invIds = "",machineId= 0,productId =0 })
                .Update("UpdateAssignTool2", "Tool"))
            .Columns(columns =>
            {
                columns.Bound(f => f.VendorCodeName).Width(150).Title("NCC").ReadOnly(true);
                columns.Bound(f => f.ToolFullCodeName).Width(250).Title("Công cụ").ReadOnly(true);
                columns.Bound(f => f.UnitMeasure).Width(70).Title("ĐVT").ReadOnly(true);
                columns.Bound(f => f.TotalInv).Width(70).ReadOnly(true)
                    .HeaderTemplate("Tồn kho")
                    .Format("{0:n1}")
                    .HtmlAttributes(new { style = "text-align:right" });
                columns.Bound(f => f.LotNumber).Width(50).ReadOnly(true).Title("Lô");
                columns.Bound(f => f.Quantity).Width(70)
                    .HeaderTemplate("SL Phát")
                    .HtmlAttributes(new { style = "text-align:right" })
                       .ClientTemplate("<span name='Quantity'><#= Quantity == null ? 0 : $.telerik.formatString('{0:n1}', Quantity) #></span>")
                       .FooterTemplate("<span id='TotalQuantity'></span>");
                columns.Bound(f => f.MachineName).Width(75).Title("Máy");
                columns.Bound(f => f.ProductCode).Width(75).Title("SP");
                columns.Bound(f => f.Note);
                columns.Command(commands => commands.Delete().ButtonType(GridButtonType.Image)).Width(40).Title("");
            })
            .ClientEvents(events => events
                .OnSave("gridToolInventoryDetail_OnSave")
                .OnSubmitChanges("gridToolInventoryDetail_OnSubmitChanges")
                .OnError("grid_OnError")
            )
            .Editable(f => f.Mode(GridEditMode.InCell))
            // .Footer(true)
            .Render();   
    }
</div>
