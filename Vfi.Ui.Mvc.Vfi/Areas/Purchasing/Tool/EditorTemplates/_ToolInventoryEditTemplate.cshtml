<script>
    function cbo_OnChange(e) {

        //var material = $('#MaterialCode').data('tComboBox');
        //material.val();
            $.ajax({
                type: 'post',
                data: { toolInvId: e.currentTarget.value },
                dataType: 'json',
                url: '@Url.Action("GetToolInvTotal", "Tool", new { area = "Purchasing" })',
                timeout: 20000,
                success: function (data) {
                    e.target.parentNode.parentNode.parentNode.childNodes[4].innerHTML = data;
                    //material.dataBind(data);
                }
            });
    }
</script>


@{
    Html.Telerik().ComboBox()
        .Name(ViewData.TemplateInfo.GetFullHtmlFieldName(string.Empty))
        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxToolInventory", "Tool", new { area = "Purchasing" }).Delay(350))
        //.HtmlAttributes(new {style = "width: 150px"})
        .DropDownHtmlAttributes(new {style = "width: 250px"})
        .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
        .HighlightFirstMatch(true)
        .AutoFill(true)
        .ClientEvents(e=> e.OnChange("cbo_OnChange"))
        .Render();
}