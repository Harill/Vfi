@using Vfi.Server.Core.DataModel.Models.Inv
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Purchasing.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@{
    ViewBag.Title = "Duyệt phiếu công cụ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- approve stockorder -->
    <script type="text/javascript">

        function grid_OnDataBound() {
            var btn = document.querySelector('#twoToneButton');
            if (btn && btn.className.includes("loading")) {
                btn.classList.remove('loading');
                btn.innerHTML = "<span></span>";
            }
        }

        function ApproveTransaction() {
            var btn = document.querySelector('#twoToneButton');
            if (btn) {
                if (btn.className.includes("loading")) {
                    return false;
                } else {
                    btn.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (Đang duyệt)";
                    btn.classList.add('loading');
                    var $checkedRecords = $("input[name='chkTransactionIds']:checked");

                    if ($checkedRecords.length < 1) {
                        alert("Vui lọn chọn ít nhất 1 phiếu");
                        return;
                    }
                    $.post('@Url.Action("UpdateApproveTransactionTool", "Tool")',
                    {
                        //checkedRecords: $checkedRecords.map(function () { return value; })
                        checkedRecords: $checkedRecords.eq(0).val()
                    },
                    function (data) {

                        if (data === "okie") {
                            RefreshGrid("gridTool");
                        } else
                            alert(data);
                    });
                }
            } else {
                return false;
            }
        }

        function Grid_OnRowDataBound(e) {
            var check = e.dataItem.IsNormal;
            if (!check) {
                e.row.childNodes[2].bgColor = "#F4FA58";
                //e.row.style.backgroundColor = "#F4FA58";
            }
            if (e.dataItem.IsInternal) {
                e.row.childNodes[4].className = "cell-highlight";
            }
            var dataItem = e.dataItem;
            // neu chua dc ky duyet
            if (dataItem.PurchasingSignature === 0) {
                // neu ko co quyen ky duyet
                if (dataItem.PurchasingSignatureType === 0) {
                    e.row.getElementsByClassName("t-button purchasing")[0].parentNode
                        .innerHTML = "<span class='t-icon t-cancel'></span>";
                    // neu la xuat huy
                    if (dataItem.AccountantSignatureType === 0)
                        e.row.getElementsByClassName("chkCheck")[0].parentNode.innerHTML = "";
                } else {
                    if (dataItem.AccountantSignatureType === 0)
                        e.row.getElementsByClassName("chkCheck")[0].parentNode.innerHTML = "";
                }
            } else {
                e.row.getElementsByClassName("t-button purchasing")[0].parentNode
                    .innerHTML = "<span class='t-icon t-insert'></span>";
            }
        }

        function Signature(transactionId, type) {
            $.ajax({
                type: 'post',
                data: { transactionId: transactionId, type: type },
                dataType: 'json',
                url: '@Url.Action("FuelSignature", "User", new {area = ""})',
                timeout: 20000,
                success: function() {
                    alert("Thêm chữ ký thành công !");
                    RefreshGrid("gridTool");
                }
            });
            return false;
        }


    </script>

    <!-- grid Transaction -->
    <script type="text/javascript">

        function PrintForm(val) {
            alert(val);
            $('#result').load('@Url.Action("PrintTransactionTool", "Tool")',
                {
                    transactionId: val
                },
                function() {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }
    </script>

}

<div class="title">Duyệt phiếu xuất nhập công cụ</div>
<div class="t-info-sha" style="padding-left: 15px; width: 250px; color: Maroon;">Sổ lệnh</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<TransactionFptModel>()
            .Name("gridTool")
            .DataKeys(keys => keys.Add(f => f.TransactionId).RouteKey("transactionId"))
            .ToolBar(bar => bar.Template(
                @<text>
                     <div class="grid_7">
                         <button class="t-button" id="btnApproveTransaction" name="btnApproveTransaction" onclick=" ApproveTransaction() ">
                             <span class='t-icon t-insert'></span>
                             Duyệt các sổ lệnh
                             <span id="twoToneButton"></span>
                         </button>
                     </div>
                     <div class="clear"></div>
                 </text>
                                ))
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("SelectWaitingTransactionTool", "Tool",
                                                             new { status = (byte)MyUtilities.Transaction.Status.Open })
                                                     .Delete("CancelTransactionTool", "Tool")
            )
            .Columns(columns =>
                {
                    columns.Bound(f => f.TransactionId).Title("Chọn").Width(45)
                           .ClientTemplate("<input type='radio' name='chkTransactionIds' class='chkCheck' value='<#= TransactionId #>' />")
                           .HtmlAttributes(new {style = "text-align:center"})
                           .Filterable(false)
                           .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                           .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                           .FooterHtmlAttributes(new { style = "text-align: left; font-weight:bold; " })
                           .Aggregate(agg => agg.Count());
                    columns.Bound(f => f.TransactionDate).Width(90).Title("Ngày nhập")
                           .Format("{0:dd/MM/yyyy}");
                    //columns.Bound(f => f.PoCode).Width(90).Title("Phiếu mua");
                    columns.Bound(f => f.TransactionCode).Width(95).Title("Số phiếu");
                    columns.Bound(f => f.EoIName).Width(100)
                           .HeaderTemplate("<span style='text-decoration:underline'>Nhập</span></br>Xuất")
                           .HtmlAttributes(new {style = "text-align:center;"});
                    //columns.Bound(f => f.FptName).Width(100).Title("Loại");
                    columns.Bound(f => f.TotalQuantity).Width(70).Title("Tổng SL")
                           .HtmlAttributes(new { style = "text-align:right;" })
                           .Format("{0:n2}")
                           .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                           .FooterHtmlAttributes(new { style = "text-align: right; font-weight:bold; " })
                           .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                           .Filterable(false)
                           .Aggregate(agg => agg.Sum());
                    columns.Bound(f => f.TotalPrice).Width(100)
                           .HeaderTemplate("Tổng tiền</br>(VNĐ)")
                           .HtmlAttributes(new { style = "text-align:right;" })
                           .Format("{0:n0}")
                           .Filterable(false)
                           .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                           .FooterHtmlAttributes(new { style = "text-align: right; font-weight:bold; " })
                           .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                           .Aggregate(agg => agg.Sum());
                    columns.Bound(f => f.ModifiedUser).Width(75).Title("Người lập").Filterable(false);
                    columns.Bound(f => f.ModifiedDate).Width(90).Title("Ngày lập")
                           .Format("{0:dd/MM/yyyy HH:mm}");
                    columns.Bound(f => f.Department).Title("BP đề xuất");
                    columns.Bound(f => f.Note).Title("Ghi chú").Filterable(false);
                    columns.Bound(f => f.TransactionId).Title("In").Width(60)
                           .ClientTemplate("<input type='button' id='id_<#= TransactionId #>' value='In' class='t-button' onclick=PrintForm(<#= TransactionId #>) />")
                           .Filterable(false)
                           .HtmlAttributes(new {style = "text-align:center"});
                    columns.Command(c => c.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(50);
                    columns.Bound(f => f.TransactionId).Title("QL mua").Width(60)
                           .Filterable(false)
                           .ClientTemplate("<button class='t-button purchasing' id='QLM_<#= TransactionId #>' onclick=Signature(<#= TransactionId #>,1) ><span class='t-icon t-insert'></span></button>")
                           .HtmlAttributes(new {style = "text-align:center"});
                })
            .DetailView(details => details.ClientTemplate(
                Html.Telerik().TabStrip()
                    .Name("TabStrip_<#= TransactionId #>")
                    .SelectedIndex(0)
                    .Items(items =>
                           items.Add().Text("Thông tin chi tiết").Content(
                               Html.Telerik().Grid<TransactionFptDetailModel>()
                                   .Name("gridTransactionDetail_<#= TransactionId #>")
                                   .DataBinding(dataDindings => dataDindings.Ajax()
                                                                            .Select("SelectTransactionToolDetail", "Tool",
                                                                                    new { transactionId = "<#= TransactionId #>" }))
                                   .Columns(columns =>
                                       {
                                           columns.Bound(f => f.VendorName).Title("NCC").Width(125);
                                           columns.Bound(f => f.ToolName).Title("Tên chi tiết").Width(125);
                                           columns.Bound(f => f.ToolFullCodeName).Title("Quy cách").Width(150);
                                           //columns.Bound(f => f.ToolMaterial).Title("NL").Width(100);
                                           columns.Bound(f => f.LotNumber).Width(50).Title("Lô")
                                                  .HtmlAttributes(new {style = "text-align: right;"});
                                           columns.Bound(f => f.TotalInv).Width(50).Title("Tồn kho")
                                                  .Format("{0:n2}")
                                                  .HtmlAttributes(new {style = "text-align: right;"});
                                           columns.Bound(f => f.Quantity).Width(50).Title("SL")
                                                  .Format("{0:n2}")
                                                  .HtmlAttributes(new {style = "text-align: right;"});
                                           columns.Bound(f => f.UnitPrice).Width(75)
                                               .HeaderTemplate("Đơn giá")
                                                  .Format("{0:n2}")
                                                  .HtmlAttributes(new {style = "text-align: right;"});
                                           columns.Bound(f => f.Price).Width(75).Title("Thành tiền")
                                                  .Format("{0:n2}")
                                                  .HtmlAttributes(new {style = "text-align: right;"});
                                           columns.Bound(f => f.UnitMeasure).Width(30).Title("ĐVT");
                                           columns.Bound(f => f.Note).Title("Ghi chú");
                                       })
            .ClientEvents(events => events.OnError("grid_OnError"))
                                   .ToHtmlString()
                               )
                    )
                    .ToHtmlString()
                                       ))
            .Selectable()
            .Sortable()
            .Scrollable(f => f.Height(700))
            .Filterable()
            .Resizable(resizing => resizing.Columns(true))
            .ClientEvents(events => events.OnError("grid_OnError")
                                        .OnRowSelect("grid_OnRowSelect")
                                        .OnDataBound("grid_OnDataBound")
                                        .OnRowDataBound("Grid_OnRowDataBound")
                                        
            )
            //.Pageable(f=>f.PageSize(5))
            .Render();
    }
</div>

<!-- windown -->
@{
    Html.Telerik().Window()
        .Name("windowReport")
        .Modal(true)
        .Draggable(true)
        .Content
        (
    @<text>
    <div id="result"></div>
    </text>
        )
        //.ClientEvents(e => e.OnLoad("Window_onLoad"));
        .Visible(false)
        .Width(960)
        .ClientEvents(e => e.OnOpen("window_onopen"))
        .Render();
}

<script>
    function window_onopen(e) {
        //alert("b");
        $("#rptvPageImportToolForm_ReportToolbar_ExportGr_FormatList_DropDownList option[value='XLS']").remove();
        $("#rptvPageImportToolForm_ReportToolbar_ExportGr_FormatList_DropDownList option[value='RTF']").remove();
        $("#rptvPageImportToolForm_ReportToolbar_ExportGr_FormatList_DropDownList option[value='MHTML']").remove();
    }
</script>
<style type="text/css">
    #windowReport {
        /*
            float: right;
            Position: relative;
            */
        min-height: 580px;
        top: 15%;
    }

    #result {
        height: 520px;
        overflow: hidden;
    }

    #ReportBody {
        padding-bottom: 25px;
        margin-bottom: 25px;
    }

    .tb-witdh td {
        width: 55px;
    }
</style>
