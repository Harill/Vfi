                                                columns.Bound(f => f.Productivity).Width(70)
                                                       .HeaderTemplate("NS TK</br>(s/pc)")
                                                       .ClientTemplate("<#= Productivity == null ? 0 : $.telerik.formatString('{0:n0}', Productivity) #>")
                                                       .HtmlAttributes(new { style = "text-align:right;" });
                                                columns.Bound(f => f.MillProductivity).Width(70)
                           .HeaderTemplate("NS Mil</br>(s/pc)")
                           .ClientTemplate("<#= MillProductivity == null ? 0 : $.telerik.formatString('{0:n0}', MillProductivity) #>")
                           .HtmlAttributes(new { style = "text-align:right;" });
                                                columns.Bound(f => f.MaterialCodeDesign).Width(100).ReadOnly(true)
                                                       .HeaderTemplate("NL</br>thiết kế");
                                            })
                                        .Editable(editing => editing.Mode(GridEditMode.InLine))
                                        .ClientEvents(e => e.OnRowDataBound("gridProductionSection_OnRowDataBound")
                                                            .OnDataBinding("gridProductionSection_OnDataBinding")
                                                               .OnError("grid_OnError")
                                                            .OnSave("gridProductionSection_OnSave"))
                                        .ToHtmlString()
                                    );
                                items.Add().Text("Công đoạn").Content(
                                    Html.Telerik().Grid<ProductionSectionModel>()
                                        .Name("gridProductionSection_<#= ProductId #>")
                                        .DataKeys(key => key.Add(f => f.SectionId).RouteKey("sectionId"))
                                        .DataBinding(
                                            dataBinding => dataBinding.Ajax()
                                                                      .Select("SelectProductionSectionById", "Product", new { area = "", productId = "<#= ProductId #>" })
                                    )
                                        .Columns(columns =>
                                        {
                                            
                                            columns.Bound(f => f.SectionName).Width(100).Title("Tên công đoạn").ReadOnly(true);
                                            columns.Bound(f => f.SectionIndex).Width(100).Title("Tiến trình").ReadOnly(true);
                                            columns.Bound(f => f.Productivity).Width(100).Title("Năng suất").ReadOnly(true);
                                            columns.Bound(f => f.Description).Width(100).Title("Mô tả").ReadOnly(true);
                                            columns.Bound(f => f.SectionCost).Width(100).Title("Giá");
                                            columns.Bound(f => f.UpdateDate).Width(50).Title("Ngày sửa").ReadOnly(true)
                                                   .ClientTemplate("<#= UpdateDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', UpdateDate) #>");
                                            columns.Bound(f => f.UpdateUser).Width(50).Title("Người sửa").ReadOnly(true);
                                            columns.Bound(f => f.Active).Width(30).ReadOnly(true)
                                                   .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                                                   .HtmlAttributes(new { style = "text-align:center" });
                                        })
                                        .Editable(editing => editing.Mode(GridEditMode.InLine))
                                        .ClientEvents(e => e.OnRowDataBound("gridProductionSection_OnRowDataBound")
                                                            .OnDataBinding("gridProductionSection_OnDataBinding")
                                           .OnError("grid_OnError")
                                                            .OnSave("gridProductionSection_OnSave"))
                                        .ToHtmlString()
                                    );
                                items.Add().Text("Gia công ngoài").Content(
                                    Html.Telerik().Grid<ProductionPlatingModel>()
                                        .Name("gridProductionPlating_<#= ProductId #>")
                                        .DataKeys(key => key.Add(f => f.PlatingId).RouteKey("platingId"))
                                        .DataBinding(
                                            dataBinding => dataBinding.Ajax()
                                                .Select("SelectProductionPlatingById", "Product", new {area = "", productId = "<#= ProductId #>"})
                                                //.Insert("InsertProductionSection", "Product", new {area = "", productId = "<#= ProductId #>"})
                                                .Update("UpdateProductionPlating", "Product", new {area = "", productId = "<#= ProductId #>"})
                                        )
                                        .Columns(columns =>
                                        {
                                            columns.Command(command =>
                                                command.Edit().ButtonType(GridButtonType.Image).UpdateText("Cập nhật").CancelText("Hủy").Text("Sửa").InsertText("Thêm mới")
                                                ).Width(98).Title("Commands").HtmlAttributes(new {style = "text-align:center"});
                                            columns.Bound(f => f.PlatingName).Width(100).Title("Tên GCN").ReadOnly(true);
                                            columns.Bound(f => f.Description).Width(100).Title("Mô tả").ReadOnly(true);
                                            columns.Bound(f => f.PlatingCost).Width(100).Title("Giá");
                                            columns.Bound(f => f.InsertDate).Width(50).Title("Ngày thêm").ReadOnly(true)
                                                .ClientTemplate("<#= InsertDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', InsertDate) #>");
                                            columns.Bound(f => f.InserUser).Width(50).Title("Người thêm").ReadOnly(true);
                                            columns.Bound(f => f.ModifiedDate).Width(50).Title("Ngày sửa").ReadOnly(true)
                                                .ClientTemplate("<#= ModifiedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', ModifiedDate) #>");
                                            columns.Bound(f => f.ModifiedUser).Width(50).Title("Người sửa").ReadOnly(true);
                                            columns.Bound(f => f.Active).Width(30).ReadOnly(true)
                                                .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                                                .HtmlAttributes(new {style = "text-align:center"});
                                        })
                                        .Editable(editing => editing.Mode(GridEditMode.InLine))
                                        .ClientEvents(e => e.OnRowDataBound("gridProductionPlating_OnRowDataBound")
                                            .OnDataBinding("gridProductionPlating_OnDataBinding")
                                            .OnError("grid_OnError")
                                            .OnSave("gridProductionPlating_OnSave"))
                                        .ToHtmlString()
                                    );

                                items.Add().Text("Phí khác").Content(
                                        Html.Telerik().Grid<ProductAdditionFeeModel>()
                                            .Name("gridAdditionFee_<#= ProductId #>")
                                            .HtmlAttributes(new { lockInsert = "<#= IsCalculateLock #>" })
                                            .DataKeys(key => key.Add(f => f.FeeId).RouteKey("feeId"))
                                            .ToolBar(tool => tool.Insert().Text("Thêm mới")
                                                    .ButtonType(GridButtonType.ImageAndText)
                                                    .ImageHtmlAttributes(new { style = "margin-left:0px;" })
                                                    //.HtmlAttributes(new { id = "gridAdditionFee_<#= ProductId #>_Insert" })
                                                    )
                                            .DataBinding(
                                                dataBinding => dataBinding.Ajax()
                                                                          .Select("SelectProductAdditionFee", "Production", new { area = "Factory", productId = "<#= ProductId #>" })
                                                                          .Insert("InsertProductAdditionFee", "Production", new { area = "Factory", productId = "<#= ProductId #>" })
                                                                          .Update("UpdateProductAdditionFee", "Production", new { area = "Factory", productId = "<#= ProductId #>" })
                                            )
                                            .Columns(columns => {
                                                columns.Command(command =>
                                                                command.Edit().ButtonType(GridButtonType.Image)
                                                    ).Width(50).Title("").HtmlAttributes(new { style = "text-align:center" });
                                                columns.Bound(f => f.Name).Width(120)
                                                       .Title("Tên");
                                                columns.Bound(f => f.Price).Width(100).Title("Giá (usd/pc)")
                                                    .Format("{0:n4}");
                                                columns.Bound(f => f.Active).Width(100)
                                                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                                                       .HtmlAttributes(new { style = "text-align:center" });
                                                columns.Bound(f => f.ModifiedDate).Width(100).Title("Ngày làm").ReadOnly(true)
                                                       .Format("{0:dd/MM/yyyy HH:mm}");
                                                columns.Bound(f => f.ModifiedUser).Width(100).Title("Người làm").ReadOnly(true);
                                            })
                                            .Editable(editing => editing.Mode(GridEditMode.InLine))
                                            .ClientEvents(events => events.OnError("grid_OnError")
                                            //.OnLoad("gridAdditionFee_OnLoad")
                                            //.OnRowDataBound("gridAdditionFee_OnRowDataBound")
                                            )
                                            .ToHtmlString()
                                        );

                                items.Add().Text("Quy trình kho").Content(
                                    Html.Telerik().Grid<ProductionProcessModel>()
                                        .Name("gridProductionProcess_<#= ProductId #>")
                                        .DataKeys(key => key.Add(f => f.ProcessId).RouteKey("processId"))
                                        .DataBinding(
                                            dataBinding => dataBinding.Ajax()
                                                                      .Select("SelectProductionProcessById", "Product", new { area = "", productId = "<#= ProductId #>" })
                                        )
                                        .Columns(columns =>
                                            {
                                                columns.Bound(f => f.WarehouseName).Width(50).Title("Tên kho");
                                                columns.Bound(f => f.ProcessIndex).Width(50).Title("Tiến trình")
                                                       .ClientTemplate("<#= ProcessIndex == null ? 0 : $.telerik.formatString('{0:n0}', ProcessIndex) #>");
                                                columns.Bound(f => f.IsAlert).Width(75).Title("Cảnh báo ?")
                                                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='Alert' <#=IsAlert? checked='checked' : '' #> />")
                                                       .HtmlAttributes(new { style = "text-align:center" });
                                                columns.Bound(f => f.IsNecessary).Width(75).Title("Bắt buộc ?")
                                                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='Necessary' <#=IsNecessary? checked='checked' : '' #> />")
                                                       .HtmlAttributes(new { style = "text-align:center" });
                                                columns.Bound(f => f.ModifiedDate).Width(100).Title("Ngày thêm").ReadOnly(true)
                                                       .ClientTemplate("<#= ModifiedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', ModifiedDate) #>");
                                                columns.Bound(f => f.ModifiedUser).Width(100).Title("Người cập nhật").ReadOnly(true);
                                                //columns.Command(commands => commands.Delete().ButtonType(GridButtonType.Image)).Width(30).Title("");
                                            })
                                        .Editable(editing => editing.Mode(GridEditMode.InLine))
                                        .ClientEvents(e => e.OnError("grid_OnError"))
                                        .ToHtmlString()
                                    );
                                items.Add().Text("Lịch sử đổi mã").Content(
                                   Html.Telerik().Grid<ProductChangeModel>()
                                       .Name("gridProductChange_<#= ProductId #>")
                                       .DataKeys(key => key.Add(f => f.ChangeId).RouteKey("changeId"))
                                       .DataBinding(
                                           dataBinding => dataBinding.Ajax()
                                                                     .Select("SelectProductChangeById", "Product", new { area = "", productId = "<#= ProductId #>" })
                                       )
                                       .Columns(columns =>
                                       {
                                           columns.Bound(f => f.ModifiedDate).Width(70).Title("Ngày thay đổi")
                                                    .ClientTemplate("<#= ModifiedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy HH:mm:ss}', ModifiedDate) #>");
                                           columns.Bound(f => f.OldProductCode).Width(50).Title("Tên cũ");
                                           columns.Bound(f => f.NewProductCode).Width(50).Title("Tên mới");
                                           columns.Bound(f => f.OldPrice).Width(50).Title("Giá cũ")
                                                       .ClientTemplate("<#= OldPrice == 0 ? '' :  OldPrice #>");
                                           columns.Bound(f => f.NewPrice).Width(50).Title("Giá mới")
                                                       .ClientTemplate("<#= NewPrice == 0 ? '' :  NewPrice #>");
                                           columns.Bound(f => f.ModifiedUser).Width(200).Title("Người thay đổi");
                                           //columns.Command(commands => commands.Delete().ButtonType(GridButtonType.Image)).Width(30).Title("");
                                       })
                                       .ClientEvents(e => e.OnError("grid_OnError"))
                                       .ToHtmlString()
                                   );
                            }
                        )
                        .ToHtmlString()
                                             ))
            .Editable(editing => editing.Mode(GridEditMode.InLine))
            .ClientEvents(events => events.OnDataBinding("gridProduct_OnDataBinding")
                                          .OnEdit("gridProduct_onEdit")
                                          .OnError("grid_OnError")
                                          .OnSave("grid_OnSave")
                                          .OnRowSelect("grid_OnRowSelect"))
            .Selectable()
            //.Pageable(page => page.PageSize(7))
            .Scrollable(f => f.Height(500))
            .Sortable()
            .Resizable(f => f.Columns(true))
            .Reorderable(f => f.Columns(true))
            .Filterable()
            .Resizable(resizing => resizing.Columns(true))
            .Render();
    }
</div>

