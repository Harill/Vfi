@using Vfi.Ui.Mvc.Vfi.Models.Production
@{
    ViewBag.Title = "Products Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

    <style>
        .highslide-container div {
            font-family: Verdana, Helvetica;
            font-size: 10pt;
        }
        .highslide-container table {
            background: none;
        }
        .highslide {
            outline: none;
            text-decoration: none;
        }
        .highslide img {
            border: 2px solid silver;
        }
        .highslide:hover img {
            border-color: gray;
        }
        .highslide-active-anchor img {
            visibility: hidden;
        }
        .highslide-gallery .highslide-active-anchor img {
            border-color: black;
            visibility: visible;
            cursor: default;
        }
        .highslide-image {
            border-width: 2px;
            border-style: solid;
            border-color: white;
        }
        .highslide-wrapper, .highslide-outline {
            background: white;
        }
        .glossy-dark {
            background: #111;
        }

        .highslide-image-blur {
        }
        .highslide-number {
            display: none;
            font-weight: bold;
            color: gray;
            font-size: .9em;
        }
        .highslide-caption {
            display: none;
            font-size: 1em;
            padding: 5px;
            width: 100%;
            text-align: center;
            font-weight: bold;
            /*background: white;*/
        }
        .highslide-heading {
            display: none;
            font-weight: bold;
            margin: 0.4em;
        }
        .highslide-dimming {
            /*position: absolute;*/
            background: black;
        }
        a.highslide-full-expand {
            display: block;
            margin: 0 10px 10px 0;
            width: 34px;
            height: 34px;
        }
        .highslide-loading {
            display: block;
            color: black;
            font-size: 9px;
            font-weight: bold;
            text-transform: uppercase;
            text-decoration: none;
            padding: 3px;
            border: 1px solid white;
            background-color: white;
            padding-left: 22px;
            background-repeat: no-repeat;
            background-position: 3px 1px;
        }
        a.highslide-credits,
        a.highslide-credits i {
            padding: 2px;
            color: silver;
            text-decoration: none;
            font-size: 10px;
            display: none;
        }
        a.highslide-credits:hover,
        a.highslide-credits:hover i {
            color: white;
            background-color: gray;
        }
        .highslide-move, .highslide-move * {
            cursor: move;
        }

        .highslide-viewport {
            display: none;
            position: fixed;
            width: 100%;
            height: 100%;
            z-index: 1;
            background: none;
            left: 0;
            top: 0;
        }
        .highslide-overlay {
            display: none;
        }
        .hidden-container {
            display: none;
        }
/* Example of a semitransparent, offset closebutton */
        .closebutton {
            position: relative;
            top: -15px;
            left: 15px;
            width: 30px;
            height: 30px;
            cursor: pointer;
            /* NOTE! For IE6, you also need to update the highslide-ie6.css file. */
        }
        .highslide-controls {
            display: none 
        }

    </style>

    <script type="text/javascript">
        hs.graphicsDir = '';
        hs.align = 'center';
        hs.transitions = ['expand', 'crossfade'];
        hs.outlineType = '';
        hs.fadeInOut = true;
        hs.numberPosition = 'caption';
        hs.dimmingOpacity = 0.75;

        // Add the controlbar
        if (hs.addSlideshow)
            hs.addSlideshow({
                //slideshowGroup: 'group1',
                interval: 5000,
                repeat: false,
                useControls: true,
                fixedControls: 'fit',
                overlayOptions: {
                    opacity: .75,
                    position: 'bottom center',
                    hideOnMouseOut: true
                }
            });
    </script>
@section Scripts{
    <script type="text/javascript">
        function gridProduct_OnDataBinding(args) {
            var statusValue = $("#Status").data("tComboBox").value();
            if (statusValue === "")
                statusValue = 0;
            var customer = $("#Customer").data("tComboBox").value();
            if (customer === "")
                customer = 0;
            //var productCodeName2 = $("#ProductCodeName").data("tAutoComplete");
            var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
            var productName = $("#ProductName").data("tAutoComplete").value();
            args.data = $.extend(args.data, {
                customerId:customer,
                status: statusValue,
                productCode: productCodeName,
                productName: productName
            });
        }

        function gridProductionSection_OnDataBinding() {
            index = 0;
            count = 0;
        }

        function gridProductionSection_OnSave() {
            index = 0;
            count = 0;
        }

        var index = 0;
        var count = 0;

        function gridProductionSection_OnRowDataBound(e) {
            var dataItem = e.dataItem;
            if (dataItem.IsSaleManagement === 1) {
                this.getElementsByClassName("t-button t-grid-edit t-button-icon")[index - count].parentNode.innerHTML = "";
                count++;
            }
            index++;
        }

        function gridProductionPlating_OnDataBinding() {
            indexP = 0;
            countP = 0;
        }

        function gridProductionPlating_OnSave() {
            indexP = 0;
            countP = 0;
        }

        var indexP = 0;
        var countP = 0;

        function gridProductionPlating_OnRowDataBound(e) {
            var dataItem = e.dataItem;
            if (dataItem.IsSaleManagement === 1) {
                this.getElementsByClassName("t-button t-grid-edit t-button-icon")[index - count].parentNode.innerHTML = "";
                countP++;
            }
            indexP++;
        }
        
        function grid_OnSave(e) {
            var statusValue = $("#Status").data("tComboBox").value();
            if (statusValue === "")
                statusValue = 0;
            var customer = $("#Customer").data("tComboBox").value();
            if (customer === "")
                customer = 0;
            var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
            e.values = $.extend(e.values,
                {
                    customerId: customer,
                    status: statusValue,
                    productCodeFilter: productCodeName
                }
            );
            var i = 0;
            var drawing2D = "";
            var editRow = document.getElementsByClassName("t-grid-edit-row")[0];
            var ul2D = editRow.childNodes[2].childNodes[1].childNodes[1];
            if (ul2D == null && e.Upload === "" || typeof ul2D == 'undefined') {
                drawing2D = e.dataItem?.Upload2D;
            } else {
                var child2D = ul2D.childNodes;
                for (i = child2D.length - 1; i >= 0; i--) {
                    if (child2D[i].childNodes[0].textContent === "uploaded") {
                        e.values.Attachment2D = child2D[0].childNodes[1].title;
                        drawing2D = child2D[0].childNodes[1].title;
                        break;
                    }
                }
            }
            var drawing = "";
            var ulReal = editRow.childNodes[3]?.childNodes[1]?.childNodes[1];
            if (ulReal == null && e.Upload === "" || typeof ulReal == 'undefined') {
                drawing = drawing2D;
            } else {
                var child = ulReal.childNodes;
                for (i = child.length - 1; i >= 0; i--) {
                    if (child[i].childNodes[0].textContent === "uploaded") {
                        e.values.AttachmentReal = child[0].childNodes[1].title;
                        drawing = child[0].childNodes[1].title;
                        break;
                    }
                }
            }
            var message = "";
            if (drawing === "" || drawing === "askquestion.jpg" ||
                drawing2D === "" || drawing2D === "askquestion.jpg") {
                message += "\nCảnh báo!";
                if (drawing2D === "")
                    message += "\nBản vẽ sản phẩm chưa có !";
                if (drawing === "")
                    message += "\nHình sản phẩm chưa có !";
                message += "\nSẽ dùng hình mặc định !";
                message += "\nĐồng ý lưu ??";
                if (confirm(message)) {
                    return true;
                };
            } else {
                return true;
            }
            return false;
        }

        function gridProduct_onEdit(e) {
            var mode = e.mode;
            var form = e.form;

            //var materialCodeName = $(form).find('#MaterialCode');
            //var materialCodeNameData = $(form).find('#MaterialCode').data('tComboBox');

            var customerCodeName = $(form).find('#CustomerCodeName');
            var customerCodeNameData = $(form).find('#CustomerCodeName').data('tComboBox');

            if (mode === 'insert') {
                //var nodes = document.getElementsByClassName("t-widget t-combobox t-header");
                //var textboxes = document.getElementsByClassName("text-box single-line");
                var product = document.getElementById("ProductCode");
                product.parentNode.innerHTML = "";
                //var status = document.getElementById("StatusName");
                //status.parentNode.innerHTML = "";
                //var a = nodes[0].parentNode;
                //nodes[0].parentNode.innerHTML = "<strong>" + machineName.val() + "</strong>";
                //nodes[0].parentNode.innerHTML = "<strong>" + stateName.val() + "</strong>";
            } else if (mode === 'edit') {
                //materialCodeNameData.reload();
                //materialCodeName.bind('dataBound', function() { // your code 
                //    materialCodeNameData.select(function(item) {
                //        return item.Value == e.dataItem['MaterialId'];
                //    });
                //});

                customerCodeNameData.reload();
                customerCodeName.bind('dataBound', function() { // your code 
                    customerCodeNameData.select(function(item) {
                        return item.Value === e.dataItem['CustomerId'];
                    });
                });

            }
        }

        function PrintComparePriceList() {
            var customer = $("#Customer").data("tComboBox").value();
            if (customer === "")
                customer = 0;
            var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
            var productName = $("#ProductName").data("tAutoComplete").value();
            var statusValue = $("#Status").data("tComboBox").value();
            if (statusValue === "")
                statusValue = 0;
            $('#result').load('@Url.Action("PrintComparePriceList", "Product")',
                {
                    customerId: customer,
                    productCode: productCodeName,
                    status: statusValue,
                    productName: productName
                }, function() {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
                return false;
        }

        function PrintPriceList() {
            var customer = $("#Customer").data("tComboBox").value();
            if (customer === "")
                customer = 0;
            var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
            var productName = $("#ProductName").data("tAutoComplete").value();
            var statusValue = $("#Status").data("tComboBox").value();
            if (statusValue === "")
                statusValue = 0;

            var fromDate = $("#FromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            $('#result').load('@Url.Action("PrintPriceList", "Product")',
                {
                    customerId: customer,
                    productCode: productCodeName,
                    status: statusValue,
                    fromDate: fromDate,
                    productName: productName
                }, function () {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }

        function Duplicate(productId) {

            $.ajax({
                type: 'post',
                data: { productId: productId },
                dataType: 'json',
                url: '@Url.Action("DuplicateProduct", "Product", new { area = "" })',
            timeout: 20000,
            success: function (res) {
                if (res.Code != 1)
                    alert("Lỗi !" + res.Message);
                else {
                    alert("Nhân bản thành công !" + res.Data);
                    RefreshGrid("gridProduct");
                }
            }
        });
        }

        function status_onChange() {
            RefreshGrid("gridProduct");
        }
        function customer_onChange() {
            RefreshGrid("gridProduct");
        }
    </script>
    
    }

