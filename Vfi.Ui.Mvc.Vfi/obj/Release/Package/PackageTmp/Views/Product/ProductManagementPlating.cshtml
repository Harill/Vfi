@using Vfi.Ui.Mvc.Vfi.Models.Production
@{
    ViewBag.Title = "Sản phẩm gia công ngoài";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">
        function gridProduct_OnDataBinding(args) {
            var customer = $("#Customer").data("tComboBox").value();
            if (customer === "")
                customer = 0;
            var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
            args.data = $.extend(args.data, {
                customerId: customer,
                productId: 0,
                productCode: productCodeName
            });
            var index = 0;
        }

        var index = 0;

        function customer_onChange() {
            var index = 0;
            RefreshGrid("gridProduct");
        }
    </script>
}

<div class="title">
    @*Quản lý thông tin sản phẩm (gia công ngoài)*@
    @HttpContext.GetGlobalResourceObject("Resource", "ProductManagementPlating")
</div>
<div id="pnlInvPeriod">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">

        <fieldset>
            <legend>
                @*Tiêu chí trích lọc*@
                @HttpContext.GetGlobalResourceObject("Resource", "Filter")
            </legend>

            <div class="grid_1_5">
                @*Mã KH*@
                @HttpContext.GetGlobalResourceObject("Resource", "CustomerCode2")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Customer")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                        .HtmlAttributes(new { style = "width: 150px" })
                        .DropDownHtmlAttributes(new { style = "width: 250px" })
                        .ClientEvents(events => events.OnChange("customer_onChange"))
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>

            <div class="grid_1_5">
                @*Sản phẩm*@
                @HttpContext.GetGlobalResourceObject("Resource", "Product")
            </div>
            <div class="grid_5">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeName")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv", new { area = "Inv" }))
                        .HtmlAttributes(new { style = "width: 150px; " })
                        .DropDownHtmlAttributes(new { style = "width: 250px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Value("")
                        //.ClientEvents(events => events.OnClose("ProductCodeName_OnClose"))
                        .Render();
                }
            </div>
            <button id="btnRefresh" class='t-button' onclick=" return RefreshGrid('gridProduct'); ">
                <span class='t-icon t-insert'></span>
                @*Làm mới*@
                @HttpContext.GetGlobalResourceObject("Resource", "Refresh")
            </button>
        </fieldset>
    </div>
</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<ProductionPlatingModel>()
            .Name("gridProduct")
            .DataKeys(key => key.Add(f => f.ProductId).RouteKey("productId"))
            //.ToolBar(
            //                            toolbar =>
            //                            toolbar.Insert().Text("Thêm công đoạn mới").ButtonType(GridButtonType.ImageAndText).ImageHtmlAttributes(new { style = "margin-left:0px;" }))

            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                        .Select("SelectProductionPlating", "Production", new { area = "Factory", customerId = 0, productId = "<#= ProductId #>", productCode = "" })
                                          )
            .Columns(columns => {
                //columns.Command(command =>
                //                command.Edit().ButtonType(GridButtonType.Image).UpdateText("Cập nhật").CancelText("Hủy").Text("Sửa")
                //    ).Width(50).Title("").HtmlAttributes(new {style = "text-align:center"});

                columns.Bound(f => f.ProductId)
                    //.Title("STT")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Index").ToString())
                    .Width(35).ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "font-weight: bold" })
                    .ClientTemplate("<#= ++index #>")
                    .HtmlAttributes(new { style = "text-align: center;" });
                
                columns.Bound(f => f.CustomerCode).Width(70)
                    //.HeaderTemplate("Mã KH")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "CustomerCode").ToString());
                
                columns.Bound(f => f.ProductCode).Width(100)
                    //.HeaderTemplate("Mã SP")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductCode2").ToString());

                columns.Bound(f => f.PlatingIndex).Width(50)
                    //.HeaderTemplate("STT</br>GCN")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "PlatingA").ToString()
                        + "</br>"
                        + @HttpContext.GetGlobalResourceObject("Resource", "Index").ToString()
                    );
                
                columns.Bound(f => f.PlatingName).Width(200)
                    //.HeaderTemplate("Gia công")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Processing").ToString());
                
                columns.Bound(f => f.SaltSprayTime).Width(100)
                    //.HeaderTemplate("Phun muối")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "SaltSpray").ToString());
                
                columns.Bound(f => f.Thickness).Width(100)
                    //.HeaderTemplate("Độ dày")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Thickness").ToString());
                
                columns.Bound(f => f.PlatingDay).Width(100)
                    //.HeaderTemplate("Thời gian</br>(d)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Time").ToString()
                        + "</br>(d)"
                    )
                    .HtmlAttributes(new { style = "text-align: center;" });
                
                columns.Bound(f => f.PlatingCost).Width(100)
                    //.HeaderTemplate("Chi phí")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Cost").ToString())
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align: right;" });
                
                columns.Bound(f => f.Description)
                    //.HeaderTemplate("Ghi chú")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Note").ToString());
                
                columns.Bound(f => f.Active).Width(50)
                    //.Title("Kích</br>hoạt")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Active").ToString())
                    .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                    .HtmlAttributes(new { style = "text-align:center" });
                
                columns.Bound(f => f.IsMainProcess).Width(50)
                    //.Title("CĐ</br>chính")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "MainStage3").ToString())
                    .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsMainProcess' <#=IsMainProcess? checked='checked' : '' #> />")
                    .HtmlAttributes(new { style = "text-align:center" });
                
                columns.Bound(f => f.ModifiedDate).Width(100)
                    //.Title("Ngày làm")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ModifiedDate").ToString())
                    .ReadOnly(true)
                    .Format("{0:dd/MM/yyyy HH:mm}");
                
                columns.Bound(f => f.ModifiedUser).Width(100)
                    //.Title("Người làm")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ModifiedUser").ToString())
                    
                    .ReadOnly(true);
            })
            .ClientEvents(events => events.OnDataBinding("gridProduct_OnDataBinding")
                                          .OnError("grid_OnError"))
            .Selectable()
            .Scrollable(f => f.Height(510))
            .Resizable(f => f.Columns(true))
            .Reorderable(f => f.Columns(true))
            .Filterable()
            .Sortable()
            .Render();
    }
</div>
