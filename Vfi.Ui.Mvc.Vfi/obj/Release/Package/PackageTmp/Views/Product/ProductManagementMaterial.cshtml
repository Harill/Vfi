            //                            toolbar =>
            //                            toolbar.Insert().Text("Thêm công đoạn mới").ButtonType(GridButtonType.ImageAndText).ImageHtmlAttributes(new { style = "margin-left:0px;" }))

            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectProduct", "Product", new { area = "", active = true, status = 0, customerId = -1, productCode = "", productId = 0, productName = "" })
            //.Insert("InsertProduct", "Product", new { area = "" })
            //.Update("UpdateProductManagementProduction", "Product", new { area = "" })
            )
            .Columns(columns =>
                {
                    //columns.Command(command =>
                    //                command.Edit().ButtonType(GridButtonType.Image).CancelText("Hủy").UpdateText("Cập nhật").Text("Sửa")
                    //    ).Width(30).Title("").HtmlAttributes(new { style = "text-align:center" });
                    //columns.Bound(f => f.Upload2D).Width(40).Title("Bản vẽ").ReadOnly(true)
                    //       .ClientTemplate("<a id='<#=ProductId#>' href='" + Url.Content("~/Content/FileUpload/Drawing/") + "<#=Upload2D#>?<#=UploadDate#>' class='highslide' onclick='return hs.expand(this)'>" +
                    //                       "<img src='" + Url.Content("~/Content/FileUpload/Drawing/") + "<#=Upload2D#>?<#=UploadDate#>' height='40' width='40' title='Mở lớn'/>" +
                    //                       "</a><div class='highslide-caption'><#= ProductCode #></div>");
                    //columns.Bound(f => f.UploadReal).Width(40).Title("Hình SP").ReadOnly(true)
                    //       .ClientTemplate("<a id='<#=ProductId#>' href='" + Url.Content("~/Content/FileUpload/Drawing/") + "<#=UploadReal#>?<#=UploadDate#>' class='highslide' onclick='return hs.expand(this)'>" +
                    //                       "<img src='" + Url.Content("~/Content/FileUpload/Drawing/") + "<#=UploadReal#>?<#=UploadDate#>' height='40' width='40' title='Mở lớn'/>" +
                    //                       "</a><div class='highslide-caption'><#= ProductCode #></div>");
                    columns.Bound(f => f.CustomerCode).Width(50).ReadOnly(true)
                           .HeaderTemplate("<strong>Mã</br>KH</strong>")
                           .HeaderHtmlAttributes(new {style = "text-align:center;"})
                           .HtmlAttributes(new {style = "text-align:center;"})
                           .ClientTemplate("<strong><#= CustomerCode #></strong>");
                    columns.Bound(f => f.ProductCode).Width(100).ReadOnly(true)
                           .HeaderTemplate("<strong>Mã</br>SP</strong>")
                           .HeaderHtmlAttributes(new {style = "text-align:center"})
                           .ClientTemplate("<strong><#= ProductCode #></strong>")
                           .Aggregate(agg => agg.Count())
                           .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>")
                           .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n0}', Count) #></div>")
                        ;
                    columns.Bound(f => f.StatusName).Width(100).Title("Tình trạng")
                           .ClientTemplate("<strong><#= StatusName #></strong>");
                    columns.Bound(f => f.Diameter).Width(50)
                           .HeaderTemplate("Dia.</br>(mm)")
                           .HtmlAttributes(new {style = "text-align:right;"});
                    columns.Bound(f => f.OutDiameterTolerance).Width(50)
                           .HeaderTemplate("TOL</br>(O)")
                           .HtmlAttributes(new {style = "text-align:right;"});
                    columns.Bound(f => f.InDiameterTolerance).Width(50)
                           .HeaderTemplate("TOL</br>(I)")
                           .HtmlAttributes(new {style = "text-align:right;"});
                    columns.Bound(f => f.Length).Width(50)
                           .HeaderTemplate("L</br>(mm)")
                           .HtmlAttributes(new {style = "text-align:right;"});
                    columns.Bound(f => f.Weight).Width(50).ReadOnly(true)
                           .HeaderTemplate("W</br>(g)")
                           .ClientTemplate("<#= Weight == null ? 0 : $.telerik.formatString('{0:n3}', Weight) #>")
                           .HtmlAttributes(new {style = "text-align:right;"});
                    columns.Bound(f => f.KnifeCut).Width(70)
                           .HeaderTemplate("Dao cắt</br>(mm)")
                           .HtmlAttributes(new {style = "text-align:right;"});
                    columns.Bound(f => f.ProductionRate).Width(70)
                           .HeaderTemplate("ĐM TK</br>(pcs/cây)")
                           .ClientTemplate("<#= ProductionRate == null ? 0 : $.telerik.formatString('{0:n0}', ProductionRate) #>")
                           .HtmlAttributes(new {style = "text-align:right;"});
                    columns.Bound(f => f.MaterialCodeDesign).Width(100).ReadOnly(true)
                           .HeaderTemplate("NL</br>thiết kế");
                    //columns.Bound(f => f.ProductionFactor).Width(35).ReadOnly(true)
                    //       .HeaderTemplate("HS</br>SX")
                    //       .ClientTemplate("<#= ProductionFactor == null ? 0 : $.telerik.formatString('{0:n1}', ProductionFactor) #>")
                    //       .HtmlAttributes(new {style = "text-align:center;"});
                })
            .DetailView(details => details.ClientTemplate(
                Html.Telerik().TabStrip()
                    .Name("TabStrip_<#= ProductId #>")
                    .SelectedIndex(0)
                    .Items(items => items.Add().Text("Nguyên liệu sử dụng").Content(
                        Html.Telerik().Grid<ProductionMaterialModel>()
                            .Name("gridProductionMaterial_<#= ProductId #>")
                            .DataKeys(key => key.Add(f => f.RealMaterialId).RouteKey("realMaterialId"))
                            .ToolBar(
                                toolbar =>
                                toolbar.Insert().Text("Thêm mới").ButtonType(GridButtonType.ImageAndText).ImageHtmlAttributes(new {style = "margin-left:0px;"}))
                            .DataBinding(
                                dataBinding => dataBinding.Ajax()
                                                          .Select("SelectProductionMaterialById", "Product", new {area = "", productId = "<#= ProductId #>"})
                                                          .Insert("InsertProductionMaterial", "Product", new {area = "", productId = "<#= ProductId #>"})
                                                          .Update("UpdateProductionMaterial", "Product", new {area = "", productId = "<#= ProductId #>"})
                            )
                            .Columns(columns =>
                                {
                                    columns.Command(command =>
                                                    command.Edit().ButtonType(GridButtonType.Image).UpdateText("Cập nhật").CancelText("Hủy").Text("Sửa").InsertText("Thêm mới")
                                        ).Width(50).Title("").HtmlAttributes(new {style = "text-align:center"});
                                    columns.Bound(f => f.MaterialCode).Width(100).Title("Mã NL");
                                    columns.Bound(f => f.UnitWeightByMaterial).Width(50).ReadOnly(true)
                                           .HeaderTemplate("Trọng lượng</br>theo NL (g)")
                                           .ClientTemplate("<#= UnitWeightByMaterial == null ? 0 : $.telerik.formatString('{0:n3}', UnitWeightByMaterial) #>");
                                    columns.Bound(f => f.ProductWeight).Width(50).ReadOnly(true)
                                           .HeaderTemplate("Trọng lượng</br>đã lưu")
                                           .ClientTemplate("<#= ProductWeight == null ? 0 : $.telerik.formatString('{0:n3}', ProductWeight) #>");
                                    columns.Bound(f => f.Priority).Width(50).Title("Ưu tiên");
                                    columns.Bound(f => f.Note).Width(100).Title("Ghi chú");
