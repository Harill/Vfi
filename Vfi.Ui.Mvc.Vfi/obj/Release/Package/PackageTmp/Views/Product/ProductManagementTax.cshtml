@using Vfi.Ui.Mvc.Vfi.Models.Production
@{
    ViewBag.Title = "Products Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .highslide-container div {
        font-family: Verdana, Helvetica;
        font-size: 10pt;
    }

    .highslide-container table {
        background: none;
    }

    .highslide {
        outline: none;
        text-decoration: none;
    }

        .highslide img {
            border: 2px solid silver;
        }

        .highslide:hover img {
            border-color: gray;
        }

    .highslide-active-anchor img {
        visibility: hidden;
    }

    .highslide-gallery .highslide-active-anchor img {
        border-color: black;
        visibility: visible;
        cursor: default;
    }

    .highslide-image {
        border-width: 2px;
        border-style: solid;
        border-color: white;
    }

    .highslide-wrapper, .highslide-outline {
        background: white;
    }

    .glossy-dark {
        background: #111;
    }

    .highslide-number {
        display: none;
        font-weight: bold;
        color: gray;
        font-size: .9em;
    }

    .highslide-caption {
        display: none;
        font-size: 1em;
        padding: 5px;
        width: 100%;
        text-align: center;
        font-weight: bold;
        /*background: white;*/
    }

    .highslide-heading {
        display: none;
        font-weight: bold;
        margin: 0.4em;
    }

    .highslide-dimming {
        /*position: absolute;*/
        background: black;
    }

    a.highslide-full-expand {
        display: block;
        margin: 0 10px 10px 0;
        width: 34px;
        height: 34px;
    }

    .highslide-loading {
        display: block;
        color: black;
        font-size: 9px;
        font-weight: bold;
        text-transform: uppercase;
        text-decoration: none;
        padding: 3px;
        border: 1px solid white;
        background-color: white;
        padding-left: 22px;
        background-repeat: no-repeat;
        background-position: 3px 1px;
    }

    a.highslide-credits,
    a.highslide-credits i {
        padding: 2px;
        color: silver;
        text-decoration: none;
        font-size: 10px;
        display: none;
    }

        a.highslide-credits:hover,
        a.highslide-credits:hover i {
            color: white;
            background-color: gray;
        }

    .highslide-move, .highslide-move * {
        cursor: move;
    }

    .highslide-viewport {
        display: none;
        position: fixed;
        width: 100%;
        height: 100%;
        z-index: 1;
        background: none;
        left: 0;
        top: 0;
    }

    .highslide-overlay {
        display: none;
    }

    .hidden-container {
        display: none;
    }
    /* Example of a semitransparent, offset closebutton */
    .closebutton {
        position: relative;
        top: -15px;
        left: 15px;
        width: 30px;
        height: 30px;
        cursor: pointer;
        /* NOTE! For IE6, you also need to update the highslide-ie6.css file. */
    }

    .highslide-controls {
        display: none;
    }
</style>
@section Scripts{
    <script type="text/javascript">
        function gridProduct_OnDataBinding(args) {
            var statusValue = $("#Status").data("tComboBox").value();
            if (statusValue === "")
                statusValue = 0;
            var customer = $("#Customer").data("tComboBox").value();
            if (customer === "")
                customer = 0;
            var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
            args.data = $.extend(args.data, {
                customerId: customer,
                status: statusValue,
                productCode: productCodeName
            });
        }

        function gridProductionSection_OnDataBinding() {
            index = 0;
            count = 0;
        }

        var index = 0;
        var count = 0;

        function gridProductionSection_OnRowDataBound(e) {
            var dataItem = e.dataItem;
            if (dataItem.PermisstionType == 1) {
                this.getElementsByClassName("t-button t-grid-edit t-button-icon")[index - count].parentNode.innerHTML = "";
                count++;
            }
            index++;
        }

        function gridProductionPlating_OnDataBinding() {
            indexP = 0;
            countP = 0;
        }

        var indexP = 0;
        var countP = 0;

        function gridProductionPlating_OnRowDataBound(e) {
            var dataItem = e.dataItem;
            if (dataItem.PermisstionType == 1) {
                this.getElementsByClassName("t-button t-grid-edit t-button-icon")[indexP - countP].parentNode.innerHTML = "";
                countP++;
            }
            indexP++;
        }

        function grid_OnSave(e) {
            //var message = CheckUpdate(e.values);
            //if (!message.startsWith("Oke")) {
            //    alert(message);
            //    return false;
            //} else
            //    return true;
        }

        function gridProduct_onEdit(e) {
            var mode = e.mode;
            var form = e.form;

            var statusName = $(form).find('#StatusName');
            //var statusNameData = $(form).find('#StatusName').data('tComboBox');

            if (mode == 'insert') {

            } else if (mode == 'edit') {
                var dataItem = e.dataItem;
                if (dataItem.Status != 5) {
                    var nodes = this.getElementsByClassName("t-widget t-combobox t-header");
                    nodes[0].parentNode.innerHTML = "<strong>" + statusName.val() + "</strong>";
                }
            }
        }

        //   MaterialNameDesign OutDiameterDesign ShapeDesign DiameterTypeDesign

        function CheckUpdate(data) {
            var a = "";
            if (data.Diameter == 0)
                a += "\nThiếu cập nhật đường kính";
            if (data.Length == 0)
                a += "\nThiếu cập nhật chiều dài";
            if (data.ProcessingTypeName == "" || data.ProcessingTypeName == null)
                a += "\nThiếu cập nhật loại máy";
            if (data.KnifeCut == 0)
                a += "\nThiếu cập nhật chiều dài dao cắt";
            if (data.Productivity == 0)
                a += "\nThiếu cập nhật năng suất";
            if (data.MilProductivity == 0)
                a += "\nThiếu cập nhật năng suất";
            if (data.ProductionRate == 0)
                a += "\nThiếu cập nhật định mức";
            if (data.MaterialNameDesign == "" || data.MaterialNameDesign == null)
                a += "\nThiếu cập nhật tên nguyên liệu thiết kế";
            if (data.OutDiameterDesign == 0)
                a += "\nThiếu cập nhật đường kính nguyên liệu";
            if (data.ShapeDesign == "" || data.ShapeDesign == null)
                a += "\nThiếu cập nhật hình dạng nguyên liệu";
            if (data.DiameterTypeDesign == "" || data.DiameterTypeDesign == null)
                a += "\nThiếu cập nhật dung sai nguyên liệu";
            if (a == "")
                a += "Oke";
            return a;
        }

        function status_onChange() {
            RefreshGrid("gridProduct");
        }

        function customer_onChange() {
            RefreshGrid("gridProduct");
        }

        function gridProductionProcess_OnDataBinding() {
            indexP2 = 0;
            countP2 = 0;
        }

        var indexP2 = 0;
        var countP2 = 0;

        function gridProductionProcess_OnRowDataBound(e) {
            var dataItem = e.dataItem;
            switch (dataItem.WarehouseId) {
            case 5:
                indexP2++;
                break;
            case 12:
                indexP2++;
                break;
            default:
                this.getElementsByClassName("t-icon t-plus")[indexP2 - countP2].parentNode.innerHTML = "";
                countP2++;
                indexP2++;
                break;
            }
            //if (dataItem.WarehouseId != 12) {
            //    this.getElementsByClassName("t-icon t-plus")[indexP2 - countP2].parentNode.innerHTML = "";
            //    countP2++;
            //}
            //if (dataItem.WarehouseId != 5) {
            //    this.getElementsByClassName("t-icon t-plus")[indexP2 - countP2].parentNode.innerHTML = "";
            //    countP2++;
            //}
            //indexP2++;
        }

        function gridProductionProcess_OnSave(e) {
            indexP2 = 0;
            countP2 = 0;
        }
    </script>

    <script type="text/javascript">
        hs.graphicsDir = '';
        hs.align = 'center';
        hs.transitions = ['expand', 'crossfade'];
        hs.outlineType = '';
        hs.fadeInOut = true;
        hs.numberPosition = 'caption';
        hs.dimmingOpacity = 0.75;

        // Add the controlbar
        if (hs.addSlideshow)
            hs.addSlideshow({
                //slideshowGroup: 'group1',
                interval: 5000,
                repeat: false,
                useControls: true,
                fixedControls: 'fit',
                overlayOptions: {
                    opacity: .75,
                    position: 'bottom center',
                    hideOnMouseOut: true
                }
            });
    </script>

    <script type="text/javascript">

        function gridProductionTool_onSave(e) {

            var $toolFullCode = $(e.cell).find('#ToolFullCode');
            if ($toolFullCode.length > 0) {
                var toolFullCode = $toolFullCode.data("tComboBox"),
                    toolFullCodeSelectItem = toolFullCode.selectedIndex > -1 ? toolFullCode.data[toolFullCode.selectedIndex] : null;

                if (toolFullCodeSelectItem) {
                    e.values["ToolFullCode"] = toolFullCodeSelectItem.Text;
                    e.values["ToolId"] = toolFullCodeSelectItem.Value;
                }
            }
        }

        function gridProductionFuel_onSave(e) {

            var $fuelFullCode = $(e.cell).find('#FuelFullCode');
            if ($fuelFullCode.length > 0) {
                var fuelFullCode = $fuelFullCode.data("tComboBox"),
                    fuelFullCodeSelectItem = fuelFullCode.selectedIndex > -1 ? fuelFullCode.data[fuelFullCode.selectedIndex] : null;

                if (fuelFullCodeSelectItem) {
                    e.values["FuelFullCode"] = fuelFullCodeSelectItem.Text;
                    e.values["FuelId"] = fuelFullCodeSelectItem.Value;
                }
            }
        }

    </script>
    }
    <div class="title">Quản lý thông tin sản phẩm (kế toán)</div>
