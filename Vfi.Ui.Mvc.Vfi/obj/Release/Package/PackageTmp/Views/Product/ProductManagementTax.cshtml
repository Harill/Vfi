                <div class="grid_1">
                    Mã KH
                </div>
                <div class="grid_4">
                    @{
                        Html.Telerik().ComboBox()
                            .Name("Customer")
                            .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new {area = "Sales"}))
                            .HtmlAttributes(new {style = "width: 150px"})
                            .DropDownHtmlAttributes(new {style = "width: 250px"})
                            .ClientEvents(events => events.OnChange("customer_onChange"))
                            .AutoFill(true)
                            .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                            .Render();
                    }
                </div>
                <div class="grid_2">
                    Tình trạng sản phẩm
                </div>
                <div class="grid_4">
                    @{
                        Html.Telerik().ComboBox()
                            .Name("Status")
                            .DataBinding(binding => binding.Ajax().Select("SelectComboBoxProductStatus", "Product"))
                            .HtmlAttributes(new {style = "width: 100%"})
                            .DropDownHtmlAttributes(new {style = "width: 250px"})
                            .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                            .HighlightFirstMatch(true)
                            .AutoFill(true)
                            .ClientEvents(events => events.OnChange("status_onChange"))
                            .Render();
                    }
                </div>
                <div class="grid_1">Sản phẩm</div>
                <div class="grid_5">
                    @{
                        Html.Telerik().AutoComplete()
