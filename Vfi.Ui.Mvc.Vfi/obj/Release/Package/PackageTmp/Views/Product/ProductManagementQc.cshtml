        function ActiveImg(ImgId) {
            $.ajax({
                type: 'post',
                data: { ImgId: ImgId},
                dataType: 'json',
                url: '@Url.Action("ActiveImg", "Product", new { area = "" })',
                timeout: 20000,
                success: function (res) {
                    if (res.Code != 1) {
                        // Nếu muốn vẫn xử lý lỗi, có thể log ra console thay vì alert
                        console.error("Lỗi ! " + res.Message);
                    } else {
