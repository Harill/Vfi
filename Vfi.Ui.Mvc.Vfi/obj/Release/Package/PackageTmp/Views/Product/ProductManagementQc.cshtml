@section Scripts{
    <script type="text/javascript">
        function grid_OnSave() {

            var statusValue = 0;
            var customer = $("#Customer").data("tComboBox").value();
            if (customer === "")
                customer = 0;
            var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
            e.values = $.extend(e.values,
                {
                    customer: customer,
                    statusValue: statusValue,
                    productCodeName: productCodeName,
                }
            );
        }

        function gridProduct_OnDataBinding(args) {
            //var statusValue = $("#Status").data("tComboBox").value();
            //if (statusValue === "")
            var statusValue = 0;
            var customer = $("#Customer").data("tComboBox").value();
            if (customer === "")
                customer = 0;
            var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
            args.data = $.extend(args.data, {
                customerId: customer,
                status: statusValue,
                productCode: productCodeName
            });
        }

        function customer_onChange() {
            RefreshGrid("gridProduct");
        }

        // QC

        function gridQcImg_OnSave(e) {
            var editRow = e.target.getElementsByClassName("t-grid-edit-row")[0];
            var ul2D = editRow.childNodes[3].childNodes[1].childNodes[1];

            if (ul2D != null) {
                var child2D = ul2D.childNodes;
                for (var i = child2D.length - 1; i >= 0; i--) {
                    if (child2D[i].childNodes[0].textContent === "uploaded") {
                        e.values.ImgUrl = child2D[0].childNodes[1].title;

                        // kiểm tra giá trị ImgUrl
                        if (!e.values.ImgUrl) {
                            console.log("ImgUrl hiện đang NULL hoặc rỗng");
                            alert("ImgUrl hiện đang NULL hoặc rỗng");
                        } else {
                            console.log("ImgUrl:", e.values.ImgUrl);
                            alert("ImgUrl: " + e.values.ImgUrl);
                        }

                        break;
                    }
                }
            }
            return true;
        }


        function gridQcImg_OnRowDataBound(e) {
            if (!e.dataItem.CanModify) {
                e.row.getElementsByClassName("t-button t-grid-edit t-button-icon")[0].parentNode.innerHTML = "";
                e.row.getElementsByClassName("t-button t-grid-delete t-button-icon")[0].parentNode.innerHTML = "";
            }
        }

        // product 

        function gridProductImg_OnSave(e) {
            //var i = 0;
            //var drawing2D = "";
            var editRow = e.target.getElementsByClassName("t-grid-edit-row")[0];
            var ul2D = editRow.childNodes[2].childNodes[1].childNodes[1];
            //if (ul2D == null && e.Upload === "" || typeof ul2D == 'undefined') {
            //    //drawing2D = e.dataItem.ImgUrl;
            //} else
            if (ul2D != null) {
                var child2D = ul2D.childNodes;
                for (var i = child2D.length - 1; i >= 0; i--) {
                    if (child2D[i].childNodes[0].textContent === "uploaded") {
                        e.values.ImgUrl = child2D[0].childNodes[1].title;
                        //drawing2D = child2D[0].childNodes[1].title;
                        break;
                    }
                }
            }
            return true;
        }

        function gridProductImg_OnRowDataBound(e) {
            if (!e.dataItem.CanModify) {
                e.row.getElementsByClassName("t-button t-grid-edit t-button-icon")[0].parentNode.innerHTML = "";
                e.row.getElementsByClassName("t-button t-grid-delete t-button-icon")[0].parentNode.innerHTML = "";
            }
        }

