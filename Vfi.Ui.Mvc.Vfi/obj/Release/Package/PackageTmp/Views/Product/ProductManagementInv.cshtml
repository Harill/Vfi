@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@using Vfi.Ui.Mvc.Vfi.Models.Production
@{
    ViewBag.Title = "Products Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">
        function gridProduct_OnDataBinding(args) {
            var customer = $("#Customer").data("tComboBox").value();
            if (customer === "")
                customer = 0;
            var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
            args.data = $.extend(args.data, {
                customerId: customer,
                status: 0,
                productCode: productCodeName
            });
        }

        function status_onChange() {
            RefreshGrid("gridProduct");
        }
        function customer_onChange() {
            RefreshGrid("gridProduct");
        }

        function grid_OnSave(e) {
            var customer = $("#Customer").data("tComboBox").value();
            if (customer === "")
                customer = 0;
            var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
            e.values = $.extend(e.values,
                {
                    customerId: customer,
                    status: 0,
                    productCodeFilter: productCodeName
                }
            );
        }
    </script>
}

<div class="title">Quản lý thông tin sản phẩm (kho)</div>
<div id="pnlInvPeriod">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">
    
        <fieldset>
            <legend>Tiêu chí trích lọc</legend>
            
           <div class="grid_1">
                    Mã KH
                </div>
                <div class="grid_4">
                     @{
                         Html.Telerik().ComboBox()
                             .Name("Customer")
                             .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new {area = "Sales"}))
                             .HtmlAttributes(new {style = "width: 150px"})
                             .DropDownHtmlAttributes(new {style = "width: 250px"})
                             .ClientEvents(events => events.OnChange("customer_onChange"))
                             .AutoFill(true)
                             .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                             .Render();
                     }
                </div>
               
                <div class="grid_1">Sản phẩm</div>
            <div class="grid_5">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeName")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv", new {area = "Inv"}))
                        .HtmlAttributes(new {style = "width: 150px; "})
                        .DropDownHtmlAttributes(new {style = "width: 250px; "})
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Value("")
                        //.ClientEvents(events => events.OnClose("ProductCodeName_OnClose"))
                        .Render();
                }
            </div>
              <button id="btnRefresh" class='t-button' onclick=" return RefreshGrid('gridProduct'); ">
                    <span class='t-icon t-insert'></span>
                   Làm mới
                </button>
        </fieldset>
    </div>
</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<ProductModel>()
            .Name("gridProduct")
            .DataKeys(key => key.Add(f => f.ProductId).RouteKey("productId"))
            //.ToolBar(
            //                            toolbar =>
            //                            toolbar.Insert().Text("Thêm công đoạn mới").ButtonType(GridButtonType.ImageAndText).ImageHtmlAttributes(new { style = "margin-left:0px;" }))

            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectProduct", "Product", new {area = "", active = true, status = 0, customerId = -1, productCode = "", productId = 0, productName = ""})
                                   //.Insert("InsertProduct", "Product", new { area = "" })
                                          .Update("UpdateProductManagementInv", "Product", new {area = "", customerId = 0, productCode = ""}))
            .Columns(columns =>
                {
                    columns.Command(command =>
                                    command.Edit().ButtonType(GridButtonType.Image).UpdateText("Cập nhật").CancelText("Hủy").Text("Sửa")
                        ).Width(50).Title("").HtmlAttributes(new {style = "text-align:center"});

                    columns.Bound(f => f.CustomerCode).Width(70).ReadOnly(true)
                           .HeaderTemplate("<strong>Mã</br>KH</strong>")
                           .HeaderHtmlAttributes(new {style = "text-align:center;"})
                           .HtmlAttributes(new {style = "text-align:center;"})
                           .ClientTemplate("<strong><#= CustomerCode #></strong>");

                    columns.Bound(f => f.ProductCode).Width(100).ReadOnly(true)
                           .HeaderTemplate("<strong>Mã</br>SP</strong>")
                           .HeaderHtmlAttributes(new {style = "text-align:center"})
                           .ClientTemplate("<strong><#= ProductCode #></strong>");

                    columns.Bound(f => f.ProductionRate).Width(70)
                           .HeaderTemplate("Định mức SP</br>(pcs/cây)");

                    columns.Bound(f => f.ProductionWeight).Width(70)
                           .HeaderTemplate("Trọng lượng</br>SX");
                    columns.Bound(f => f.CncWeight).Width(70)
                           .HeaderTemplate("Trọng lượng</br>CNC");
                    columns.Bound(f => f.Production2Weight).Width(70)
                           .HeaderTemplate("Trọng lượng</br>SX2");
                    columns.Bound(f => f.HeatTreatmentWeight).Width(70)
                           .HeaderTemplate("Trọng lượng</br>nhiệt luyện");
                    columns.Bound(f => f.SurfaceTreatmentWeight).Width(70)
                           .HeaderTemplate("Trọng lượng</br>rung bóng");
                    columns.Bound(f => f.WaitingPlatingWeight).Width(70)
                           .HeaderTemplate("Trọng lượng</br>trước xi");
                    columns.Bound(f => f.PlatingWeight).Width(70)
                           .HeaderTemplate("Trọng lượng</br>sau xi");
                    columns.Bound(f => f.QcWeight).Width(70)
                           .HeaderTemplate("Trọng lượng</br>QC");
                })
            .ClientEvents(events => events.OnDataBinding("gridProduct_OnDataBinding")
                                          .OnError("grid_OnError"))
            //.Pageable(page => page.PageSize(7))
            //.Editable(editing => editing.Mode(GridEditMode.InLine))
            .Selectable()
            .Scrollable(f => f.Height(510))
            .Resizable(f => f.Columns(true))
            .Reorderable(f => f.Columns(true))
            .Filterable()
            .Sortable()
            .Render();
    }
</div>
