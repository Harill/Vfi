<div class="title">
    @*Quản lý thông tin sản phẩm (sản xuất)*@
    @HttpContext.GetGlobalResourceObject("Resource", "ProductManagementProduction")

</div>
<div id="pnlInvPeriod">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">

        <div class="grid_3">
            @*Ngày thống kê*@
            @HttpContext.GetGlobalResourceObject("Resource", "StatisticalDate")
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("FromDate")
                    .Format("dd/MM/yyyy")
                    .Value(new DateTime(DateTime.Now.Year, 1, 1))
                    .Render();
            }
        </div>
        <button id="btnPrintList" class='t-button' onclick=" return PrintTechnicalList();">
            <span class='t-icon t-insert'></span>
            @*Danh sách tổng hợp kỹ thuật*@
            @HttpContext.GetGlobalResourceObject("Resource", "TechnicalSummaryList")
        </button>
        <fieldset>
            <legend>
                @*Tiêu chí trích lọc*@
                @HttpContext.GetGlobalResourceObject("Resource", "Filter")
            </legend>

            <div class="grid_1_5">
                @*Mã KH*@
                @HttpContext.GetGlobalResourceObject("Resource", "CustomerCode2")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Customer")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                        .HtmlAttributes(new { style = "width: 150px" })
                        .DropDownHtmlAttributes(new { style = "width: 250px" })
                        //.ClientEvents(events => events.OnChange("customer_onChange"))
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>
            <div class="grid_2">
                @*Tình trạng sản phẩm*@
                @HttpContext.GetGlobalResourceObject("Resource", "ProductStatus")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Status")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxProductStatus", "Product"))
                        .HtmlAttributes(new { style = "width: 100%" })
                        .DropDownHtmlAttributes(new { style = "width: 250px" })
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .HighlightFirstMatch(true)
                        .AutoFill(true)
                        .ClientEvents(events => events.OnChange("status_onChange"))
                        .Render();
                }
            </div>
            <div class="grid_1_5">
                @*Sản phẩm*@
                @HttpContext.GetGlobalResourceObject("Resource", "Product")
            </div>
            <div class="grid_5">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeName")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv", new { area = "Inv" }))
                        .HtmlAttributes(new { style = "width: 150px; " })
                        .DropDownHtmlAttributes(new { style = "width: 250px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Value("")
                        //.ClientEvents(events => events.OnClose("ProductCodeName_OnClose"))
                        .Render();
                }
            </div>
            <button id="btnRefresh" class='t-button' onclick=" return RefreshGrid('gridProduct'); ">
                <span class='t-icon t-insert'></span>
                @*Làm mới*@
                @HttpContext.GetGlobalResourceObject("Resource", "Refresh")
            </button>
        </fieldset>
    </div>
</div>

<div class="cover-div">
    @{
        Html.Telerik().Grid<ProductModel>()
            .Name("gridProduct")
            .DataKeys(key => key.Add(f => f.ProductId).RouteKey("productId"))
            //.ToolBar(
            //                            toolbar =>
            //                            toolbar.Insert().Text("Thêm công đoạn mới").ButtonType(GridButtonType.ImageAndText).ImageHtmlAttributes(new { style = "margin-left:0px;" }))

            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectProduct1", "Product", new { area = "", active = true, status = 0, customerId = -1, productCode = "", productId = 0, productName = "" })
                    //.Insert("InsertProduct", "Product", new { area = "" })
                                          .Update("UpdateProductManagementProduction", "Product", new { area = "" }))
            .Columns(columns => {
                columns.Command(command =>
                                command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)
                                    .CancelText(@HttpContext.GetGlobalResourceObject("Resource", "CancelText").ToString())
                                    .UpdateText(@HttpContext.GetGlobalResourceObject("Resource", "UpdateText").ToString())
                                    .Text(@HttpContext.GetGlobalResourceObject("Resource", "EditText").ToString())
                    ).Width(30).Title("").HtmlAttributes(new { style = "text-align:center" });
             
                columns.Bound(f => f.Upload2D).Width(40)
                    //.Title("Bản vẽ")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Blueprint").ToString())
                    .ReadOnly(true)
                    .ClientTemplate("<a id='<#=ProductId#>' href='" + Url.Content("~/Content/FileUpload/Drawing/") + "<#=Upload2D#>?<#=UploadDate#>' class='highslide' onclick='return hs.expand(this)'>" +
                                       "<img src='" + Url.Content("~/Content/FileUpload/Drawing/") + "<#=Upload2D#>?<#=UploadDate#>' height='40' width='40' title='Mở lớn'/>" +
                                       "</a><div class='highslide-caption'><#= ProductCode #></div>");
              
                columns.Bound(f => f.UploadReal).Width(40)
                    //.Title("Hình SP")
