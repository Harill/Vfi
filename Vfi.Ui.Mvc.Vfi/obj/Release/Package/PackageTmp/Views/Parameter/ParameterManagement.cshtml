
@using Vfi.Ui.Mvc.Vfi.Models.Production
@{
    ViewBag.Title = "Parameter Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="title">Tham số hệ thống</div>

<div class="cover-div">
@{
    Html.Telerik().Grid<ParameterModel>()
        .Name("gridParameter")
        .DataKeys(keys => keys.Add(f => f.ParamId).RouteKey("paramId"))
        .DataBinding(dataBinding=>dataBinding.Ajax()
            .Select("SelectParam", "Parameter")
            .Update("UpdateParam", "Parameter")
        )
        .Columns(columns=> {
                         columns.Command(cmd => cmd.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(100);
                         columns.Bound(f => f.ParamCode).ReadOnly(true);
                         columns.Bound(f => f.Name);
                         columns.Bound(f => f.Value).Width(100);
                         columns.Bound(f => f.ModifiedDate).Width(100).Title("Ngày chỉnh").ReadOnly(true)
                                .Format("{0:dd/MM/yyyy HH:mm}");
                     })
        .ClientEvents(events => events.OnError("grid_OnError"))
        .Render();
}
</div>

