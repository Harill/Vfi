    @* 13/08/2026 *@
     

<script type="text/javascript">
    var gridUser = $('#GridUser').data('tGrid');
    var displayedUserId = null; // biến toàn cục để lưu userId đang hiển thị

    // Hiển thị quyền của user
    function displayCheckedUsers() {
        var gridUser = $('#GridUser').data('tGrid');
        var $userId = $("input[name='rdioUser']:checked").val();

        if (!$userId || $userId.length < 1) {
            alert('Check a few grid rows first.');
            resetForm();
            return;
        } else {
            startForm();
            displayedUserId = $userId; // lưu userId hiển thị để so sánh sau

            $('#result').load('@Url.Action("DisplayCheckedUserForFunction", "User")',
            {
                userId: $userId
            });
        }
    }

    // Gán quyền cho user
    function createFunctionForUser() {
        var $checkedRecords = $("input[name='IsUserFunction']:checked");
        var $userId = $("input[name='rdioUser']:checked").val();

        // So sánh userId hiển thị và userId gửi đi
        if (displayedUserId !== $userId) {
            alert("Lỗi: User đang hiển thị không phải User được phân quyền!");
            return false;
        }

        var a = {};
        var ids = "";
        alert($checkedRecords.length);

        for (var i = 0; i < $checkedRecords.length; i++) {
            a[i] = $checkedRecords[i].value;
            ids += $checkedRecords[i].value;
            if (i < ($checkedRecords.length - 1))
                ids += ":";
        }

        try {
            $.post("@strAssignPermissionForUser",
                {
                    checkedRecords: a,
                    userId: $userId
                },
                function (data) {
                    alert("Create Function Successful !");
                    resetForm();
                });
        } catch (err) {
            alert("Có Lỗi !");
        }
        return false;
    }
</script>





<div class="title">User Function</div>

<div class="t-info-sha">
    
    <div class="userDiv">
        <button class="t-button t-state-default" onclick="displayCheckedUsers()">Check users</button>
        @{
            var gridUser = Html.Telerik().Grid<UserModel>();
    
            gridUser.Name("GridUser");
            gridUser.DataKeys(key => key.Add(u => u.UserId));
            gridUser.DataBinding(dataBindings => dataBindings.Ajax()
                                                             .Select("SelectActiveUser", "User"));
            gridUser.Columns(columns =>
                {
                    columns.Bound(u => u.Username)
                           .ClientTemplate("<input type='radio' name='rdioUser'value='<#= UserId #>' />")
                           .Title("Check").Width(35)
                           .HtmlAttributes(new {style = "text-align:center"});
                    columns.Bound(u => u.Username).Width(100);
                    columns.Bound(u => u.FullName).Width(200);
                });
            gridUser.Sortable();
            gridUser.Footer(false);
            gridUser.Render();
        }
    </div>

    <div class="functionDiv">
        <input type="button" class="t-button t-state-default" onclick="return createFunctionForUser();" 
               id="btnCreateFunction" name="btnCreateFunction" value="Create Function For User/Group " />

        <div id="result"></div>
    </div>
    <div class="clear"></div>
</div>

