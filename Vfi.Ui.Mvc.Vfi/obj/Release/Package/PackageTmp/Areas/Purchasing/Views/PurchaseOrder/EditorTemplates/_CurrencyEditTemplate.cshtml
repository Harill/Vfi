@{
    Html.Telerik().ComboBox()
        .Name(ViewData.TemplateInfo.GetFullHtmlFieldName(string.Empty))
        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCurrency", "Currency", new { area = "" }).Delay(350))
        .HtmlAttributes(new { style = "width: 50px" })
        .DropDownHtmlAttributes(new { style = "width: 150px" })
        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
        .HighlightFirstMatch(true)
        .AutoFill(true)
        //.ClientEvents(events => events.OnDataBinding("material_onDataBinding"))
        .Render();
}
