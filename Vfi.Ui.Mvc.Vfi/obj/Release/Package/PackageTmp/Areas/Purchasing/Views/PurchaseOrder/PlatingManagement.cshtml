                        .HtmlAttributes(new {style = "text-align:right"})
                        .ClientTemplate("<#= ExchangeRate == null ? 0 : $.telerik.formatString('{0:n0}', ExchangeRate) #>");
                    columns.Bound(f => f.TotalExportPrice).Width(100).Title("Tiền xuất").ReadOnly(true)
                        .Filterable(false)
                        .HtmlAttributes(new {style = "text-align:right"})
                        .Format("{0:n0}")
                        .FooterHtmlAttributes(new {style = "text-align: right;"})
                        .Aggregate(agg => agg.Sum())
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                        .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>");
                    columns.Bound(f => f.TotalImportPrice).Width(100).Title("Tiền nhập").ReadOnly(true)
                        .Filterable(false)
                        .HtmlAttributes(new {style = "text-align:right"})
                        .Format("{0:n0}")
                        .FooterHtmlAttributes(new {style = "text-align: right;"})
                        .Aggregate(agg => agg.Sum())
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                        .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>");
                    columns.Bound(f => f.Note).Title("Ghi chú");
                    columns.Bound(f => f.CreateUser).Width(75).Title("Người tạo").ReadOnly(true);
                    columns.Bound(f => f.CreateDate).Title("Ngày tạo").Width(90).ReadOnly(true)
                        .Format("{0:dd/MM/yyyy HH:mm}");
                    
                })
                .DetailView(details => details.ClientTemplate(
                    Html.Telerik().TabStrip()
                        .Name("TabStrip_<#= FormId #>")
                        .SelectedIndex(0)
                        .Items(items =>
                        {
                            items.Add().Text("Thông tin chi tiết").Content(
                                Html.Telerik().Grid<PlatingDetailModel>()
                                    .Name("gridDetail_<#= FormId #>")
                                    .DataKeys(keys => keys.Add(f => f.DetailId).RouteKey("detailId"))
                                    .DataBinding(dataDindings => dataDindings.Ajax()
                                        .Select("SelectPlatingFormDetail", "PurchaseOrder",
                                            new { formId = "<#= FormId #>" })
                                        .Update("UpdatePlatingFormDetail", "PurchaseOrder")
                                    )
                                    .Columns(columns =>
                                    {
                                        columns.Command(command => command.Edit().ButtonType(GridButtonType.Image)).Width(50).Title("");
                                        columns.Bound(f => f.ProductCode).Width(200).Title("Mã SP").ReadOnly(true);
                                        columns.Bound(f => f.UnitPrice).Width(100).Title("Đơn giá")
                                            .HtmlAttributes(new { style = "text-align:right" })
                                        .ClientTemplate("<#= UnitPriceString #>");
                                        columns.Bound(f => f.Unit).Width(50).Title("ĐVT").ReadOnly(true);
                                        columns.Bound(f => f.QuantityRequirement).Width(100).Title("SL yêu cầu").ReadOnly(true)
                                            .HtmlAttributes(new {style = "text-align:right"})
                                            .Format("{0:n0}");
                                        columns.Bound(f => f.ExportString).Width(100).Title("SL xuất").ReadOnly(true)
                                            .HtmlAttributes(new {style = "text-align:right"});
                                        columns.Bound(f => f.ImportString).Width(100).Title("SL nhập").ReadOnly(true)
                                            .HtmlAttributes(new {style = "text-align:right"});
                                        columns.Bound(f => f.ExportDateRequirement).Width(90).Title("Ngày xuất").ReadOnly(true)
                                            .ClientTemplate("<#= ExportDateRequirement == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', ExportDateRequirement) #>");

                                        columns.Bound(f => f.ImportDateRequirement).Width(90).Title("Ngày giao").ReadOnly(true)
                                            .ClientTemplate("<#= ImportDateRequirement == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', ImportDateRequirement) #>");
                                        columns.Bound(f => f.Note).Title("Ghi chú");
                                    })
                                    .ClientEvents(events => events.OnError("grid_OnError")
                                        .OnRowDataBound("gridDetail_OnRowDataBound"))
                                    .ToHtmlString()
                                );
                            items.Add().Text("Phiếu xuất kho").Content(
                                Html.Telerik().Grid<ExportGCN_NCUModel>()
                                    .Name("gridExport_<#= FormId #>")
                                    .DataBinding(dataDindings => dataDindings.Ajax()
                                        .Select("SelectExportPlating", "PurchaseOrder",
                                            new { formId = "<#= FormId #>" })
                                            )
                                    .Columns(columns => {
                                        columns.Bound(f => f.ExportDate).Width(100).Title("Ngày xuất")
                                                .Format("{0:dd/MM/yyyy}");
                                        columns.Bound(f => f.TransactionCode).Width(120).Title("Mã giao dịch");
                                        columns.Bound(f => f.TotalNumber).Width(70).Title("Tổng SL (pcs)")
                                            .Format("{0:n0}")
                                            .HtmlAttributes(new { style = "text-align:right" });
                                        columns.Bound(f => f.TotalWeight).Width(70).Title("Tổng TL (g)")
                                            .Format("{0:n0}")
                                            .HtmlAttributes(new { style = "text-align:right" });
                                        columns.Bound(f => f.TransactionId).Title("Biễu mẫu").Width(45)
                                            .ClientTemplate("<input type='button' id='id_<#= ExportFormId #>' value='In'  class='t-button' onclick=PrintPlatingForm(<#= ExportFormId #>) />")
                                            .HtmlAttributes(new { style = "text-align:center" });
                                        columns.Bound(f => f.TransactionId).Title("PXK").Width(45)
