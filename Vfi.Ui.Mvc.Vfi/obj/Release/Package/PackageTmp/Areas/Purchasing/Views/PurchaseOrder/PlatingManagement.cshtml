                                        columns.Bound(f => f.ProductCode).Width(120).Title("Mã SP").ReadOnly(true);
                                        columns.Bound(f => f.PlatingCode).Width(120).Title("Mã xi mạ");

                                        columns.Bound(f => f.Thickness).Width(100)
                                            .HeaderTemplate("Độ dày (µm)");
                                        columns.Bound(f => f.SaltSprayTime).Width(100)
