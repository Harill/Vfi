                                        columns.Bound(f => f.SpecialRequest).Width(150).Title("Yêu cầu");
                                        columns.Bound(f => f.Sample).Width(100)
                                            .HeaderTemplate("Mẫu SP (pcs)");
                                        columns.Bound(f => f.TestingEquipment).Width(100).Title("Thiết bị KT");
