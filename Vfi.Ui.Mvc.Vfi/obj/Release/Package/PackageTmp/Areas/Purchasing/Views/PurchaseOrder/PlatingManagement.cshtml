                    columns.Bound(f => f.VendorCodeName).Width(150).Title("Nhà cung cấp").ReadOnly(true);
                    columns.Bound(f => f.PlatingTypeName).Width(100).Title("Loại");
                    columns.Bound(f => f.CreateDate).Width(90).Title("Ngày nhập").ReadOnly(true)
                        .Format("{0:dd/MM/yyyy}");
                    columns.Bound(f => f.PlatingFormNumber).Width(100).Title("Số phiếu").ReadOnly(true);
                    columns.Bound(f => f.CurrencyCode).Width(50).Title("Tiền tệ")
                        .HtmlAttributes(new {style = "text-align:right"});
                    columns.Bound(f => f.ExchangeRate).Width(70).Title("Tỉ giá")
