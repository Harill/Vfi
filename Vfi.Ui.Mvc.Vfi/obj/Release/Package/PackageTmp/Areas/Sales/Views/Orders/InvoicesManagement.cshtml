                                                   .ClientTemplate("<#= Number == null ? 0 : $.telerik.formatString('{0:n0}', Number) #>")
                                                   .Aggregate(agg => agg.Sum())
                                                   .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                                   .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                                   .FooterHtmlAttributes(new { style = "text-align: right;" });
                                            columns.Bound(f => f.StartDateStr).Width(175).ReadOnly(true).Title("Ngày bắt đầu");
                                                   //.ClientTemplate("<#= StartDate == null ? '' : $.telerik.formatString('{0:HH:mm dd/MM/yyyy }', StartDate) #>");
                                            columns.Bound(f => f.EndDateStr).Width(175).ReadOnly(true).Title("Ngày kết thúc");
                                                   //.ClientTemplate("<#= EndDateStr == null ? '' : $.telerik.formatString('{0:HH:mm dd/MM/yyyy }', EndDate) #>");
                                            columns.Bound(f => f.NoteDetail).Title("Ghi chú");
                                            
                                        })
                                        .ToHtmlString()
                                );
                                items.Add().Text("Giấy chứng nhận NL").Content(
                                     Html.Telerik().Grid<InvoiceDetailTempModel>()
                                        .Name("gridMaterialImg_<#= ExportId #>")
                                        .DataKeys(key => key.Add(f => f.TransactionCode).RouteKey("transactionCode"))
                                        .DataBinding(dataDindings =>
                                                     dataDindings.Ajax()
                                                                 .Select("SelectMaterialCertificateByExportId", "Orders", new { exportId = "<#= ExportId #>" }))
                                         .Columns(columns => {
                                             columns.Bound(f => f.Index).Title("STT").Width(50)
                                                    .HtmlAttributes(new { style = "text-align: center;" });
                                             columns.Bound(f => f.ProductCodeDetail).Title("Sản phẩm").Width(150);
                                             columns.Bound(f => f.MaterialCode).Title("Nguyên liệu").Width(200);
                                             columns.Bound(f => f.LotNumber).Title("Lô").Width(150);
                                             
                                             // kieu 1
                                             columns.Bound(f => f.InfoImg).Width(65).Title("Giấy</br>CN NCC").Filterable(false)
                                                 .ClientTemplate("<a id='<#=MaterialId#>' href='" + Url.Content("~/Content/FileUpload/CertificateMaterial/") + "<#=InfoImg#>' class='highslide' onclick='return hs.expand(this)'>" +
                                                                 "<img src='" + Url.Content("~/Content/FileUpload/CertificateMaterial/") + "<#=InfoImg#>' height='30' width='40' title='Mở lớn'/>" + "</a>"
                                                                 //<div class='highslide-caption'><#= MaterialCode #></div>")
                                                                 )
                                                  .HtmlAttributes(new { style = "text-align: center;" });

                                             columns.Bound(f => f.InfoImg2).Width(65).Title("Giấy</br>CN VF").Filterable(false)
                                                 .ClientTemplate("<a id='<#=MaterialId#>_2' href='" + Url.Content("~/Content/FileUpload/CertificateMaterial2/") + "<#=InfoImg2#>' class='highslide' onclick='return hs.expand(this)'>" +
                                                                 "<img src='" + Url.Content("~/Content/FileUpload/CertificateMaterial2/") + "<#=InfoImg2#>' height='30' width='40' title='Mở lớn'/>" + "</a>"
                                                                //<div class='highslide-caption'><#= MaterialCode #></div>")
                                                                 )
                                                .HtmlAttributes(new { style = "text-align: center;" });
                                            
                                             // kieu 2
                                             //columns.Bound(f => f.InfoImg).Width(200).Title("Giấy CN NCC(2)").Filterable(false)
                                             //   .ClientTemplate("<a id='<#=MaterialId#>' href='" + Url.Content("~/Content/FileUpload/CertificateMaterial/") + "<#=InfoImg#>'target='_blank'>" +
                                             //                   "<#=MaterialCode#></a>");

                                             //columns.Bound(f => f.InfoImg2).Width(200).Title("Giấy CN VF(2)").Filterable(false)
                                             //    .ClientTemplate("<a id='<#=MaterialId#>_2' href='" + Url.Content("~/Content/FileUpload/CertificateMaterial2/") + "<#=InfoImg2#>'target='_blank'>" +
                                             //                    "<#=MaterialCode#></a>");

                                             
                                             columns.Bound(f => f.Number).Title("Số lượng </br>(PCS)").Width(100)
                                                    .HtmlAttributes(new { style = "text-align: right;" })
                                                    .ClientTemplate("<#= Number == null ? 0 : $.telerik.formatString('{0:n0}', Number) #>")
                                                    .Aggregate(agg => agg.Sum())
                                                    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                                    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                                    .FooterHtmlAttributes(new { style = "text-align: right;" });

                                             columns.Bound(f => f.ImportDate).Title("Ngày nhập NL").Width(100)
                                                    .HtmlAttributes(new { style = "text-align: center;" });

                                             columns.Bound(f => f.LastUsedDate).Title("Ngày cuối</br>SD NL").Width(100)
                                                    .HtmlAttributes(new { style = "text-align: center;" });

                                         })
                                         .ToHtmlString());
                                items.Add().Text("Chứng nhận đính kèm").Content(
                                     Html.Telerik().Grid<InvoiceImgModel>()
                                         .Name("gridInvoiceImg_<#= InvoiceId #>")
                                         .DataKeys(key => key.Add(f => f.ImgId).RouteKey("imgId"))
                                         .ToolBar(
                                             toolbar =>
                                             toolbar.Insert().Text("Thêm mới").ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).ImageHtmlAttributes(new { style = "margin-left:0px;" }))
                                         .DataBinding(
                                             dataBinding => dataBinding.Ajax()
                                                                       .Select("SelectInvoiceImgById", "Orders", new { area = "", invoiceId = "<#= InvoiceId #>" })
                                                                       .Insert("InsertInvoiceImg", "Orders", new { area = "", invoiceId = "<#= InvoiceId #>" })
                                                                       .Update("UpdateInvoiceImg", "Orders", new { area = "", invoiceId = "<#= InvoiceId #>" })
                                                                       .Delete("DeleteInvoiceImg", "Orders", new { area = "", invoiceId = "<#= InvoiceId #>" })
                                         )
                                         .Columns(columns => {
                                             columns.Command(command =>
                                                             command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)
                                                 ).Width(40).Title("").HtmlAttributes(new { style = "text-align:center" });
                                             columns.Bound(f => f.Name).Title("Tên ảnh").Width(70);
                                             columns.Bound(f => f.ImgUrl).Width(40).Title("Bản vẽ")
                                                    .ClientTemplate("<a id='<#=ImgId#>' href='" + Url.Content("~/Content/FileUpload/InvoiceImg/") + "<#=ImgUrl#>?<#=UploadDate#>' class='highslide' onclick='return hs.expand(this)'>" +
                                                                    "<img src='" + Url.Content("~/Content/FileUpload/InvoiceImg/") + "<#=ImgUrl#>?<#=UploadDate#>' height='40' width='40' title='Mở lớn'/>" 
                                                                    //+ "</a><div class='highslide-caption'><#= Name #>-<#= Description #></div>"
                                                                    )
                                                    .HtmlAttributes(new { style = "text-align:center" });
                                             columns.Bound(f => f.Description).Title("Mô tả").Width(140);
                                             //columns.Bound(f => f.Step).Title("Thứ tự").Width(70);
                                             columns.Bound(f => f.ModifiedUser).Title("Người tạo").ReadOnly(true).Width(60);
                                             columns.Bound(f => f.ModifiedDate).Title("Ngày tạo").ReadOnly(true).Width(80)
                                                    .Format("{0:HH:mm - dd/MM/yyyy }")
                                                    .HtmlAttributes(new { style = "text-align:center" });
                                             columns.Command(commands => commands.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(30).Title("Xoá")
                                                    .HtmlAttributes(new { style = "text-align:center" });
                                         })
                                         .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
                                         .ClientEvents(e => e.OnError("grid_OnError")
                                             .OnSave("gridInvoiceImg_OnSave")
                                             .OnRowDataBound("gridInvoiceImg_OnRowDataBound")
                                             )
                                         .ToHtmlString());
                            })
                        .ToHtmlString()))
                .Selectable()
                .ClientEvents(events => events.OnRowSelect("grid_OnRowSelect")
                                              .OnDataBinding("GridVND_OnDataBinding")
                                              .OnDataBound("OnLoadedData")
                )
                .Scrollable(f => f.Height(600))
                .Sortable()
                .Filterable()
                .Resizable(resizing => resizing.Columns(true))
                .Scrollable()
                .Render();
                }
                
    </div>

