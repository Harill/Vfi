}



    <script type="text/javascript">
        hs.graphicsDir = '';
        hs.align = 'center';
        hs.transitions = ['expand', 'crossfade'];
        hs.outlineType = '';
        hs.fadeInOut = true;
        hs.numberPosition = 'caption';
        hs.dimmingOpacity = 0.75;

        // Add the controlbar
        if (hs.addSlideshow)
            hs.addSlideshow({
                //slideshowGroup: 'group1',
                interval: 5000,
                repeat: false,
                useControls: true,
                fixedControls: 'fit',
                overlayOptions: {
                    opacity: .75,
                    position: 'bottom center',
                    hideOnMouseOut: true
                }
            });
    </script>
@section Scripts{
    <script type="text/javascript">
        function GridVND_OnDataBinding(args) {

            var statusValue = $("#Status").data("tComboBox").value();
            if (statusValue === "")
                statusValue = 0;
            var fromDate = $("#fromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#toDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
            }

            //    if (customerId == 0)
            //        customerId = 0;

            args.data = $.extend(args.data, {
                fromDate: fromDate,
                toDate: toDate,
                status: statusValue,
                currency: "VND"
            });
        }

        function gridInvoiceImg_OnSave(e) {
            //var i = 0;
            //var drawing2D = "";
            var editRow = e.target.getElementsByClassName("t-grid-edit-row")[0];
            var ul2D = editRow.childNodes[2].childNodes[1].childNodes[1];
            //if (ul2D == null && e.Upload === "" || typeof ul2D == 'undefined') {
            //    //drawing2D = e.dataItem.ImgUrl;
            //} else
            if (ul2D != null) {
                var child2D = ul2D.childNodes;
                for (var i = child2D.length - 1; i >= 0; i--) {
                    if (child2D[i].childNodes[0].textContent === "uploaded") {
                        e.values.ImgUrl = child2D[0].childNodes[1].title;
                        //drawing2D = child2D[0].childNodes[1].title;
                        break;
                    }
                }
            }
            return true;
        }

        function gridInvoiceImg_OnRowDataBound(e) {
            if (!e.dataItem.CanModify) {
                e.row.getElementsByClassName("t-button t-grid-edit t-button-icon")[0].parentNode.innerHTML = "";
                e.row.getElementsByClassName("t-button t-grid-delete t-button-icon")[0].parentNode.innerHTML = "";
            }
        }



        var onLoading = false;
        function OnLoadingData() {
            if (!onLoading) {
                onLoading = true;
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (Chờ load)";
                    loading.classList.add('loading');
                }
            }
        }
        function OnLoadedData() {
            if (onLoading) {
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    if (loading && loading.className.includes("loading")) {
                        loading.classList.remove('loading');
                        loading.innerHTML = "<span></span>";
                    }
                }
                onLoading = false;
            }


        } function RefreshGrid2(name) {
            if (!onLoading) {
                OnLoadingData();
                startGrid = true;
                RefreshGrid(name);
            }
        }

        function status_onChange() {
            RefreshGrid("gridInvoice");
        }

        function status_onload() {
            var combobox = $('#Status').data('tComboBox');
            var dataSource =
            [
                { Text: "Chưa xuất HĐ", Value: "1" },
                { Text: "Đã xuất HĐ", Value: "2" },
                { Text: "Huỷ", Value: "3" }
            ];

            combobox.dataBind(dataSource);
        }

        function fromMonth_onLoad() {
            var combobox = $('#FromMonth').data('tDropDownList');
            var dataSource =
            [
                { Text: "1", Value: "1" },
                { Text: "2", Value: "2" },
                { Text: "3", Value: "3" },
                { Text: "4", Value: "4" },
                { Text: "5", Value: "5" },
                { Text: "6", Value: "6" },
                { Text: "7", Value: "7" },
                { Text: "8", Value: "8" },
                { Text: "9", Value: "9" },
                { Text: "10", Value: "10" },
                { Text: "11", Value: "11" },
                { Text: "12", Value: "12" }
            ];

            combobox.dataBind(dataSource);
            combobox.value(new Date().getMonth() + 1);
        }

        function toMonth_onLoad() {
            var combobox = $('#ToMonth').data('tDropDownList');
            var dataSource =
            [
                { Text: "1", Value: "1" },
                { Text: "2", Value: "2" },
                { Text: "3", Value: "3" },
                { Text: "4", Value: "4" },
                { Text: "5", Value: "5" },
                { Text: "6", Value: "6" },
                { Text: "7", Value: "7" },
                { Text: "8", Value: "8" },
                { Text: "9", Value: "9" },
                { Text: "10", Value: "10" },
                { Text: "11", Value: "11" },
                { Text: "12", Value: "12" }
            ];

            combobox.dataBind(dataSource);
            combobox.value(new Date().getMonth() + 1);
        }

        function PrintInvoiceForm(val) {
            $('#result').load('@Url.Action("PrintInvoice", "Inv", new { area = "Inv" })',
                {
                    invoiceId: val,
                    showPrice: true,
                }, function () {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }

        function PrintInvoiceExportForm(val) {
            $('#result').load('@Url.Action("PrintInvoice", "Inv", new { area = "Inv" })',
                {
                    invoiceId: val
                }, function (data) {
                    //alert(data);
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }

        function PrintCustomerIncome(formType) {
            if (!onLoading) {
                OnLoadingData();
            var customerId = $("#cboCustomer").data('tComboBox').value();
            if (customerId === 0 || customerId === "")
                customerId = 0;
            var fromMonth = $("#FromMonth").data("tDropDownList").value();
            if (fromMonth === null)
                fromMonth = new Date().getMonth() + 1;
            var fromYear = $("#FromYear").val();
            if (fromYear === null || fromYear === "")
                fromYear = new Date().getYear() + 1;
            var toMonth = $("#ToMonth").data("tDropDownList").value();
            if (toMonth === null)
                toMonth = new Date().getMonth() + 1;
            var toYear = $("#ToYear").val();
            if (toYear === null || toYear === "")
                toYear = new Date().getYear() + 1;
            switch (formType) {
                case 1:
                    $('#result').load('@Url.Action("PrintCustomerIncome", "Inv", new { area = "Inv" })',
                        {
                            customerById: customerId,
                            fromMonth: fromMonth,
                            fromYear: fromYear,
                            toMonth: toMonth,
                            toYear: toYear
                        }, function () {
                            OnLoadedData();
                            var window = $('#windowReport').data('tWindow');
                            window.open();
                        });
                    break;
                case 2:
                    $('#result').load('@Url.Action("PrintCustomerIncome2", "Inv", new { area = "Inv" })',
                        {
                            customerById: customerId,
                            fromMonth: fromMonth,
                            fromYear: fromYear,
                            toMonth: toMonth,
                            toYear: toYear
                        }, function () {
                            OnLoadedData();
                            var window = $('#windowReport').data('tWindow');
                            window.open();
                        });
                    break;
                case 3:
                    $('#result').load('@Url.Action("PrintCustomerIncome3", "Inv", new { area = "Inv" })',
                        {
                            customerById: customerId,
                            fromMonth: fromMonth,
                            fromYear: fromYear,
                            toMonth: toMonth,
                            toYear: toYear
                        }, function () {
                            OnLoadedData();
                            var window = $('#windowReport').data('tWindow');
                            window.open();
                        });
                    break;
                default:
            }
            }
            return false;
        }
        // Định nghĩa constructor ReportViewer
        function ReportViewer(previewFrameID, defaultPrintFormat) {
            this.previewFrameID = previewFrameID;
            this.defaultPrintFormat = defaultPrintFormat;
        }

        ReportViewer.prototype.PrintReport = function () {
            switch (this.defaultPrintFormat) {
                case "Default":
                    this.DefaultPrint();
                    break;
                case "PDF":
                    this.PrintAs("PDF");
                    previewFrame = document.getElementById(this.previewFrameID);
                    previewFrame.onload = function () { previewFrame.contentDocument.execCommand("print", true, null); }
                    break;
            }
        };
    </script>
}

