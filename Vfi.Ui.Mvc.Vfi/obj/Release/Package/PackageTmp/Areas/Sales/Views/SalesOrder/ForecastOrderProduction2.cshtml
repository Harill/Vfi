@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@using Vfi.Ui.Mvc.Vfi.Models.Production
@using Vfi.Ui.Mvc.Vfi.Utilities
@{
    ViewBag.Title = "KH(SX2)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script type="text/javascript">

    var startGrid = false;
    function RefreshGrid2(name) {
        if (!onLoading) {
            OnLoadingData();
            startGrid = true;
            RefreshGrid(name);
        }
    }

    function grid_OnDataBound() {
        OnLoadedData();
    }

    var onLoading = false;
    function OnLoadingData() {
        if (!onLoading) {
            onLoading = true;
            var loadings = document.querySelectorAll('.twoToneButton');
            for (var i = 0; i < loadings.length; i++) {
                var loading = loadings[i];
                loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (Chờ load)";
                loading.classList.add('loading');
            }
        }
    }
    function OnLoadedData() {
        if (onLoading) {
            var loadings = document.querySelectorAll('.twoToneButton');
            for (var i = 0; i < loadings.length; i++) {
                var loading = loadings[i];
                if (loading && loading.className.includes("loading")) {
                    loading.classList.remove('loading');
                    loading.innerHTML = "<span></span>";
                }
            }
            onLoading = false;
        }
    }

    function grid_OnDataBinding(args) {
        if (startGrid) {
           
        var all = $("input[name='chkAll']").attr('checked');

        var customerId = $('#cboCustomer').data('tComboBox').value();
        if (customerId === "")
            customerId = 0;
        var productCode = $("#ProductCode").data("tAutoComplete").value();
        var fromDate = $("#fromDate").data("tDatePicker").value();
        if (fromDate === null)
            fromDate = "";
        else {
            fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
        }
        var toDate = $("#toDate").data("tDatePicker").value();
        if (toDate === null)
            toDate = "";
        else {
            toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
        }
        args.data = $.extend(args.data, {
            customerId: customerId,
            productCode: productCode,
            fromDate: fromDate,
            toDate: toDate,
            all: all
        });
        }
        index = 0;
    }

    function grid_OnRowDataBound(e) {
        var row = 2;
        if (e.dataItem.LastOrderQuantity > e.dataItem.ForecastQuantity) {
            e.row.childNodes[row+8].style.backgroundColor = "#F4FA58";
        }
        if (e.dataItem.OrderQuantity > e.dataItem.ForecastNextMonth) {
            e.row.childNodes[row+11].style.backgroundColor = "#F4FA58";
        }
        if (e.dataItem.EndDate3 > e.dataItem.ForecastDate) {
            e.row.childNodes[row+23].style.backgroundColor = "#F4FA58";
        }
    }

    var index = 0;
</script>

<div class="title">
    @*PO KD (sản xuất 2)*@
    @HttpContext.GetGlobalResourceObject("Resource", "ForecastOrderProduction2")
</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 1020px;">
        <fieldset>
            <legend>
                @*Tiêu chí trích lọc*@
                @HttpContext.GetGlobalResourceObject("Resource", "Filter")
            </legend>
            <div class="grid_1_5">
                @*KH*@
                @HttpContext.GetGlobalResourceObject("Resource", "Customer2")
            </div>
            <div class="grid_5">
                @{
                    Html.Telerik().ComboBox()
                        .Name("cboCustomer")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new {area = "Sales"}))
                        .HtmlAttributes(new {style = "width: 190px"})
                        .DropDownHtmlAttributes(new {style = "width: 275px;"})
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>
             <div class="grid_1_5">
                @*Mã SP*@
                 @HttpContext.GetGlobalResourceObject("Resource", "ProductCode2")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCode")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv", new { area = "Inv" }))
                        .DropDownHtmlAttributes(new { style = "width: 250px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
             <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("fromDate")
                        .Format("dd/MM/yyyy")
                        .Value(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1, 0, 0, 0))
                        .Render();
                }
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("toDate")
                        .Format("dd/MM/yyyy")
                        .Value(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1))
                        .Render();
                }
            </div>
            
                <div class="grid_3">
                <label>
                    <input type="checkbox" id="chkAll" name="chkAll"/>
                    @*Lấy tất cả*@
                    @HttpContext.GetGlobalResourceObject("Resource", "SelectAll")
                </label> <br />
            </div>
             <button id="btnRefresh" class='t-button' onclick=" return RefreshGrid2('gridForecast'); ">
                <span class='t-icon t-refresh'></span>
                @*Làm mới*@
                 @HttpContext.GetGlobalResourceObject("Resource", "Refresh")
                <span class="twoToneButton"></span>
            </button>
        </fieldset>
    </div>



