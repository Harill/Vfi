@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models

@{
    ViewBag.Title = @HttpContext.GetGlobalResourceObject("Resource", "EmployeeManagement").ToString();
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
<script type="text/javascript">
    function gridEmploye_onEdit(e) {
        //var dataItem = e.dataItem;
        //var mode = e.mode;
        //var form = e.form;

        var employeeCode = $(form).find('#EmployeeCode');
        if (mode == 'insert') {
            employeeCode.attr("style", "color: blue;");
        }
        if (mode == 'edit') {
            //employeeCode.attr("readonly", "readonly");
            employeeCode.attr("style", "color: red;");
        }
    }

</script>
}
<div class="title">@HttpContext.GetGlobalResourceObject("Resource", "EmployeeInformation")</div>

<div class="cover-div">
@{
    Html.Telerik().Grid<EmployeeModel>()
        .Name("gridEmployee")
        .DataKeys(keys => keys.Add(f => f.EmployeeId).RouteKey("employeeId"))
        .ToolBar(
            toolbar =>
            toolbar.Insert()
                .Text(@HttpContext.GetGlobalResourceObject("Resource", "NewText").ToString())
                .ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).ImageHtmlAttributes(new { style = "margin-left:0" }))
        .DataBinding(dataBindings=>dataBindings.Ajax()
            .Select("SelectEmployee","Employee")
            .Insert("InsertEmployee","Employee")
            .Update("UpdateEmployee","Employee")
        )
        .Columns(columns=>
        {
            columns.Command(command =>
                command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)
                    //.UpdateText("Sửa").CancelText("Hủy")
                    .UpdateText(@HttpContext.GetGlobalResourceObject("Resource", "UpdateText").ToString())
                    .CancelText(@HttpContext.GetGlobalResourceObject("Resource", "CancelText").ToString())

            ).Width(98).Title("").HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.EmployeeCode).Width(125)
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "EmployeeCode").ToString());
            columns.Bound(f => f.EmployeeName).Width(200)
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "EmployeeName").ToString());
            columns.Bound(f => f.Active).Width(95)
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Sale").ToString())
                //.Title("Kinh doanh")
                .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                .HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.Production2).Width(95)
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Production2").ToString())
                //.Title("NV SX2")
                .ClientTemplate("<input type='checkbox' disabled='disabled' name='Production2' <#=Production2? checked='checked' : '' #> />")
                .HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.Production2B).Width(95)
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Production2B").ToString())
                //.Title("NV SX2B")
                .ClientTemplate("<input type='checkbox' disabled='disabled' name='Production2B' <#=Production2B? checked='checked' : '' #> />")
                .HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.Repair).Width(95)
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "MachineRepair").ToString())
                //.Title("Sửa máy")
                .ClientTemplate("<input type='checkbox' disabled='disabled' name='Repair' <#=Repair? checked='checked' : '' #> />")
                .HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.QcLine).Width(95)
                //.Title(@HttpContext.GetGlobalResourceObject("Resource", "QcLine").ToString())
                .ClientTemplate("<input type='checkbox' disabled='disabled' name='Repair' <#=QcLine? checked='checked' : '' #> />")
                .HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.GroupName)
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Group").ToString());
                //.Title("Nhóm");
            columns.Bound(f => f.UserName)
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "LinkAccount").ToString());
                //.Title("LK ACC");
            columns.Bound(f => f.ModifiedDate).Width(125)
                //.Title("Ngày làm")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "ModifiedDate").ToString())
                .Format("{0:dd/MM/yyyy HH:mm}").ReadOnly(true);
            columns.Bound(f => f.ModifiedUser).Width(100)
                //.Title("Người làm")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "ModifiedUser").ToString())
                .ReadOnly(true);
        })
        .ClientEvents(events => events.OnEdit("gridEmploye_onEdit").OnError("grid_OnError"))
        .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
        //.Pageable(page => page.PageSize(10))
                .Scrollable(f => f.Height(510))
        .Sortable()
        .Render();  
}
</div>