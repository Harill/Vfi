@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models

@{
    ViewBag.Title = "Quản lý nhân viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
<script type="text/javascript">
    function gridEmploye_onEdit(e) {
        //var dataItem = e.dataItem;
        //var mode = e.mode;
        //var form = e.form;

        var employeeCode = $(form).find('#EmployeeCode');
        if (mode == 'insert') {
            employeeCode.attr("style", "color: blue;");
        }
        if (mode == 'edit') {
            //employeeCode.attr("readonly", "readonly");
            employeeCode.attr("style", "color: red;");
        }
    }

</script>
}
<div class="title">Thông tin nhân viên</div>

<div class="cover-div">
@{
    Html.Telerik().Grid<EmployeeModel>()
        .Name("gridEmployee")
        .DataKeys(keys => keys.Add(f => f.EmployeeId).RouteKey("employeeId"))
        .ToolBar(
            toolbar =>
            toolbar.Insert().Text("Thêm NV mới").ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).ImageHtmlAttributes(new { style = "margin-left:0" }))
        .DataBinding(dataBindings=>dataBindings.Ajax()
            .Select("SelectEmployee","Employee")
            .Insert("InsertEmployee","Employee")
            .Update("UpdateEmployee","Employee")
        )
        .Columns(columns=>
        {
            columns.Command(command =>
                command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image).UpdateText("Sửa").CancelText("Hủy")
            ).Width(98).Title("").HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.EmployeeCode).Width(125);
            columns.Bound(f => f.EmployeeName).Width(200);
            columns.Bound(f => f.Active).Width(75).Title("Kinh doanh")
                .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                .HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.Production2).Width(75).Title("NV SX2")
                .ClientTemplate("<input type='checkbox' disabled='disabled' name='Production2' <#=Production2? checked='checked' : '' #> />")
                .HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.Production2B).Width(75).Title("NV SX2B")
                .ClientTemplate("<input type='checkbox' disabled='disabled' name='Production2B' <#=Production2B? checked='checked' : '' #> />")
                .HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.Repair).Width(75).Title("Sửa máy")
                .ClientTemplate("<input type='checkbox' disabled='disabled' name='Repair' <#=Repair? checked='checked' : '' #> />")
                .HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.QcLine).Width(75)
                .ClientTemplate("<input type='checkbox' disabled='disabled' name='Repair' <#=QcLine? checked='checked' : '' #> />")
                .HtmlAttributes(new { style = "text-align:center" });
            columns.Bound(f => f.GroupName).Title("Nhóm");
            columns.Bound(f => f.UserName).Title("LK ACC");
            columns.Bound(f => f.ModifiedDate).Width(125).Title("Ngày làm").Format("{0:dd/MM/yyyy HH:mm}").ReadOnly(true);
            columns.Bound(f => f.ModifiedUser).Width(100).Title("Người làm").ReadOnly(true);
        })
        .ClientEvents(events => events.OnEdit("gridEmploye_onEdit").OnError("grid_OnError"))
        .Editable(editing => editing.Mode(GridEditMode.InLine))
        //.Pageable(page => page.PageSize(10))
                .Scrollable(f => f.Height(510))
        .Sortable()
        .Render();  
}
</div>