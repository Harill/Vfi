                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 275px" })
                    //.ClientEvents(events => events.OnChange("customerForPeriod_onChange"))
                    .AutoFill(true)
                    .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                    .Render();
            }
        </div>
                <div class="grid_3">
                    @{
                        Html.Telerik().DatePicker()
                            .Name("fromDate")
                            .Format("dd/MM/yyyy")
                            .Value(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1))
                            .Render();
                    }
                </div>
                <div class="grid_3">
                    @{
                        Html.Telerik().DatePicker()
                            .Name("toDate")
                            .Format("dd/MM/yyyy")
                            .Value(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1))
                            .Render();
                    }
                </div>
        <div class="grid_3">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2(); ">
