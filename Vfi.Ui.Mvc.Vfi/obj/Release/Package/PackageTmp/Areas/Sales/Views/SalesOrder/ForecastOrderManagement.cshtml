        </legend>
        <div class="grid_2">
            @*@Html.Label("Tình trạng")*@
            @HttpContext.GetGlobalResourceObject("Resource", "Status")
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("Status")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxTransactionStatus", "Transaction", new { area = "Inv" }))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                    .HighlightFirstMatch(true)
                    .AutoFill(true)
                    .Render();
            }
        </div>
        <div class="grid_2">
            @*@Html.Label("Nhân viên")*@
            @HttpContext.GetGlobalResourceObject("Resource", "Employee")
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().ComboBox()
                    .Name("EmployeeName")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxSalesEmployee", "Employee", new { area = "" }))
                    .HtmlAttributes(new { style = "width: 110px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .Render();
            }
        </div>
        <div class="grid_1_5">
            @*@Html.Label("Mã KH")*@
            @HttpContext.GetGlobalResourceObject("Resource", "Customer2")
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("CustomerForMonthly")
