@using Telerik.Web.Mvc.UI
@using Vfi.Ui.Mvc.Vfi.Areas.Sales.Models
@{
    ViewBag.Title = "Quản lý dự báo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">

        var startGrid = false;

        function grid_OnDataBinding(args) {

            if (startGrid) {
                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);

                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);

                var customerId = $('#CustomerForMonthly').data('tComboBox').value();
                if (customerId === "")
                    customerId = 0;
                var status = $('#Status').data('tComboBox').value();
                if (status === "")
                    status = 2;
                var employee = $('#EmployeeName').data('tComboBox').value();
                if (employee === "")
                    employee = 0;
                args.data = $.extend(args.data,
                {
                    fromDate: fromDate,
                    toDate: toDate,
                    status: status,
                    employeeId: employee,
                    customerId: customerId
                });
            }
            index = 0;
        }


        function grid_OnDataBound() {
            OnLoadedData();
        }

        var onLoading = false;
        function OnLoadingData() {
            if (!onLoading) {
                onLoading = true;
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (Chờ load)";
                    loading.classList.add('loading');
                }
            }
        }
        function OnLoadedData() {
            if (onLoading) {
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    if (loading && loading.className.includes("loading")) {
                        loading.classList.remove('loading');
                        loading.innerHTML = "<span></span>";
                    }
                }
                onLoading = false;
            }
        }

        var index = 0;

        //function month_onLoad() {
        //    var combobox = $('#Month').data('tDropDownList');
        //    var dataSource =
        //    [
        //        { Text: "1", Value: "1" },
        //        { Text: "2", Value: "2" },
        //        { Text: "3", Value: "3" },
        //        { Text: "4", Value: "4" },
        //        { Text: "5", Value: "5" },
        //        { Text: "6", Value: "6" },
        //        { Text: "7", Value: "7" },
        //        { Text: "8", Value: "8" },
        //        { Text: "9", Value: "9" },
        //        { Text: "10", Value: "10" },
        //        { Text: "11", Value: "11" },
        //        { Text: "12", Value: "12" }
        //    ];
        //    combobox.dataBind(dataSource);
        //    combobox.value(new Date().getMonth() + 1);
        //}
        function PrintForecastPlan() {

            var warehouse = $('#Warehouse').data('tComboBox').value();
            if (warehouse === "")
                warehouse = 0;

            var fromDate = $("#fromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);

            var toDate = $("#toDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else
                toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
            //var month = $("#Month").data("tDropDownList").value();
            //if (month === null)
            //    month = 0;
            //var year = $("#Year").val();
            //if (year === null || year === "")
            //    year = 0;
            $('#result').load('@Url.Action("PrintForecastPlan", "SalesOrder", new {area = "Sales"})',
                {
                    fromDate: fromDate,
                    toDate: toDate,
                    warehouseId: warehouse
                },
                function() {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }

        //function grid_OnRowDataBound(e) {
        //    var dataItem = e.dataItem;
        //    if (!dataItem.SaleManagement) {
        //        e.row.getElementsByClassName("t-button t-grid-delete t-button-icon")[0].parentNode.innerHTML = "";
        //    }
        //}

        function grid_OnRowDataBound(e) {                   // 04/03/2026
            var dataItem = e.dataItem;
            if (!dataItem.SaleManagement) {
                var btn = e.row.getElementsByClassName("t-button t-grid-delete t-button-icon");
                if (btn.length > 0) {
                    btn[0].parentNode.innerHTML = "";
                }
            }
        }



        function RefreshGrid2() {
            if (!onLoading) {
                OnLoadingData();
                startGrid = true;
                RefreshGrid("gridForecast");
            }
        }
    </script>
}

<div class="title">
    @*Quản lý dự báo đơn hàng*@
    @HttpContext.GetGlobalResourceObject("Resource", "ForecastOrderManagement")
</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 1070px;">
