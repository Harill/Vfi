                                .ToHtmlString());

                        items.Add()
                            .Text("Công cụ thiết kế")
                            .Content(
                                Html.Telerik().Grid<ProductionToolModel>()
                                    .Name("gridProductionTool_<#= ProductId #>")
                                    .DataKeys(key => key.Add(f => f.RealToolId).RouteKey("realToolId"))
                                    .ToolBar(
                                        toolbar =>
                                        toolbar.Insert()
                                            .Text("Thêm mới")
                                            .ButtonType(GridButtonType.ImageAndText).ImageHtmlAttributes(new { style = "margin-left:0px;" }))
                                    .DataBinding(
                                        dataBinding => dataBinding.Ajax()
                                                                  .Select("SelectProductionTool", "Tool", new { area = "Purchasing", productId = "<#= ProductId #>" })
                                                                  .Insert("InsertProductionTool", "Tool", new { area = "Purchasing", productId = "<#= ProductId #>" })
                                                                  .Update("UpdateProductionTool", "Tool", new { area = "Purchasing", productId = "<#= ProductId #>" })
                                    )
                                    .Columns(columns =>
                                    {
                                        columns.Command(command =>
                                                        command.Edit().ButtonType(GridButtonType.Image)
                                            ).Width(98).Title("").HtmlAttributes(new { style = "text-align:center" });

                                        columns.Bound(f => f.ToolIndex)
                                            .Width(50)
                                            .HeaderTemplate("STT")
                                            ;
                                        
                                        columns.Bound(f => f.ToolLocation).Width(70)
                                            .HeaderTemplate("Vị trí dao")
                                            ;
                                       
                                        columns.Bound(f => f.ToolFullCode).Width(200)
                                            .HeaderTemplate("Công cụ")
                                            ;
                                        
                                        columns.Bound(f => f.Note)
                                            .Title("Chức năng")
                                            ;
                                        
                                        columns.Bound(f => f.Description)
                                            .Title("Quy cách SD")
                                            ;
                                        
                                        columns.Bound(f => f.Quota).Width(70)
                                            .HeaderTemplate("Tuổi thọ")
                                            ;
                                        
                                        columns.Bound(f => f.UseNumber).Width(70)
                                            .HeaderTemplate("SL sử dụng")
                                            ;
                                        
                                        columns.Bound(f => f.Active).Width(40)
                                            .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                                            .HtmlAttributes(new { style = "text-align:center" });
                                        
                                        columns.Bound(f => f.ToolActive).Width(40).ReadOnly(true)
                                            .ClientTemplate("<input type='checkbox' disabled='disabled' name='ToolActive' <#=ToolActive? checked='checked' : '' #> />")
                                            .HtmlAttributes(new { style = "text-align:center" });
                                        
                                        columns.Bound(f => f.ModifiedDate).Width(100)
                                            .Title("Ngày thêm")
                                            
                                            .ReadOnly(true)
                                            .Format("{0:dd/MM/yyyy}");
                                        
                                        columns.Bound(f => f.ModifiedUser).Width(100)
                                            .Title("Người cập nhật")
                                            
                                            .ReadOnly(true);

                                    })
                                    .Editable(editing => editing.Mode(GridEditMode.InLine))
                                    .ClientEvents(events => events.OnError("grid_OnError")
                                                                  //.OnSave("gridProductionTool_onSave")
                                                                  )
                                    .ToHtmlString()
                                );

                        items.Add()
                            .Text("Công cụ sử dụng")
                            .Content(
                                Html.Telerik().Grid<ProductionToolReplacementModel>()
                                    .Name("gridProductionToolReplace_<#= TrackId #>")
                                    .DataKeys(key => key.Add(f => f.ReplaceId).RouteKey("replaceId"))
                                    .DataKeys(key => key.Add(f => f.ProductionToolId).RouteKey("productionToolId"))
                                    .TableHtmlAttributes(new { TrackId = "<#= TrackId #>" })
                                    .DataBinding(
                                        dataBinding => dataBinding.Ajax()
                                                                  .Select("SelectProductionToolReplacement", "Tool", new { area = "Purchasing", trackId = "<#= TrackId #>" })
                                                                  .Update("UpdateProductionToolReplacement", "Tool", new { area = "Purchasing", trackId = "<#= TrackId #>" })
                                    )
                                    .Columns(columns =>
                                    {
                                        columns.Command(command =>
                                                        command.Edit().ButtonType(GridButtonType.Image)
                                            ).Width(98).Title("").HtmlAttributes(new { style = "text-align:center" });

                                        columns.Bound(f => f.ToolImg).Width(50).Title("Hình").ReadOnly(true)
                                            .ClientTemplate("<a id='<#=ProductionToolId#>' href='" + Url.Content("~/Content/FileUpload/ToolImg/") + "<#=ToolImg#>?<#=UploadDate#>' class='highslide' onclick='return hs.expand(this)'>" +
                                                            "<img src='" + Url.Content("~/Content/FileUpload/ToolImg/") + "<#=ToolImg#>?<#=UploadDate#>' height='40' width='40' title='Mở lớn'/>" +
                                                            "</a><div class='highslide-caption'><#= ProductionToolFullCode #></div>");
                                        
                                        columns.Bound(f => f.ProductionToolFullCode).Width(250).ReadOnly(true)
                                            .HeaderTemplate("Công cụ thiết kế")
                                            ;

                                        columns.Bound(f => f.ReplaceImg).Width(50).Title("Hình").ReadOnly(true)
                                            .ClientTemplate("<a id='<#=ReplaceId#>' href='" + Url.Content("~/Content/FileUpload/ToolImg/") + "<#=ReplaceImg#>?<#=UploadDate#>' class='highslide' onclick='return hs.expand(this)'>" +
                                                               "<img src='" + Url.Content("~/Content/FileUpload/ToolImg/") + "<#=ReplaceImg#>?<#=UploadDate#>' height='40' width='40' title='Mở lớn'/>" +
                                                               "</a><div class='highslide-caption'><#= ReplaceToolFullCode #></div>");
                                 
                                        columns.Bound(f => f.ReplaceToolFullCode).Width(250)
                                            .HeaderTemplate("Công cụ thay thế")
                                            ;
                                        
                                        columns.Bound(f => f.TotalInv).Width(100).ReadOnly(true)
                                            .HeaderTemplate("Tổng tồn")
                                            ;
                                        
                                        columns.Bound(f => f.PrepareQuantity).Width(100)
                                            .HeaderTemplate("SL dự trù")
                                            ;
                                        
                                        columns.Bound(f => f.AutoPrepareQuantity).Width(100).ReadOnly(true)
                                            .HeaderTemplate("SL tự động")
                                            ;
                                        
                                        columns.Bound(f => f.RequireInventory).Width(100).ReadOnly(true)
                                            .HeaderTemplate("YC tối thiểu")
                                            ;
                                        
                                        columns.Bound(f => f.Note)
                                            .HeaderTemplate("Ghi chú")
                                            ;
                                        
                                        columns.Bound(f => f.ModifiedDate).Width(100)
                                            .Title("Ngày thêm")
                                            
                                            .ReadOnly(true)
                                            .Format("{0:dd/MM/yyyy}");
                                        columns.Bound(f => f.ModifiedUser).Width(100)
                                            .Title("Người cập nhật")
                                            
                                            .ReadOnly(true);

                                    })
                                    .Editable(editing => editing.Mode(GridEditMode.InLine))
                                    .ClientEvents(events => events.OnError("grid_OnError")
                                                                  )
                                    .ToHtmlString()
                                );
                    }
                    )
                    .ToHtmlString()
                                       ))
                .Editable(editing => editing.Mode(GridEditMode.InLine))
                .Scrollable(f => f.Height(510))
                .Sortable()
                .Filterable()
                .Resizable(resizing => resizing.Columns(true))
                .ClientEvents(e => e.OnDataBinding("grid_OnDataBinding")
                                    .OnSave("grid_OnSave")
                                    .OnDataBound("grid_OnDataBound")
                                    .OnRowDataBound("Grid_OnRowDataBound")
                                    .OnEdit("grid_OnEdit")
                                    .OnDelete("grid_OnDelete")
                                    //.OnRowSelect("grid_OnRowSelect")
                                    //.OnError("grid_OnError")
                                    )
                .Render();
        }
    </div>

    <!-- windown -->
    @{
        Html.Telerik().Window()
            .Name("windowReport")
            .Modal(true)
            .Draggable(true)
            .Content
            (
                @<text>
                     <div id="result"></div>
                 </text>
            )
            //.ClientEvents(e => e.OnLoad("Window_onLoad"));
            .Visible(false)
            .Width(960)
            .Render();
    }

