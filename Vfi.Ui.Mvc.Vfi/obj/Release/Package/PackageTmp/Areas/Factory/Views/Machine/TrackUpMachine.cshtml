}

<style>
    .highslide-container div {
        font-family: Verdana, Helvetica;
        font-size: 10pt;
    }
    .highslide-container table {
        background: none;
    }
    .highslide {
        outline: none;
        text-decoration: none;
    }
    .highslide img {
        border: 2px solid silver;
    }
    .highslide:hover img {
        border-color: gray;
    }
    .highslide-active-anchor img {
        visibility: hidden;
    }
    .highslide-gallery .highslide-active-anchor img {
        border-color: black;
        visibility: visible;
        cursor: default;
    }
    .highslide-image {
        border-width: 2px;
        border-style: solid;
        border-color: white;
    }
    .highslide-wrapper, .highslide-outline {
        background: white;
    }
    .glossy-dark {
        background: #111;
    }

    .highslide-image-blur {
    }
    .highslide-number {
        display: none;
        font-weight: bold;
        color: gray;
        font-size: .9em;
    }
    .highslide-caption {
        display: none;
        font-size: 1em;
        padding: 5px;
        width: 100%;
        text-align: center;
        font-weight: bold;
        /*background: white;*/
    }
    .highslide-heading {
        display: none;
        font-weight: bold;
        margin: 0.4em;
    }
    .highslide-dimming {
        /*position: absolute;*/
        background: black;
    }
    a.highslide-full-expand {
        display: block;
        margin: 0 10px 10px 0;
        width: 34px;
        height: 34px;
    }
    .highslide-loading {
        display: block;
        color: black;
        font-size: 9px;
        font-weight: bold;
        text-transform: uppercase;
        text-decoration: none;
        padding: 3px;
        border: 1px solid white;
        background-color: white;
        padding-left: 22px;
        background-repeat: no-repeat;
        background-position: 3px 1px;
    }
    a.highslide-credits,
    a.highslide-credits i {
        padding: 2px;
        color: silver;
        text-decoration: none;
        font-size: 10px;
        display: none;
    }
    a.highslide-credits:hover,
    a.highslide-credits:hover i {
        color: white;
        background-color: gray;
    }
    .highslide-move, .highslide-move * {
        cursor: move;
    }

    .highslide-viewport {
        display: none;
        position: fixed;
        width: 100%;
        height: 100%;
        z-index: 1;
        background: none;
        left: 0;
        top: 0;
    }
    .highslide-overlay {
        display: none;
    }
    .hidden-container {
        display: none;
    }
    /* Example of a semitransparent, offset closebutton */
    .closebutton {
        position: relative;
        top: -15px;
        left: 15px;
        width: 30px;
        height: 30px;
        cursor: pointer;
        /* NOTE! For IE6, you also need to update the highslide-ie6.css file. */
    }
    .highslide-controls {
        display: none 
    }

</style>

    <script type="text/javascript">
        hs.graphicsDir = '';
        hs.align = 'center';
        hs.transitions = ['expand', 'crossfade'];
        hs.outlineType = '';
        hs.fadeInOut = true;
        hs.numberPosition = 'caption';
        hs.dimmingOpacity = 0.75;

        // Add the controlbar
        if (hs.addSlideshow)
            hs.addSlideshow({
                //slideshowGroup: 'group1',
                interval: 5000,
                repeat: false,
                useControls: true,
                fixedControls: 'fit',
                overlayOptions: {
                    opacity: .75,
                    position: 'bottom center',
                    hideOnMouseOut: true
                }
            });
    </script>

@section Scripts{
    <script type="text/javascript">
        var materialId = 0;
        
        function fecthParam() {
            var month = $("#Month").data("tDropDownList").value();
            if (month === null)
                month = new Date().getMonth() + 1;
            var year = $("#Year").val();
            if (year === null || year === "")
                month = new Date().getYear() + 1;
            var status = $("#Status").data("tComboBox").value();
            if (status === null || status === "")
                status = 2;
            return {
                status: status,
                month: month,
                year: year
            };
        }
        function grid_OnSave(e) {
            var param = fecthParam();
            if (!($('#MaterialCode').data('tComboBox') == undefined))
                e.values.MaterialCode = $('#MaterialCode').data('tComboBox').text();
            e.values = $.extend(e.values, param);
        }

        function grid_OnEdit(e) {
            var mode = e.mode;
            var form = e.form;
            materialId = 0;
            if (mode === 'insert') {
                var nodes = $(form).find('#DeliveryDate');
                nodes[0].parentNode.parentNode.parentNode.innerHTML = "";
            } else if (mode === 'edit') {
                var dataItem = e.dataItem;

                //if ((dataItem.PermisstionType == 1 || dataItem.StatusColor == 2)) {
                nodes = $(form).find('#StartDate');
                nodes[0].parentNode.parentNode.parentNode.innerHTML = dataItem.StartDate.format("dd/MM/yyyy");
                nodes = $(form).find('#ForecastDay');
                nodes[0].parentNode.parentNode.innerHTML = dataItem.ForecastDay;
                nodes = $(form).find('#MachineName');
                nodes[0].parentNode.parentNode.innerHTML = dataItem.MachineName;
                nodes = $(form).find('#ProductCode');
                nodes[0].parentNode.parentNode.innerHTML = dataItem.ProductCode;
                nodes = $(form).find('#MaterialCode');
                nodes[0].parentNode.parentNode.innerHTML = dataItem.MaterialCode;
                //}
                //if (dataItem.StatusColor == 2) {
                //}
            }

        }

        function product_onchange() {
            var month = $("#Month").data("tDropDownList").value();
            alert(month);
        }

        function grid_OnDelete(e) {
            var param = fecthParam();
            e.values = $.extend(e.values, param);
        }

        function grid_OnDataBinding(args) {
            var param = fecthParam();
            args.data = $.extend(args.data, param);
        }


        function grid_OnDataBound() {

        }


        function status_onChange() {
            RefreshGrid("gridTrack");
        }

