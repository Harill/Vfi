            ];
            combobox.dataBind(dataSource);
        }


        function month_onLoad() {
            var combobox = $('#Month').data('tDropDownList');
            var dataSource =
            [
                { Text: "1", Value: "1" },
                { Text: "2", Value: "2" },
                { Text: "3", Value: "3" },
                { Text: "4", Value: "4" },
                { Text: "5", Value: "5" },
                { Text: "6", Value: "6" },
                { Text: "7", Value: "7" },
                { Text: "8", Value: "8" },
                { Text: "9", Value: "9" },
                { Text: "10", Value: "10" },
                { Text: "11", Value: "11" },
                { Text: "12", Value: "12" }
            ];

            combobox.dataBind(dataSource);
            combobox.value(new Date().getMonth() + 1);
        }

        function Grid_OnRowDataBound(e) {
            var dataItem = e.dataItem; //FA5858 F4FA58
            //if (dataItem.Productivity < dataItem.RealProductivity || dataItem.Productivity === 0)
            //    e.row.childNodes[14].style.backgroundColor = "#F4FA58";
            //else if (dataItem.Productivity > (dataItem.RealProductivity * 1.2)) {
            //    e.row.childNodes[14].style.backgroundColor = "rgb(181,230,29)";
            //}
            if (dataItem.ProductRate > (dataItem.RealRate) || dataItem.ProductRate === 0)
                e.row.childNodes[12].style.backgroundColor = "#F4FA58";
            if ((dataItem.PermisstionType === 1 || dataItem.StatusColor === 2) && dataItem.DeliveryDate != null) {
                e.row.getElementsByClassName("t-button t-grid-edit t-button-icon")[0].parentNode.innerHTML = "";
                e.row.getElementsByClassName("t-button t-grid-delete t-button-icon")[0].parentNode.innerHTML = "";
            }
            if (dataItem.StatusColor === 2) {
                e.row.style.backgroundColor = "#FA5858";
            }
        }

        function gridProductionProcessByMachine_OnEdit(e) {
            var mode = e.mode;
            var form = e.form;
            if (mode === 'insert') {
            } else if (mode === 'edit') {
                var dataItem = e.dataItem;
                var nodes = $(form).find('#WarehouseName');
                nodes[0].parentNode.parentNode.innerHTML = "<b>" + e.dataItem.WarehouseName + "</b>";
            }
        }
