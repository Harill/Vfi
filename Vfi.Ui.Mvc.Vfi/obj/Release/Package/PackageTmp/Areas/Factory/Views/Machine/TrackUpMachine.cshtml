        //    });
        //}
    </script>
    
    <script type="text/javascript">

        function printTrackUpMachine() {

            var month = $("#Month").data("tDropDownList").value();
            if (month === null)
                month = new Date().getMonth() + 1;
            var year = $("#Year").val();
            if (year === null || year === "")
                month = new Date().getYear() + 1;
            var status = $("#Status").data("tComboBox").value();
            if (status === null || status === "")
                status = 2;
            $('#result').load('@Url.Action("PrintTrackUpMachine", "Machine")',
                {
                    status: status,
                    month: month,
                    year: year
                }, function () {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }


        function PrintPreparationTools(val) {
            alert(val);
            $('#result').load('@Url.Action("PrintPreparationTools", "Machine")',
            {
                trackId: val
            }, function (data) {
                var window = $('#windowReport').data('tWindow');
                window.open();
            });
            return false;
        }

    </script>

}

