        @using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@{
    ViewBag.Title = "TK XNT Kho";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{

    <script type="text/javascript">

        function grid_OnDataBinding(args) {
            
            if (startGrid) {
                var productCodeNameForMonthly = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();

                var customerId = $("#CustomerForMonthly").data('tComboBox').value();
                if (customerId == 0)
                    customerId = 0;

                var fromDate = $("#FromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#ToDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

                var warehouse1 = $("#Warehouse1").data('tDropDownList').value();
                if (warehouse1 == 0)
                    warehouse1 = 0;
                var warehouse2 = $("#Warehouse2").data('tDropDownList').value();
                if (warehouse2 == 0)
                    warehouse2 = 0;
                var warehouse3 = $("#Warehouse3").data('tDropDownList').value();
                if (warehouse3 == 0)
                    warehouse3 = 0;
                var warehouse4 = $("#Warehouse4").data('tDropDownList').value();
                if (warehouse4 == 0)
                    warehouse4 = 0;
                var warehouse5 = $("#Warehouse5").data('tDropDownList').value();
                if (warehouse5 == 0)
                    warehouse5 = 0;
                var warehouse6 = $("#Warehouse6").data('tDropDownList').value();
                if (warehouse6 == 0)
                    warehouse6 = 0;
                var warehouse7 = $("#Warehouse7").data('tDropDownList').value();
                if (warehouse7 == 0)
                    warehouse7 = 0;
                var warehouse8 = $("#Warehouse8").data('tDropDownList').value();
                if (warehouse8 == 0)
                    warehouse8 = 0;
                var warehouse9 = $("#Warehouse9").data('tDropDownList').value();
                if (warehouse9 == 0)
                    warehouse9 = 0;
                var warehouse10 = $("#Warehouse10").data('tDropDownList').value();
                if (warehouse10 == 0)
                    warehouse10 = 0;

                args.data = $.extend(args.data, {
                    customerId: customerId,
                    productCode: productCodeNameForMonthly,
                    fromDate: fromDate,
                    toDate: toDate,
                    warehouse1: warehouse1,
                    warehouse2: warehouse2,
                    warehouse3: warehouse3,
                    warehouse4: warehouse4,
                    warehouse5: warehouse5,
                    warehouse6: warehouse6,
                    warehouse7: warehouse7,
                    warehouse8: warehouse8,
                    warehouse9: warehouse9,
                    warehouse10: warehouse10
                });
            }
            index = 0;
        }
        var index = 0;

        var startGrid = false;
        function RefreshGrid2() {
            startGrid = true;
            RefreshGrid("gridProductionMonthly");
        }

    </script>
}

