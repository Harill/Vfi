@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model MaterialInventoryModel
@{
    ViewBag.Title = "Thống kê công cụ năm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">

        var startGrid = false;
        var index = 0;
        function grid_OnDataBinding(args) {

            if (startGrid) {

                var statusValue = $("#Status").data("tComboBox").value();
                if (statusValue === "")
                    statusValue = 0;
                var toolType = $("#ToolType").data('tComboBox').value();
                if (toolType === "")
                    toolType = 0;
                var toolName = $("#ToolName").data('tAutoComplete').value();

                var year = $("#Year").val();
                if (year === null || year === "")
                    year = new Date().getYear() + 1;
                args.data = $.extend(args.data,
                {
                    toolType: toolType,
                    toolName: toolName,
                    year: year,
                    exportType: statusValue
                });
                index = 0;
            }
        }

        function status_onload() {
            var combobox = $('#Status').data('tComboBox');
            var dataSource =
            [
                { Text: "Tất cả", Value: "0" },
                { Text: "SX1", Value: "1" },
                { Text: "SX2", Value: "2" }
            ];
            combobox.dataBind(dataSource);
        }

        function RefreshGrid2() {
            startGrid = true;
            RefreshGrid("gridTool");
        }
    </script>

}

    <div class="title">Báo cáo công cụ năm</div>

    <div id="pnlInv">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">
        <fieldset>
            <legend>Tiêu chí trích lọc</legend>
            <div class="grid_2"> Loại CC </div>
            <div class="grid_4">
                @{
                Html.Telerik().ComboBox()
                    .Name("ToolType")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxToolType", "Tool", new { area = "Purchasing" }))
                    .HtmlAttributes(new { style = "width: 100%" })
                    .AutoFill(true)
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .Render();
            }
            </div>
            <div class="grid_2">Công cụ</div>
            <div class="grid_4">
            @{
                Html.Telerik().AutoComplete()
                    .Name("ToolName")
                    .HtmlAttributes(new { style = "width: 100%" })
                    .Render();
            }
            </div>
            
            <div class="grid_2">
                Loại xuất
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Status")
                        //.DataBinding(binding => binding.Ajax().Select("SelectStatus", "Orders"))
                        .HtmlAttributes(new {style = "width: 150px"})
                        .DropDownHtmlAttributes(new {style = "width: 250px"})
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .HighlightFirstMatch(true)
                        .AutoFill(true)
                        .ClientEvents(events => events.OnLoad("status_onload"))
                        //.Enable(false)
                        .Render();
                }
            </div>
            <div class="grid_2"> Năm </div>
            <div class="grid_2">
                    @{
                        Html.Telerik().AutoComplete()
                            .Name("Year")
                            .Value(DateTime.Now.Year + "")
                            .HtmlAttributes(new {style = "width: 40px"})
                            .Render();
                    }
                </div>
            <div class="grid_3">
                <button id="btnRefesh" class="t-button" onclick="return RefreshGrid2(); ">
                    <span class='t-icon t-insert'></span>
                    Làm mới
                </button>
            </div>
        </fieldset>

    </div>
    <div class="clear"></div>
    <div class="cover-div">
