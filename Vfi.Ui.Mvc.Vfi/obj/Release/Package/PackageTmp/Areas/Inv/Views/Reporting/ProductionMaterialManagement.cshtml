                                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Request").ToString()
                                        + "</br>("
                                        + @HttpContext.GetGlobalResourceObject("Resource", "Bar").ToString()
                                        + ")"
                                    )
                                    .Format("{0:n2}")
                                    .HtmlAttributes(new { style = "text-align:right" });
                            })
                            .Filterable()
                            .ClientEvents(events => events.OnError("grid_OnError"))
                            .ToHtmlString())
                    )
                    .ToHtmlString())
            )
            //.Scrollable(f => f.Height(510))
            .Resizable(f => f.Columns(true))
            .Reorderable(f => f.Columns(true))
            .Filterable()
            .Selectable()
            .Sortable()
            .ClientEvents(events => events
                                        .OnDataBinding("grid_OnDataBinding")
                                        .OnRowDataBound("grid_OnRowDataBound")
                                        .OnRowSelect("grid_OnRowSelect")
                                        .OnError("grid_OnError"))
            .Groupable()
            .Render();
    }
    @*@{ Html.Telerik().ScriptRegistrar().OnDocumentReady("applyFrozenColumns();"); }*@
</div>
