@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Models.Production
@model ProductInventoryModel
@{
    ViewBag.Title = "Tiến độ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{


    <!-- grid Monthly -->
    <script type="text/javascript">
        var startGrid = false;

        function grid_OnDataBinding(args) {
            if (startGrid && !onLoading) {
                OnLoadingData();

                var productCodeNameForMonthly = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();

                var customerId = $("#CustomerForMonthly").data('tComboBox').value();
                if (customerId == 0)
                    customerId = 0;
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

                var invDate = $("#invDate").data("tDatePicker").value();
                if (invDate === null)
                    invDate = "";
                else
                    invDate = $.telerik.formatString('{0:dd/MM/yyyy}', invDate);
                var month = $("#Month").data("tDropDownList").value();
                if (month === null)
                    month = new Date().getMonth() + 1;
                var year = $("#Year").val();
                if (year === null || year == "")
                    month = new Date().getYear() + 1;
                var isAllOrder = $("input[name='chkAllOrder']").attr('checked');
                args.data = $.extend(args.data, {
                    customerId: customerId,
                    productCode: productCodeNameForMonthly,
                    toDate: toDate,
                    invDate: invDate,
                    month: month,
                    year: year,
                    isAllOrder: isAllOrder,
                });
            }
        }

        function grid_OnDataBound() {
            OnLoadedData();
        }

        function type_onLoad() {
            var combobox = $('#Type').data('tDropDownList');
            var dataSource =
            [
                { Text: "Tất cả", Value: "1" },
                { Text: "Trong tháng", Value: "2" }
            ];

            combobox.dataBind(dataSource);
            combobox.value("Trong tháng");
        }

        function month_onLoad() {
            var combobox = $('#Month').data('tDropDownList');
            var dataSource =
            [
                { Text: "1", Value: "1" },
                { Text: "2", Value: "2" },
                { Text: "3", Value: "3" },
                { Text: "4", Value: "4" },
                { Text: "5", Value: "5" },
                { Text: "6", Value: "6" },
                { Text: "7", Value: "7" },
                { Text: "8", Value: "8" },
                { Text: "9", Value: "9" },
                { Text: "10", Value: "10" },
                { Text: "11", Value: "11" },
                { Text: "12", Value: "12" }
            ];

            combobox.dataBind(dataSource);
            combobox.value(new Date().getMonth() + 1);
        }

        function RefreshGrid2(name) {
            startGrid = true;
            RefreshGrid(name);
        }
    </script>
    <!-- report -->
    <script type="text/javascript">

        function printOrderProgressInMonth() {
            
            if (!onLoading) {
                OnLoadingData();
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

                var invDate = $("#invDate").data("tDatePicker").value();
                if (invDate === null)
                    invDate = "";
                else
                    invDate = $.telerik.formatString('{0:dd/MM/yyyy}', invDate);
                var month = $("#Month").data("tDropDownList").value();
                if (month === null)
                    month = new Date().getMonth() + 1;
                var year = $("#Year").val();
                if (year === null || year == "")
                    month = new Date().getYear() + 1;
                var isAllOrder = $("input[name='chkAllOrder']").attr('checked');
                $('#result').load('@Url.Action("PrintOrderProgressInMonth", "Reporting")',
                    {
                        toDate: toDate,
                        invDate: invDate,
                        month: month,
                        year: year,
                        isAllOrder: isAllOrder
                    }, function (data) {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
                return false;
            }
        }

        function printProductionProgressInMonth() {
            
            if (!onLoading) {
                OnLoadingData();
                var month = $("#Month").data("tDropDownList").value();
                if (month === null)
                    month = new Date().getMonth() + 1;
                var year = $("#Year").val();
                if (year === null || year == "")
                    month = new Date().getYear() + 1;
                //var type = $("#Type").data("tDropDownList").value();
                //if (type === "")
                //    type = 1;
                $('#result').load('@Url.Action("PrintOrderProgressProduction", "Reporting")',
                    {
                        month: month,
                        year: year
                    }, function (data) {

                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
                return false;
            }
        }

        function printProductState() {
            
            if (!onLoading) {
                OnLoadingData();
                var month = $("#Month").data("tDropDownList").value();
                if (month === null)
                    month = new Date().getMonth() + 1;
                var year = $("#Year").val();
                if (year === null || year == "")
                    month = new Date().getYear() + 1;
                //var type = $("#Type").data("tDropDownList").value();
                //if (type === "")
                //    type = 1;
                $('#result').load('@Url.Action("PrintOrderProgress", "Reporting")',
                    {
                        month: month,
                        year: year
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
                return false;
            }
        }

        function printExpecedSalesReport() {
            
            if (!onLoading) {
                OnLoadingData();
                var productCodeNameForMonthly = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();

                var customerId = $("#CustomerForMonthly").data('tComboBox').value();
                if (customerId == 0)
                    customerId = 0;
                var month = $("#Month").data("tDropDownList").value();
                if (month === null)
                    month = new Date().getMonth() + 1;
                var year = $("#Year").val();
                if (year === null || year == "")
                    month = new Date().getYear() + 1;
                $('#result').load('@Url.Action("PrintExpectedSalesReport", "Reporting")',
                    {
                        customerId: customerId,
                        productCode: productCodeNameForMonthly,
                        month: month,
                        year: year
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
                return false;
            }
        }

    </script>
}

