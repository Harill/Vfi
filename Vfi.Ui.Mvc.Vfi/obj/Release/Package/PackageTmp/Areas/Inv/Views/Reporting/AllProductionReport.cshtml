                        columns.Bound(f => f.TranferInv)
                            .HeaderTemplate("Tồn kho<br/>trung chuyển").Width(70)
                               .Aggregate(agg => agg.Sum())
                               .Format("{0:n0}")
                               .HtmlAttributes(new { style = "text-align: right;" })
                               .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                               .FooterHtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.LastExportDate)
                            .HeaderTemplate("Ngày giao<br/>cuối").Width(100)
                               .ClientTemplate("<#= LastExportDate == null ? '' : $.telerik.formatString('{0:dd/MM/yy}', LastExportDate) #>")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.MaterialType).Title("Loại NL").Width(100);
                        columns.Bound(f => f.MaterialCode).Title("Nguyên liệu").Width(200);
                        columns.Bound(f => f.MaterialPrice).Title("Giá NL").Width(70)
                               .Format("{0:n0}")
                               .HtmlAttributes(new { style = "text-align: right;" });
                        columns.Bound(f => f.ProductionWeight).Title("TL Phoi").Width(70)
