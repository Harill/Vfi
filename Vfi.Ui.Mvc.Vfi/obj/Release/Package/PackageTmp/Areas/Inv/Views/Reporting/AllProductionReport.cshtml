                Xuất báo cáo xuất nhập
                <span class="loadButton"></span>
            </button>
            <button id="btnNotFinishInvProduct" class="t-button" onclick=" return printNotFinishInvProduct(); ">
                <span class='t-icon t-insert'></span>
                Xuất báo cáo bán thành phẩm
                <span class="loadButton"></span>
            </button>

        </div>
        <div class="clear"></div>

        <fieldset>
            <legend>Tiêu chí trích lọc</legend>
            <div class="grid_3">
                @{
                    Html.Telerik().DropDownList()
                        .Name("ReportType")
                        .HtmlAttributes(new { style = "width: 100px" })
                        .DropDownHtmlAttributes(new { style = "width: 100px" })
                        .ClientEvents(events => events.OnLoad("reportType_onLoad"))
                        .Render();
                }
            </div>
            <div class="grid_2">
                @Html.Label("Mã KH")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("CustomerForMonthly")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                        .HtmlAttributes(new { style = "width: 150px" })
                        .DropDownHtmlAttributes(new { style = "width: 275px" })
                        //.ClientEvents(events => events.OnChange("customerForPeriod_onChange"))
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>
            <div class="grid_2">
                @Html.LabelFor(f => f.ProductCodeName)
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeNameForMonthly")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                        .DropDownHtmlAttributes(new { style = "width: 200px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("fromDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today.Month + "/01/" + DateTime.Today.Year)
                        .Render();
                }
            <div class="clear"></div>
                @{
                    Html.Telerik().DatePicker()
                        .Name("toDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
            <div class="grid_3">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2('gridProductionMonthly'); ">
                    <span class='t-icon t-insert'></span>
                    Làm mới
                <span class="loadButton"></span>
                </button>
            </div>
            <div class="grid_4">
            <button id="btnImportExportProduction" class="t-button" onclick=" return printImportExportProduction(); ">
                <span class='t-icon t-insert'></span>
                Xuất báo cáo tháng
                <span class="loadButton"></span>
            </button>
                
            </div>
        </fieldset>
