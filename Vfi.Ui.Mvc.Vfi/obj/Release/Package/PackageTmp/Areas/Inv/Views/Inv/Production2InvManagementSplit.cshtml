@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "SX2 riêng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{


    <!-- grid Monthly -->
    <script type="text/javascript">

        function grid_OnDataBinding(args) {

            var productCodeNameForMonthly = $("#ProductCodeNameForMonthly").data("tAutoComplete").value();

            var customerId = $("#CustomerForMonthly").data('tComboBox').value();
            if (customerId == 0)
                customerId = 0;

            var warehouseId = $("#WarehouseProduction2").data('tDropDownList').value();
            if (warehouseId == "")
                warehouseId = -1;

            var fromDate = $("#FromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            var toDate = $("#ToDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else
                toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);


            args.data = $.extend(args.data, {
                customerId: customerId,
                productCode: productCodeNameForMonthly,

                warehouseId: warehouseId,
                fromDate: fromDate,
                toDate: toDate,
            });
        }

        var index = 0;

        function grid_OnRowDataBound(e) {
            var dataItem = e.dataItem;
            if (dataItem.Weight == 0)
                e.row.childNodes[3].style.backgroundColor = "#F4FA58";
        }

    </script>
    <!-- report -->
    <script type="text/javascript">
        function printProduction2List() {

            var isForecast = $("input[name='chkForecast']").attr('checked');
            var isSales = $("input[name='chkSales']").attr('checked');
            var fromDate = $("#FromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#ToDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
            }
            $('#result').load('@Url.Action("PrintProduction2List", "Inv")',
                {
                    from: fromDate,
                    to: toDate,
                    isForecast: isForecast,
                    isSales: isSales
                }, function() {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }

        function printProduction2Price() {

            var isForecast = $("input[name='chkForecast']").attr('checked');
            var isSales = $("input[name='chkSales']").attr('checked');
            var fromDate = $("#FromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#ToDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
            }
            $('#result').load('@Url.Action("PrintProduction2PriceList", "Inv")',
                {
                    from: fromDate,
                    to: toDate,
                    isForecast: isForecast,
                    isSales: isSales
                }, function() {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }

        function printProduction2Plan() {

            var isForecast = $("input[name='chkForecast']").attr('checked');
            //var isSales = $("input[name='chkSales']").attr('checked');
            var fromDate = $("#FromDate2").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#ToDate2").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
            }
            $('#result').load('@Url.Action("PrintProduction2Plan", "Inv")',
                {
                    from: fromDate,
                    to: toDate,
                    isForecast: isForecast,
                    //isSales: isSales
                }, function() {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }

        function printProduction2Period() {

            var warehouseId = $("#WarehouseProduction2").data('tDropDownList').value();
            if (warehouseId == "")
                warehouseId = -1;
            var fromDate = $("#FromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#ToDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
            }
            $('#result').load('@Url.Action("PrintProduction2Period", "Inv")',
               {
                   //from: fromDate,
                   warehouseId: warehouseId,
                   fromDate: fromDate,
                   toDate: toDate
               }, function () {
                   var window = $('#windowReport').data('tWindow');
                   window.open();
               });
            return false;
        }
    </script>
}

