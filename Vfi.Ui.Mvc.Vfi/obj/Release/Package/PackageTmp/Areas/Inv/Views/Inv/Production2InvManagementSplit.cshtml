                            .HtmlAttributes(new { style = "text-align: right;" })
                            .FooterHtmlAttributes(new { style = "text-align: right;" });
                   
                        columns.Bound(f => f.Note)
                            //.Title("Ghi chú")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Note").ToString());
                     
                        //
                        columns.Bound(f => f.DiffQuantity).Width(65)
                            //.HeaderTemplate("Lệch</br>tồn")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Diff").ToString()
                                + "</br>"
                                + @HttpContext.GetGlobalResourceObject("Resource", "Inv").ToString()
                            )
                            .Format("{0:n0}")
                            .Aggregate(agg => agg.Sum())
                            .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                            .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                            .HtmlAttributes(new { style = "text-align: right;border-left:black 3px double;" })
                            .FooterHtmlAttributes(new { style = "text-align: right;border-left:black 3px double;" });
                    
                        columns.Bound(f => f.DiffImport).Width(65)
                            //.HeaderTemplate("Lệch</br>nhập")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Diff").ToString()
                                + "</br>"
                                + @HttpContext.GetGlobalResourceObject("Resource", "Import").ToString()
                            )
                            .Format("{0:n0}")
                            .Aggregate(agg => agg.Sum())
                            .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                            .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                            .HtmlAttributes(new { style = "text-align: right;" })
                            .FooterHtmlAttributes(new { style = "text-align: right;" });
                   
                        columns.Bound(f => f.DiffExport).Width(65)
                            //.HeaderTemplate("Lệch</br>xuất")
                            .Title(@HttpContext.GetGlobalResourceObject("Resource", "Diff").ToString()
                                + "</br>"
                                + @HttpContext.GetGlobalResourceObject("Resource", "Export").ToString()
                            )
                            .Format("{0:n0}")
                            .Aggregate(agg => agg.Sum())
                            .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                            .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                            .HtmlAttributes(new { style = "text-align: right;" })
                            .FooterHtmlAttributes(new { style = "text-align: right;" });
                    })
                      .Scrollable(f => f.Height(510))
                .Resizable(f => f.Columns(true))
                .Reorderable(f => f.Columns(true))
                .Filterable()
                .Sortable()
                .ClientEvents(events => events
                                            .OnDataBinding("grid_OnDataBinding")
                                            .OnRowDataBound("grid_OnRowDataBound")
                                            .OnError("grid_OnError"))
                .Groupable()
                .Render();
        }
    </div>
</div>

