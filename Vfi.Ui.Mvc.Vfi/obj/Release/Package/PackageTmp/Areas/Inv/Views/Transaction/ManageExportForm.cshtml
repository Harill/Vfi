@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@using Telerik.Web.Mvc.UI
@{
    ViewBag.Title = "Manage Product Form";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section Scripts{
    <!-- approve stockorder -->
    <script type="text/javascript">
        function PrintForm(val) {
            var $item = $('#id_' + val);
            var $formType = $item.attr('ftype');
            $('#result').load('@Url.Action("PrintImportExportForm", "Inv")',
                {
                    transactionId: val,
                    formType: $formType,
                }, function (data) {
                    var window = $('#windowReport').data('tWindow');
                    window.open();
                });
            return false;
        }
    </script>

    <!-- grid Transaction -->
    <script type="text/javascript">
        startGrid = false;
        function RefreshGrid2(name) {
            startGrid = true;
            RefreshGrid(name);
        }

        function grid_onDataBinding(args) {
            if (startGrid) {

                var warehouse = $("#Warehouse").data('tComboBox').value();
                if (warehouse === "") warehouse = 0;
                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else {
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                }
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else {
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
                }
                var status = $("#Status").data("tComboBox").value();
                if (status === "")
                    status = 0;
                //status = Number(@((byte)MyUtilities.Transaction.Status.Approved));
                args.data = $.extend(args.data, {
                    status: status,
                    transactionId: "",
                    fromDate: fromDate,
                    toDate: toDate,
                    warehouseId: warehouse
                });
            }
        }

        function gridTransaction_OnRowDataBound(e) {
            var dataItem = e.dataItem; //FA5858 F4FA58
            switch (dataItem.StatusInt) {
                case Number(@((byte)MyUtilities.Transaction.Status.Open)):
                    e.row.childNodes[6].bgColor = "yellow";
                    break;
                case Number(@((byte)MyUtilities.Transaction.Status.Cancel)):
                    e.row.childNodes[6].bgColor = "red";
                    break;
                case Number(@((byte)MyUtilities.Transaction.Status.Processing)):
                    e.row.childNodes[6].bgColor = "orange";
                    break;
                default:
                    break;
            }
        }

        function gridTransactionDetail_OnRowDataBound(e) {
            var dataItem = e.dataItem; //FA5858 F4FA58
            
            if (!dataItem.CanEdit) {
                e.row.childNodes[0].innerHTML = "";
            }
        }

    </script>
>
}

<div class="title">Quản lý biểu mẫu xuất nhập</div>

<div class="t-info-sha" style="padding-left: 15px; width: 250px; color: Maroon;">Sổ lệnh</div>
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">
        <fieldset>
            <legend>Tiêu chí trích lọc</legend>            
            <div class="grid_2">
                Công đoạn
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Warehouse")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxWarehouseMainProcess", "Warehouse", new { area = "Inv" }).Delay(350))
                        .HtmlAttributes(new { style = "width: 100%" })
                        .DropDownHtmlAttributes(new { style = "width: 250px" })
                        .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                        .HighlightFirstMatch(true)
                        .AutoFill(true)
                        //.ClientEvents(events => events.OnChange("warehouse_OnChange"))
                        .Render();
                }
            </div>
            <div class="grid_2">
                Tình trạng
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Status")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxTransactionStatus", "Transaction"))
                        .HtmlAttributes(new { style = "width: 150px" })
                        .DropDownHtmlAttributes(new { style = "width: 250px" })
                        .Filterable(f => f.FilterMode(AutoCompleteFilterMode.Contains))
                        .HighlightFirstMatch(true)
                        .AutoFill(true)
                        .Render();
                }
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("fromDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today.Month + "/01/" + DateTime.Today.Year)
                        .Render();
                }
            </div>
            <div class="grid_2">
                @{
                    Html.Telerik().DatePicker()
                        .Name("toDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
            
            <div class="grid_4 prefix_1">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2('gridExport'); ">
                    <span class='t-icon t-insert'></span>
                    Làm mới
                </button>
            </div>
        </fieldset>
    </div>


    <div class="cover-div">
    @{
        Html.Telerik().Grid<ManageImportExportModel>()
            .Name("gridExport")
            .DataKeys(keys => keys.Add(f => f.TransactionId).RouteKey("TransactionId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("SelectFormByStatus", "Transaction",
                                                             new {
                                                                 status = 0,
                                                                 transactionId = "",
                                                                 warehouseId = 0,
                                                                 fromDate = "",
                                                                 toDate = ""
                                                             })
            )
            .Columns(columns => {
                    columns.Bound(f => f.FormType).Hidden();
                    columns.Bound(f => f.TransactionCode).Width(120)
                           .Title("Mã Giao Dịch");
                    columns.Bound(f => f.WarehouseName).Width(150)
                           .Title("Công đoạn");
                    columns.Bound(f => f.ReportDate).Width(85)
                           .Format("{0:dd/MM/yyyy}")
                           .Title("Ngày báo cáo");
                    columns.Bound(f => f.TotalQuality).Title("Tổng SL").Width(80)
                            .Format("{0:n0}")
                            .HtmlAttributes(new { style = "text-align:right;" });
                    columns.Bound(f => f.Status).Width(100)
                            .Title("Tình trạng");
                    columns.Bound(f => f.Note)
                           .Title("Ghi Chú");
                    columns.Bound(f => f.TransactionId).Title("In").Width(70)
                           .ClientTemplate("<input type='button' id='id_<#= TransactionId #>' value='In' ftype='<#= FormType #>' class='t-button' onclick=PrintForm(<#= TransactionId #>) />")
                           .HtmlAttributes(new { style = "text-align:center" });
                    columns.Bound(f => f.ModifiedUser).Title("Người làm").Width(85);
                    columns.Bound(f => f.ModidifiedDate).Title("Ngày làm").Width(85)
                           .Format("{0:dd/MM/yyyy HH:mm}");
                })
            .DetailView(details => details.ClientTemplate(
                Html.Telerik().TabStrip()
                    .Name("TabStrip_<#= TransactionId #>")
                    .SelectedIndex(0)
                    .Items(items => {
                               items.Add().Text("Thông tin").Content(
                                  Html.Telerik().Grid<ManageImportExportDetailModel>()
                                  .DataKeys(keys => keys.Add(f => f.DetailId).RouteKey("detailId"))
                                  .Name("gridTransactionInfo_<#= TransactionId #>")
                                   //.Name("gridTransactionDetail")
                                  .DataBinding(dataDindings => dataDindings.Ajax()
                                                                           .Select("SelectFormDetailByTransactionId", "Transaction",
                                  new { transactionId = "<#= TransactionId #>", formType = "<#= FormType #>" })
                                   //.Update("UpdateFormDetailByTransactionId", "Transaction")
                                  )
                                      .Columns(columns => {
                                          //columns.Command(c => c.Edit().Text("").ButtonType(GridButtonType.Image)).Width(50);
                                          columns.Bound(f => f.ProductCode).Width(100).Title("Sản phẩm").ReadOnly(true);
                                          columns.Bound(f => f.Number).Width(98).Title("Số lượng (PCS)")
                                              .HtmlAttributes(new { style = "text-align: right;" })
                                              .ClientTemplate("<#= Number == null ? 0 : $.telerik.formatString('{0:n0}', Number) #>")
                                              .Aggregate(agg => agg.Sum())
                                              .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                                              .ClientFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                                              .FooterHtmlAttributes(new { style = "text-align: right;" });
                                          columns.Bound(f => f.Weight).Width(98).Title("Trọng lượng(kg)")
                                              .HtmlAttributes(new { style = "text-align: right;" })
                                              .ClientTemplate("<#= Weight == null ? 0 : $.telerik.formatString('{0:n2}', Weight) #>")
                                              .Aggregate(agg => agg.Sum())
                                              .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                                              .ClientFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                                              .FooterHtmlAttributes(new { style = "text-align: right;" });
                                          columns.Bound(f => f.FormType).Hidden();
                                          columns.Bound(f => f.TransactionId).Hidden();
                                          columns.Bound(f => f.Note).Title("Ghi chú");
                                          //    columns.Bound(f => f.BigBox).Title("Thùng Lớn");
                                          //    columns.Bound(f => f.SmallBox).Title("Thùng Nhỏ");
                                      })

                                   .ClientEvents(events => events.OnError("grid_OnError")
                                   //.OnRowDataBound("gridTransactionDetail_OnRowDataBound")
                                   )
                                      .ToHtmlString()
                                  );

                               items.Add().Text("Thông tin chi tiết").Content(
                                  Html.Telerik().Grid<ManageImportExportDetailModel>()
                                  .DataKeys(keys => keys.Add(f => f.DetailId).RouteKey("detailId"))
                                  .Name("gridTransactionDetail_<#= TransactionId #>")
                                   //.Name("gridTransactionDetail")
                                  .DataBinding(dataDindings => dataDindings.Ajax()
                                                                           .Select("SelectFormDetailLotNumberByTransactionId", "Transaction",
                                  new { transactionId = "<#= TransactionId #>", formType = "<#= FormType #>" })
                                   //.Update("UpdateFormDetailByTransactionId", "Transaction")
                                  )
                                      .Columns(columns => {
                                          //columns.Command(c => c.Edit().Text("").ButtonType(GridButtonType.Image)).Width(50);
                                          columns.Bound(f => f.Index).Width(50).Title("STT").ReadOnly(true)
                                              .HtmlAttributes(new { style = "text-align: center;" });
                                          columns.Bound(f => f.LotNumber).Width(200).Title("Lô").ReadOnly(true)
                                              .Aggregate(agg => agg.Count())
                                              .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                                              .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Count) #>")
                                              .FooterHtmlAttributes(new { style = "text-align: center; font-weight:bold; " });
                                          
                                          columns.Bound(f => f.ProductCode).Width(100).Title("Sản phẩm").ReadOnly(true);
                                          
                                          columns.Bound(f => f.Number).Width(98).Title("Số lượng (PCS)")
                                              .HtmlAttributes(new { style = "text-align: right;" })
                                              .ClientTemplate("<#= Number == null ? 0 : $.telerik.formatString('{0:n0}', Number) #>")
                                              .Aggregate(agg => agg.Sum())
                                              .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                                              .ClientFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                                              .FooterHtmlAttributes(new { style = "text-align: right;" });
                                          //columns.Bound(f => f.Weight).Width(98).Title("Trọng lượng(kg)")
                                          //    .HtmlAttributes(new { style = "text-align: right;" })
                                          //    .ClientTemplate("<#= Weight == null ? 0 : $.telerik.formatString('{0:n2}', Weight) #>")
                                          //    .Aggregate(agg => agg.Sum())
                                          //    .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                                          //    .ClientFooterTemplate("<#= $.telerik.formatString('{0:n2}', Sum) #>")
                                          //    .FooterHtmlAttributes(new { style = "text-align: right;" });
                                          columns.Bound(f => f.FormType).Hidden();
                                          columns.Bound(f => f.TransactionId).Hidden();
                                          columns.Bound(f => f.Note).Title("Ghi chú");
                                          //    columns.Bound(f => f.BigBox).Title("Thùng Lớn");
                                          //    columns.Bound(f => f.SmallBox).Title("Thùng Nhỏ");
                                      })

                                   .ClientEvents(events => events.OnError("grid_OnError")
                                   //.OnRowDataBound("gridTransactionDetail_OnRowDataBound")
                                   )
                                      .ToHtmlString()
                                  );
                        
                        
                           }
                    )
                    .ToHtmlString()
                                       ))
            .Selectable()
            .ClientEvents(events => events
                                        .OnRowSelect("grid_OnRowSelect")
                                        .OnDataBinding("grid_onDataBinding")
                                        .OnRowDataBound("gridTransaction_OnRowDataBound")
                                        .OnError("grid_OnError")
            )
            //.Pageable(f => f.PageSize(10))
            //.Scrollable(f => f.Height("auto"))
            //.HtmlAttributes(new { style = "width: 950px;" })
            //.Sortable()
            //.Groupable()
            .Filterable()
            .Resizable(resizing => resizing.Columns(true))
                .Scrollable(f => f.Height(610))
            .Render();
    }
</div>
<!-- windown -->
@{
    Html.Telerik().Window()
        .Name("windowReport")
        .Modal(true)
        .Draggable(true)
        .Content
        (
    @<text>
    <div id="result"></div>
    </text>
        )
        .Visible(false)
        .Width(960)
        .ClientEvents(e => e.OnOpen("window_onopen"))
        .Render();
}

<script>
    function window_onopen(e) {
        //alert("b");
        $("#rptvPageImportNCU_QCBForm_ReportToolbar_ExportGr_FormatList_DropDownList option[value='XLS']").remove();
        $("#rptvPageImportNCU_QCBForm_ReportToolbar_ExportGr_FormatList_DropDownList option[value='RTF']").remove();
        $("#rptvPageImportNCU_QCBForm_ReportToolbar_ExportGr_FormatList_DropDownList option[value='MHTML']").remove();
    }
</script>

