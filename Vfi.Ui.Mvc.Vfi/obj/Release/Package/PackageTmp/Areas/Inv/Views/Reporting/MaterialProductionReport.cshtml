@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@{
    ViewBag.Title = "Theo dõi nguyên liệu sản xuất";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">

        var startGrid = false;
        var index = 0;

        function grid_OnDataBinding(args) {

            if (startGrid) {
                var materialTypeId = $("#MaterialTypeName").data('tComboBox').value();
                if (materialTypeId === "")
                    materialTypeId = 0;

                var materialName = $("#MaterialCodeName").data("tAutoComplete").value();
                var toDate = $("#toDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else {
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                }
                var fromDate = $("#fromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else {
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                }
                args.data = $.extend(args.data,
                {
                    materialCode: materialName,
                    materialTypeId: materialTypeId,
                    fromDate: fromDate,
                    toDate: toDate
                });
            }
            index = 0;
        }

        function RefreshGrid2() {
            startGrid = true;
            RefreshGrid("grid");
        }
    </script>
}

    <div class="title">
       @* Báo cáo theo dõi nguyên liệu sản xuất*@
        @HttpContext.GetGlobalResourceObject("Resource", "MaterialProductionReport")
    </div>
    <div id="pnlInv">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">
        <fieldset>
            <legend>
                @*Tiêu chí trích lọc*@
                @HttpContext.GetGlobalResourceObject("Resource", "Filter")
            </legend>
            <div class="grid_2">
                @*Loại Nguyên Liệu*@
                @HttpContext.GetGlobalResourceObject("Resource", "TypeMaterial")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("MaterialTypeName")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxAllMaterialType", "Material", new {area = ""}))
                        .HtmlAttributes(new {style = "width: 150px"})
                        .DropDownHtmlAttributes(new {style = "width: 250px"})
                        .SelectedIndex(0)
                        .Render();
                }
            </div>
            <div class="grid_2">
                @*Nguyên Liệu*@
                @HttpContext.GetGlobalResourceObject("Resource", "Material")
            </div>
            <div class="grid_5">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("MaterialCodeName")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedMaterialInventory", "Inv", new {materialTypeId = 0}))
                        //.HtmlAttributes(new { style = "width: 185px; " })
                        .DropDownHtmlAttributes(new {style = "width: 250px; "})
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Render();
                }
            </div>
            <div class="grid_1">
                @*Ngày*@
                @HttpContext.GetGlobalResourceObject("Resource", "Date")
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("fromDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Now.AddDays(-7))
                        .Render();
                }
            </div>
            <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("toDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Now)
                        .Render();
                }
            </div>
            <div class="grid_3">
                <button id="btnRefesh" class="t-button" onclick="return RefreshGrid2(); ">
                    <span class='t-icon t-insert'></span>
                    @*Làm mới*@
                    @HttpContext.GetGlobalResourceObject("Resource", "Refresh")
                </button>
            </div>
        </fieldset>

    </div>
    <div class="clear"></div>
    <div class="cover-div">
