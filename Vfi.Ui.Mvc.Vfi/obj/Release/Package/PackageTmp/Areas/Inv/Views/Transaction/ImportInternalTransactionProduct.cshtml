        <div class="grid_2">
            @*Sản phẩm:*@
            @HttpContext.GetGlobalResourceObject("Resource", "Product")
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().AutoComplete()
                    .Name("ProductCodeName")
                    .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                    .HtmlAttributes(new { style = "width: 100%" })
                    .DropDownHtmlAttributes(new { style = "min-width: 250px" })
                    .Encode(false)
                    .AutoFill(true)
                    .HighlightFirstMatch(true)
                    .ClientEvents(events => events
                        .OnChange("autoComplete_onChange")
                    )
                    .Render();
            }
        </div>
        <div class="grid_2">
            @*Khách hàng:*@
            @HttpContext.GetGlobalResourceObject("Resource", "Customer")
        </div>
        <div class="grid_7">
            @{
                Html.Telerik().ComboBox()
                    .Name("Customer")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                    .HtmlAttributes(new { style = "width: 100%" })
                    .DropDownHtmlAttributes(new { style = "min-width: 375px" })
                    .ClientEvents(events => events.OnChange("customer_onChange"))
                    .AutoFill(true)
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .Render();
            }
