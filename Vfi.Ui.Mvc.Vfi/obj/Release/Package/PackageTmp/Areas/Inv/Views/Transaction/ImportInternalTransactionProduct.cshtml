                    .HtmlAttributes(new { style = "border-left: 1px black solid;" });
                
                columns.Command(commands => commands.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image).Text("")).Width(50).Title("");
            })
            .ClientEvents(events => events
                .OnDataBinding("grid_OnDataBinding")
                .OnRowDataBound("gridProduct_OnRowDataBound")
                .OnSave("gridProductInventoryDetail_onSave")
                .OnSubmitChanges("gridProductInventoryDetail_onSubmitChanges")
                .OnError("grid_OnError")
            )
            .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
            .KeyboardNavigation()
            .Groupable(group => group.Groups(g => g.Add(model => model.ProductCode)))
            .Render();   
    }
