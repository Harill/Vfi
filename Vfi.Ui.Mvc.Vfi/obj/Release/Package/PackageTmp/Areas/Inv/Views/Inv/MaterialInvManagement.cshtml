                                .FooterTemplate("<span id='tongcot1'></span>")
                                .HtmlAttributes(new {style = "text-align: left;"});
                           
                            columns.Bound(f => f.LotNumber).Width(50)
                                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Lot").ToString());
                            
                            columns.Bound(f => f.UnitWeight)
                                //.Title("Trọng lượng")
                                .Title(@HttpContext.GetGlobalResourceObject("Resource", "UnitWeight").ToString())
                                .Width(70);
                            
                            columns.Bound(f => f.UnitPrice)
                                //.Title("Đơn giá")
                                .Title(@HttpContext.GetGlobalResourceObject("Resource", "UnitPrice").ToString())
