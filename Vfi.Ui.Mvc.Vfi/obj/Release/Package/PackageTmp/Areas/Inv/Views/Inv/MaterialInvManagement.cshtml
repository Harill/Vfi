                    })
                .Scrollable(f => f.Height("auto"))
                .Groupable()
                .Reorderable(f => f.Columns(true))
                .Resizable(f => f.Columns(true))
                .ClientEvents(events => events.OnDataBinding("gridMaterialInventoryForPeriod_onDataBinding"))
                .Render();
        }
