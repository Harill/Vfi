@using Vfi.Server.Core.DataModel.Models.Inv
@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@using Vfi.Ui.Mvc.Vfi.Utilities
@model MaterialInventoryModel
@{
    ViewBag.Title = "Material Inv Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- $.() -->
    <script type="text/javascript">
        $(function() {
            // panel display
            $("#pnlInv").hide();
            $("#pnlMaterialPeriod").hide();
            //$("#pnlInvPeriod").hide();
            // panel effect
            $("input[name='rdoInvType'][value='rdoInvPeriod']").attr('checked', 'checked');

            $("input[name='rdoInvType']").change(function() {
                if ($("input[name='rdoInvType']:checked").val() == 'rdoInv') {

                    if ($("#pnlInvPeriod").is(":visible"))
                        runEffectHide("#pnlInvPeriod", "drop");

                    if ($("#pnlMaterialPeriod").is(":visible"))
                        runEffectHide("#pnlMaterialPeriod", "drop");

                    setTimeout(function() {
                        runEffectShow("#pnlInv", "drop");
                    }, 1200);

                } else if ($("input[name='rdoInvType']:checked").val() == 'rdoInvPeriod') {

                    if ($("#pnlInv").is(":visible"))
                        runEffectHide("#pnlInv", "drop");

                    if ($("#pnlMaterialPeriod").is(":visible"))
                        runEffectHide("#pnlMaterialPeriod", "drop");

                    setTimeout(function() {
                        runEffectShow("#pnlInvPeriod", "drop");
                    }, 1200);
                } else if ($("input[name='rdoInvType']:checked").val() == 'rdoMaterialPeriod') {

                    if ($("#pnlInv").is(":visible"))
                        runEffectHide("#pnlInv", "drop");
                    if ($("#pnlInvPeriod").is(":visible"))
                        runEffectHide("#pnlInvPeriod", "drop");

                    setTimeout(function() {
                        runEffectShow("#pnlMaterialPeriod", "drop");
                    }, 1200);
                }
            });        var onLoading = false;
            function OnLoadingData() {
                if (!onLoading) {
                    onLoading = true;
                    var loadings = document.querySelectorAll('.twoToneButton');
                    for (var i = 0; i < loadings.length; i++) {
                        var loading = loadings[i];
                        loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (Chờ load)";
                        loading.classList.add('loading');
                    }
                }
            }
            function OnLoadedData() {
                if (onLoading) {
                    var loadings = document.querySelectorAll('.twoToneButton');
                    for (var i = 0; i < loadings.length; i++) {
                        var loading = loadings[i];
                        if (loading && loading.className.includes("loading")) {
                            loading.classList.remove('loading');
                            loading.innerHTML = "<span></span>";
                        }
                    }
                    onLoading = false;
                }
            };


            // warehouse checked
            $("input[name='chkAllWarehouse']").attr('checked', 'checked');
            // warehouse change event
            $("input[name='chkAllWarehouse']").change(function () {
                RefreshGrid("gridMaterialInventory");
            });
            // warehouse checked ForPeriod
            $("input[name='chkAllWarehouseForPeriod']").attr('checked', 'checked');
            // warehouse change event
            $("input[name='chkAllWarehouseForPeriod']").change(function () {
                RefreshGrid("gridMaterialInventoryForPeriod");
            });
        });
        var onLoading = false;
        function OnLoadingData() {
            if (!onLoading) {
                onLoading = true;
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    loading.innerHTML = "<span class='t-icon t-refresh t-loading'></span> (Chờ load)";
                    loading.classList.add('loading');
                }
            }
        }
        function OnLoadedData() {
            if (onLoading) {
                var loadings = document.querySelectorAll('.twoToneButton');
                for (var i = 0; i < loadings.length; i++) {
                    var loading = loadings[i];
                    if (loading && loading.className.includes("loading")) {
                        loading.classList.remove('loading');
                        loading.innerHTML = "<span></span>";
                    }
                }
                onLoading = false;
            }
        };
    </script>

    <!-- binding -->
    <script type="text/javascript">
        function materialClassified_onChange() {
            $("#MaterialTypeName").data('tDropDownList').reload();
        }

        function materialTypeName_onDataBinding(args) {
            var materialClassifiedId = $("#MaterialClassifiedName").data('tDropDownList').value();
            args.data = $.extend({}, args.data, { classifiedId: materialClassifiedId });
        }

        function materialTypeName_onChange() {
            RefreshGrid("gridMaterialInventory");
        }

        function warehouseIssueName_onChange() {
            RefreshGrid("gridMaterialInventory");
        }

        function warehouseReceiptName_onChange() {
            var chkAllWarehouse = $("input[name='chkAllWarehouse']").is(":checked");
            if (chkAllWarehouse == false) {
                RefreshGrid("gridMaterialInventory");
            }
        }

        function autoComplete_onDataBinding(args) {
            var materialTypeId = $("#MaterialTypeName").data('tDropDownList').value();

            if (materialTypeId === 0 || $("#MaterialTypeName").data('tDropDownList') == null)
                args.preventDefault();

            args.data = $.extend({}, args.data, { materialTypeId: materialTypeId });
        }

        function autoComplete_onChange() {
            RefreshGrid("gridMaterialInventory");
        }

        // grid

        function gridMaterialInventory_onDataBinding(args) {

            var materialTypeId = $("#MaterialTypeName").data('tDropDownList').value();
            if (materialTypeId === "")
                materialTypeId = 0;
            var materialClassifiedId = $("#MaterialClassifiedName").data('tDropDownList').value();
            if (materialClassifiedId === "")
                materialClassifiedId = 0;
            var materialName = $("#MaterialCodeName").data("tAutoComplete").value();
            var fromDate = $("#fromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#toDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
            }
            args.data = $.extend(args.data, {
                materialCode: materialName,
                materialTypeId: materialTypeId,
                materialClassifiedId: materialClassifiedId,
                fromDate: fromDate,
                toDate: toDate
            });

        }
    </script>

    <!-- ForPeriod -->
    <script type="text/javascript">
        function materialClassifiedForPeriod_onClose() {
            $("#MaterialTypeNameForPeriod").data('tDropDownList').reload();
        }

        function materialTypeNameForPeriod_onDataBinding(args) {
            var materialClassifiedForPeriodId = $("#MaterialClassifiedNameForPeriod").data('tDropDownList').value();
            args.data = $.extend({}, args.data, { classifiedId: materialClassifiedForPeriodId });
        }

        function materialTypeNameForPeriod_onClose() {
            RefreshGrid("gridMaterialInventoryForPeriod");
        }

        function materialTypeNameForPeriod_onChange2() {
            RefreshGrid("gridMaterialPeriod");
        }

        function warehouseIssueNameForPeriod_onChange() {
            RefreshGrid("gridMaterialInventoryForPeriod");
        }

        function warehouseReceiptNameForPeriod_onChange() {
            var chkAllWarehouseForPeriod = $("input[name='chkAllWarehouseForPeriod']").is(":checked");
            if (chkAllWarehouseForPeriod == false) {
                RefreshGrid("gridMaterialInventoryForPeriod");
            }
        }

        function autoCompleteForPeriod_onDataBinding(args) {
            var materialTypeForPeriodId = $("#MaterialTypeNameForPeriod").data('tDropDownList').value();

            if (materialTypeForPeriodId === 0 || $("#MaterialTypeNameForPeriod").data('tDropDownList') == null)
                args.preventDefault();

            args.data = $.extend({}, args.data, { materialTypeId: materialTypeForPeriodId });
        }

        function autoCompleteForPeriod_onChange() {
            RefreshGrid("gridMaterialInventoryForPeriod");
        }

        function autoCompleteForPeriod_onChange2() {
            RefreshGrid("gridMaterialPeriod");
        }

// grid ForPeriod

        function gridMaterialInventoryForPeriod_onDataBinding(args) {

            var materialTypeForPeriodId = $("#MaterialTypeNameForPeriod").data('tDropDownList').value();
            var materialNameForPeriod = $("#MaterialCodeNameForPeriod").data("tAutoComplete").value();

            //var warehouseIssue = $("#WarehouseIssueName").data('tDropDownList').value();
            var warehouseReceiptForPeriod = $("#WarehouseReceiptNameForPeriod").data('tDropDownList').value();

            var chkAllWarehouseForPeriod = $("input[name='chkAllWarehouseForPeriod']").is(":checked");
            if (chkAllWarehouseForPeriod == true)
                warehouseReceiptForPeriod = 0;

            var fromDate = $("#fromDateReported").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#toDateReported").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
            }

            if (materialTypeForPeriodId == 0)
                args.preventDefault();
            else {
                args.data = $.extend(args.data, {
                    materialTypeId: materialTypeForPeriodId,
                    //warehouseIssue: warehouseIssue,
                    //warehouseReceipt: warehouseReceipt,
                    warehouseId: warehouseReceiptForPeriod,
                    eoi: "@Convert.ToChar(MyUtilities.Transaction.EoIEnum.Import)",
                    materialName: materialNameForPeriod,
                    fromDate: fromDate, //$.telerik.formatString('{0:dd/MM/yyyy}', fromDate),
                    toDate: toDate//$.telerik.formatString('{0:dd/MM/yyyy}', toDate )
                });


            }
        }
    </script>

    <!-- report -->
    <script type="text/javascript">
        function printMaterialInvManagementForPeriod() {
            if (!onLoading) {
                OnLoadingData();
                var materialTypeForPeriodId = $("#MaterialTypeNameForPeriod").data('tDropDownList').value();
                var materialNameForPeriod = $("#MaterialCodeNameForPeriod").data("tAutoComplete").value();

                //var warehouseIssue = $("#WarehouseIssueName").data('tDropDownList').value();
                var warehouseReceiptForPeriod = $("#WarehouseReceiptNameForPeriod").data('tDropDownList').value();

                var chkAllWarehouseForPeriod = $("input[name='chkAllWarehouseForPeriod']").is(":checked");
                if (chkAllWarehouseForPeriod == true)
                    warehouseReceiptForPeriod = 0;

                var fromDate = $("#fromDateReported").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else {
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                }
                var toDate = $("#toDateReported").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else {
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                }

                //        if (materialTypeForPeriodId == 0)
                //            args.preventDefault();
                //        else {
                //            args.data = $.extend(args.data, {
                //                materialTypeId: materialTypeForPeriodId,
                //                //warehouseIssue: warehouseIssue,
                //                //warehouseReceipt: warehouseReceipt,
                //                warehouseId: warehouseReceiptForPeriod,
                //                eoi: "@Convert.ToChar(MyUtilities.Transaction.EoIEnum.Import)",
                //                materialName: materialNameForPeriod,
                //                fromDate: fromDate, //$.telerik.formatString('{0:dd/MM/yyyy}', fromDate),
                //                toDate: toDate//$.telerik.formatString('{0:dd/MM/yyyy}', toDate )
                //            });


                //        }

                if (materialTypeForPeriodId.length == 0) {
                    alert("Vui Lòng Loại Nguyên Liệu");
                    return false;
                }
                //        if (materialNameForPeriod.length == 0) {
                //            alert("Vui Lòng Chọn Nguyên Liệu");
                //            return false;
                //        }


                $('#result').load('@Url.Action("PrintMaterialInvManagementForPeriod", "Inv")',
                    {
                        materialTypeId: materialTypeForPeriodId,
                        warehouseId: warehouseReceiptForPeriod,
                        eoi: "@Convert.ToChar(MyUtilities.Transaction.EoIEnum.Import)",
                        materialName: materialNameForPeriod,
                        fromDate: fromDate, //$.telerik.formatString('{0:dd/MM/yyyy}', fromDate),
                        toDate: toDate//$.telerik.formatString('{0:dd/MM/yyyy}', toDate )
                    }, function (data) {
                        OnLoadedData();
                        var window = $('#windowReportMaterialInvManagementForPeriod').data('tWindow');
                        window.open();

                        //$("t-window-content t-content").css("height","100%;");
                    })
            };

            return false;
        }

        function gridMaterialPeriod_onDataBinding(args) {
            var materialType = $("#MaterialType").data('tComboBox').value();
            if (materialType === "")
                materialType = 0;
            var materialCode = $("#MaterialCodeNameForPeriod").data("tAutoComplete").value();
            var toDate = $("#toDateReported").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
            }
            args.data = $.extend(args.data, {
                materialType: materialType,
                materialCode: materialCode,
                toDate: toDate,
            });
        }

        function printMaterialDailyPeriod() {
            if (!onLoading) {
                OnLoadingData();
                var materialType = $("#MaterialType").data("tComboBox").value();
                if (materialType === "")
                    materialType = 0;
                var materialCode = $("#MaterialCodeNameForPeriod").data("tAutoComplete").value();
                var toDate = $("#toDateReported").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else {
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);
                    $('#result').load('@Url.Action("PrintMaterialDailyPeriod", "Inv")',
                        {
                            materialType: materialType,
                            materialCode: materialCode,
                            monthly: toDate
                        }, function () {
                            OnLoadedData();
                            var window = $('#windowReportMaterialInvManagementForPeriod').data('tWindow');
                            window.open();

                            //$("t-window-content t-content").css("height","100%;");
                        });
                }
            }
            return false;
        }

        function printMaterialInvTotalInMonth() {
            if (!onLoading) {
                OnLoadingData();
                var month = $('#Month').data('tComboBox').value();
                var year = $('#Year').data('tAutoComplete').text();
                $('#result').load('@Url.Action("PrintMaterialInvTotalInMonth", "Reporting")',
                    {
                        month: month,
                        year: year
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReportMaterialInvTotal').data('tWindow');
                        window.open();
                    });

            }
            return false;
        }


        function cbo_onclose(e) {
            var combobox = $(this).data('tComboBox');
            alert(combobox);
        }

        function month_onLoad() {
            var combobox = $('#Month').data('tComboBox');
            var dataSource =
            [
                { Text: "1", Value: "1" },
                { Text: "2", Value: "2" },
                { Text: "3", Value: "3" },
                { Text: "4", Value: "4" },
                { Text: "5", Value: "5" },
                { Text: "6", Value: "6" },
                { Text: "7", Value: "7" },
                { Text: "8", Value: "8" },
                { Text: "9", Value: "9" },
                { Text: "10", Value: "10" },
                { Text: "11", Value: "11" },
                { Text: "12", Value: "12" }
            ];

            combobox.dataBind(dataSource);
            if (new Date().getMonth() == 12)
                combobox.value = "1";
            else combobox.value(new Date().getMonth() + 1);
        }
    </script>

}

    <div class="title">
        @*Thông tin tồn kho nguyên liệu*@
        @HttpContext.GetGlobalResourceObject("Resource", "MaterialInvManagement")
