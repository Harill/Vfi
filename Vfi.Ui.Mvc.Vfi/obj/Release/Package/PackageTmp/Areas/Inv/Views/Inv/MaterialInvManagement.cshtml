    <div id="pnlInv">
        <div class="title">
            @*Quản lý xuất nhập tồn nguyên liệu*@
            @HttpContext.GetGlobalResourceObject("Resource", "Management") @HttpContext.GetGlobalResourceObject("Resource", "ExportImport") @HttpContext.GetGlobalResourceObject("Resource", "MaterialInv")
        </div>
        <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 920px;">
            <div class="prefix_10">
                <div class="grid_1">
                    @*@Html.Label("Tháng")*@
                    @HttpContext.GetGlobalResourceObject("Resource", "Month")
                </div>
                 <div class="grid_2">
                    @{
                        Html.Telerik().ComboBox()
                            .Name("Month")
                            .HtmlAttributes(new {style = "width: 40px"})
