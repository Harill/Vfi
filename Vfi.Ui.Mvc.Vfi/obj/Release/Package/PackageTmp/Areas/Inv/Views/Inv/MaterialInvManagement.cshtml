                            .HtmlAttributes(new {style = "width: 150px"})
                            .DropDownHtmlAttributes(new {style = "width: 250px"})
                            .ClientEvents(events => events.OnDataBinding("materialTypeName_onDataBinding").OnChange("materialTypeName_onChange"))
