                                .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n1}', Sum) #></div>")
                                .FooterTemplate("<span id='tongcot1'></span>")
                                .HtmlAttributes(new {style = "text-align: right;"});
                            
                            columns.Bound(f => f.EarlyQuantityKg).Width(100)
                                //.HeaderTemplate("<strong>Tồn đầu</br>(Kg)</strong>")
                                .Title(@HttpContext.GetGlobalResourceObject("Resource", "EarlyQuantity").ToString()
                                    + "</br>(kg)"
                                )
                                .Aggregate(agg => agg.Sum())
                                .ClientTemplate("<#= EarlyQuantityKg == null ? 0 : $.telerik.formatString('{0:n1}', EarlyQuantityKg) #>")
                                .ClientGroupFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n1}', Sum) #></div>")
                                .ClientFooterTemplate("<div style='text-align: right; width: 100%;'><#= $.telerik.formatString('{0:n1}', Sum) #></div>")
