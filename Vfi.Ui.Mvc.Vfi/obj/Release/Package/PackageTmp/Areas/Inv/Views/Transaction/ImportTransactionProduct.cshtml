@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model TransactionModel
@{
    ViewBag.Title = "Nhập SP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">
        function customer_onChange() {
            RefreshGrid("gridProductInventory");
        }

        function warehouseReceiptName_OnChange() {
            RefreshGrid("gridProductInventory");
        }
        function autoComplete_onChange() {
            RefreshGrid("gridProductInventory");
        }
        function gridProductInventory_onDataBinding(args) {


            var customerId = $("#Customer").data('tComboBox').value();
            var warehouseIssue = $("#WarehouseReceiptName").data('tDropDownList').value();

            var productCode = $("#ProductCode").data("tAutoComplete").value();

            if (warehouseIssue === "") {
                warehouseIssue = 0;
            }
            if (customerId === "") {
                customerId = 0;
            }

            args.data = $.extend(args.data, {
                customerId: customerId,
                warehouseId: warehouseIssue,
                productCode: productCode
            });
        }

    </script>

    <script type="text/javascript">
        var index = 0;
        function PickupProductId() {

            var $checkedRecords = $(':checked');

            if ($checkedRecords.length < 1) {
                alert("Vui lọn chọn ít nhất 1 nguyên liệu");
                return;
            }
            var a = {};
            var ids = "";

            for (var i = 0; i < $checkedRecords.length; i++) {
                a[i] = $checkedRecords[i].value;

                ids += $checkedRecords[i].value;
                if (i < ($checkedRecords.length - 1))
                    ids += ":";
            }

            var warehouseReceipt = $("#WarehouseReceiptName").data('tDropDownList').value();
            $("#gridProductInventoryDetail").data("tGrid").rebind({
                productIds: ids,
                warehouseId: warehouseReceipt
            });

            index = 0;
        }
    </script>

    <!-- input validation -->
    <script type="text/javascript">
        function InputValidation() {
            var strMsgAlert = "";
            var warehouseReceiptName = $('#WarehouseReceiptName').data('tDropDownList').value();
            if (warehouseReceiptName === "") {
                strMsgAlert += "Vui lòng chọn kho nhập.\t\r\n";
            }

            if (strMsgAlert === "")
                return true;

            alert(strMsgAlert);
            return false;
        }
    </script>

    <!-- client event grid material inventory -->
    <script type="text/javascript">
        function gridProductInventoryDetail_onSubmitChanges(e) {
            var flag = InputValidation();

            if (flag === false)
                e.preventDefault();
            else {
                var warehouseReceiptName = $('#WarehouseReceiptName').data('tDropDownList').value();
                var monthlyDate = $("#MonthlyDate").data("tDatePicker").value();
                if (monthlyDate === null)
                    monthlyDate = "";
                else
                    monthlyDate = $.telerik.formatString('{0:dd/MM/yyyy}', monthlyDate);

                e.values = $.extend(e.values,
                    {
                        warehouseReceiptId: warehouseReceiptName,
                        date: monthlyDate
                    }
                );
            }
        }

        function gridProductInv_OnRowDataBound(e) {
            var dataItem = e.dataItem; //FA5858 F4FA58
            if (dataItem.ProductWeight === 0)
                e.row.childNodes[2].style.backgroundColor = "#F4FA58";
        }
    </script>
}

<div class="title">
    @*Nhập sản phẩm*@
    @HttpContext.GetGlobalResourceObject("Resource", "ImportTransactionProduct")
</div>

<div class="t-info-sha" style="padding-left: 15px;padding-right: 15px; width:920px;">
    
    <div class="grid_3">
        @*Khách hàng:*@
        @HttpContext.GetGlobalResourceObject("Resource", "Customer")
    </div>
    <div class="grid_7">
        @{
            Html.Telerik().ComboBox()
                .Name("Customer")
                .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                .HtmlAttributes(new { style = "width: 250px" })
                .DropDownHtmlAttributes(new { style = "width: 325px;" })
                .ClientEvents(events => events.OnChange("customer_onChange"))
                .AutoFill(true)
                .Filterable(f=>f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                .Render();
        }
    </div>
    <div class="grid_2">
        @*Sản phẩm:*@
        @HttpContext.GetGlobalResourceObject("Resource", "Product")
    </div>
    <div class="grid_4">
        @{
            Html.Telerik().AutoComplete()
                .Name("ProductCode")
                .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                .HtmlAttributes(new { style = "width: 200px; " })
                .DropDownHtmlAttributes(new { style = "width: 250px; " })
                .Encode(false)
                .AutoFill(true)
                .HighlightFirstMatch(true)
                .ClientEvents(events=>events
                    .OnChange("autoComplete_onChange")
                )
                .Render();
        }
    </div>
    <div class="clear"></div><br/>

    <fieldset>
        <legend>
            @*Thông tin phiếu nhập*@
            @HttpContext.GetGlobalResourceObject("Resource", "ImportFormInformation")
        </legend>
        <div class="grid_3">
            @*@Html.LabelFor(f=>f.WarehouseReceiptName)*@
            @HttpContext.GetGlobalResourceObject("Resource", "ImportWarehouse")
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().DropDownList()
                    .Name("WarehouseReceiptName")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxImportWarehouse", "Warehouse"))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px; height: 250px;" })
                    .ClientEvents(events => events
                        .OnChange("warehouseReceiptName_OnChange")
                        )
                    .Render();
            }
        </div>
         <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("MonthlyDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
    </fieldset>
</div>
<div class="clear"></div>

<div class="cover-div">
    @{
        Html.Telerik().Grid<ProductInventoryRotateModel>()
            .Name("gridProductInventory")
            .ToolBar(bar => bar.Template(
        @<text>
        <div class="grid_7">
            <button class="t-button" id="btnPickupProductId" name="btnPickupProductId" onclick=" PickupProductId() ">
                <span class='t-icon t-insert'></span>
                @*Chọn các sản phẩm vào lưới*@
                @HttpContext.GetGlobalResourceObject("Resource", "SelectProductIntoNet")
            </button>
        </div>
        <div class="clear"></div>
        </text>
))
            .DataKeys(keys => keys.Add(f => f.ProductInventoryIssueId).RouteKey("productInventoryIssueId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                .Select("SelectProductInventoryById", "Inv", new { customerId = 0, warehouseId = 0, productCode = "" }))
            .Columns(columns =>
            {
                columns.Bound(f => f.ProductId)
                    //.Title("Chọn")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Select").ToString())
                    .Width(75)
                    .ClientTemplate("<input type='checkbox' name='chkProductIds' value='<#= ProductId #>' />")
                    .HtmlAttributes(new { style = "text-align:center" });
               
                columns.Bound(f => f.ProductCode).Width(250)
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductCode2").ToString());
               
                columns.Bound(f => f.ProductWeight).Width(100)
                    //.Title("TL sản phẩm (g/pc)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductWeight2").ToString()
                        + " (g/pc)"    
                    )
                    .Format("{0:n3}");
                
                columns.Bound(f => f.LotNumber)
                    //.Title("Lô")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Lot").ToString())
                    .Width(150);

                columns.Bound(f => f.TotalQty)
                    //.Title("Tồn kho xuất (pcs)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Inventory").ToString()
                        + " "
                        + @HttpContext.GetGlobalResourceObject("Resource", "Export").ToString()
                        + " (pcs)"
                    )
                    .Width(100)
                    .Format("{0:n0}");
                
                columns.Bound(f => f.AvailableQty)
                    //.Title("Có thể xuất (pcs)")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Available").ToString()
                        + " "
                        + @HttpContext.GetGlobalResourceObject("Resource", "Export").ToString()
                        + " (pcs)" 
                    )
                    .Width(100)
                    .Format("{0:n0}");
                
                columns.Bound(f => f.Note)
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Note").ToString());
            })
            .Scrollable(f => f.Height("auto"))
            .Scrollable(f => f.Height(200))
            .Resizable(f => f.Columns(true))
            //.Pageable(f => f.Style(GridPagerStyles.Status))
            .ClientEvents(events => events.OnError("grid_OnError")
                .OnDataBinding("gridProductInventory_onDataBinding")
                .OnRowDataBound("gridProductInv_OnRowDataBound"))
            .Render();
    }
</div>

<div class="clear"></div><br/>
<div class="t-info-sha" style="padding-left: 15px; width:250px; color: Maroon;">
    @*Chi tiết lệnh nhập sản phẩm*@
    @HttpContext.GetGlobalResourceObject("Resource", "MaterialInputOrderDetail")
</div>
<div class="cover-div">
@{
    Html.Telerik().Grid<ProductInventoryRotateModel>()
        .Name("gridProductInventoryDetail")
        .ToolBar(bar=>bar.SubmitChanges().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
            .SaveText(@HttpContext.GetGlobalResourceObject("Resource", "SaveAll").ToString())
            .CancelText(@HttpContext.GetGlobalResourceObject("Resource", "CancelText").ToString()))
        .DataKeys(keys => keys.Add(f => f.ProductInventoryId).RouteKey("productInventoryId"))
        .DataBinding(dataBindings => dataBindings.Ajax()
            .Select("SelectProductInventory", "Inv", new { productIds = "", warehouseId = 0 })
            .Update("CreateImportProductInventory", "Transaction"))
        .Columns(columns =>
        {
            columns.Bound(f => f.ProductId).Width(30)
                .ClientTemplate("<#= ++index #>")
                //.HeaderTemplate("<strong>STT</strong>")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Index").ToString());
          
            columns.Bound(f => f.CustomerCode)
                //.Title("Mã KH")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "CustomerCode2").ToString())
                .Width(100).ReadOnly(true);
            
            columns.Bound(f => f.ProductCode).Width(200).ReadOnly(true)
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductCode2").ToString());
            
            columns.Bound(f => f.TotalQty)
                //.Title("Tồn kho(pcs)")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Inventory").ToString()
                    + "(pcs)"
                )
                .ReadOnly(true).Width(100)
                .Format("{0:n0}");
            
            columns.Bound(f => f.LotNumber)
                //.Title("Lô")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Lot").ToString())
                .Width(150);
            
            columns.Bound(f => f.Quantity).Width(100)
                //.Title("Số lượng(pcs)")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Quantity").ToString()
                    + "(pcs)"
                )
                .HeaderHtmlAttributes(new { @class = "edit-column" })
                .Format("{0:n0}")
                .HtmlAttributes(new { style = "text-align: right;" });
            
            columns.Bound(f => f.Note)
                //.Title("Ghi chú")
                .Title(@HttpContext.GetGlobalResourceObject("Resource", "Note").ToString());
            
            columns.Command(commands => commands.Delete().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(98).Title("");
        })
        .ClientEvents(events => events
            .OnSubmitChanges("gridProductInventoryDetail_onSubmitChanges")
            .OnError("grid_OnError")
        )
        .Editable(f=>f.Mode(Telerik.Web.Mvc.UI.GridEditMode.InCell))
        //.Footer(false)
        .Resizable(f => f.Columns(true))
        .Render();   
}
</div>