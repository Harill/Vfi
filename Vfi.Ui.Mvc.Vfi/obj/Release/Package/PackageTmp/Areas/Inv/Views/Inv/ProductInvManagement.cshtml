        var index = 0;

        function gridProductInventoryForMonthly_onDataBound() {
            var sum = 0;
            $("span[name='sumMonthly']").each(function() {
                sum = sum + parseInt($(this).text());
            });
            $("#sumMonthly").text(sum);

            for (var i = 7; i <= 18; i++) {
                var total = 0;
                $("span[name='cot" + i + "']").each(function() {
