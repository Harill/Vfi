// grid ForPeriod 

        function gridProductInventoryForPeriod_onDataBinding(args) {
            if (startGrid) {
                //var materialForPeriodId = $("#MaterialNameForPeriod").data('tComboBox').value();
                var productCodeNameForPeriod = $("#ProductCodeNameForPeriod").data("tAutoComplete").value();
                var lot = $("#LotNumber").data("tAutoComplete").value();

                var customerId = $("#CustomerForPeriod").data('tComboBox').value();

                //var warehouseIssue = $("#WarehouseIssueName").data('tDropDownList').value();
                var warehouseReceiptForPeriod = $("#WarehouseReceiptNameForPeriod").data('tDropDownList').value();

                var fromDate = $("#fromDateReported").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else {
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                }
                var toDate = $("#toDateReported").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else {
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
                }


                if (customerId == 0)
                    customerId = 0;

                var isGroup = $("input[name='chkGroup']").attr('checked');
                args.data = $.extend(args.data, {
                    customerId: customerId,
                    warehouseId: warehouseReceiptForPeriod,
                    productCode: productCodeNameForPeriod,
                    lotnumber: lot,
                    fromDate: fromDate, //$.telerik.formatString('{0:dd/MM/yyyy}', fromDate),
                    toDate: toDate, //$.telerik.formatString('{0:dd/MM/yyyy}', toDate )
                    isGroup: isGroup,
                });
            }
        }

        var index = 0;

