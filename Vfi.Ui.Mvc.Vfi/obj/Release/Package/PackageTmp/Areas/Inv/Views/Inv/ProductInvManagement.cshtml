    </script>    
    <!-- report -->    
    <script type="text/javascript">
        function printProductInvManagementForPeriod() {
            //alert(2);

            var productCodeNameForPeriod = $("#ProductCodeNameForPeriod").data("tAutoComplete").value();

            var customerId = $("#CustomerForPeriod").data('tComboBox').value();

            var warehouseReceiptForPeriod = $("#WarehouseReceiptNameForPeriod").data('tDropDownList').value();

            var chkAllWarehouseForPeriod = $("input[name='chkAllWarehouseForPeriod']").is(":checked");
            if (chkAllWarehouseForPeriod == true)
                warehouseReceiptForPeriod = 0;

            var fromDate = $("#fromDateReported").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#toDateReported").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
            }

            if (customerId == 0)
                customerId = 0;
            // con cai nay test thôi
            $('#result').load('@Url.Action("ProductInvManagementForPeriod", "Inv")',
                {
                    customerId: customerId,
                    warehouseId: warehouseReceiptForPeriod,
                    productName: productCodeNameForPeriod,
                    fromDate: fromDate, //$.telerik.formatString('{0:dd/MM/yyyy}', fromDate),
                    toDate: toDate//$.telerik.formatString('{0:dd/MM/yyyy}', toDate )
            
                }, function(data) {
                    var window = $('#windowReportProductInvManagementForPeriod').data('tWindow');
                    window.open();

                    //$("t-window-content t-content").css("height","100%;");
                });

            return false;
        }

        function printProductInvManagementForPeriodAndListWarehouse() {
            var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();

            var customerId = $("#Customer").data('tComboBox').value();

            var fromDate = $("#fromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else {
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            }
            var toDate = $("#toDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else {
                toDate = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', toDate);
            }

            if (customerId == 0)
                customerId = 0;

            $('#rptResult2').load('@Url.Action("PrintProductInvManagementForPeriodAndListWarehouse", "Inv")',
                {
                    customerId: customerId,
                    warehouseId: 0,

                    productName: productCodeName,
                    fromDate: fromDate, //$.telerik.formatString('{0:dd/MM/yyyy}', fromDate),
                    toDate: toDate//$.telerik.formatString('{0:dd/MM/yyyy}', toDate )
                }, function(data) {
                    var window = $('#windowReportProductInvManagementForPeriodAndListWarehouse').data('tWindow');
                    window.open();

                    //$("t-window-content t-content").css("height","100%;");
                });

            return false;
        }


        function gridInventoryInDay_onDataBinding(args) {

            var customerId = $("#CustomerForInventoryInDay").data('tComboBox').value();
            var productCodeName = $("#ProductCodeNameForInventoryInDay").data("tAutoComplete").value();
            var warehouseView = $("#WarehouseView").data('tDropDownList').value();
            var warehouseReceiptInDay1 = $("#WarehouseReceiptInDay1").data('tDropDownList').value();
            var warehouseReceiptInDay2 = $("#WarehouseReceiptInDay2").data('tDropDownList').value();
            var warehouseReceiptInDay3 = $("#WarehouseReceiptInDay3").data('tDropDownList').value();
            var warehouseReceiptInDay4 = $("#WarehouseReceiptInDay4").data('tDropDownList').value();
            var warehouseReceiptInDay5 = $("#WarehouseReceiptInDay5").data('tDropDownList').value();
            var warehouseIssueInDay1 = $("#WarehouseIssueInDay1").data('tDropDownList').value();
            var warehouseIssueInDay2 = $("#WarehouseIssueInDay2").data('tDropDownList').value();
            var warehouseIssueInDay3 = $("#WarehouseIssueInDay3").data('tDropDownList').value();
            var warehouseIssueInDay4 = $("#WarehouseIssueInDay4").data('tDropDownList').value();
            var warehouseIssueInDay5 = $("#WarehouseIssueInDay5").data('tDropDownList').value();

            var dateView = $("#DateView").data("tDatePicker").value();
            if (dateView === null)
                dateView = "";
            else
                dateView = $.telerik.formatString('{0:dd/MM/yyyy 23:59:59}', dateView);


            if (warehouseView == 0) {
                args.preventDefault();
            }
            if (warehouseReceiptInDay1 == "") {
                warehouseReceiptInDay1 = 0;
            }
            if (warehouseReceiptInDay2 == "") {
                warehouseReceiptInDay2 = 0;
            }
            if (warehouseReceiptInDay3 == "") {
                warehouseReceiptInDay3 = 0;
            }
            if (warehouseReceiptInDay4 == "") {
                warehouseReceiptInDay4 = 0;
            }
            if (warehouseReceiptInDay5 == "") {
                warehouseReceiptInDay5 = 0;
            }
            if (warehouseIssueInDay1 == "") {
                warehouseIssueInDay1 = 0;
            }
            if (warehouseIssueInDay2 == "") {
                warehouseIssueInDay2 = 0;
            }
            if (warehouseIssueInDay3 == "") {
                warehouseIssueInDay3 = 0;
            }
            if (warehouseIssueInDay4 == "") {
                warehouseIssueInDay4 = 0;
            }
            if (warehouseIssueInDay5 == "") {
                warehouseIssueInDay5 = 0;
            }
            if (customerId == 0 || customerId == "") {
                customerId = 0;
            }

            args.data = $.extend(args.data, {
                //customerId: customerId,
                //productCodeName: productCodeName,
                warehouseView: warehouseView,
                warehouseReceiptInDay1: warehouseReceiptInDay1,
                warehouseReceiptInDay2: warehouseReceiptInDay2,
                warehouseReceiptInDay3: warehouseReceiptInDay3,
                warehouseReceiptInDay4: warehouseReceiptInDay4,
                warehouseReceiptInDay5: warehouseReceiptInDay5,
                warehouseIssueInDay1: warehouseIssueInDay1,
                warehouseIssueInDay2: warehouseIssueInDay2,
                warehouseIssueInDay3: warehouseIssueInDay3,
                warehouseIssueInDay4: warehouseIssueInDay4,
                warehouseIssueInDay5: warehouseIssueInDay5,
                dateView: dateView,
            });

        }

        var startGrid = false;

        function RefreshGrid2(name) {
            startGrid = true;
            RefreshGrid(name);
        }
    </script>
}

