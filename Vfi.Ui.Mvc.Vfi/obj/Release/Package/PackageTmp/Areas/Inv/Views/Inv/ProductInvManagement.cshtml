                toDate: toDate//$.telerik.formatString('{0:dd/MM/yyyy}', toDate )
            });
        }

        function gridProductInventoryForPeriodAndListWarehouse_onDataBound() {
            var sum = 0;
            $("span[name='sum']").each(function() {
                sum = sum + parseInt($(this).text());
            });
            $("#sum").text(sum);

            for (var i = 1; i < 12; i++) {
                var totalImport = 0;
                $("span[name='QtyImport" + i + "']").each(function() {
                    totalImport = totalImport + parseInt($(this).text());
                });
                $("#TotalQtyImport" + i).text(totalImport);

                var totalExport = 0;
                $("span[name='QtyExport" + i + "']").each(function() {
                    totalExport = totalExport + parseInt($(this).text());
                });
                $("#TotalQtyExport" + i).text(totalExport);

                var total = 0;
                $("span[name='Qty" + i + "']").each(function() {
                    total = total + parseInt($(this).text());
                });
                $("#TotalQty" + i).text(total);
            }
        }
    </script>
