@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@{
    ViewBag.Title = "Kế hoạch nguyên liệu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <!-- grid Monthly -->
    <script type="text/javascript">

        function grid_OnDataBinding(args) {

            var month = $("#Month").val();
            if (month === null)
                month = new Date().getMonth() + 1;
            var year = $("#Year").val();
            if (year === null || year == "")
                year = new Date().getYear() + 1;
            var monthCount = $("#MonthCount").val();
            if (monthCount === null || monthCount == "")
                monthCount = 3;
            var materialCode = $("#MaterialCodeName").data("tAutoComplete").value();
            var isAll = $("input[name='chkAll']").attr('checked');
            args.data = $.extend(args.data, {
                materialCode: materialCode,
                month: month,
                year: year,
                monthCount: monthCount,
                isAll: isAll,
            });
            index = 0;
            $("#ForecastByMonthHeader")[0].innerText = (monthCount + " tháng");
            $("#RequireByMonthHeader")[0].innerText = (monthCount + " tháng");
        }
        var index = 0;
        function grid_OnRowDataBound(e) {
            if (e.dataItem.HasProductDuplicate) {
                e.row.childNodes[3].bgColor = "#F4FA58";
            }
        }

        function gridDetail_OnDataBinding(args) {
            var month = $("#Month").val();
            if (month === null)
                month = new Date().getMonth() + 1;
            var year = $("#Year").val();
            if (year === null || year == "")
                year = new Date().getYear() + 1;
            var monthCount = $("#MonthCount").val();
            if (monthCount === null || monthCount == "")
                monthCount = 3;
            args.data = $.extend(args.data, {
                month: month,
                year: year,
                monthCount: monthCount,
            });

        }

        function gridDetail_OnLoad(e) {
            var monthCount = $("#MonthCount").val();
            e.target.getElementsByClassName("ForecastByMonthHeaderDetail")[0].innerText = (monthCount + " tháng");
        }

    </script>
}

<div class="title">Dự kiến đặt hàng nguyên liệu</div>
<div class="clear"></div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px; width: 1000px;">
    <fieldset>
        <legend>Tiêu chí trích lọc</legend>

        <div class="grid_2">
            Nguyên liệu
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().AutoComplete()
                    .Name("MaterialCodeName")
                    .DataBinding(binding => binding.Ajax().Select("AutoCompletedMaterialInventory", "Inv", new { materialTypeId = 0 }))
                    //.HtmlAttributes(new { style = "width: 185px; " })
                    .DropDownHtmlAttributes(new { style = "width: 250px; " })
                    .Encode(false)
                    .AutoFill(true)
                    .HighlightFirstMatch(true)
                    .Render();
            }
        </div>

        <div class="grid_2">
            @Html.Label("Kế hoạch")
        </div>
        <div class="grid_1">
            @{
                Html.Telerik().IntegerTextBox()
                    .Name("MonthCount")
                    .Value(3)
                    .MinValue(1)
                    .MaxValue(12)
                    //.HtmlAttributes(new {style = "width: 42px"})
                    .InputHtmlAttributes(new { style = "width: 30px" })
                    .Render();
            }
        </div>
        <div class="grid_2">
            @Html.Label("Tháng")  | 
        </div>

        <div class="grid_1">
            @Html.Label("Tháng")
        </div>
        <div class="grid_1">
            @{
                Html.Telerik().IntegerTextBox()
                    .Name("Month")
                    .Value(DateTime.Now.Month)
                    .MinValue(1)
                    .MaxValue(12)
                    //.HtmlAttributes(new {style = "width: 42px"})
                    .InputHtmlAttributes(new { style = "width: 30px" })
                    .Render();
            }
        </div>

        <div class="grid_1">
            @Html.Label("Năm")
        </div>
        <div class="grid_1_5">

            @{
                Html.Telerik().AutoComplete()
                    .Name("Year")
                    .Value(DateTime.Now.Year + "")
                    .HtmlAttributes(new { style = "width: 42px" })
                    .Render();
            }
        </div>
        <div class="grid_2_5">
            <label>
                <input type="checkbox" id="chkAll" name="chkAll" />
                Xem tất cả
            </label>
        </div>
        <div class="grid_3 prefix_1">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridPlan'); ">
                <span class='t-icon t-insert'></span>
                Làm mới
            </button>
        </div>
    </fieldset>
</div>
<div class="clear">
</div>

