@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@model ProductInventoryModel
@{
    ViewBag.Title = "Material Inventory On Machine";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{


    <!-- grid Monthly -->
    <script type="text/javascript">

        var startGrid = false;

        function grid_OnDataBinding(args) {

            if (startGrid && !onLoading) {
                OnLoadingData();
                var fromDate = $("#FromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#ToDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

                var factory = $("#Factory").data('tComboBox').value();
                args.data = $.extend(args.data, {
                    fromDate: fromDate,
                    toDate: toDate,
                    factory: factory,
                });
            }
        }
        
        function grid_OnDataBound() {
            OnLoadedData();
        }
    </script>
    <!-- report -->
    <script type="text/javascript">
        // in phat nguyen lieu
        function printNewAssignMaterial() {
            if (!onLoading) {
                OnLoadingData();
                var printDate = $("#PrintDate").data("tDatePicker").value();
                if (printDate === null)
                    printDate = "";
                else
                    printDate = $.telerik.formatString('{0:dd/MM/yyyy}', printDate);
                var factory = $("#Factory").data('tComboBox').value();
                $('#result').load('@Url.Action("PrintNewAssignMaterial", "Inv")',
                    {
                        printDate: printDate,
                        factory: factory
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }
        function printMaterialUseFormByDate() {
            
            if (!onLoading) {
                OnLoadingData();
                var fromDate = $("#FromDate").data("tDatePicker").value();
                if (fromDate === null)
                    fromDate = "";
                else
                    fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
                var toDate = $("#ToDate").data("tDatePicker").value();
                if (toDate === null)
                    toDate = "";
                else
                    toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

                var factory = $("#Factory").data('tComboBox').value();
                //var printDate = $("#PrintDate").data("tDatePicker").value();
                //if (printDate === null)
                //    printDate = "";
                //else
                //    printDate = $.telerik.formatString('{0:dd/MM/yyyy}', printDate);
                $('#result').load('@Url.Action("PrintMaterialUseFormByDate", "Inv")',
                    {
                        fromDate: fromDate,
                        toDate: toDate,
                        factory: factory
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

        // in su dung nguyen lieu
        function printMaterialUseForm() {
            
            if (!onLoading) {
                OnLoadingData();
                var printDate = $("#PrintDate").data("tDatePicker").value();
                if (printDate === null)
                    printDate = "";
                else
                    printDate = $.telerik.formatString('{0:dd/MM/yyyy}', printDate);
                var factory = $("#Factory").data('tComboBox').value();
                $('#result').load('@Url.Action("PrintMaterialUseForm", "Inv")',
                    {
                        printDate: printDate,
                        factory: factory
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }

        // in can hang
        function printProduction() {
            
            if (!onLoading) {
                OnLoadingData();
                var printDate = $("#PrintDate").data("tDatePicker").value();
                if (printDate === null)
                    printDate = "";
                else
                    printDate = $.telerik.formatString('{0:dd/MM/yyyy}', printDate);
                var factory = $("#Factory").data('tComboBox').value();
                $('#result').load('@Url.Action("PrintProduction", "Inv")',
                    {
                        printDate: printDate,
                        factory: factory,
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }
        // in can hang 2
        function printProduction2() {
            
            if (!onLoading) {
                OnLoadingData();
                var printDate = $("#PrintDate").data("tDatePicker").value();
                if (printDate === null)
                    printDate = "";
                else
                    printDate = $.telerik.formatString('{0:dd/MM/yyyy}', printDate);
                var factory = $("#Factory").data('tComboBox').value();
                $('#result').load('@Url.Action("PrintProduction2", "Inv")',
                    {
                        printDate: printDate
                    }, function () {
                        OnLoadedData();
                        var window = $('#windowReport').data('tWindow');
                        window.open();
                    });
            }
            return false;
        }


        function Factory_Onload() {
            var combobox = $('#Factory').data('tComboBox');
            var dataSource =
            [
                { Text: "VF1", Value: "VF1" },
                { Text: "VF2", Value: "VF2" }
            ];

            combobox.dataBind(dataSource);
        }

        var startGrid = false;
        function RefreshGrid2(name) {
            if (!onLoading) {
                startGrid = true;
                RefreshGrid(name);
            }
        }
    </script>
}

<div class="title">
    Báo cáo xuất nguyên liệu trên máy
    @HttpContext.GetGlobalResourceObject("Resource", "MaterialOnMachineManagement")
</div>
<div class="clear"></div>
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">
        
            <div class="grid_2">
                @*Xưởng:*@ 
                @HttpContext.GetGlobalResourceObject("Resource", "Factory")
            </div>
            <div class="grid_2">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Factory")
                    .HtmlAttributes(new { style = "width: 100%" })
                    .DropDownHtmlAttributes(new { style = "width: 100%" })
                        .ClientEvents(events => events.OnLoad("Factory_Onload"))
                        .Render();
                }
            </div>
            <div class="grid_2">
                @*Ngày*@
                @HttpContext.GetGlobalResourceObject("Resource", "Date")
            </div>
             <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("PrintDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
        <div class="grid_6">
            <button id="btnPrintAssign" class="t-button" onclick="printNewAssignMaterial();">
                <span class='t-icon t-insert'></span>
               In Phát nguyên liệu

                <span class="loadButton"></span>
            </button>
        </div>
        
            <div class="grid_7">
                <button id="btnPrintUse" class="t-button" onclick="printMaterialUseForm();">
                    <span class='t-icon t-insert'></span>
                    In sử dụng nguyên liệu

                <span class="loadButton"></span>
                </button>
            </div>
            <div class="grid_6">
                <button id="btnPrintProduction" class="t-button" onclick="printProduction();">
                    <span class='t-icon t-insert'></span>
                    In cân hàng (gộp)

                <span class="loadButton"></span>
                </button>
            </div>
            <div class="grid_6">
                <button id="btnPrintProduction2" class="t-button" onclick="printProduction2();">
                    <span class='t-icon t-insert'></span>
                    In cân hàng (tách)

                <span class="loadButton"></span>
                </button>
            </div>
        <div class="clear"></div>

        <fieldset>
            <legend>
                @*Tiêu chí trích lọc*@
                @HttpContext.GetGlobalResourceObject("Resource", "Filter")
            </legend>
            <div class="grid_2">
                @*Ngày*@
                @HttpContext.GetGlobalResourceObject("Resource", "Date")
            </div>
                <div class="grid_3">
                    @{
                        Html.Telerik().DatePicker()
                            .Name("FromDate")
                            .Format("dd/MM/yyyy")
                            .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
                            .Render();
                    }
                </div>
             <div class="grid_3">
                @{
                    Html.Telerik().DatePicker()
                        .Name("ToDate")
                        .Format("dd/MM/yyyy")
                        .Value(DateTime.Today)
                        .Render();
                }
            </div>
            <div class="grid_5">
                <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid2('gridMaterialUse'); ">
                    <span class='t-icon t-insert'></span>
                    @*Làm mới*@
                    @HttpContext.GetGlobalResourceObject("Resource", "Refresh")
                <span class="loadButton"></span>
                </button>
            </div>
            
            <div class="grid_4">
                <button id="btnPrintReport" class="t-button" onclick=" printMaterialUseFormByDate(); ">
                    <span class='t-icon t-insert'></span>
                    @*In*@
                    @HttpContext.GetGlobalResourceObject("Resource", "Print")
                <span class="loadButton"></span>
                </button>
            </div>
        </fieldset>
    </div>
    <div class="clear">
        
    </div>

<div class="cover-div">
    @{
        Html.Telerik().Grid<MaterialInvOnMachineModel>()
            .Name("gridMaterialUse")
            .DataKeys(keys => keys.Add(f => f.MachineId).RouteKey("machineId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("SelectMaterialInvOnMachineTotal", "Inv",
                                                             new { fromDate = "", toDate ="" }))
            .Columns(columns =>
                {
                    columns.Bound(f => f.MachineName).Width(70)
                        //.Title("Máy")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Machine").ToString());
               
                    columns.Bound(f => f.ProductCode).Width(100)
                        //.Title("SP đang chạy")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Product2").ToString()
                            + " "
                            + @HttpContext.GetGlobalResourceObject("Resource", "Producting").ToString()
                        );
                    
                    //columns.Bound(f => f.MaterialName).Width(100).Title("Tên NL");
                    
                    columns.Bound(f => f.MaterialDesign).Width(250)
                        //.Title("Quy cách")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Specifications").ToString());

                    //columns.Bound(f => f.LotNumber).Width(40).Title("Lô");
                    
                    //columns.Bound(f => f.Shift).Width(50).Title("Ca");
                    
                    columns.Bound(f => f.EarlyQuantity)
                        //.Title("Tồn đầu")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "EarlyQuantity").ToString())
                        .Width(100)
                        .Format("{0:n2}")
                        .HtmlAttributes(new {style = "text-align:right;"})
                        .Aggregate(agg => agg.Sum())
                        .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n}', Sum) #>")
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n}', Sum) #>")
                        .FooterHtmlAttributes(new {style = "text-align:right;"});
                    
                    columns.Bound(f => f.AssignQuantity)
                        //.Title("Cấp mới")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "AssignNew").ToString())
                        .Width(100)
                        .Format("{0:n2}")
                        .HtmlAttributes(new { style = "text-align:right;" })
                        .Aggregate(agg => agg.Sum())
                        .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n}', Sum) #>")
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n}', Sum) #>")
                        .FooterHtmlAttributes(new { style = "text-align:right;" });
                    
                    columns.Bound(f => f.QuantityUse1)
                        //.Title("Ca 1")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Shift1").ToString())
                        .Width(100)
                        .Format("{0:n2}")
                        .HtmlAttributes(new { style = "text-align:right;" })
                        .Aggregate(agg => agg.Sum())
                        .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n}', Sum) #>")
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n}', Sum) #>")
                        .FooterHtmlAttributes(new { style = "text-align:right;" });
                    
                    columns.Bound(f => f.QuantityUse2)
                        //.Title("Ca 2")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Shift2").ToString())
                        .Width(100)
                        .Format("{0:n2}")
                        .HtmlAttributes(new { style = "text-align:right;" })
                        .Aggregate(agg => agg.Sum())
                        .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n}', Sum) #>")
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n}', Sum) #>")
                        .FooterHtmlAttributes(new { style = "text-align:right;" });
                    
                    columns.Bound(f => f.SendBack)
                        //.Title("Trả NL")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "SendBackMaterial").ToString())
                        .Width(100)
                        .Format("{0:n2}")
                        .HtmlAttributes(new { style = "text-align:right;" })
                        .Aggregate(agg => agg.Sum())
                        .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n}', Sum) #>")
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n}', Sum) #>")
                        .FooterHtmlAttributes(new { style = "text-align:right;" });
                    
                    columns.Bound(f => f.Destroy)
                        //.Title("NL Hủy")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "Material2").ToString()
                            + " "
                            + @HttpContext.GetGlobalResourceObject("Resource", "Cancel").ToString()
                        )
                        .Width(100)
                        .Format("{0:n2}")
                        .HtmlAttributes(new { style = "text-align:right;" })
                        .Aggregate(agg => agg.Sum())
                        .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n}', Sum) #>")
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n}', Sum) #>")
                        .FooterHtmlAttributes(new { style = "text-align:right;" });
                    
                    columns.Bound(f => f.LastQuantity)
                        //.Title("Cuối ca")
                        .Title(@HttpContext.GetGlobalResourceObject("Resource", "EndShift").ToString())
                        .Width(100)
                        .Format("{0:n2}")
                        .HtmlAttributes(new { style = "text-align:right;" })
                        .Aggregate(agg => agg.Sum())
                        .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n}', Sum) #>")
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n}', Sum) #>")
                        .FooterHtmlAttributes(new { style = "text-align:right;" });
                    
                    columns.Bound(f => f.LastCheckQuantity).Title("")
                        .Format("{0:n2}")
                        .HtmlAttributes(new { style = "text-align:right;" })
                        .Aggregate(agg => agg.Sum())
                        .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n}', Sum) #>")
                        .ClientFooterTemplate("<#= $.telerik.formatString('{0:n}', Sum) #>")
                        .FooterHtmlAttributes(new { style = "text-align:right;" });
                })
            .Scrollable(f => f.Height(510))
            .Resizable(f => f.Columns(true))
            .Reorderable(f => f.Columns(true))
            .Filterable()
            .Sortable()
            .ClientEvents(events => events
                                        .OnDataBinding("grid_OnDataBinding")
                                        .OnDataBound("grid_OnDataBound")
                                        .OnError("grid_OnError"))
            .Groupable()
            .Render();
    }
    @*@{ Html.Telerik().ScriptRegistrar().OnDocumentReady("applyFrozenColumns();"); }*@
</div>

<!-- windown -->
@{
    Html.Telerik().Window()
        .Name("windowReport")
        .Modal(true)
        .Draggable(true)
        .Content
        (
    @<text>
    <div id="result"></div>
    </text>
        )
        //.ClientEvents(e => e.OnLoad("Window_onLoad"));
        .Visible(false)
        .Width(960)
        .Render();
}

