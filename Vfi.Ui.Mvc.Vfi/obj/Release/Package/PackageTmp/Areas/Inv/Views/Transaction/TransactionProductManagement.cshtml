@using Vfi.Ui.Mvc.Vfi.Areas.Inv.Models
@{
    ViewBag.Title = "QL phiếu sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">
        function transactionStatus_onChange() {
            RefreshGrid("gridTransaction");
        }

        function gridTransaction_onDataBinding(args) {
            var productCode = $("#ProductCodeName").data("tAutoComplete").value();

            var warehouse = $("#Warehouse").data('tComboBox').value();
            if (warehouse === "") {
                warehouse = 0;
            }
            var statusValue = $("#transactionStatus").data("tComboBox").value();
            if (statusValue === "")
                statusValue = 0;

            var fromDate = $("#fromDate").data("tDatePicker").value();
            if (fromDate === null)
                fromDate = "";
            else
                fromDate = $.telerik.formatString('{0:dd/MM/yyyy}', fromDate);
            var toDate = $("#toDate").data("tDatePicker").value();
            if (toDate === null)
                toDate = "";
            else
                toDate = $.telerik.formatString('{0:dd/MM/yyyy}', toDate);

            args.data = $.extend({}, args.data, {
                productCode: productCode,
                warehouseId: warehouse,
                status: statusValue,
                transactionCode: "",
                mop: false,
                fromDate: fromDate,
                toDate: toDate
            });
        }

        //function grid_OnSave(e) {
        //    var value = e.values;
        //    var date = value.CreatedDate;
        //    date = $.telerik.formatString('{0:dd/MM/yyyy}', date);
        //    //var transactionId = value.transactionId;
        //    e.data = $.extend(e.data,
        //    {
        //        transactionId: value.transactionId,
        //        date: date
        //    });
        //}
        function grid_OnRowDataBound(e) {
            //if (e.dataItem.StatusName === "Đang giao")
            //    e.row.style.backgroundColor = "#F4FA58";

            //var today = new Date();
            //var check = e.dataItem.DueDate < today;
            //if (check)
            //    e.row.style.backgroundColor = "#FA5858";
            if (!e.dataItem.CanApprove) {
                e.row.getElementsByClassName("t-button t-grid-edit t-button-icon")[0].parentNode.innerHTML = "";
                e.row.getElementsByClassName("t-button rollback_" + e.dataItem.TransactionId)[0].parentNode.innerHTML = "";
            }
        }
    </script>

    <script type="text/javascript">
        function PrintForm(val) {
            alert(val);
            $('#result').load('@Url.Action("PrintTransactionForm", "Inv")',
            {
                transactionId: val
            }, function (data) {
                var window = $('#windowReport').data('tWindow');
                window.open();
            });
            return false;
        }
        function PrintFormGroup(val) {
            alert(val);
            $('#result').load('@Url.Action("PrintTransactionFormGroup", "Inv")',
            {
                transactionId: val
            }, function (data) {
                var window = $('#windowReport').data('tWindow');
                window.open();
            });
            return false;
        }

        function RollbackTransaction(id) {
            var message = "Phục hồi lệnh trở về chưa duyệt";
            message += "\nĐồng ý ??";
            if (confirm(message)) {
                $.ajax({
                    type: 'post',
                    data: { transactionId: id },
                    dataType: 'json',
                    url: '@Url.Action("CreateRollbackTransaction", "Transaction", new { area = "Inv" })',
                    timeout: 20000,
                    success: function (res) {
                        if (res.Code === 1) {
                            alert("Đã lưu " + res.Data);
                            if (res.Message && res.Message != "") {
                                alert(res.Message);
                            }
                            RefreshGrid("gridTransaction");
                        } else {
                            alert("Lỗi! " + res.Message);
                        }
                    }
                });
            } else {
            }
        }
    </script>

}
<div class="title">Quản lý hồ sơ thông tin lệnh về sản phẩm</div>
<div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">
    <fieldset>
        <legend>Tiêu chí trích lọc</legend>
        
        <div class="grid_2">Kho:</div>
        <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Warehouse")
                        .DataBinding(binding => binding.Ajax().Select("SelectAllComboBoxWarehouse", "Warehouse"))
                        .HtmlAttributes(new {style = "width: 100%"})
                        .DropDownHtmlAttributes(new {style = "width: 250px; height: 250px;"})
                        .Render();
                }
        </div>
        <div class="grid_2">Sản phẩm:</div>
        <div class="grid_4">
            @{
                Html.Telerik().AutoComplete()
                    .Name("ProductCodeName")
                    .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv"))
                    .HtmlAttributes(new { style = "width: 100%; " })
                    .DropDownHtmlAttributes(new { style = "width: 250px; " })
                    .Encode(false)
                    .AutoFill(true)
                    .HighlightFirstMatch(true)
                    .Render();
            }
        </div>
        <div class="grid_2">
            Tình trạng giao dịch
        </div>
        <div class="grid_4">
            @{
                Html.Telerik().ComboBox()
                    .Name("transactionStatus")
                    .DataBinding(binding => binding.Ajax().Select("SelectComboBoxTransactionStatus", "Transaction"))
                    .HtmlAttributes(new { style = "width: 150px" })
                    .DropDownHtmlAttributes(new { style = "width: 250px" })
                    .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                    .HighlightFirstMatch(true)
                    .AutoFill(true)
                    .ClientEvents(events => events.OnChange("transactionStatus_onChange"))
                    .Render();
            }
        </div>
        <div class="grid_3">
            @{
                Html.Telerik().DatePicker()
                    .Name("fromDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today.Month + "/01/" + DateTime.Today.Year)
                    .Render();
            }
        </div>
        <div class="grid_2">
            @{
                Html.Telerik().DatePicker()
                    .Name("toDate")
                    .Format("dd/MM/yyyy")
                    .Value(DateTime.Today)
                    .Render();
            }
        </div>
        <div class="grid_4 prefix_1">
            <button id="btnRefesh" class="t-button" onclick=" return RefreshGrid('gridTransaction'); ">
                <span class='t-icon t-insert'></span>
                Làm mới
            </button>
        </div>
    </fieldset>
</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<TransactionModel>()
            .Name("gridTransaction")
            .DataKeys(keys => keys.Add(f => f.TransactionId).RouteKey("transactionId"))
            .DataBinding(dataBindings => dataBindings.Ajax()
                                                     .Select("SelectTransactionReviewByStatus", "Transaction", new {
                                                         productCode = "",
                                                         warehouseId= 0,
                                                         status = 0,
                                                         mop = false,
                                                         fromDate = "",
                                                         toDate = ""
                                                     })
                                                          .Update("UpdateTransactions", "Transaction")
            )
            .Columns(columns => {
                columns.Command(c => c.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)).Width(50).Title("")
                    .HtmlAttributes(new { style = "text-align:center" });
                //columns.Bound(f => f.TransactionId).Title("Chọn").Width(50)
                //          .ClientTemplate("<input type='radio' name='chkTransactionIds' value='<#= TransactionId #>' />")
                //          .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.TransactionCode).Width(120).ReadOnly(true);
                columns.Bound(f => f.CreatedDate).Title("Ngày báo cáo").Width(100)
                           .ClientTemplate("<#= CreatedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', CreatedDate) #>");
                //columns.Bound(f => f.StockOrderCode);
                columns.Bound(f => f.WarehouseIssueName).Width(130).ReadOnly(true);
                columns.Bound(f => f.WarehouseReceiptName).Width(130).ReadOnly(true);
                columns.Bound(f => f.TotalQuality).Title("Tổng SL").ReadOnly(true).Width(90)
                       .HtmlAttributes(new { style = "text-align:right" })
                       .ClientTemplate("<#= TotalQuality == null ? 0 : $.telerik.formatString('{0:n0}', TotalQuality) #>");
                //columns.Bound(f => f.EoI).ClientTemplate("<#= EoI ? 'Xuất' : 'Nhập' #>");
                //columns.Bound(f => f.EoIName).ReadOnly(true);
                columns.Bound(f => f.StatusName).Width(100).ReadOnly(true);
                columns.Bound(f => f.TransactionId).Title("In").Width(45).ReadOnly(true).Filterable(false)
                       .ClientTemplate("<input type='button' id='id_<#= TransactionId #>' value='In' class='t-button' onclick=PrintForm(<#= TransactionId #>) />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.WarehouseIssueId).Title("In (G)").Width(45).ReadOnly(true).Filterable(false)
                       .ClientTemplate("<input type='button' id='id_<#= TransactionId #>' value='In' class='t-button' onclick=PrintFormGroup(<#= TransactionId #>) />")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.SpecialNote).Width(150).Title("Ghi chú").ReadOnly(true);
                columns.Bound(f => f.CreatedUser).Width(100).ReadOnly(true);
                columns.Bound(f => f.ModifiedDate).Title("Ngày tạo").Width(100).ReadOnly(true)
                       .ClientTemplate("<#= ModifiedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy}', ModifiedDate) #>");
                columns.Bound(f => f.TransactionId).Title("").Width(50).ReadOnly(true)
                       .ClientTemplate("<input type='button' id='rollback_<#= TransactionId #>' value='Rollback' class='t-button rollback_<#= TransactionId #>' onclick='RollbackTransaction(<#= TransactionId #>)' />")
                       .HtmlAttributes(new { style = "text-align:center" });
            })
            .DetailView(details => details.ClientTemplate(

                //Html.Telerik().TabStrip()
                //    .Name("TabStrip_<#= TransactionId #>")
                //    .SelectedIndex(0)
                //    .Items(items =>

                //           items.Add().Text("Thông tin chi tiết").Content(
                               Html.Telerik().Grid<TransactionDetailModel>()
                                   .Name("gridTransactionDetail_<#= TransactionId #>")
                                   .DataBinding(dataDindings => dataDindings.Ajax()
                                                                            .Select("SelectTransactionDetailByTransactionId", "Transaction",
                                                                                    new { transactionId = "<#= TransactionId #>" }))
                                   .Columns(columns => {
                                       columns.Bound(f => f.CustomerCode).Title("Mã KH").Width(50);
                                       columns.Bound(f => f.ProductCode).Title("Mã SP").Width(100);
                                       columns.Bound(f => f.LotNumber).Title("Lô").Width(150);
                                       columns.Bound(f => f.UnitWeight).Title("TL(g/pc)").Width(50);
                                       columns.Bound(f => f.Quantity).Width(75).Title("SL (PCS)")
                                              .HtmlAttributes(new { style = "text-align: right;" })
                                              .Format("{0:n0}").Aggregate(agg => agg.Sum())
                                              .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                              .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>");
                                       columns.Bound(f => f.QuantityKg).Width(75).Title("SL (g)")
                                              .HtmlAttributes(new { style = "text-align: right;" })
                                              .Format("{0:n0}")
                                              .Aggregate(agg => agg.Sum())
                                              .ClientGroupFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>")
                                              .ClientFooterTemplate("<#= $.telerik.formatString('{0:n0}', Sum) #>");
                                       columns.Bound(f => f.Note).Title("Ghi chú");
                                       columns.Bound(f => f.MaterialCode).Width(150).Title("Nguyên liệu");
                                       columns.Bound(f => f.MaterialTypeName).Width(75).Title("Loại");
                                       columns.Bound(f => f.Identity).Width(50).Title("Code");
                                   })
                                       .Groupable()
                                   .ClientEvents(events => events.OnError("grid_OnError"))
                                   .ToHtmlString()
                               )
                    )
            //.ToHtmlString()
            //                   ))
            .Selectable()
            .ClientEvents(events => events.OnError("grid_OnError")
                                          .OnRowSelect("grid_OnRowSelect")
                                          .OnRowDataBound("grid_OnRowDataBound")
                                          .OnDataBinding("gridTransaction_onDataBinding"))
            .Filterable()
            .Groupable()
            .Scrollable(f => f.Height(510))
            .Render();
    }
</div>

@{
    Html.Telerik().Window()
        .Name("windowReport")
        .Modal(true)
        .Draggable(true)
        .Content
        (
    @<text>
    <div id="result"></div>
    </text>
)
        //.ClientEvents(e => e.OnLoad("Window_onLoad"));
        .Visible(false)
        .Width(960)
        .Render();
}

<style type="text/css">
    #windowReport {
        /*
            float: right;
            Position: relative;
            */
        min-height: 580px;
        top: 15%;
    }

    #result {
        height: 520px;
        overflow: hidden;
    }

    #ReportBody {
        padding-bottom: 25px;
        margin-bottom: 25px;
    }

    .tb-witdh td {
        width: 55px;
    }
</style>
