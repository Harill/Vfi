<div class="title">Quản lý quyền</div>

<div class="cover-div">
    @{
        Html.Telerik().Grid<FunctionNewModel>()
            .Name("gridFunction")
            .DataKeys(key => key.Add(f => f.FunctionId).RouteKey("functionId"))
            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectFunctionPermission", "Permission", new { area = "" })
                                           .Insert("InsertFunction", "Permission", new { area = "" })
                                          .Update("UpdateFunction", "Permission", new { area = "" })
            )
            .ToolBar(toolbar =>toolbar.Insert()
                                       .Text("Thêm mới")
                                       .ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
            )
            .Columns(columns => {
                columns.Command(c => c.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image))
                       .Width(40).Title("")
                       .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.FunctionId).ReadOnly(true).Width(80).HtmlAttributes(new { style = "text-align:center;" });
                columns.Bound(f => f.FunctionName);
                columns.Bound(f => f.Description);
                columns.Bound(f => f.Active).Width(55);
                columns.Bound(f => f.ModifiedDate).Format("{0:(HH:mm) dd/MM/yyyy }").ReadOnly(true).Width(140);
            })
            .DetailView(details2 => details2.ClientTemplate(
                        Html.Telerik().Grid<PermissionNewModel>()
                    .Name("gridFunctionUserList_<#= FunctionId #>")
                    .DataKeys(key => key.Add(f => f.PermissionId).RouteKey("permissionId"))
                    .DataBinding(
                        dataBinding => dataBinding
                                           .Ajax()
                                           .Select("SelectFunctionUserList", "Permission", new { area = "", functionId = "<#= FunctionId #>" }))
                            .Columns(columns => {
                                columns.Bound(f => f.UserLogin);
                                columns.Bound(f => f.UserName);
                                columns.Bound(f => f.ModifiedDate).Format("{0:(HH:mm) dd/MM/yyyy }");
                            })
                            .ClientEvents(e => e.OnError("grid_OnError"))
                            .ToHtmlString()))
            .Selectable()
            .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
            .ClientEvents(events => events.OnRowSelect("grid_OnRowSelect")
                                          .OnError("grid_OnError"))
            .Scrollable(f => f.Height("auto"))
            .Resizable(resizing => resizing.Columns(true))
            .Scrollable()
            .Render();
    }
</div>
