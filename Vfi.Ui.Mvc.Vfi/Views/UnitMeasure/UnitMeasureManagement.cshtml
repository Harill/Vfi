<div class="title">@HttpContext.GetGlobalResourceObject("Resource", "UnitMeasureManagement")</div>

<div class="cover-div">
@{
    Html.Telerik().Grid<UnitMeasureModel>()
        .Name("gridUnitMeasure")
        .DataKeys(key => key.Add(f => f.UnitId).RouteKey("unitId"))
        .ToolBar(
            toolbar =>
            toolbar.Insert().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).ImageHtmlAttributes(new {style = "margin-left:0"}))
        .DataBinding(
            dataBinding => dataBinding.Ajax()
                                      .Select("SelectUnitMeasure", "UnitMeasure")
                                      .Insert("InsertUnitMeasure", "UnitMeasure")
                                      .Update("UpdateUnitMeasure", "UnitMeasure"))
        .Columns(columns =>
            {
                columns.Command(command => command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)
                    ).Width(98).Title("").HtmlAttributes(new {style = "text-align:center"});
                columns.Bound(f => f.UnitMeasureCode).Width(150).Title(@HttpContext.GetGlobalResourceObject("Resource", "UnitMeasureCode").ToString());
                columns.Bound(f => f.UnitMeasureName).Title(@HttpContext.GetGlobalResourceObject("Resource", "UnitMeasureName").ToString());
                //columns.Bound(f => f.Active).Width(45)
                //    .ClientTemplate("<input type='checkbox' disabled='disabled' name='Active' <#=Active? checked='checked' : '' #> />")
                //    .HtmlAttributes(new { style = "text-align:center" });
                columns.Bound(f => f.IsPlatingUnit).Width(45).Title(@HttpContext.GetGlobalResourceObject("Resource", "IsPlating").ToString())
                       .ClientTemplate("<input type='checkbox' disabled='disabled' name='IsPlatingUnit' <#=IsPlatingUnit? checked='checked' : '' #> />")
                       .HtmlAttributes(new {style = "text-align:center"});
            })
        //.ClientEvents(events => events.OnEdit("gridUnitMeasure_onEdit"))
        .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
        .Pageable(page => page.PageSize(15))
        .Sortable()
        .Render();
}

</div>