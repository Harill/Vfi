<!DOCTYPE html>
<html>
<head>
    <title>@ViewBag.Title</title>
    <meta http-equiv="content-type" content="text/html;charset=UTF-8" />
    <link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/Reports.css")" rel="stylesheet" type="text/css" />
    @*<link href="@Url.Content("~/Content/960/960_24_col.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/jquery-ui-1.8.13/css/ui-lightness/jquery-ui-1.8.13.custom.css")" rel="stylesheet" type="text/css" />*@

    <script type="text/javascript"src="@Url.Content("~/Scripts/jquery-1.4.4.min.js")" ></script>
    @*<script type="text/javascript" src="@Url.Content("~/Scripts/jquery-1.6.2.min.js")" ></script>*@
    
    <script type="text/javascript" src="@Url.Content("~/Scripts/MicrosoftAjax.js")"            ></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/MicrosoftMvcAjax.js")"         ></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/MicrosoftMvcValidation.js")"   ></script>
    
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.min.js")"      ></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
    
    <script type="text/javascript" src="@Url.Content("~/Scripts/common/common.js")"     ></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/common/ConfusedValidation.js")"     ></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/highslide-with-gallery.js")"   ></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/MyGridEvents.js")"   ></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnLoad.js")"   ></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/OnProcess.js")"   ></script>
    @*<script type="text/javascript" src="@Url.Content("~/Content/jquery-ui-1.8.13/js/jquery-ui-1.8.14.custom.min.js")"></script>*@

    @(Html.Telerik().StyleSheetRegistrar()
        .DefaultGroup(
                        group => group
                            .Add("telerik.common.min.css")
                            
                            //.Add("telerik.sunset.css")
                            
                            .Add(ViewBag.PageTheme)
                            
                            .Add("~/Content/960/960_24_col.css")
                                    
                            .Add("~/Content/jquery-ui-1.8.13/css/ui-lightness/jquery-ui-1.8.13.custom.css")
                                //.Add("~/Content/bootstrap.min.css")
                            .Combined(true).Compress(true)))

    @RenderSection("css", false)

    @RenderSection("Scripts", false)
    
    @RenderSection("HeadContent", false)
</head>
<script type="text/javascript">
    $(document).ready(function () {
        document.body.style.backgroundImage = "url('@ViewBag.ImagePath/Background/@ViewBag.BackgroundImage";
        document.getElementById("logo").src = "@ViewBag.ImagePath/Logo/@ViewBag.LogoImage";
    });
</script>   
<body style="background-image: url('@ViewBag.ImagePath/Background/@ViewBag.BackgroundImage');">
<div class="container_24">
    @* <div class="grid_26 page">*@
     <div class="page">
         <div class="logo">
             <img id="logo" src="@ViewBag.ImagePath/Logo/@ViewBag.LogoImage" alt="@ViewBag.LogoImage" />
         </div>
        <div id="header" style="width:93%;float:left">
            <div id="title">
                <h1 style="color: @ViewBag.PageTitleColor;">@HttpContext.GetGlobalResourceObject("Resource", "SystemManagement") @ViewBag.PageName</h1>
            </div>

            <div id="logindisplay" style="color: @ViewBag.PageTitleColor;">
                @Html.Partial("_LogOnUserControl")
            </div>


            @* 06/07/2026 *@
@*            @using (Html.BeginForm("SetLanguage", "Home", System.Web.Mvc.FormMethod.Post, new { area = "" }))
            {
                <select name="lang">
                    <option value="en-US">English</option>
                    <option value="vi-VN">Tiếng Việt</option>
                </select>
                <input type="submit" value="Change" />
            }*@


            <div class="clear"></div>
        </div>
        <br />
            <div id="menuArea" style="width:93%; float:left">
               @if (!Request.IsAuthenticated)
               {
                   @: @{ Html.Telerik().Menu().Name("M").Render();} 
               }
               else { 
                   @: @Html.Action("MainMenu", "Menu", new {Area = ""} )
               }
            </div>
            <!-- Menu Area , Render menu after login -->
            <!-- end Menu Area -->
            <div style="clear: both;"></div>
        <div id="main">
            @RenderBody()
        </div>
    </div>
    </div>
    <div class="t-overlay"></div>
@*@(Html.Telerik().ScriptRegistrar().Globalization(true).DefaultGroup(group => group.Combined(true).Compress(true)).jQuery(false))*@

@(Html.Telerik().ScriptRegistrar().Globalization(true)
        .DefaultGroup(
                        group => group
                            .Add("~/Content/jquery-ui-1.8.13/js/jquery-ui-1.8.14.custom.min.js")
                                //.Add("~/Scripts/Bvi/uis.common.js")
                                        //.Add("~/Scripts/jquery.validate.min.js")
                                            //.Add("~/Scripts/MicrosoftAjax.js")
                                                //.Add("~/Scripts/MicrosoftMvcAjax.js")
                                                    //.Add("~/Scripts/MicrosoftMvcValidation.js")
                            .Combined(true)
                            .Compress(true)
                            ).jQuery(false))
</body>
</html>
