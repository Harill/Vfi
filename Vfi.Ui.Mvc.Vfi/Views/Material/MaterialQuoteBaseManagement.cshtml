<div class="cover-div">
@{
    Html.Telerik().Grid<MaterialQuoteBaseModel>()
        .Name("gridMaterial")
        .DataKeys(key => key.Add(f => f.BaseId).RouteKey("baseId"))
        .ToolBar(
            toolbar =>
            toolbar.Insert().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
                            .Text(@HttpContext.GetGlobalResourceObject("Resource", "NewText").ToString())
                            .ImageHtmlAttributes(new { style = "margin-left:0px;" }))
        .DataBinding(
            dataBinding => dataBinding.Ajax()
                                      .Select("SelectMaterialQuoteBase", "Material", new { area = "" })
                                      .Insert("InsertMaterialQuoteBase", "Material")
                                      .Update("UpdateMaterialQuoteBase", "Material"))
        .Columns(columns =>
            {
                columns.Command(command =>
                                command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText)
                                       .UpdateText(@HttpContext.GetGlobalResourceObject("Resource", "UpdateText").ToString())
                                       .InsertText(@HttpContext.GetGlobalResourceObject("Resource", "InsertText").ToString())
                                       .CancelText(@HttpContext.GetGlobalResourceObject("Resource", "CancelText").ToString())
                                       .Text(@HttpContext.GetGlobalResourceObject("Resource", "EditText").ToString())
                    ).Width(90)
                    //.Title("Lệnh")
                    .HtmlAttributes(new {style = "text-align:center"});
                //columns.Bound(f => f.VendorCodeName).Width(150)
                //       .ClientTemplate("<strong><#= VendorCodeName #></strong>");
                columns.Bound(f => f.MaterialTypeName).Width(100)
                       //.HeaderTemplate("Loại</br>nguyên liệu")
                       .ClientTemplate("<strong><#= MaterialTypeName #></strong>")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "MaterialTypeName").ToString());
                columns.Bound(f => f.MaterialName).Width(100)
                       //.HeaderTemplate("Tên</br>nguyên liệu")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "MaterialName").ToString());
                columns.Bound(f => f.MaterialShape).Width(50)
                       .HtmlAttributes(new {style = "text-align:center;"})
                       //.HeaderTemplate("Hình</br>dạng")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "MaterialShape").ToString());
                columns.Bound(f => f.MaterialDiameterType).Width(50)
                       .HtmlAttributes(new { style = "text-align:center;" })
                       //.HeaderTemplate("Dung</br>sai")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "MaterialDiameterType").ToString());

                columns.Bound(f => f.BasePrice).Width(50)
                       .HtmlAttributes(new { style = "text-align:center;" })
                       //.HeaderTemplate("Giá trị")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "BasePrice").ToString());
                columns.Bound(f => f.ModifiedUser)
                    //.Title("Người tạo")
                    .ReadOnly(true).Width(70)
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ModifiedUser").ToString());
                columns.Bound(f => f.ModifiedDate).Title("Ngày tạo").ReadOnly(true).Width(80)
                       .Format("{0:dd/MM/yyyy HH:mm}")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "ModifiedDate").ToString());
            })

        .DetailView(details => details.ClientTemplate(

            Html.Telerik().TabStrip()
                .Name("TabStrip_<#= BaseId #>")
                .SelectedIndex(0)
                .Items(items =>

                       items.Add().Text(@HttpContext.GetGlobalResourceObject("Resource", "DetailText").ToString()).Content(

                           Html.Telerik().Grid<MaterialQuoteBaseDetailModel>()
                               .Name("gridDetail_<#= BaseId #>")
                               .DataKeys(key => key.Add(f => f.DetailId).RouteKey("detailId"))
                               .ToolBar(
                                   toolbar =>
                                   toolbar.Insert()
                                          .Text(@HttpContext.GetGlobalResourceObject("Resource", "NewText").ToString())
                                          .ButtonType(Telerik.Web.Mvc.UI.GridButtonType.ImageAndText).ImageHtmlAttributes(new { style = "margin-left:0px;" }))
                               .DataBinding(
                                   dataBinding => dataBinding.Ajax()
                                                             .Select("SelectMaterialQuoteBaseDetail", "Material", new { area = "", baseId = "<#= BaseId #>" })
                                                             .Insert("InsertMaterialQuoteBaseDetail", "Material", new { area = "", baseId = "<#= BaseId #>" })
                                                             .Update("UpdateMaterialQuoteBaseDetail", "Material", new { area = "" })
                               )
                               .Columns(columns => {
                                       columns.Command(command =>
                                                       command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)
                                                              .UpdateText(@HttpContext.GetGlobalResourceObject("Resource", "UpdateText").ToString())
                                                              .InsertText(@HttpContext.GetGlobalResourceObject("Resource", "InsertText").ToString())
                                                              .CancelText(@HttpContext.GetGlobalResourceObject("Resource", "CancelText").ToString())
                                                              .Text(@HttpContext.GetGlobalResourceObject("Resource", "EditText").ToString())
                                                              
                                           ).Width(40).Title("").HtmlAttributes(new { style = "text-align:center" });
                                       columns.Bound(f => f.FromOutDiameter).Width(50)
                                           //.Title(">= Đường kính")
                                           .Title(@HttpContext.GetGlobalResourceObject("Resource", "FromOutDiameter").ToString());

                                       columns.Bound(f => f.ToOutDiameter).Width(50)
                                           //.Title("< Đường kính");
                                   .Title(@HttpContext.GetGlobalResourceObject("Resource", "ToOutDiameter").ToString());

                                       columns.Bound(f => f.InDiameter).Width(50)
                                           //.Title("Đường kính trong</br>(nếu có)")
                                           .Title(@HttpContext.GetGlobalResourceObject("Resource", "InDiameter").ToString());
                                       columns.Bound(f => f.Value).Width(50)
                                           //.Title("Giá trị thêm")
                                           .Title(@HttpContext.GetGlobalResourceObject("Resource", "Value").ToString());
                                       columns.Bound(f => f.Price).Width(50)
                                           //.Title("Giá trị")
                                           .ReadOnly(true).Title(@HttpContext.GetGlobalResourceObject("Resource", "Price").ToString());
                                   })
                               .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
                               .ClientEvents(e => e.OnError("grid_OnError"))
                               .ToHtmlString()
                           ))

                .ToHtmlString()
                                   ))
        .Selectable()
        .Editable(editing => editing.Mode(Telerik.Web.Mvc.UI.GridEditMode.InLine))
        .ClientEvents(events => events.OnEdit("gridMaterial_onEdit")
                                      .OnRowSelect("grid_OnRowSelect")
                                      //.OnDataBinding("gridMaterial_OnDataBinding")
                                      .OnError("grid_OnError"))
        //.Pageable(page => page.PageSize(10).Style(GridPagerStyles.NextPreviousAndNumeric))
        .Scrollable(f => f.Height(500))
        .Sortable()
        .Filterable()
        .Resizable(f => f.Columns(true))
        .Reorderable(f => f.Columns(true))
        .Render();
}
</div>

