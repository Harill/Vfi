@using Vfi.Ui.Mvc.Vfi.Models.Production
@{
    ViewBag.Title = "Material Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{

   <script type="text/javascript">
            hs.graphicsDir = '';
            hs.align = 'center';
            hs.transitions = ['expand', 'crossfade'];
            hs.outlineType = '';
            hs.fadeInOut = true;
            hs.numberPosition = 'caption';
            hs.dimmingOpacity = 0.75;

            // Add the controlbar
            if (hs.addSlideshow)
                hs.addSlideshow({
                    //slideshowGroup: 'group1',
                    interval: 5000,
                    repeat: false,
                    useControls: true,
                    fixedControls: 'fit',
                    overlayOptions: {
                        opacity: .75,
                        position: 'bottom center',
                        hideOnMouseOut: true
                    }
                });
    </script>

    <script type="text/javascript">

        function gridTabProduct_OnEdit(e) {
            var mode = e.mode;
            var form = e.form;

            var productCodeName = $(form).find('#ProductCode');
            var productCodeNameData = $(form).find('#ProductCode').data('tComboBox');

            if (mode == 'insert') {

            }
            else if (mode == 'edit') {
                productCodeNameData.reload();
                productCodeName.bind('dataBound', function () { // your code 
                    productCodeNameData.select(function (item) {
                        return item.Value == e.dataItem['ProductId'];
                    });
                });
            }
        }

        function gridMaterial_onEdit(e) {
            var mode = e.mode;
            var form = e.form;

            var materialTypeName = $(form).find('#MaterialTypeName');
            var materialTypeNameData = $(form).find('#MaterialTypeName').data('tDropDownList');
            //var vendorCodeName = $(form).find('#VendorCodeName');
            //var vendorCodeNameData = $(form).find('#VendorCodeName').data('tComboBox');

            if (mode == 'insert') {

            }
            else if (mode == 'edit') {

                materialTypeNameData.reload();
                materialTypeName.bind('dataBound', function () { // your code 
                    materialTypeNameData.select(function (item) {
                        return item.Text == e.dataItem['MaterialTypeName'];
                    });
                });
                //vendorCodeNameData.reload();
                //vendorCodeName.bind('dataBound', function () { // your code 
                //    vendorCodeNameData.select(function (item) {
                //        return item.Value == e.dataItem['VendorId'];
                //    });
                //});
            }
        }
        
        function gridMaterial_OnDataBinding(args) {
            var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
            args.data = $.extend(args.data, {
                productCode: productCodeName
            });
        }


        function gridMaterialImg_OnSave(e) {
            var editRow = e.target.getElementsByClassName("t-grid-edit-row")[0];
            var ul2D = editRow.childNodes[2].childNodes[1].childNodes[1];

            if (ul2D != null) {
                var child2D = ul2D.childNodes;
                for (var i = child2D.length - 1; i >= 0; i--) {
                    if (child2D[i].childNodes[0].textContent === "uploaded") {
                        e.values.ImgUrl = child2D[0].childNodes[1].title;

                        // kiểm tra giá trị ImgUrl
                        if (!e.values.ImgUrl) {
                            console.log("ImgUrl hiện đang NULL hoặc rỗng");
                            alert("ImgUrl hiện đang NULL hoặc rỗng");
                        } else {
                            console.log("ImgUrl:", e.values.ImgUrl);
                            alert("ImgUrl: " + e.values.ImgUrl);
                        }

                        //drawing2D = child2D[0].childNodes[1].title;
                        break;
                    }
                }
            }
            return true;
        }


        function gridMaterialImg_OnRowDataBound(e) {
            if (!e.dataItem.CanModify) {
                e.row.getElementsByClassName("t-button t-grid-edit t-button-icon")[0].parentNode.innerHTML = "";
                e.row.getElementsByClassName("t-button t-grid-delete t-button-icon")[0].parentNode.innerHTML = "";
            }
        }




    </script>
}

