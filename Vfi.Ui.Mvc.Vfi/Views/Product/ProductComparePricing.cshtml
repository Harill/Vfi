@using Vfi.Ui.Mvc.Vfi.Models
@{
    ViewBag.Title = "Giá SP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">
        function gridProduct_OnDataBinding(args) {
            if (startGrid) {
                var materialTypeId = $("#MaterialTypeName").data('tComboBox').value();
                if (materialTypeId === "")
                    materialTypeId = 0;
                var customer = $("#Customer").data("tComboBox").value();
                if (customer === "")
                    customer = 0;
                var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
                args.data = $.extend(args.data, {
                    customerId: customer,
                    materialTypeId: materialTypeId,
                    productCode: productCodeName
                });
            }
            index = 0;
        }
        
        //function grid_OnSave(e) {
        //    var customer = $("#Customer").data("tComboBox").value();
        //    if (customer === "")
        //        customer = 0;
        //    var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
        //    e.values = $.extend(e.values,
        //        {
        //            customerId: customer,
        //            productCode: productCodeName
        //        }
        //    );
        //    index = 0;
        //}
        var index = 0;
        var startGrid = false;
        function RefreshGrid2() {
            startGrid = true;
            RefreshGrid('gridProductPricing');
            index = 0;
        }
    </script>
}

<div class="title">
    @*Bảng tính giá sản phẩm*@
    @HttpContext.GetGlobalResourceObject("Resource", "ProductComparePricing")

</div>
<div id="pnlInvPeriod">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">

        <fieldset>
            <legend>
                @*Tiêu chí trích lọc*@
                @HttpContext.GetGlobalResourceObject("Resource", "Filter")

            </legend>
            <div class="grid_3">
                @*Loại nguyên liệu*@
                @HttpContext.GetGlobalResourceObject("Resource", "MaterialType")

            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("MaterialTypeName")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxAllMaterialType", "Material", new {area = ""}))
                        .HtmlAttributes(new {style = "width: 150px"})
                        .DropDownHtmlAttributes(new {style = "width: 250px"})
                        .SelectedIndex(0)
                        .Render();
                }
            </div>
            <div class="grid_2">
                @*Mã KH*@
                @HttpContext.GetGlobalResourceObject("Resource", "CustomerCode2")

            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Customer")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                        .HtmlAttributes(new { style = "width: 150px" })
                        .DropDownHtmlAttributes(new { style = "width: 250px" })
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>

            <div class="grid_2">
                @*Sản phẩm*@
                @HttpContext.GetGlobalResourceObject("Resource", "Product")

            </div>
            <div class="grid_5">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeName")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv", new { area = "Inv" }))
                        .HtmlAttributes(new { style = "width: 150px; " })
                        .DropDownHtmlAttributes(new { style = "width: 250px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Value("")
                        .Render();
                }
            </div>
        
            <button id="btnRefresh" class='t-button' onclick=" return RefreshGrid2(); ">
                <span class='t-icon t-insert'></span>
                @*Làm mới*@
                @HttpContext.GetGlobalResourceObject("Resource", "Refresh")

            </button>
        </fieldset>
    </div>
</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<ProductPricingModel>()
            .Name("gridProductPricing")
            .DataKeys(key => key.Add(f => f.ProductId).RouteKey("productId"))
            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectProductComparePricing", "Product", 
                                          new { area = "", customerId = -1,materialTypeId = 0, productCode = "" })
                                          )
            .Columns(columns => {
                columns.Bound(f => f.CustomerCode).Width(70).ReadOnly(true)
                       //.HeaderTemplate("<strong>Mã KH</strong>")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "CustomerCode2").ToString())
                       .HeaderHtmlAttributes(new { style = "text-align:center;" })
                       .HtmlAttributes(new { style = "text-align:center;" })
                       .ClientTemplate("<strong><#= CustomerCode #></strong>");

                columns.Bound(f => f.ProductName).Width(150).ReadOnly(true)
                       //.HeaderTemplate("<strong>Tên SP</strong>")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductName2").ToString())
                       .HeaderHtmlAttributes(new { style = "text-align:center" })
                       .ClientTemplate("<strong><#= ProductName #></strong>");
         
                columns.Bound(f => f.ProductDesignNo).Width(100).ReadOnly(true)
                       //.HeaderTemplate("<strong>Mã</br>SP KH</strong>")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "CustomerProductCode3").ToString())
                       .HeaderHtmlAttributes(new { style = "text-align:center" })
                       .ClientTemplate("<strong><#= ProductDesignNo #></strong>");
              
                columns.Bound(f => f.ProductCode).Width(100).ReadOnly(true)
                       //.HeaderTemplate("<strong>Mã</br>SP VF</strong>")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "VFProductCode3").ToString())
                       .HeaderHtmlAttributes(new { style = "text-align:center" })
                       .ClientTemplate("<strong><#= ProductCode #></strong>");


                columns.Bound(f => f.ProductCurrency).Width(50).ReadOnly(true)
                       //.HeaderTemplate("<strong>Tiền tệ</strong>")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "Currency").ToString())
                       .HeaderHtmlAttributes(new { style = "text-align:center" });

                columns.Bound(f => f.OutDiameterDesign).Width(50)
                       .HeaderTemplate("<strong>OD</strong>")
                       //.Title(@HttpContext.GetGlobalResourceObject("Resource", "").ToString())
                       .Format("{0:n2}")
                       .HtmlAttributes(new { style = "text-align:right" });
              
                columns.Bound(f => f.Length).Width(50)
                       //.HeaderTemplate("<strong>CD</strong>")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "Length2").ToString())
                       .Format("{0:n2}")
                       .HtmlAttributes(new { style = "text-align:right" });
               
                columns.Bound(f => f.MaterialWeight).Width(70)
                       //.HeaderTemplate("<strong>TL NL SP</strong>")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "Material2").ToString()
                            + " "
                            + @HttpContext.GetGlobalResourceObject("Resource", "Product2").ToString()
                            + " "
                            + @HttpContext.GetGlobalResourceObject("Resource", "Weight2").ToString() 
                       )
                       .Format("{0:n3}")
                       .HtmlAttributes(new { style = "text-align:right" });
                
                columns.Bound(f => f.ProductWeight).Width(50)
                       //.HeaderTemplate("<strong>TL SP</strong>")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductWeight3").ToString())
                       .Format("{0:n3}")
                       .HtmlAttributes(new { style = "text-align:right" });

                columns.Bound(f => f.MaterialCode).Width(120).ReadOnly(true)
                       //.HeaderTemplate("<strong>Mã NL</strong>")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "MaterialCode3").ToString())
                       .HeaderHtmlAttributes(new { style = "text-align:center" })
                       .ClientTemplate("<strong><#= MaterialCode #></strong>");
               
                columns.Bound(f => f.MaterialPrice).Width(60)
                       //.HeaderTemplate("<strong>Giá</br>NL</strong>")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "MaterialPrice3").ToString())
                       .Format("{0:n0}")
                       .HtmlAttributes(new { style = "text-align:right" });
                
                columns.Bound(f => f.ProductMaterialPrice).Width(60)
                       //.HeaderTemplate("<strong>Giá</br>NL SP</strong>")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "Material2").ToString()
                            + " "
                            + @HttpContext.GetGlobalResourceObject("Resource", "Product2").ToString()
                            + "</br>"
                            + @HttpContext.GetGlobalResourceObject("Resource", "Price").ToString()
                       )
                       .Format("{0:n0}")
                       .HtmlAttributes(new { style = "text-align:right" });

                columns.Bound(f => f.ProductPrice).Width(60)
                       //.HeaderTemplate("<strong>Giá bán</strong>")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "SalePrice").ToString())
                       .Format("{0:n0}")
                       .HtmlAttributes(new { style = "text-align:right" });

                columns.Bound(f => f.DiffPrice).Width(60)
                       //.HeaderTemplate("<strong>Chênh lệch</br>giá bán</strong>")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "SaleDiff1").ToString())
                       .Format("{0:n0}")
                       .HtmlAttributes(new { style = "text-align:right" });
               
                columns.Bound(f => f.DiffPriceRate).Width(60)
                       //.HeaderTemplate("<strong>Tỉ lệ</br>giá bán</strong>")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "SaleRate1").ToString())
                       .Format("{0:n0}")
                       .HtmlAttributes(new { style = "text-align:right" });

                columns.Bound(f => f.WorkpiecePrice).Width(60)
                       //.HeaderTemplate("<strong>Giá</br>phế liệu</strong>")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "ScrapPrice1").ToString())
                       .Format("{0:n0}")
                       .HtmlAttributes(new { style = "text-align:right" });
              
                columns.Bound(f => f.WorkpiecePriceRate).Width(60)
                       //.HeaderTemplate("<strong>Tỉ lệ</br>phế liệu</strong>")
                       .Title(@HttpContext.GetGlobalResourceObject("Resource", "ScrapRate1").ToString())
                       .Format("{0:n0}")
                       .HtmlAttributes(new { style = "text-align:right" });
                
            })
            .ClientEvents(events => events.OnDataBinding("gridProduct_OnDataBinding")
                                          //.OnSave("grid_OnSave")
                                          .OnError("grid_OnError"))
            .Selectable()
            .Scrollable(f => f.Height(510))
            .Resizable(f => f.Columns(true))
            .Reorderable(f => f.Columns(true))
            .Filterable()
            .Sortable()
            .Render();
    }
</div>
