@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@using Vfi.Ui.Mvc.Vfi.Models.Production
@model ProductModel
@{
    ViewBag.Title = "Products Quote Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript">
        function gridProduct_OnDataBinding(args) {
            var statusValue = $("#Status").data("tComboBox").value();
            if (statusValue === "")
                statusValue = 0;
            var customer = $("#Customer").data("tComboBox").value();
            if (customer === "")
                customer = 0;
            var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
            args.data = $.extend(args.data, {
                customerId: customer,
                status: statusValue,
                productCode: productCodeName
            });
        }
        
        function status_onChange() {
            RefreshGrid("gridProduct");
        }
        function customer_onChange() {
            RefreshGrid("gridProduct");
        }
        function grid_OnRowDataBound(e) {
            //if (!e.dataItem.CanLock) {
            //    $("#lock_" + e.dataItem.ProductId)[0].parentNode.innerHTML = "";
            //}
        }

        function LockProductCalculate(productId) {
            var message = "Xác nhận thực hiện ";
            message += "\nĐồng ý ?";
            if (confirm(message)) {
                // Save it!
                $.ajax({
                    type: 'post',
                    data: { productId: productId },
                    dataType: 'json',
                    url: '@Url.Action("LockProductCalculate", "Product", new { area = "" })',
                timeout: 20000,
                success: function (res) {
                    if (res.Code != 1)
                        alert("Lỗi !" + res.Message);
                    else {
                        alert("Thành công !" + res.Data);
                        RefreshGrid("gridProduct");
                    }
                }
            });
            } else {
                return false;
            }
        }
    </script>
}
<span id='islock'>@Model.IsCalculateLock </span>
<div class="title">Quản lý thông tin sản phẩm báo giá</div>
<div id="pnlInvPeriod">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">

        <fieldset>
            <legend>Tiêu chí trích lọc</legend>

            <div class="grid_1">
                Mã KH
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Customer")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                        .HtmlAttributes(new { style = "width: 150px" })
                        .DropDownHtmlAttributes(new { style = "width: 250px" })
                        .ClientEvents(events => events.OnChange("customer_onChange"))
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>
            <div class="grid_2">
                Tình trạng sản phẩm
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Status")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxProductStatus", "Product"))
                        .HtmlAttributes(new { style = "width: 100%" })
                        .DropDownHtmlAttributes(new { style = "width: 250px" })
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .HighlightFirstMatch(true)
                        .AutoFill(true)
                        .ClientEvents(events => events.OnChange("status_onChange"))
                        .Render();
                }
            </div>
            <div class="grid_1">Sản phẩm</div>
            <div class="grid_5">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeName")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv", new { area = "Inv" }))
                        .HtmlAttributes(new { style = "width: 150px; " })
                        .DropDownHtmlAttributes(new { style = "width: 250px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Value("")
                        //.ClientEvents(events => events.OnClose("ProductCodeName_OnClose"))
                        .Render();
                }
            </div>
            <button id="btnRefresh" class='t-button' onclick=" return RefreshGrid('gridProduct'); ">
                <span class='t-icon t-insert'></span>
                Làm mới
            </button>
        </fieldset>
    </div>
</div>

