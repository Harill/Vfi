@{
    Html.Telerik().ComboBox()
        .Name(ViewData.TemplateInfo.GetFullHtmlFieldName(string.Empty))
        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxRotateWarehouse", "Warehouse", new { area = "Inv" }).Delay(350))
        //.HtmlAttributes(new { style = "width: 200px" })
        .DropDownHtmlAttributes(new { style = "width: 200px" })
        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
        .HighlightFirstMatch(true)
        .AutoFill(true)
        .Render();
}
