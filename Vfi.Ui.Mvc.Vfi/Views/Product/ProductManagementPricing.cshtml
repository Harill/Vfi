@using Vfi.Ui.Mvc.Vfi.Areas.Factory.Models
@using Vfi.Ui.Mvc.Vfi.Models.Production
@{
    ViewBag.Title = "Giá SP SX";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts{
    <script type="text/javascript">
        function gridProduct_OnDataBinding(args) {
            if (startGrid) {
                var customer = $("#Customer").data("tComboBox").value();
                if (customer === "")
                    customer = 0;
                var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
                args.data = $.extend(args.data, {
                    customerId: customer,
                    productCode: productCodeName
                });
            }
            index = 0;
        }
        
        function grid_OnSave(e) {
            var customer = $("#Customer").data("tComboBox").value();
            if (customer === "")
                customer = 0;
            var productCodeName = $("#ProductCodeName").data("tAutoComplete").value();
            e.values = $.extend(e.values,
                {
                    customerId: customer,
                    productCode: productCodeName
                }
            );
            index = 0;
        }
        var index = 0;
        var startGrid = false;
        function RefreshGrid2() {
            startGrid = true;
            RefreshGrid('gridProductPricing');
            index = 0;
        }
    </script>
}

<div class="title">
    @*Quản lý thông tin sản phẩm (giá sản xuất)*@
    @HttpContext.GetGlobalResourceObject("Resource", "ProductManagementPricing")
</div>
<div id="pnlInvPeriod">
    <div class="t-info-sha" style="padding-left: 15px; padding-right: 15px;">

        <fieldset>
            <legend>
                @*Tiêu chí trích lọc*@
                @HttpContext.GetGlobalResourceObject("Resource", "Filter")
                </legend>

            <div class="grid_1">
                @*Mã KH*@
                @HttpContext.GetGlobalResourceObject("Resource", "CustomerCode2")
            </div>
            <div class="grid_4">
                @{
                    Html.Telerik().ComboBox()
                        .Name("Customer")
                        .DataBinding(binding => binding.Ajax().Select("SelectComboBoxCustomer", "Customer", new { area = "Sales" }))
                        .HtmlAttributes(new { style = "width: 150px" })
                        .DropDownHtmlAttributes(new { style = "width: 250px" })
                        .AutoFill(true)
                        .Filterable(f => f.FilterMode(Telerik.Web.Mvc.UI.AutoCompleteFilterMode.Contains))
                        .Render();
                }
            </div>

            <div class="grid_1">
                @*Sản phẩm*@
                @HttpContext.GetGlobalResourceObject("Resource", "Product")
            </div>
            <div class="grid_5">
                @{
                    Html.Telerik().AutoComplete()
                        .Name("ProductCodeName")
                        .DataBinding(binding => binding.Ajax().Select("AutoCompletedProductInventoryByCode", "Inv", new { area = "Inv" }))
                        .HtmlAttributes(new { style = "width: 150px; " })
                        .DropDownHtmlAttributes(new { style = "width: 250px; " })
                        .Encode(false)
                        .AutoFill(true)
                        .HighlightFirstMatch(true)
                        .Value("")
                        .Render();
                }
            </div>
        
            <button id="btnRefresh" class='t-button' onclick=" return RefreshGrid2(); ">
                <span class='t-icon t-insert'></span>
                @*Làm mới*@
                @HttpContext.GetGlobalResourceObject("Resource", "Refresh")
            </button>
        </fieldset>
    </div>
</div>
<div class="cover-div">
    @{
        Html.Telerik().Grid<ProductionPricingModel>()
            .Name("gridProductPricing")
            .DataKeys(key => key.Add(f => f.ProductId).RouteKey("productId"))
            .DataBinding(
                dataBinding => dataBinding.Ajax()
                                          .Select("SelectProductManagementPricing", "Product", 
                                          new { area = "", customerId = -1, productCode = "" })

                                          .Update("UpdateProductionPricing", "Product", new { area = "", customerId = 0, productCode = "" })
                                          )
            .Columns(columns => {
                columns.Command(command =>
                                command.Edit().ButtonType(Telerik.Web.Mvc.UI.GridButtonType.Image)
                                    .UpdateText(@HttpContext.GetGlobalResourceObject("Resource", "UpdateText").ToString())
                                    .CancelText(@HttpContext.GetGlobalResourceObject("Resource", "CancelText").ToString())
                                    .Text(@HttpContext.GetGlobalResourceObject("Resource", "EditText").ToString())
                    ).Width(50).Title("").HtmlAttributes(new { style = "text-align:center" });

                columns.Bound(f => f.ProductId)
                    //.Title("STT")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Index").ToString())
                    .Width(35).ReadOnly(true)
                    .HeaderHtmlAttributes(new { style = "font-weight: bold" })
                    .ClientTemplate("<#= ++index #>")
                    .HtmlAttributes(new { style = "font-weight: center;" });
             
                columns.Bound(f => f.CustomerCode).Width(70).ReadOnly(true)
                    //.HeaderTemplate("<strong>Mã KH</strong>")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "CustomerCode2").ToString())
                    .HeaderHtmlAttributes(new { style = "text-align:center;" })
                    .HtmlAttributes(new { style = "text-align:center;" })
                    .ClientTemplate("<strong><#= CustomerCode #></strong>");

                columns.Bound(f => f.ProductCode).Width(100).ReadOnly(true)
                    //.HeaderTemplate("<strong>Mã SP</strong>")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ProductCode2").ToString())
                    .HeaderHtmlAttributes(new { style = "text-align:center" })
                    .ClientTemplate("<strong><#= ProductCode #></strong>");

                columns.Bound(f => f.ProductionCamesPricing).Width(100)
                    //.HeaderTemplate("<strong>SX Cames</strong>")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "CamcesProduction2").ToString())
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align:right" });
                
                columns.Bound(f => f.ProductionCncPricing).Width(100)
                    //.HeaderTemplate("<strong>SX CNC</strong>")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "CNCProduction2").ToString())
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align:right" });
              
                columns.Bound(f => f.CncPricing).Width(100)
                    //.HeaderTemplate("<strong>Phay CNC</strong>")
                    //.Title(@HttpContext.GetGlobalResourceObject("Resource", "").ToString())                    
                    .Title("Mil CNC")
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align:right" });
             
                columns.Bound(f => f.Production2Pricing).Width(100)
                    //.HeaderTemplate("<strong>Sản Xuất 2</strong>")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Production2").ToString())
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align:right" });
              
                columns.Bound(f => f.ProductionTeamDPricing).Width(100)
                    //.HeaderTemplate("<strong>Tổ D</strong>")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "TeamD").ToString())
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align:right" });
              
                columns.Bound(f => f.ProductionTechnicalPricing).Width(100)
                    //.HeaderTemplate("<strong>Kỹ Thuật</strong>")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "Technical").ToString())
                    .Format("{0:n0}")
                    .HtmlAttributes(new { style = "text-align:right" });
                
                columns.Bound(f => f.ModifiedDate).Width(50)
                    //.Title("Ngày làm")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ModifiedDate").ToString())
                    .ReadOnly(true)
                    .ClientTemplate("<#= ModifiedDate == null ? '' : $.telerik.formatString('{0:dd/MM/yyyy hh:mm}', ModifiedDate) #>");
               
                columns.Bound(f => f.ModifiedUser).Width(50)
                    //.Title("Người làm")
                    .Title(@HttpContext.GetGlobalResourceObject("Resource", "ModifiedUser").ToString())
                    .ReadOnly(true);
            })
            .ClientEvents(events => events.OnDataBinding("gridProduct_OnDataBinding")
                                          .OnSave("grid_OnSave")
                                          .OnError("grid_OnError"))
            .Selectable()
            .Scrollable(f => f.Height(510))
            .Resizable(f => f.Columns(true))
            .Reorderable(f => f.Columns(true))
            .Filterable()
            .Sortable()
            .Render();
    }
</div>
